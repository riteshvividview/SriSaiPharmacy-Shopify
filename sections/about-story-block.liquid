{%- comment -%}
  Section: About - Story Block
  Reusable premium content block for the About Us page: eyebrow + heading +
  a stack of labeled points (or plain paragraphs, if a point's label is
  left blank) alongside an image. Image side is switchable per instance so
  several of these, added in sequence with alternating "Image position",
  build an editorial-style story page (founding story / commitment to
  health / meet the founder, etc). Everything scroll-reveals in with a
  staggered fade + slide, matching the reveal technique used elsewhere in
  this theme (see 4th-nourish-hero.liquid).
{%- endcomment -%}

{{ 'https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap' | stylesheet_tag }}

{%- liquid
  assign section_id = section.id
  assign s = section.settings
  assign points = section.blocks
-%}

<section
  class="asb{% if s.image_position == 'right' %} asb--image-right{% endif %}"
  id="asb-{{ section_id }}"
  data-asb
  data-scroll-bg-zone="{{ s.background_color | default: '#FFFFFF' }}"
  style="
    --asb-bg: {{ s.background_color | default: '#FFFFFF' }};
    --asb-text: {{ s.text_color | default: '#141414' }};
    --asb-muted: {{ s.muted_color | default: '#5B5B5B' }};
    --asb-accent: {{ s.accent_color | default: '#2E7D32' }};
    --asb-frame: {{ s.frame_color | default: s.accent_color | default: '#2E7D32' }};
    --asb-watermark: {{ s.accent_color | default: '#2E7D32' }};
    --asb-padding-top: {{ s.padding_top | default: 90 }}px;
    --asb-padding-bottom: {{ s.padding_bottom | default: 90 }}px;
  "
>
  {%- if s.bg_word != blank -%}
    <p class="asb__watermark" aria-hidden="true">{{ s.bg_word }}</p>
  {%- endif -%}

  <div class="asb__container">
    <div class="asb__media" data-reveal data-reveal-media>
      <div class="asb__media-inner">
        {%- if s.frame_style == 'accent-offset' -%}
          <div class="asb__media-frame" aria-hidden="true"></div>
        {%- endif -%}
        <div class="asb__media-image">
          {%- if s.image != blank -%}
            <div class="asb__media-parallax" data-media-parallax>
              <img
                src="{{ s.image | image_url: width: 1200 }}"
                srcset="
                  {{ s.image | image_url: width: 600 }} 600w,
                  {{ s.image | image_url: width: 900 }} 900w,
                  {{ s.image | image_url: width: 1200 }} 1200w
                "
                sizes="(max-width: 899px) 100vw, 560px"
                alt="{{ s.image_alt | default: s.heading | escape }}"
                width="{{ s.image.width }}"
                height="{{ s.image.height }}"
                loading="lazy"
              >
            </div>
          {%- else -%}
            <div class="asb__media-placeholder" aria-hidden="true">
              <svg width="56" height="56" viewBox="0 0 24 24" fill="none"><path d="M12 2 3 6v6c0 5 4 8.5 9 10 5-1.5 9-5 9-10V6l-9-4Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M12 8v8M8 12h8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>

    <div class="asb__content">
      {%- if s.eyebrow != blank -%}
        <p class="asb__eyebrow" data-reveal data-reveal-delay="0"><span class="asb__eyebrow-rule" aria-hidden="true"></span>{{ s.eyebrow }}</p>
      {%- endif -%}

      {%- if s.heading != blank -%}
        <h2 class="asb__heading" data-reveal data-reveal-delay="1">{{ s.heading }}</h2>
      {%- endif -%}

      {%- if points.size > 0 -%}
        <div class="asb__points">
          {%- for point in points -%}
            {%- assign ps = point.settings -%}
            {%- assign delay = forloop.index | plus: 1 -%}
            <div class="asb__point" data-reveal data-reveal-delay="{{ delay }}" {{ point.shopify_attributes }}>
              {%- if ps.label != blank -%}
                <p class="asb__point-label">{{ ps.label }}</p>
              {%- endif -%}
              {%- if ps.content != blank -%}
                <div class="asb__point-content">{{ ps.content }}</div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{%- comment -%} ---------------- CSS ---------------- {%- endcomment -%}
<style>
  /* No background paint here on purpose - "Background" now sets the
     shared, whole-page background color that fades in once this section
     reaches the center of the viewport (see the scroll-synced controller
     in the JS below), rather than a hard-edged color block per section. */
  #asb-{{ section_id }} {
    position: relative;
    color: var(--asb-text);
    font-family: 'Poppins', sans-serif;
    padding: var(--asb-padding-top) 20px var(--asb-padding-bottom);
    overflow: hidden;
    isolation: isolate;
  }

  #asb-{{ section_id }} * {
    box-sizing: border-box;
  }

  #asb-{{ section_id }} .asb__watermark {
    position: absolute;
    inset: auto 0 -0.12em 0;
    z-index: 0;
    margin: 0;
    text-align: left;
    transform: translate3d(var(--asb-watermark-x, 0), 0, 0);
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-size: clamp(80px, 16vw, 220px);
    line-height: 1;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--asb-watermark);
    opacity: 0.05;
    pointer-events: none;
    white-space: nowrap;
  }

  #asb-{{ section_id }} .asb__container {
    position: relative;
    z-index: 1;
    max-width: 1240px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    gap: 72px;
    align-items: center;
  }

  #asb-{{ section_id }}.asb--image-right .asb__container {
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
  }

  #asb-{{ section_id }}.asb--image-right .asb__media {
    order: 2;
  }

  /* ---- Media ---- */
  #asb-{{ section_id }} .asb__media {
    opacity: 0;
    transform: translate3d(0, 28px, 0);
    transition: opacity 0.8s cubic-bezier(0.22, 0.61, 0.36, 1), transform 0.8s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  #asb-{{ section_id }} .asb__media.is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  #asb-{{ section_id }} .asb__media-inner {
    position: relative;
    transform: perspective(1000px) rotateX(var(--asb-tilt-x, 0deg)) rotateY(var(--asb-tilt-y, 0deg));
    transition: transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  #asb-{{ section_id }} .asb__media-inner.is-tilting {
    transition: transform 0.1s linear;
  }

  #asb-{{ section_id }} .asb__media-frame {
    position: absolute;
    inset: 20px -20px -20px 20px;
    border-radius: 22px;
    background: var(--asb-frame);
    opacity: 0.16;
    z-index: 0;
    transform: translate3d(0, var(--asb-frame-parallax, 0px), 0);
  }

  #asb-{{ section_id }}.asb--image-right .asb__media-frame {
    inset: 20px 20px -20px -20px;
  }

  #asb-{{ section_id }} .asb__media-image {
    position: relative;
    z-index: 1;
    aspect-ratio: 1 / 1;
    border-radius: 22px;
    overflow: hidden;
    background: #f0f3f0;
    box-shadow: 0 24px 50px rgba(20, 20, 20, 0.12);
  }

  /* Oversized and offset so the scroll-driven translateY (JS, no
     transition - see below) never exposes an empty edge. The reveal
     zoom lives on the img itself, one layer deeper, so the two motions
     (continuous scroll parallax vs. one-time reveal) never fight over
     the same `transform` transition. */
  #asb-{{ section_id }} .asb__media-parallax {
    position: absolute;
    inset: -14% 0;
    height: 128%;
  }

  #asb-{{ section_id }} .asb__media-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.08);
    transition: transform 1.1s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  #asb-{{ section_id }} .asb__media.is-visible .asb__media-image img {
    transform: scale(1);
  }

  #asb-{{ section_id }} .asb__media-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--asb-accent);
    opacity: 0.5;
  }

  /* ---- Content ---- */
  #asb-{{ section_id }} .asb__content {
    min-width: 0;
  }

  #asb-{{ section_id }} [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 22px, 0);
    transition: opacity 0.7s cubic-bezier(0.22, 0.61, 0.36, 1), transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  #asb-{{ section_id }} [data-reveal].is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  #asb-{{ section_id }} [data-reveal-delay="0"] { transition-delay: 0.05s; }
  #asb-{{ section_id }} [data-reveal-delay="1"] { transition-delay: 0.15s; }
  #asb-{{ section_id }} [data-reveal-delay="2"] { transition-delay: 0.25s; }
  #asb-{{ section_id }} [data-reveal-delay="3"] { transition-delay: 0.35s; }
  #asb-{{ section_id }} [data-reveal-delay="4"] { transition-delay: 0.45s; }
  #asb-{{ section_id }} [data-reveal-delay="5"] { transition-delay: 0.55s; }
  #asb-{{ section_id }} [data-reveal-delay="6"] { transition-delay: 0.65s; }

  #asb-{{ section_id }} .asb__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 18px;
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--asb-accent);
  }

  #asb-{{ section_id }} .asb__eyebrow-rule {
    width: 0;
    height: 2px;
    background: var(--asb-accent);
    flex-shrink: 0;
    transition: width 0.6s cubic-bezier(0.22, 0.61, 0.36, 1) 0.25s;
  }

  #asb-{{ section_id }} .asb__eyebrow.is-visible .asb__eyebrow-rule {
    width: 28px;
  }

  #asb-{{ section_id }} .asb__point {
    position: relative;
    padding-left: 16px;
    border-left: 2px solid transparent;
    transition: border-color 0.7s cubic-bezier(0.22, 0.61, 0.36, 1) 0.2s;
  }

  #asb-{{ section_id }} .asb__point.is-visible {
    border-left-color: color-mix(in srgb, var(--asb-accent) 35%, transparent);
  }

  #asb-{{ section_id }} .asb__heading {
    margin: 0 0 32px;
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-weight: 400;
    font-size: clamp(30px, 4vw, 46px);
    line-height: 1.05;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--asb-text);
  }

  #asb-{{ section_id }} .asb__points {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  #asb-{{ section_id }} .asb__point-label {
    margin: 0 0 8px;
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 13.5px;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: var(--asb-text);
  }

  #asb-{{ section_id }} .asb__point-content {
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--asb-muted);
  }

  #asb-{{ section_id }} .asb__point-content p {
    margin: 0 0 0.8em;
  }

  #asb-{{ section_id }} .asb__point-content p:last-child {
    margin-bottom: 0;
  }

  /* ---- Tablet ---- */
  @media (max-width: 999px) {
    #asb-{{ section_id }} .asb__container {
      gap: 48px;
    }
  }

  /* ---- Mobile ---- */
  @media (max-width: 749px) {
    #asb-{{ section_id }} {
      padding-left: 20px;
      padding-right: 20px;
    }

    #asb-{{ section_id }} .asb__container,
    #asb-{{ section_id }}.asb--image-right .asb__container {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    #asb-{{ section_id }}.asb--image-right .asb__media {
      order: 0;
    }

    #asb-{{ section_id }} .asb__media-frame {
      inset: 14px -14px -14px 14px;
    }

    #asb-{{ section_id }}.asb--image-right .asb__media-frame {
      inset: 14px 14px -14px -14px;
    }
  }

  @media (hover: none) {
    #asb-{{ section_id }} .asb__media-inner {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #asb-{{ section_id }} .asb__media,
    #asb-{{ section_id }} [data-reveal],
    #asb-{{ section_id }} .asb__media-image img,
    #asb-{{ section_id }} .asb__media-parallax,
    #asb-{{ section_id }} .asb__media-inner,
    #asb-{{ section_id }} .asb__media-frame,
    #asb-{{ section_id }} .asb__watermark,
    #asb-{{ section_id }} .asb__eyebrow-rule,
    #asb-{{ section_id }} .asb__point {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>

{%- comment -%} ---------------- JS ---------------- {%- endcomment -%}
<script>
  (function () {
    var section = document.getElementById('asb-{{ section_id }}');
    if (!section) return;

    var revealTargets = Array.prototype.slice.call(section.querySelectorAll('[data-reveal]'));
    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (revealTargets.length) {
      if ('IntersectionObserver' in window) {
        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.2, rootMargin: '0px 0px -8% 0px' }
        );
        revealTargets.forEach(function (el) { observer.observe(el); });
      } else {
        revealTargets.forEach(function (el) { el.classList.add('is-visible'); });
      }
    }

    if (reducedMotion) return;

    /* ---- Media: cursor tilt (fine pointers only) ---- */
    var mediaInner = section.querySelector('.asb__media-inner');
    if (mediaInner && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      var maxTilt = 6;

      mediaInner.addEventListener('mousemove', function (e) {
        var rect = mediaInner.getBoundingClientRect();
        var px = (e.clientX - rect.left) / rect.width - 0.5;
        var py = (e.clientY - rect.top) / rect.height - 0.5;
        mediaInner.classList.add('is-tilting');
        mediaInner.style.setProperty('--asb-tilt-y', (px * maxTilt).toFixed(2) + 'deg');
        mediaInner.style.setProperty('--asb-tilt-x', (py * -maxTilt).toFixed(2) + 'deg');
      });

      mediaInner.addEventListener('mouseleave', function () {
        mediaInner.classList.remove('is-tilting');
        mediaInner.style.setProperty('--asb-tilt-x', '0deg');
        mediaInner.style.setProperty('--asb-tilt-y', '0deg');
      });
    }

    /* ---- Scroll-synced parallax: frame panel + image ----
       Both read the same scroll-progress value (0 as the section enters
       the viewport, 1 as it leaves) so they drift together but at
       different speeds/directions - image moves inside its fixed frame
       (see the oversized `.asb__media-parallax` layer in CSS), frame
       panel drifts behind it. Applied directly via inline transform (no
       CSS transition) so it tracks the scroll position exactly, every
       frame, with zero lag. */
    var frame = section.querySelector('.asb__media-frame');
    var mediaParallax = section.querySelector('[data-media-parallax]');
    var watermark = section.querySelector('.asb__watermark');

    if (frame || mediaParallax || watermark) {
      var ticking = false;
      function updateParallax() {
        ticking = false;
        var rect = section.getBoundingClientRect();
        var vh = window.innerHeight || document.documentElement.clientHeight;
        if (rect.bottom < 0 || rect.top > vh) return;
        var progress = (vh - rect.top) / (vh + rect.height);
        var centered = progress - 0.5;
        if (frame) frame.style.setProperty('--asb-frame-parallax', (centered * 36).toFixed(1) + 'px');
        if (mediaParallax) mediaParallax.style.transform = 'translate3d(0, ' + (centered * -28).toFixed(1) + 'px, 0)';
        /* Starts flush left (progress 0, as the section first enters the
           viewport) and drifts rightward as you scroll through it - and
           back left again on the way back up, since this is driven by
           live scroll position rather than a one-shot trigger. */
        if (watermark) watermark.style.setProperty('--asb-watermark-x', (Math.max(progress, 0) * 22).toFixed(1) + '%');
      }
      function onScroll() {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(updateParallax);
      }
      /* This theme scrolls `.page-wrapper` (not window) on desktop - see
         assets/scroll-container.js - so both are watched here. */
      var pageScroller = document.querySelector('.page-wrapper');
      window.addEventListener('scroll', onScroll, { passive: true });
      if (pageScroller) pageScroller.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      updateParallax();
    }
  })();

  /* ---- Whole-page background morph ----
     Runs once total for the whole page, not once per section - any
     section anywhere in the theme can opt in just by carrying a
     `data-scroll-bg-zone="#hexcolor"` attribute (the Featured Collection
     section on this page does the same thing via its own "Sync background
     with page scroll effect" setting). The first section to execute this
     script claims the controller via the `window.__scrollBgController`
     guard, then waits for the full page to parse (DOMContentLoaded) so it
     can find every zone, including ones further down the page that
     haven't rendered yet at this point. A single fixed, full-viewport
     layer sits behind everything and cross-fades its background-color;
     each opted-in section's own background stays transparent, so
     scrolling reads as one continuous page tinting through zones rather
     than stacked color blocks. An IntersectionObserver (not a scroll
     listener) does the zone detection, which is the cheap, browser-native
     way to do this - no per-frame scroll math, and it costs nothing on
     pages that don't have any opted-in section at all. */
  if (!window.__scrollBgController) {
    window.__scrollBgController = true;

    document.addEventListener('DOMContentLoaded', function () {
      var zones = Array.prototype.slice.call(document.querySelectorAll('[data-scroll-bg-zone]'));
      if (!zones.length) return;

      var bgLayer = document.createElement('div');
      bgLayer.id = 'scroll-bg-layer';
      bgLayer.setAttribute('aria-hidden', 'true');
      bgLayer.style.cssText =
        'position:fixed;inset:0;z-index:-1;pointer-events:none;' +
        'background-color:' + (zones[0].getAttribute('data-scroll-bg-zone') || '#ffffff') + ';' +
        (window.matchMedia('(prefers-reduced-motion: reduce)').matches ? '' : 'transition:background-color 0.8s ease;');
      document.body.prepend(bgLayer);

      if (!('IntersectionObserver' in window)) return;

      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            var color = entry.target.getAttribute('data-scroll-bg-zone');
            if (color) bgLayer.style.backgroundColor = color;
          });
        },
        { threshold: 0, rootMargin: '-50% 0px -50% 0px' }
      );
      zones.forEach(function (el) { observer.observe(el); });
    });
  }
</script>

{% schema %}
{
  "name": "About - Story Block",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "Our Story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Rooted In Trust Since 1971" },

    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "frame_style",
      "label": "Image frame style",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "accent-offset", "label": "Offset accent panel" }
      ],
      "default": "accent-offset"
    },
    { "type": "color", "id": "frame_color", "label": "Frame panel color", "info": "Defaults to the accent color below if left blank.", "default": "#2E7D32" },

    { "type": "header", "content": "Decoration" },
    { "type": "text", "id": "bg_word", "label": "Background watermark word", "info": "Optional large faint word behind the section, e.g. \"CARE\". Leave blank to disable." },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "info": "This section has no background of its own - the whole page smoothly tints to this color once this block reaches the center of the screen, and back again as you scroll past it.", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#141414" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#5B5B5B" },
    { "type": "color", "id": "accent_color", "label": "Accent (eyebrow, frame)", "default": "#2E7D32" },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 5, "unit": "px", "default": 90 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 5, "unit": "px", "default": 90 }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "info": "Optional. Leave blank to show only the paragraph, with no bold sub-heading.", "default": "Who We Are" },
        { "type": "richtext", "id": "content", "label": "Text", "default": "<p>Add a short paragraph here.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About - Story Block",
      "blocks": [
        { "type": "point" },
        { "type": "point" }
      ]
    }
  ]
}
{% endschema %}
