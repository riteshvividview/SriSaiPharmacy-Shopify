{%- comment -%}
  Section: About - Founder Spotlight
  Chapter 3 of the "Our Story" page rebuild: a dramatic dark editorial
  chapter telling the founder's story. Two columns - a portrait that
  un-clips via a GSAP ScrollTrigger scrub as the section crosses the
  viewport center (a cinematic reveal), with a magnetic cursor pull on
  fine-pointer devices, and the founder copy set large, editorial-style,
  on the right with a decorative divider between the two paragraphs.
{%- endcomment -%}

{{ 'https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:ital,wght@0,400;0,500;0,600;1,400&display=swap' | stylesheet_tag }}

{%- liquid
  assign section_id = section.id
  assign s = section.settings
  assign paragraphs = section.blocks
-%}

<section
  class="afs"
  id="afs-{{ section_id }}"
  data-afs
  data-scroll-bg-zone="{{ s.background_color | default: '#123321' }}"
  style="
    --afs-bg: {{ s.background_color | default: '#123321' }};
    --afs-text: {{ s.text_color | default: '#F2F6F1' }};
    --afs-accent: {{ s.accent_color | default: '#6FCF97' }};
  "
>
  <div class="afs__inner">
    <div class="afs__media" data-afs-media>
      <div class="afs__media-clip" data-afs-clip>
        {%- if s.image != blank -%}
          <img
            class="afs__media-image"
            src="{{ s.image | image_url: width: 1000 }}"
            srcset="
              {{ s.image | image_url: width: 500 }} 500w,
              {{ s.image | image_url: width: 800 }} 800w,
              {{ s.image | image_url: width: 1000 }} 1000w
            "
            sizes="(max-width: 899px) 100vw, 480px"
            alt="{{ s.image_alt | default: s.heading | escape }}"
            width="{{ s.image.width }}"
            height="{{ s.image.height }}"
            loading="lazy"
          >
        {%- else -%}
          <div class="afs__media-placeholder" aria-hidden="true">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.3"/><path d="M4 20c0-4 3.5-7 8-7s8 3 8 7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
          </div>
        {%- endif -%}
      </div>
      <span class="afs__media-frame" aria-hidden="true"></span>
    </div>

    <div class="afs__content">
      {%- if s.eyebrow != blank -%}<p class="afs__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="afs__heading">{{ s.heading }}</h2>{%- endif -%}

      {%- if paragraphs.size > 0 -%}
        <div class="afs__paragraphs">
          {%- for block in paragraphs -%}
            {%- assign bs = block.settings -%}
            {%- unless forloop.first -%}<span class="afs__divider" aria-hidden="true">&#10087;</span>{%- endunless -%}
            {%- if bs.content != blank -%}
              <div class="afs__paragraph" {{ block.shopify_attributes }}>{{ bs.content }}</div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  #afs-{{ section_id }} {
    position: relative;
    background: var(--afs-bg);
    color: var(--afs-text);
    font-family: 'Poppins', sans-serif;
    padding: 110px 20px;
    overflow: hidden;
  }

  #afs-{{ section_id }}.afs--transparent-bg {
    background: transparent;
  }

  #afs-{{ section_id }} * {
    box-sizing: border-box;
  }

  #afs-{{ section_id }} .afs__inner {
    position: relative;
    z-index: 1;
    max-width: 1160px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    gap: 80px;
    align-items: center;
  }

  #afs-{{ section_id }} .afs__media {
    position: relative;
  }

  #afs-{{ section_id }} .afs__media-clip {
    position: relative;
    z-index: 1;
    aspect-ratio: 4 / 5;
    border-radius: 18px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.06);
    will-change: clip-path;
  }

  #afs-{{ section_id }} .afs__media-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.06);
  }

  #afs-{{ section_id }} .afs__media-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--afs-accent);
    opacity: 0.5;
  }

  #afs-{{ section_id }} .afs__media-frame {
    position: absolute;
    inset: 18px -18px -18px 18px;
    border-radius: 18px;
    border: 1.5px solid color-mix(in srgb, var(--afs-accent) 50%, transparent);
    z-index: 0;
  }

  #afs-{{ section_id }} .afs__eyebrow {
    margin: 0 0 14px;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--afs-accent);
  }

  #afs-{{ section_id }} .afs__heading {
    margin: 0 0 34px;
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-weight: 400;
    font-size: clamp(32px, 4.5vw, 54px);
    line-height: 1.05;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: #ffffff;
  }

  #afs-{{ section_id }} .afs__paragraphs {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  #afs-{{ section_id }} .afs__paragraph {
    font-size: 18px;
    line-height: 1.7;
    font-style: italic;
  }

  #afs-{{ section_id }} .afs__paragraph p {
    margin: 0;
  }

  #afs-{{ section_id }} .afs__divider {
    color: var(--afs-accent);
    font-size: 14px;
    opacity: 0.7;
  }

  /* ---- Tablet ---- */
  @media (max-width: 899px) {
    #afs-{{ section_id }} .afs__inner {
      grid-template-columns: 1fr;
      gap: 48px;
      max-width: 560px;
    }

    #afs-{{ section_id }} .afs__media-frame {
      inset: 14px -14px -14px 14px;
    }
  }

  /* ---- Mobile ---- */
  @media (max-width: 749px) {
    #afs-{{ section_id }} {
      padding: 80px 20px;
    }

    #afs-{{ section_id }} .afs__paragraph {
      font-size: 16px;
    }
  }

  @media (hover: none) {
    #afs-{{ section_id }} .afs__media-clip {
      transform: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #afs-{{ section_id }} .afs__media-clip {
      clip-path: none !important;
    }

    #afs-{{ section_id }} .afs__media-clip,
    #afs-{{ section_id }} .afs__media-image {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  (function () {
    var section = document.getElementById('afs-{{ section_id }}');
    if (!section) return;

    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function initAfs() {
      if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;
      var media = section.querySelector('[data-afs-media]');
      var clip = section.querySelector('[data-afs-clip]');
      if (!media || !clip) return;

      gsap.fromTo(
        clip,
        { clipPath: 'inset(18% 18% 18% 18% round 18px)' },
        {
          clipPath: 'inset(0% 0% 0% 0% round 18px)',
          ease: 'none',
          scrollTrigger: {
            trigger: media,
            start: 'top 85%',
            end: 'top 30%',
            scrub: true
          }
        }
      );
    }

    if (!reducedMotion) {
      window.__aboutChapterInits = window.__aboutChapterInits || [];
      window.__aboutChapterInits.push(initAfs);
      initAfs();
    }

    /* ---- Magnetic cursor pull on the portrait frame (fine-pointer only) ---- */
    if (!reducedMotion && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      var media = section.querySelector('[data-afs-media]');
      if (media) {
        media.addEventListener('mousemove', function (e) {
          var rect = media.getBoundingClientRect();
          var px = (e.clientX - rect.left) / rect.width - 0.5;
          var py = (e.clientY - rect.top) / rect.height - 0.5;
          media.style.transform = 'translate3d(' + (px * 14).toFixed(1) + 'px, ' + (py * 14).toFixed(1) + 'px, 0)';
        });
        media.addEventListener('mouseleave', function () {
          media.style.transform = 'translate3d(0, 0, 0)';
        });
        media.style.transition = 'transform 0.4s cubic-bezier(0.22, 0.61, 0.36, 1)';
      }
    }
  })();
</script>

{% schema %}
{
  "name": "About - Founder Spotlight",
  "tag": "section",
  "class": "shopify-section--about-founder-spotlight",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Journey" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet The Founder" },
    { "type": "image_picker", "id": "image", "label": "Portrait" },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background (also this chapter's scroll-color zone)", "default": "#123321" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F2F6F1" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#6FCF97" }
  ],
  "blocks": [
    {
      "type": "paragraph",
      "name": "Paragraph",
      "settings": [
        { "type": "richtext", "id": "content", "label": "Content" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About - Founder Spotlight",
      "blocks": [
        { "type": "paragraph" },
        { "type": "paragraph" }
      ]
    }
  ]
}
{% endschema %}
