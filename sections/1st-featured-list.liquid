{%- comment -%}
  Section: Featured Collection
  Heading + arrow-nav product slider (native drag/swipe/trackpad scroll,
  no external libraries) with block-driven, uncapped slide count.
{%- endcomment -%}

{{ 'https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@400;500;600;700;800&display=swap' | stylesheet_tag }}

{%- liquid
  assign section_id = section.id
  assign s = section.settings
  assign products = section.blocks | where: 'type', 'product'
  assign products_count = products.size
-%}

<!-- HTML -->
<section
  class="fc{% if s.sync_scroll_bg %} fc--sync-bg{% endif %}"
  id="fc-{{ section_id }}"
  data-fc
  {%- if s.sync_scroll_bg %}
  data-scroll-bg-zone="{{ s.section_bg | default: '#FFFFFF' }}"
  {%- endif %}
  data-desktop-visible="{{ s.desktop_slides_per_view }}"
  data-tablet-visible="{{ s.tablet_slides_per_view }}"
  data-mobile-visible="{{ s.mobile_slides_per_view }}"
  style="
    --fc-bg: {{ s.section_bg }};
    --fc-container-width: {{ s.container_width }}px;
    --fc-content-width: {{ s.content_width }}px;
    --fc-padding-top: {{ s.padding_top }}px;
    --fc-padding-bottom: {{ s.padding_bottom }}px;
    --fc-card-gap: {{ s.card_gap }}px;
    --fc-card-radius: {{ s.card_radius }}px;
    --fc-shadow-alpha: {{ s.card_shadow_opacity }};
    --fc-card-shadow: 0 8px 24px rgba(0 0 0 / calc(var(--fc-shadow-alpha) / 1000));
    --fc-card-shadow-hover: 0 16px 34px rgba(0 0 0 / calc(var(--fc-shadow-alpha) / 700));
    --fc-anim-speed: {{ s.animation_speed }}ms;

    --fc-heading-size: {{ s.heading_font_size }}px;
    --fc-heading-weight: {{ s.heading_font_weight }};
    --fc-heading-spacing: {{ s.heading_letter_spacing }}px;
    --fc-title-size: {{ s.title_font_size }}px;
    --fc-vendor-size: {{ s.vendor_font_size }}px;
    --fc-price-size: {{ s.price_font_size }}px;
    --fc-unit-price-size: {{ s.unit_price_font_size }}px;

    --fc-card-bg: {{ s.card_bg_color }};
    --fc-text-color: {{ s.text_color }};
    --fc-muted-color: {{ s.muted_text_color }};
    --fc-price-color: {{ s.price_color }};
    --fc-accent: {{ s.accent_color }};
    --fc-arrow-color: {{ s.arrow_color }};
    --fc-arrow-hover-color: {{ s.arrow_hover_color }};

    --fc-card-height: {{ s.card_height }}px;
    --fc-image-size: {{ s.image_size_percent }}%;
    --fc-image-padding: {{ s.image_padding }}px;
    --fc-image-fit: {{ s.image_fit }};
    --fc-hover-zoom: {{ s.hover_zoom }};
    --fc-hover-lift: {{ s.hover_lift }}px;

    --fc-badge-bg: {{ s.badge_bg_color }};
    --fc-badge-text: {{ s.badge_text_color }};
    --fc-badge-size: {{ s.badge_font_size }}px;
    --fc-badge-radius: {{ s.badge_radius }}px;
    --fc-badge-padding: {{ s.badge_padding }}px;

    --fc-icon-bg: {{ s.icon_bg_color }};
    --fc-icon-bg-hover: {{ s.icon_bg_hover_color }};
    --fc-icon-color: {{ s.icon_color }};
    --fc-icon-size: {{ s.icon_size }}px;
    --fc-icon-radius: {{ s.icon_radius }}px;

    --fc-btn-bg: {{ s.button_bg }};
    --fc-btn-bg-hover: {{ s.button_bg_hover }};
    --fc-btn-text: {{ s.button_text_color }};
    --fc-btn-radius: {{ s.button_radius }}px;
    --fc-btn-padding-x: {{ s.button_padding_x }}px;
    --fc-btn-padding-y: {{ s.button_padding_y }}px;
  "
>
  <div class="fc__container">
    <div class="fc__header">
      <h2 class="fc__heading"{% if s.sync_scroll_bg %} data-reveal{% endif %}>{{ s.heading }}</h2>

      {%- if products_count > 1 -%}
        <div class="fc__nav">
          <button type="button" class="fc__arrow fc__arrow--prev" data-prev aria-label="Previous products">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
              <path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button type="button" class="fc__arrow fc__arrow--next" data-next aria-label="Next products">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
              <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      {%- endif -%}
    </div>

    <div class="fc__slider">
      <div class="fc__track" data-track tabindex="0" role="region" aria-label="{{ s.heading | escape }} products">
        {%- for block in products -%}
          {%- assign bs = block.settings -%}
          <div class="fc__card" data-card{% if s.sync_scroll_bg %} data-reveal data-reveal-delay="{{ forloop.index0 }}"{% endif %} {{ block.shopify_attributes }}>
            <a
              href="{{ bs.link | default: '#' }}"
              class="fc__card-link"
              aria-label="{{ bs.title | escape }}"
            >
              {%- if bs.enable_badge and bs.badge_text != blank -%}
                <span class="fc__badge">{{ bs.badge_text }}</span>
              {%- endif -%}

              {%- if bs.enable_icon -%}
                <span class="fc__icon-btn" aria-hidden="true">
                  {%- case s.icon_style -%}
                    {%- when 'bag' -%}
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="none"><path d="M6 8h12l-1 12H7L6 8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 8V6a3 3 0 0 1 6 0v2" stroke="currentColor" stroke-width="1.6"/></svg>
                    {%- when 'heart' -%}
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="none"><path d="M12 20s-7-4.35-9.5-8.5C1 8 2.5 5 5.8 5 8 5 10 6.5 12 9c2-2.5 4-4 6.2-4 3.3 0 4.8 3 3.3 6.5C19 15.65 12 20 12 20Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                    {%- when 'plus' -%}
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    {%- else -%}
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="none"><path d="M2.5 12s3.7-6.5 9.5-6.5S21.5 12 21.5 12 17.8 18.5 12 18.5 2.5 12 2.5 12Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="12" cy="12" r="2.5" stroke="currentColor" stroke-width="1.6"/></svg>
                  {%- endcase -%}
                </span>
              {%- endif -%}

              <div class="fc__image-wrap">
                {%- if bs.image != blank -%}
                  <img
                    class="fc__image"
                    src="{{ bs.image | image_url: width: 600 }}"
                    srcset="
                      {{ bs.image | image_url: width: 300 }} 300w,
                      {{ bs.image | image_url: width: 600 }} 600w,
                      {{ bs.image | image_url: width: 900 }} 900w
                    "
                    sizes="(max-width: 749px) 240px, 320px"
                    alt="{{ bs.alt_text | default: bs.title | escape }}"
                    width="{{ bs.image.width }}"
                    height="{{ bs.image.height }}"
                    loading="lazy"
                    style="object-position: {{ bs.image_focal_point | default: '50% 50%' }};"
                  >
                {%- endif -%}
                {%- if s.enable_hover_pour and s.hover_pour_image != blank -%}
                  <img
                    class="fc__pour"
                    src="{{ s.hover_pour_image | image_url: width: 600 }}"
                    alt=""
                    aria-hidden="true"
                    loading="lazy"
                  >
                {%- endif -%}
              </div>

              <div class="fc__info">
                <p class="fc__title">{{ bs.title }}</p>
                {%- if bs.vendor != blank -%}
                  <p class="fc__vendor">{{ bs.vendor }}</p>
                {%- endif -%}
                <p class="fc__price">
                  <span class="fc__price-now">{{ bs.price }}</span>
                  {%- if bs.compare_at_price != blank -%}
                    <span class="fc__price-compare">{{ bs.compare_at_price }}</span>
                  {%- endif -%}
                </p>
                {%- if bs.unit_price != blank -%}
                  <p class="fc__unit-price">{{ bs.unit_price }}</p>
                {%- endif -%}
              </div>
            </a>
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- if s.button_text != blank -%}
      <div class="fc__view-all-wrap">
        <a href="{{ s.button_url | default: '#' }}" class="fc__view-all">{{ s.button_text }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

<!-- CSS -->
<style>
  #fc-{{ section_id }} {
    position: relative;
    background: var(--fc-bg);
    padding: var(--fc-padding-top) 20px var(--fc-padding-bottom);
  }

  /* "Sync background with page scroll effect": no background paint of its
     own - it hands off to the shared whole-page background layer (see
     about-story-block.liquid's scroll-bg controller) instead, so this
     section reads as a continuation of that same color flow rather than a
     hard-edged block sitting on top of it. */
  #fc-{{ section_id }}.fc--sync-bg {
    background: transparent;
  }

  #fc-{{ section_id }}.fc--sync-bg [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 24px, 0);
    transition: opacity 0.7s cubic-bezier(0.22, 0.61, 0.36, 1), transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  #fc-{{ section_id }}.fc--sync-bg [data-reveal].is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  #fc-{{ section_id }}.fc--sync-bg [data-reveal-delay="0"] { transition-delay: 0s; }
  #fc-{{ section_id }}.fc--sync-bg [data-reveal-delay="1"] { transition-delay: 0.1s; }
  #fc-{{ section_id }}.fc--sync-bg [data-reveal-delay="2"] { transition-delay: 0.2s; }
  #fc-{{ section_id }}.fc--sync-bg [data-reveal-delay="3"] { transition-delay: 0.3s; }
  #fc-{{ section_id }}.fc--sync-bg [data-reveal-delay="4"] { transition-delay: 0.4s; }
  #fc-{{ section_id }}.fc--sync-bg [data-reveal-delay="5"] { transition-delay: 0.5s; }

  @media (prefers-reduced-motion: reduce) {
    #fc-{{ section_id }}.fc--sync-bg [data-reveal] {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }

  #fc-{{ section_id }} * {
    box-sizing: border-box;
  }

  #fc-{{ section_id }} .fc__container {
    max-width: var(--fc-container-width);
    margin: 0 auto;
  }

  #fc-{{ section_id }} .fc__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
  }

  #fc-{{ section_id }} .fc__heading {
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-weight: var(--fc-heading-weight);
    font-size: var(--fc-heading-size);
    letter-spacing: var(--fc-heading-spacing);
    color: var(--fc-text-color);
    text-transform: uppercase;
    line-height: 1.1;
    margin: 0;
  }

  #fc-{{ section_id }} .fc__nav {
    display: flex;
    gap: 10px;
    flex-shrink: 0;
  }

  #fc-{{ section_id }} .fc__arrow {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1.5px solid var(--fc-arrow-color);
    border-radius: 10px;
    color: var(--fc-arrow-color);
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
    padding: 0;
  }

  #fc-{{ section_id }} .fc__arrow:hover,
  #fc-{{ section_id }} .fc__arrow:focus-visible {
    background: var(--fc-accent);
    border-color: var(--fc-accent);
    color: #ffffff;
    outline: none;
  }

  #fc-{{ section_id }} .fc__arrow[disabled] {
    opacity: 0.35;
    cursor: default;
    pointer-events: none;
  }

  /* ---- Slider ---- */
  #fc-{{ section_id }} .fc__slider {
    min-width: 0;
  }

  #fc-{{ section_id }} .fc__track {
    display: flex;
    gap: var(--fc-card-gap);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
    padding: 6px 4px 16px;
    margin: -6px -4px -16px;
    scrollbar-width: none;
    -ms-overflow-style: none;
    user-select: none;
  }

  #fc-{{ section_id }} .fc__track::-webkit-scrollbar {
    display: none;
  }

  #fc-{{ section_id }} .fc__track.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
  }

  #fc-{{ section_id }} .fc__card {
    position: relative;
    flex: 0 0 var(--fc-card-w, 280px);
    scroll-snap-align: start;
  }

  #fc-{{ section_id }} .fc__card-link {
    display: flex;
    flex-direction: column;
    height: var(--fc-card-height);
    text-decoration: none;
    color: inherit;
    background: var(--fc-card-bg);
    border-radius: var(--fc-card-radius);
    box-shadow: var(--fc-card-shadow);
    padding: 20px 20px 24px;
    position: relative;
    overflow: hidden;
    transition: transform var(--fc-anim-speed) cubic-bezier(0.22, 0.61, 0.36, 1),
      box-shadow var(--fc-anim-speed) cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  #fc-{{ section_id }} .fc__card:hover .fc__card-link {
    transform: translateY(calc(var(--fc-hover-lift) * -1));
    box-shadow: var(--fc-card-shadow-hover);
  }

  #fc-{{ section_id }} .fc__badge {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
    background: var(--fc-badge-bg);
    color: var(--fc-badge-text);
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: var(--fc-badge-size);
    border-radius: var(--fc-badge-radius);
    padding: var(--fc-badge-padding);
    line-height: 1;
  }

  #fc-{{ section_id }} .fc__icon-btn {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 2;
    width: var(--fc-icon-size);
    height: var(--fc-icon-size);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--fc-icon-bg);
    color: var(--fc-icon-color);
    border-radius: var(--fc-icon-radius);
    transform: translateX(calc(100% + 20px));
    transition: transform var(--fc-anim-speed) cubic-bezier(0.22, 0.61, 0.36, 1),
      background-color 0.25s ease;
  }

  #fc-{{ section_id }} .fc__card:hover .fc__icon-btn {
    transform: translateX(0);
  }

  #fc-{{ section_id }} .fc__icon-btn:hover {
    background: var(--fc-icon-bg-hover, var(--fc-accent));
  }

  #fc-{{ section_id }} .fc__image-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--fc-image-size);
    padding: var(--fc-image-padding);
    overflow: hidden;
  }

  #fc-{{ section_id }} .fc__image {
    width: 100%;
    height: 100%;
    object-fit: var(--fc-image-fit);
    display: block;
    transition: transform var(--fc-anim-speed) cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  #fc-{{ section_id }} .fc__card:hover .fc__image {
    transform: scale(var(--fc-hover-zoom));
  }

  /* ---- Hover pour overlay: an animated WebP (real alpha transparency,
     no GIF-style dithering/halos around soft edges) layered on top of
     the product photo. It's always playing in the background - hover
     only fades it in/out via opacity, which is what keeps the show/hide
     smooth (no restart flicker from swapping the image src). ---- */
  #fc-{{ section_id }} .fc__pour {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: var(--fc-image-fit);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  #fc-{{ section_id }} .fc__card:hover .fc__pour {
    opacity: 1;
  }

  #fc-{{ section_id }} .fc__info {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    text-align: center;
    gap: 4px;
    margin-top: auto;
  }

  #fc-{{ section_id }} .fc__title {
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    font-size: var(--fc-title-size);
    color: var(--fc-text-color);
    margin: 6px 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.35;
  }

  #fc-{{ section_id }} .fc__vendor {
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    font-size: var(--fc-vendor-size);
    color: var(--fc-muted-color);
    margin: 0;
  }

  #fc-{{ section_id }} .fc__price {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: var(--fc-price-size);
    color: var(--fc-price-color);
    margin: 4px 0 0;
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 8px;
  }

  #fc-{{ section_id }} .fc__price-compare {
    font-weight: 400;
    font-size: 0.8em;
    color: var(--fc-muted-color);
    text-decoration: line-through;
  }

  #fc-{{ section_id }} .fc__unit-price {
    font-family: 'Poppins', sans-serif;
    font-size: var(--fc-unit-price-size);
    color: var(--fc-muted-color);
    margin: 2px 0 0;
  }

  /* ---- View all button ---- */
  #fc-{{ section_id }} .fc__view-all-wrap {
    display: flex;
    justify-content: center;
    margin-top: 36px;
  }

  #fc-{{ section_id }} .fc__view-all {
    display: inline-block;
    background: var(--fc-btn-bg);
    color: var(--fc-btn-text);
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    border-radius: var(--fc-btn-radius);
    padding: var(--fc-btn-padding-y) var(--fc-btn-padding-x);
    transition: background-color 0.3s ease, transform 0.3s ease;
  }

  #fc-{{ section_id }} .fc__view-all:hover {
    background: var(--fc-btn-bg-hover);
    transform: translateY(-2px);
  }

  /* ---- Tablet ---- */
  @media (max-width: 999px) {
    #fc-{{ section_id }} .fc__heading {
      font-size: min(var(--fc-heading-size), 2.2rem);
    }
  }

  /* ---- Mobile ---- */
  @media (max-width: 749px) {
    #fc-{{ section_id }} .fc__header {
      align-items: center;
    }

    #fc-{{ section_id }} .fc__heading {
      font-size: min(var(--fc-heading-size), 1.7rem);
    }

    #fc-{{ section_id }} .fc__arrow {
      width: 36px;
      height: 36px;
    }

    #fc-{{ section_id }} .fc__view-all {
      display: block;
      text-align: center;
    }

    #fc-{{ section_id }} .fc__icon-btn {
      transform: none;
      transition: background-color 0.25s ease;
    }

    #fc-{{ section_id }} .fc__card:hover .fc__icon-btn {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #fc-{{ section_id }} .fc__card-link,
    #fc-{{ section_id }} .fc__image,
    #fc-{{ section_id }} .fc__view-all,
    #fc-{{ section_id }} .fc__icon-btn,
    #fc-{{ section_id }} .fc__pour {
      transition: none !important;
    }

    #fc-{{ section_id }} .fc__pour {
      display: none;
    }
  }
</style>

<!-- JavaScript -->
<script>
  (function () {
    var section = document.getElementById('fc-{{ section_id }}');
    if (!section) return;

    var track = section.querySelector('[data-track]');
    var cards = Array.prototype.slice.call(section.querySelectorAll('[data-card]'));
    var prevBtn = section.querySelector('[data-prev]');
    var nextBtn = section.querySelector('[data-next]');

    if (!track || !cards.length) return;

    function readSettings() {
      return {
        desktopVisible: parseFloat(section.getAttribute('data-desktop-visible')) || 4,
        tabletVisible: parseFloat(section.getAttribute('data-tablet-visible')) || 2.2,
        mobileVisible: parseFloat(section.getAttribute('data-mobile-visible')) || 1.2,
        gap: parseFloat(getComputedStyle(section).getPropertyValue('--fc-card-gap')) || 24
      };
    }

    function updateCardWidth() {
      var settings = readSettings();
      var w = window.innerWidth;
      var visible = w <= 749 ? settings.mobileVisible : w <= 999 ? settings.tabletVisible : settings.desktopVisible;
      var viewportWidth = track.clientWidth;
      var width = (viewportWidth - settings.gap * (visible - 1)) / visible;
      width = Math.max(120, width);
      section.style.setProperty('--fc-card-w', width.toFixed(2) + 'px');
    }

    function stepSize() {
      var cardRect = cards[0].getBoundingClientRect();
      var gap = cards.length > 1 ? cards[1].getBoundingClientRect().left - cardRect.right : 0;
      return cardRect.width + Math.max(gap, 0);
    }

    function updateArrows() {
      if (!prevBtn || !nextBtn) return;
      var maxScroll = track.scrollWidth - track.clientWidth;
      prevBtn.disabled = track.scrollLeft <= 1;
      nextBtn.disabled = track.scrollLeft >= maxScroll - 1;
    }

    var resizeRaf = null;
    function handleResize() {
      if (resizeRaf) window.cancelAnimationFrame(resizeRaf);
      resizeRaf = window.requestAnimationFrame(function () {
        updateCardWidth();
        updateArrows();
      });
    }

    var scrollTicking = false;
    track.addEventListener(
      'scroll',
      function () {
        if (!scrollTicking) {
          window.requestAnimationFrame(function () {
            updateArrows();
            scrollTicking = false;
          });
          scrollTicking = true;
        }
      },
      { passive: true }
    );

    window.addEventListener('resize', handleResize, { passive: true });
    window.addEventListener('load', handleResize);

    if (prevBtn) {
      prevBtn.addEventListener('click', function () {
        track.scrollBy({ left: -stepSize(), behavior: 'smooth' });
      });
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', function () {
        track.scrollBy({ left: stepSize(), behavior: 'smooth' });
      });
    }

    /* ---- Mouse drag-to-scroll (touch/trackpad already work natively) ---- */
    var isDragging = false;
    var dragMoved = false;
    var startX = 0;
    var startScrollLeft = 0;

    track.addEventListener('pointerdown', function (e) {
      if (e.pointerType !== 'mouse') return;
      isDragging = true;
      dragMoved = false;
      startX = e.clientX;
      startScrollLeft = track.scrollLeft;
      track.classList.add('is-dragging');
    });

    window.addEventListener('pointermove', function (e) {
      if (!isDragging) return;
      var dx = e.clientX - startX;
      if (Math.abs(dx) > 4) dragMoved = true;
      track.scrollLeft = startScrollLeft - dx;
    });

    function endDrag() {
      if (!isDragging) return;
      isDragging = false;
      track.classList.remove('is-dragging');
    }

    window.addEventListener('pointerup', endDrag);
    window.addEventListener('pointercancel', endDrag);

    track.addEventListener(
      'click',
      function (e) {
        if (dragMoved) {
          e.preventDefault();
          e.stopPropagation();
        }
        dragMoved = false;
      },
      true
    );

    updateCardWidth();
    updateArrows();

    /* ---- "Sync background with page scroll effect": reveal heading/cards ---- */
    if (section.classList.contains('fc--sync-bg')) {
      var revealTargets = Array.prototype.slice.call(section.querySelectorAll('[data-reveal]'));
      if (revealTargets.length) {
        if ('IntersectionObserver' in window) {
          var revealObserver = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  revealObserver.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.2, rootMargin: '0px 0px -8% 0px' }
          );
          revealTargets.forEach(function (el) { revealObserver.observe(el); });
        } else {
          revealTargets.forEach(function (el) { el.classList.add('is-visible'); });
        }
      }
    }
  })();
</script>

