{%- comment -%}
  Section: Trust Badges & Certificates
  Full-width strip showcasing certification/trust badge images (AYUSH, GMP,
  "Since 1971", etc). Badges auto-scroll in an infinite marquee (grayscale
  until hovered) and the whole row drifts with a light parallax as the page
  scrolls, reusing the same getBoundingClientRect-driven scroll-progress
  technique as the other custom sections in this theme. Blocks take an
  image only, by design - the certificate artwork speaks for itself.
{%- endcomment -%}

{{ 'https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@400;500;600;700;800&display=swap' | stylesheet_tag }}

{%- liquid
  assign section_id = section.id
  assign s = section.settings
  assign badges = section.blocks
  assign badge_count = badges.size
-%}

<section
  class="tb{% if s.sync_scroll_bg %} tb--transparent-bg{% endif %}"
  id="tb-{{ section_id }}"
  data-tb
  data-parallax-amount="{{ s.parallax_amount | default: 16 }}"
  {% if s.sync_scroll_bg %}data-scroll-bg-zone="{{ s.background_color | default: '#F2F6F1' }}"{% endif %}
  style="
    --tb-bg: {{ s.background_color | default: '#F2F6F1' }};
    --tb-border: {{ s.accent_color | default: '#2E7D32' }};
    --tb-heading-color: {{ s.heading_color | default: '#141414' }};
    --tb-eyebrow-color: {{ s.accent_color | default: '#2E7D32' }};
    --tb-subtext-color: {{ s.subtext_color | default: '#5B5B5B' }};
    --tb-badge-height: {{ s.badge_height | default: 84 }}px;
    --tb-badge-gap: {{ s.badge_gap | default: 64 }}px;
    --tb-marquee-duration: {{ s.marquee_speed | default: 28 }}s;
    --tb-padding-block: {{ s.padding_block | default: 64 }}px;
  "
>
  {%- if s.show_top_border -%}<div class="tb__edge tb__edge--top"></div>{%- endif -%}

  <div class="tb__floaters" aria-hidden="true">
    <span class="tb__floater tb__floater--1" data-tb-parallax data-speed="0.5"></span>
    <span class="tb__floater tb__floater--2" data-tb-parallax data-speed="0.8"></span>
  </div>

  <div class="tb__inner">
    {%- if s.eyebrow != blank or s.heading != blank or s.subheading != blank -%}
      <div class="tb__header" data-tb-parallax data-speed="0.3">
        {%- if s.eyebrow != blank -%}<p class="tb__eyebrow" data-tb-drop style="transition-delay:0s;">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="tb__heading" data-tb-drop style="transition-delay:0.08s;">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.subheading != blank -%}<p class="tb__subheading" data-tb-drop style="transition-delay:0.16s;">{{ s.subheading }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if badge_count > 0 -%}
      {%- comment -%}
        For the marquee to look truly infinite (no dead gap after the last
        badge), the scrolling track must always be wider than the viewport
        - not just duplicated once. With only a handful of badges, two
        copies can be much narrower than a full-width section, leaving a
        long stretch of empty background before the loop visibly repeats.
        So each of the two halves is itself an adaptive number of repeats
        of the full badge set (more repeats when there are fewer badges),
        guaranteeing the track comfortably overflows any viewport width.
      {%- endcomment -%}
      {%- capture badge_set_markup -%}
        {%- for block in badges -%}
          {%- assign bs = block.settings -%}
          {%- if bs.image != blank -%}
            <span class="tb__badge" data-tb-drop data-tb-magnetic style="transition-delay: {{ forloop.index0 | times: 0.08 }}s;">
              <img
                src="{{ bs.image | image_url: width: 400 }}"
                srcset="{{ bs.image | image_url: width: 200 }} 200w, {{ bs.image | image_url: width: 400 }} 400w"
                alt=""
                width="{{ bs.image.width }}"
                height="{{ bs.image.height }}"
                loading="lazy"
              >
            </span>
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}

      {%- assign inner_repeat = 1 -%}
      {%- if s.enable_marquee -%}
        {%- assign inner_repeat = 30 | divided_by: badge_count -%}
        {%- if inner_repeat < 2 -%}
          {%- assign inner_repeat = 2 -%}
        {%- endif -%}
        {%- if inner_repeat > 12 -%}
          {%- assign inner_repeat = 12 -%}
        {%- endif -%}
      {%- endif -%}

      <div
        class="tb__row{% if s.enable_marquee %} tb__row--marquee{% endif %}{% if s.grayscale_until_hover %} tb__row--grayscale{% endif %}"
        data-tb-row
        data-tb-parallax
        data-speed="0.6"
        {% if s.enable_marquee %}aria-hidden="true"{% endif %}
      >
        <div class="tb__track" data-tb-track>
          <div class="tb__set">
            {%- for r in (1..inner_repeat) -%}{{ badge_set_markup }}{%- endfor -%}
          </div>
          {%- if s.enable_marquee -%}
            <div class="tb__set">
              {%- for r in (1..inner_repeat) -%}{{ badge_set_markup }}{%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- if s.enable_marquee -%}
        <p class="visually-hidden">{{ s.heading | default: 'Certifications and trust badges' }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>

  {%- if s.show_bottom_border -%}<div class="tb__edge tb__edge--bottom"></div>{%- endif -%}
</section>

<style>
  #tb-{{ section_id }} {
    position: relative;
    width: 100%;
    background: var(--tb-bg);
    padding: var(--tb-padding-block) 0;
    overflow: hidden;
    font-family: 'Poppins', sans-serif;
  }

  #tb-{{ section_id }}.tb--transparent-bg {
    background: transparent;
  }

  #tb-{{ section_id }} .tb__floaters {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  #tb-{{ section_id }} .tb__floater {
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
    will-change: transform;
  }

  #tb-{{ section_id }} .tb__floater--1 {
    top: -20%;
    left: 6%;
    width: 220px;
    height: 220px;
    background: radial-gradient(circle at 30% 30%, var(--tb-border), transparent 70%);
    opacity: 0.07;
  }

  #tb-{{ section_id }} .tb__floater--2 {
    bottom: -25%;
    right: 8%;
    width: 260px;
    height: 260px;
    background: radial-gradient(circle at 30% 30%, var(--tb-border), transparent 70%);
    opacity: 0.06;
  }

  #tb-{{ section_id }} * {
    box-sizing: border-box;
  }

  #tb-{{ section_id }} .tb__edge {
    position: absolute;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--tb-border) 20%, var(--tb-border) 80%, transparent);
    opacity: 0.5;
  }

  #tb-{{ section_id }} .tb__edge--top {
    top: 0;
  }

  #tb-{{ section_id }} .tb__edge--bottom {
    bottom: 0;
  }

  #tb-{{ section_id }} .tb__inner {
    position: relative;
    z-index: 1;
    max-width: 100%;
    margin: 0 auto;
  }

  /* ---- Header ---- */
  #tb-{{ section_id }} .tb__header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 40px;
    padding: 0 24px;
  }

  /* Drop-in entrance, staggered line by line via inline transition-delay
     set in Liquid. Lands on the header's children, not the header
     itself, since the header already carries its own scroll-driven
     parallax transform - the two never touch the same element. */
  #tb-{{ section_id }} [data-tb-drop] {
    opacity: 0;
    transform: translate3d(0, -34px, 0);
    transition: transform 0.7s cubic-bezier(0.22, 1.15, 0.32, 1), opacity 0.5s ease;
  }

  #tb-{{ section_id }} [data-tb-drop].is-dropped {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  #tb-{{ section_id }} .tb__eyebrow {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--tb-eyebrow-color);
    margin: 0 0 10px;
  }

  #tb-{{ section_id }} .tb__heading {
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-weight: 400;
    font-size: clamp(24px, 3.5vw, 36px);
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--tb-heading-color);
    line-height: 1.15;
    margin: 0 0 12px;
  }

  #tb-{{ section_id }} .tb__subheading {
    font-size: 15px;
    line-height: 1.6;
    color: var(--tb-subtext-color);
    margin: 0;
  }

  /* ---- Badge row / marquee ---- */
  #tb-{{ section_id }} .tb__row {
    position: relative;
    width: 100%;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 64px, #000 calc(100% - 64px), transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 64px, #000 calc(100% - 64px), transparent 100%);
  }

  #tb-{{ section_id }} .tb__row:not(.tb__row--marquee) {
    -webkit-mask-image: none;
    mask-image: none;
    display: flex;
    justify-content: center;
    padding: 0 24px;
  }

  #tb-{{ section_id }} .tb__row:not(.tb__row--marquee) .tb__track {
    flex-wrap: wrap;
    justify-content: center;
  }

  #tb-{{ section_id }} .tb__track {
    display: flex;
    align-items: center;
    width: max-content;
  }

  #tb-{{ section_id }} .tb__row--marquee .tb__track {
    animation: tb-scroll var(--tb-marquee-duration) linear infinite;
  }

  #tb-{{ section_id }} .tb__row--marquee:hover .tb__track {
    animation-play-state: paused;
  }

  #tb-{{ section_id }} .tb__set {
    display: flex;
    align-items: center;
    gap: var(--tb-badge-gap);
    padding-right: var(--tb-badge-gap);
    flex-shrink: 0;
  }

  #tb-{{ section_id }} .tb__badge {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    height: var(--tb-badge-height);
    padding: 10px;
  }

  /* Soft backdrop card that scales in behind a badge on hover, so it
     reads as lifting off the page rather than just scaling in place. */
  #tb-{{ section_id }} .tb__badge::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--tb-border) 12%, transparent), transparent 72%);
    transform: scale(0.6);
    opacity: 0;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s ease;
  }

  #tb-{{ section_id }} .tb__badge:hover::before {
    transform: scale(1);
    opacity: 1;
  }

  #tb-{{ section_id }} .tb__badge img {
    height: 100%;
    width: auto;
    max-width: none;
    object-fit: contain;
    display: block;
    transition: filter 0.3s ease, opacity 0.3s ease, transform 0.3s ease;
  }

  #tb-{{ section_id }} .tb__row--grayscale .tb__badge img {
    filter: grayscale(100%);
    opacity: 0.55;
  }

  #tb-{{ section_id }} .tb__row--grayscale .tb__badge:hover img {
    filter: grayscale(0%);
    opacity: 1;
    transform: scale(1.06);
  }

  @keyframes tb-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* ---- Mobile ---- */
  @media (max-width: 749px) {
    #tb-{{ section_id }} .tb__header {
      margin-bottom: 28px;
    }

    #tb-{{ section_id }} .tb__row {
      -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 32px, #000 calc(100% - 32px), transparent 100%);
      mask-image: linear-gradient(90deg, transparent 0, #000 32px, #000 calc(100% - 32px), transparent 100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #tb-{{ section_id }} .tb__row--marquee .tb__track {
      animation: none;
    }

    #tb-{{ section_id }} .tb__row--marquee .tb__set:nth-child(2) {
      display: none;
    }

    #tb-{{ section_id }} [data-tb-drop] {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>

<script>
  (function () {
    var section = document.getElementById('tb-{{ section_id }}');
    if (!section) return;

    var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ---- Drop-in entrance (header lines + badges), then magnetic
       hover on badges once dropped ----
       Registering the magnetic mousemove listener only after a badge's
       own drop-in transition finishes avoids the same transform-
       property fight seen elsewhere in this project: the entrance and
       the hover pull would otherwise both try to own `style.transform`
       on the same element at the same time. */
    function registerBadgeMagnetic(el) {
      if (prefersReducedMotion || el.__tbMagneticBound) return;
      el.__tbMagneticBound = true;
      var mx = 0, my = 0, cmx = 0, cmy = 0, ticking = false;
      function render() {
        cmx += (mx - cmx) * 0.22;
        cmy += (my - cmy) * 0.22;
        el.style.transform = 'translate3d(' + cmx.toFixed(2) + 'px, ' + cmy.toFixed(2) + 'px, 0)';
        if (Math.abs(mx - cmx) > 0.1 || Math.abs(my - cmy) > 0.1) {
          window.requestAnimationFrame(render);
        } else {
          ticking = false;
        }
      }
      function startRender() {
        if (!ticking) { ticking = true; window.requestAnimationFrame(render); }
      }
      el.addEventListener('mousemove', function (e) {
        var rect = el.getBoundingClientRect();
        mx = Math.max(-8, Math.min(8, (e.clientX - (rect.left + rect.width / 2)) * 0.3));
        my = Math.max(-8, Math.min(8, (e.clientY - (rect.top + rect.height / 2)) * 0.3));
        startRender();
      });
      el.addEventListener('mouseleave', function () {
        mx = 0; my = 0;
        startRender();
      });
    }

    var dropTargets = Array.prototype.slice.call(section.querySelectorAll('[data-tb-drop]'));
    if (dropTargets.length) {
      if (prefersReducedMotion) {
        dropTargets.forEach(function (el) { el.classList.add('is-dropped'); });
      } else if ('IntersectionObserver' in window) {
        var dropObserver = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              var el = entry.target;
              el.classList.add('is-dropped');
              dropObserver.unobserve(el);
              if (el.hasAttribute('data-tb-magnetic')) {
                var delayMs = parseFloat(window.getComputedStyle(el).transitionDelay) * 1000 || 0;
                var durationMs = parseFloat(window.getComputedStyle(el).transitionDuration) * 1000 || 700;
                window.setTimeout(function () { registerBadgeMagnetic(el); }, delayMs + durationMs + 30);
              }
            });
          },
          { threshold: 0.2, rootMargin: '0px 100px 0px 100px' }
        );
        dropTargets.forEach(function (el) { dropObserver.observe(el); });
      } else {
        dropTargets.forEach(function (el) { el.classList.add('is-dropped'); });
      }
    }

    var parallaxItems = Array.prototype.slice.call(section.querySelectorAll('[data-tb-parallax]'));
    if (prefersReducedMotion || !parallaxItems.length) return;

    var amount = parseFloat(section.getAttribute('data-parallax-amount')) || 16;
    var rafId = null;

    function tick() {
      var rect = section.getBoundingClientRect();
      var viewportH = window.innerHeight || document.documentElement.clientHeight || 1;
      var center = rect.top + rect.height / 2;
      var progress = 1 - center / viewportH; /* -1 (below) .. 0 (centered) .. 1 (above) */
      progress = Math.max(-1, Math.min(1, progress));

      parallaxItems.forEach(function (el) {
        var speed = parseFloat(el.getAttribute('data-speed')) || 0.4;
        var y = progress * amount * speed;
        el.style.transform = 'translate3d(0,' + y.toFixed(1) + 'px,0)';
      });

      rafId = window.requestAnimationFrame(tick);
    }

    var visibilityObserver = null;
    if ('IntersectionObserver' in window) {
      visibilityObserver = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              if (rafId === null) rafId = window.requestAnimationFrame(tick);
            } else if (rafId !== null) {
              window.cancelAnimationFrame(rafId);
              rafId = null;
            }
          });
        },
        { rootMargin: '200px 0px 200px 0px' }
      );
      visibilityObserver.observe(section);
    } else {
      rafId = window.requestAnimationFrame(tick);
    }
  })();
</script>

{% schema %}
{
  "name": "Trust Badges",
  "tag": "section",
  "class": "shopify-section--trust-badges",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Trusted & Certified" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Quality You Can Rely On" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Every product we stock meets recognised standards for safety, purity and manufacturing practice." },

    { "type": "header", "content": "Badge row" },
    { "type": "range", "id": "badge_height", "label": "Badge height", "min": 40, "max": 160, "step": 4, "unit": "px", "default": 84 },
    { "type": "range", "id": "badge_gap", "label": "Gap between badges", "min": 16, "max": 140, "step": 4, "unit": "px", "default": 64 },
    { "type": "checkbox", "id": "grayscale_until_hover", "label": "Grayscale badges until hovered", "default": true },

    { "type": "header", "content": "Auto-scroll marquee" },
    { "type": "checkbox", "id": "enable_marquee", "label": "Enable auto-scrolling marquee", "default": true },
    { "type": "range", "id": "marquee_speed", "label": "Marquee duration (lower = faster)", "min": 10, "max": 60, "step": 2, "unit": "s", "default": 28 },

    { "type": "header", "content": "Scroll parallax" },
    { "type": "range", "id": "parallax_amount", "label": "Parallax amount", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 16, "info": "Set to 0 to disable the scroll drift entirely." },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_block", "label": "Vertical padding", "min": 20, "max": 140, "step": 4, "unit": "px", "default": 64 },
    { "type": "checkbox", "id": "show_top_border", "label": "Show top accent line", "default": true },
    { "type": "checkbox", "id": "show_bottom_border", "label": "Show bottom accent line", "default": true },

    { "type": "header", "content": "Background" },
    { "type": "checkbox", "id": "sync_scroll_bg", "label": "Sync background with page scroll effect", "info": "Joins the whole-page background color morph shared with other sections that opt in, instead of showing this section's own flat background block.", "default": true },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F2F6F1" },
    { "type": "color", "id": "accent_color", "label": "Accent (eyebrow, edge lines)", "default": "#2E7D32" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#141414" },
    { "type": "color", "id": "subtext_color", "label": "Subheading text", "default": "#5B5B5B" }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Badge image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Badges",
      "blocks": [
        { "type": "badge" },
        { "type": "badge" },
        { "type": "badge" }
      ]
    }
  ]
}
{% endschema %}
