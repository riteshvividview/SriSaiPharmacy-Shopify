{%- comment -%}
  Section: Collection - Banner
  Premium replacement for the default plain collection title/description.
  Split layout (colored content panel + framed image) rather than a
  full-bleed overlay banner, for a different, more editorial feel than
  the other hero-style banners already on the site. Image drifts with a
  light parallax and the content panel has a watermark word, both reused
  from about-story-block.liquid's proven pattern; text reveals in
  staggered on scroll-into-view. No pin/sticky effect - removed after
  feedback that it felt janky rather than premium.
{%- endcomment -%}

{{ 'https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@400;500;600;700;800&display=swap' | stylesheet_tag }}

{%- liquid
  assign section_id = section.id
  assign s = section.settings
-%}

<section
  class="cb"
  id="cb-{{ section_id }}"
  data-cb
  style="
    --cb-panel-bg: {{ s.panel_color | default: '#16311B' }};
    --cb-panel-text: {{ s.panel_text_color | default: '#FFFFFF' }};
    --cb-accent: {{ s.accent_color | default: '#F58220' }};
    --cb-frame: {{ s.frame_color | default: '#2E7D32' }};
  "
>
  <div class="cb__container">
    <div class="cb__panel" data-reveal data-reveal-side="left">
      <p class="cb__watermark" aria-hidden="true">{{ s.watermark | default: collection.title | truncate: 12, '' }}</p>
      <div class="cb__panel-inner">
        <nav class="cb__breadcrumb">
          <a href="{{ routes.root_url }}">Home</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{{ collection.title }}</span>
        </nav>
        <p class="cb__eyebrow">{{ s.eyebrow | default: 'Collection' }}</p>
        <h1 class="cb__heading">{{ collection.title }}</h1>
        {%- if collection.description != blank -%}
          <p class="cb__description">{{ collection.description | strip_html | truncate: 190 }}</p>
        {%- endif -%}
        <p class="cb__count">{{ collection.products_count | default: collection.products.size }} products</p>
      </div>
    </div>

    <div class="cb__media" data-reveal data-reveal-side="right">
      <div class="cb__media-inner">
        <div class="cb__media-frame" aria-hidden="true"></div>
        <div class="cb__media-image" data-cb-parallax-wrap>
          {%- if collection.image != blank -%}
            <span class="cb__media-image-scroll" data-cb-parallax>
              <img
                src="{{ collection.image | image_url: width: 1200 }}"
                srcset="{{ collection.image | image_url: width: 600 }} 600w, {{ collection.image | image_url: width: 900 }} 900w, {{ collection.image | image_url: width: 1200 }} 1200w"
                sizes="(max-width: 899px) 100vw, 560px"
                alt="{{ collection.image.alt | default: collection.title | escape }}"
                width="{{ collection.image.width }}"
                height="{{ collection.image.height }}"
                loading="eager"
              >
            </span>
          {%- else -%}
            <span class="cb__media-placeholder" aria-hidden="true">
              <svg width="56" height="56" viewBox="0 0 24 24" fill="none"><path d="M12 2 3 6v6c0 5 4 8.5 9 10 5-1.5 9-5 9-10V6l-9-4Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M12 8v8M8 12h8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
            </span>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{%- comment -%} ---------------- CSS ---------------- {%- endcomment -%}
<style>
  #cb-{{ section_id }} {
    position: relative;
    font-family: 'Poppins', sans-serif;
    padding: 56px 20px;
    overflow: hidden;
  }

  #cb-{{ section_id }} * {
    box-sizing: border-box;
  }

  #cb-{{ section_id }} .cb__container {
    max-width: 1300px;
    margin: 0 auto;
    display: flex;
    align-items: stretch;
    border-radius: 26px;
    overflow: hidden;
    box-shadow: 0 30px 60px rgba(20, 20, 20, 0.1);
  }

  #cb-{{ section_id }} [data-reveal] {
    opacity: 0;
    transition: opacity 0.8s cubic-bezier(0.22, 0.61, 0.36, 1), transform 0.8s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  #cb-{{ section_id }} [data-reveal-side="left"] {
    transform: translate3d(-24px, 0, 0);
  }

  #cb-{{ section_id }} [data-reveal-side="right"] {
    transform: translate3d(24px, 0, 0);
  }

  #cb-{{ section_id }} [data-reveal].is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  /* ---- Content panel ---- */
  #cb-{{ section_id }} .cb__panel {
    position: relative;
    flex: 0 0 44%;
    overflow: hidden;
    isolation: isolate;
    background: var(--cb-panel-bg);
    color: var(--cb-panel-text);
    display: flex;
  }

  #cb-{{ section_id }} .cb__watermark {
    position: absolute;
    inset: auto 0 -0.15em -0.05em;
    z-index: 0;
    margin: 0;
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-size: clamp(60px, 9vw, 120px);
    line-height: 1;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #fff;
    opacity: 0.06;
    pointer-events: none;
    white-space: nowrap;
  }

  #cb-{{ section_id }} .cb__panel-inner {
    position: relative;
    z-index: 1;
    padding: 48px 44px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  #cb-{{ section_id }} .cb__breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 22px;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.6);
  }

  #cb-{{ section_id }} .cb__breadcrumb a {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  #cb-{{ section_id }} .cb__breadcrumb a:hover {
    color: #fff;
  }

  #cb-{{ section_id }} .cb__eyebrow {
    margin: 0 0 10px;
    font-weight: 600;
    font-size: 12.5px;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--cb-accent);
  }

  #cb-{{ section_id }} .cb__heading {
    margin: 0 0 16px;
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-weight: 400;
    font-size: clamp(34px, 4.5vw, 52px);
    line-height: 1.02;
    letter-spacing: 0.4px;
    text-transform: uppercase;
  }

  #cb-{{ section_id }} .cb__description {
    max-width: 440px;
    margin: 0 0 22px;
    font-size: 14.5px;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.8);
  }

  #cb-{{ section_id }} .cb__count {
    display: inline-flex;
    align-self: flex-start;
    margin: 0;
    padding: 8px 16px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.4px;
    text-transform: uppercase;
  }

  /* ---- Media ---- */
  #cb-{{ section_id }} .cb__media {
    flex: 1;
    min-width: 0;
  }

  #cb-{{ section_id }} .cb__media-inner {
    position: relative;
    height: 100%;
  }

  #cb-{{ section_id }} .cb__media-frame {
    position: absolute;
    inset: 20px 20px -20px -20px;
    background: var(--cb-frame);
    opacity: 0.16;
    z-index: 0;
  }

  #cb-{{ section_id }} .cb__media-image {
    position: relative;
    z-index: 1;
    height: 100%;
    min-height: 320px;
    overflow: hidden;
    background: #f0f3f0;
  }

  #cb-{{ section_id }} .cb__media-image-scroll {
    position: absolute;
    inset: -14% 0;
    height: 128%;
    display: block;
  }

  #cb-{{ section_id }} .cb__media-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #cb-{{ section_id }} .cb__media-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--cb-frame);
    opacity: 0.5;
  }

  /* ---- Tablet / Mobile ---- */
  @media (max-width: 899px) {
    #cb-{{ section_id }} .cb__container {
      flex-direction: column;
      border-radius: 22px;
    }

    #cb-{{ section_id }} .cb__panel {
      flex: 0 0 auto;
    }

    #cb-{{ section_id }} .cb__media-image {
      min-height: 260px;
    }

    #cb-{{ section_id }} .cb__media-frame {
      inset: 14px 14px -14px -14px;
    }
  }

  @media (max-width: 749px) {
    #cb-{{ section_id }} {
      padding: 40px 16px;
    }

    #cb-{{ section_id }} .cb__panel-inner {
      padding: 34px 26px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #cb-{{ section_id }} [data-reveal] {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>

{%- comment -%} ---------------- JS ---------------- {%- endcomment -%}
<script>
  (function () {
    var section = document.getElementById('cb-{{ section_id }}');
    if (!section) return;

    var revealTargets = Array.prototype.slice.call(section.querySelectorAll('[data-reveal]'));
    if (revealTargets.length) {
      if ('IntersectionObserver' in window) {
        var revealObserver = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                revealObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15 }
        );
        revealTargets.forEach(function (el) { revealObserver.observe(el); });
      } else {
        revealTargets.forEach(function (el) { el.classList.add('is-visible'); });
      }
    }

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var wrap = section.querySelector('[data-cb-parallax-wrap]');
    var media = section.querySelector('[data-cb-parallax]');
    if (!wrap || !media) return;

    var ticking = false;
    function updateParallax() {
      ticking = false;
      var rect = wrap.getBoundingClientRect();
      var vh = window.innerHeight || document.documentElement.clientHeight;
      if (rect.bottom < 0 || rect.top > vh) return;
      var progress = (vh - rect.top) / (vh + rect.height);
      var offset = (progress - 0.5) * 40;
      media.style.transform = 'translate3d(0, ' + offset.toFixed(1) + 'px, 0)';
    }
    function onScroll() {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(updateParallax);
    }
    var pageScroller = document.querySelector('.page-wrapper');
    window.addEventListener('scroll', onScroll, { passive: true });
    if (pageScroller) pageScroller.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    updateParallax();
  })();
</script>

{% schema %}
{
  "name": "Collection - Banner",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Collection" },
    { "type": "text", "id": "watermark", "label": "Background watermark word", "info": "Defaults to the collection's own title if left blank." },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "panel_color", "label": "Panel background", "default": "#16311B" },
    { "type": "color", "id": "panel_text_color", "label": "Panel text", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Accent (eyebrow)", "default": "#F58220" },
    { "type": "color", "id": "frame_color", "label": "Image frame panel", "default": "#2E7D32" }
  ],
  "presets": [
    { "name": "Collection - Banner" }
  ]
}
{% endschema %}
