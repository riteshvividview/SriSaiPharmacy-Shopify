{%- comment -%}
  Section: Collection - Banner
  Premium replacement for the default plain collection title/description.
  Pins in place for a short scroll distance (reusing the same
  position:sticky-in-a-tall-wrapper technique as
  2nd-energy-countdown-banner.liquid) while the product grid section
  right after it scrolls up and covers it - a combined "pin + cover"
  reveal. Falls back to a normal (non-pinned) banner on mobile and for
  reduced-motion users.
{%- endcomment -%}

{{ 'https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@400;500;600;700;800&display=swap' | stylesheet_tag }}

{%- liquid
  assign section_id = section.id
  assign s = section.settings
  assign overlay_opacity = s.overlay_opacity | default: 55 | divided_by: 100.0
  assign overlay_color = s.overlay_color | default: '#0B1F0F' | color_modify: 'alpha', overlay_opacity
-%}

<section
  class="cb"
  id="cb-{{ section_id }}"
  data-cb
  data-enable-pin="{{ s.enable_pin }}"
  data-pin-duration="{{ s.pin_duration | default: 400 }}"
  style="
    --cb-text: {{ s.text_color | default: '#FFFFFF' }};
    --cb-accent: {{ s.accent_color | default: '#F58220' }};
    --cb-overlay: {{ overlay_color }};
    --cb-height: {{ s.height | default: 380 }}px;
  "
>
  <div class="cb__pin-wrapper" data-pin-wrapper>
    <div class="cb__pin-inner" data-pin-inner>
      <div class="cb__media">
        {%- if collection.image != blank -%}
          <img
            src="{{ collection.image | image_url: width: 1800 }}"
            srcset="{{ collection.image | image_url: width: 800 }} 800w, {{ collection.image | image_url: width: 1400 }} 1400w, {{ collection.image | image_url: width: 1800 }} 1800w"
            sizes="100vw"
            alt="{{ collection.image.alt | default: collection.title | escape }}"
            width="{{ collection.image.width }}"
            height="{{ collection.image.height }}"
            loading="eager"
          >
        {%- endif -%}
        <div class="cb__scrim" aria-hidden="true"></div>
      </div>

      <div class="cb__container">
        <nav class="cb__breadcrumb" aria-label="Breadcrumb">
          <a href="{{ routes.root_url }}">Home</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{{ collection.title }}</span>
        </nav>
        <h1 class="cb__heading">{{ collection.title }}</h1>
        {%- if collection.description != blank -%}
          <p class="cb__description">{{ collection.description | strip_html | truncate: 190 }}</p>
        {%- endif -%}
        <p class="cb__count">{{ collection.products_count | default: collection.products.size }} products</p>
      </div>
    </div>
  </div>
</section>

{%- comment -%} ---------------- CSS ---------------- {%- endcomment -%}
<style>
  #cb-{{ section_id }} {
    position: relative;
    font-family: 'Poppins', sans-serif;
  }

  #cb-{{ section_id }} * {
    box-sizing: border-box;
  }

  #cb-{{ section_id }} .cb__pin-wrapper {
    position: relative;
  }

  /* Pin state (static/fixed/released-to-bottom-of-wrapper) is applied by
     JS as an inline style, not CSS `position: sticky` - this theme
     scrolls `.page-wrapper` (not the document) on desktop with several
     unstyled wrapper divs between sections and that scroll container, a
     nesting depth where native sticky's containing-block resolution
     isn't reliable (same root cause as the header's own pin, see
     header.liquid). `width` here is a fallback for the JS-driven fixed
     state, since fixed positioning needs an explicit width once it's
     out of normal flow. */
  #cb-{{ section_id }} .cb__pin-inner {
    position: static;
    z-index: 10;
    width: 100%;
    height: var(--cb-height);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: #14210f;
  }

  #cb-{{ section_id }} .cb__media {
    position: absolute;
    inset: 0;
  }

  #cb-{{ section_id }} .cb__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #cb-{{ section_id }} .cb__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.2), var(--cb-overlay) 85%);
  }

  #cb-{{ section_id }} .cb__container {
    position: relative;
    z-index: 1;
    max-width: 1300px;
    width: 100%;
    margin: 0 auto;
    padding: 0 32px 40px;
    color: var(--cb-text);
  }

  #cb-{{ section_id }} .cb__breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 16px;
    font-size: 12.5px;
    color: rgba(255, 255, 255, 0.7);
  }

  #cb-{{ section_id }} .cb__breadcrumb a {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  #cb-{{ section_id }} .cb__breadcrumb a:hover {
    color: #fff;
  }

  #cb-{{ section_id }} .cb__heading {
    margin: 0 0 12px;
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-weight: 400;
    font-size: clamp(38px, 6vw, 64px);
    line-height: 1.02;
    letter-spacing: 0.4px;
    text-transform: uppercase;
  }

  /* Plain text, truncated in Liquid to a fixed character count (see
     markup above) - a long collection description must never be able
     to push the title out of the fixed-height banner above it. The
     line-clamp here is just a safety net for edge cases (very long
     unbroken words, narrow viewports). */
  #cb-{{ section_id }} .cb__description {
    max-width: 640px;
    margin: 0;
    font-size: 14.5px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.85);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  #cb-{{ section_id }} .cb__count {
    margin: 14px 0 0;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--cb-accent);
  }

  @media (max-width: 749px) {
    #cb-{{ section_id }} .cb__pin-inner {
      height: min(var(--cb-height), 320px);
    }

    #cb-{{ section_id }} .cb__container {
      padding: 0 20px 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #cb-{{ section_id }} .cb__pin-inner {
      position: relative;
    }
  }
</style>

{%- comment -%} ---------------- JS ---------------- {%- endcomment -%}
<script>
  (function () {
    var section = document.getElementById('cb-{{ section_id }}');
    if (!section) return;

    var pinWrapper = section.querySelector('[data-pin-wrapper]');
    var pinInner = section.querySelector('[data-pin-inner]');
    if (!pinWrapper || !pinInner) return;

    var enablePin = section.getAttribute('data-enable-pin') === 'true';
    var pinDuration = parseFloat(section.getAttribute('data-pin-duration')) || 0;
    var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function isMobile() {
      return window.innerWidth <= 749;
    }

    function pinActive() {
      return enablePin && !prefersReducedMotion && !isMobile() && pinDuration > 0;
    }

    function clearPinStyles() {
      pinInner.style.position = 'static';
      pinInner.style.top = '';
      pinInner.style.left = '';
      pinInner.style.right = '';
      pinWrapper.style.height = 'auto';
    }

    /* Three states, driven from the wrapper's actual on-screen position
       (getBoundingClientRect) rather than CSS `position: sticky`:
         1. not reached yet - normal flow (position: static)
         2. mid-pin - position: fixed, pinned to the top of the viewport
         3. scrolled past - position: absolute, released to sit at the
            bottom of the wrapper so it scrolls away with it normally
       instead of staying fixed forever. */
    var ticking = false;
    function updatePin() {
      ticking = false;
      if (!pinActive()) {
        clearPinStyles();
        return;
      }

      pinWrapper.style.height = 'calc(var(--cb-height) + ' + pinDuration + 'px)';

      var rect = pinWrapper.getBoundingClientRect();
      var innerHeight = pinInner.offsetHeight;

      if (rect.top > 0) {
        pinInner.style.position = 'static';
        pinInner.style.top = '';
        pinInner.style.left = '';
        pinInner.style.right = '';
      } else if (rect.bottom <= innerHeight) {
        pinInner.style.position = 'absolute';
        pinInner.style.top = (pinWrapper.offsetHeight - innerHeight) + 'px';
        pinInner.style.left = '0';
        pinInner.style.right = '0';
      } else {
        pinInner.style.position = 'fixed';
        pinInner.style.top = '0';
        pinInner.style.left = '0';
        pinInner.style.right = '0';
      }
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(updatePin);
    }

    var pageScroller = document.querySelector('.page-wrapper');
    window.addEventListener('scroll', onScroll, { passive: true });
    if (pageScroller) pageScroller.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    updatePin();
  })();
</script>

{% schema %}
{
  "name": "Collection - Banner",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Pin effect" },
    { "type": "checkbox", "id": "enable_pin", "label": "Pin banner while the product grid scrolls over it", "default": true },
    { "type": "range", "id": "pin_duration", "label": "Pin duration (extra scroll px)", "min": 0, "max": 1000, "step": 50, "unit": "px", "default": 400 },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "height", "label": "Banner height", "min": 260, "max": 600, "step": 20, "unit": "px", "default": 380 },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#0B1F0F" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 55 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Accent (product count)", "default": "#F58220" }
  ],
  "presets": [
    { "name": "Collection - Banner" }
  ]
}
{% endschema %}
