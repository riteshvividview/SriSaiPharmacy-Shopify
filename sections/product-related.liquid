{%- comment -%}
  Section: Product - Related
  Real "You May Also Like" product grid for the bottom of the product
  page (as opposed to collection-cross-sell, which links out to whole
  collections). Pulls other products from the current product's first
  collection so it works everywhere with zero manual curation, while
  still letting an admin override with a specific collection via
  schema. Card styling matches collection-product-grid's card design
  for visual consistency across the site. Supports the same whole-page
  scroll background morph as the other product-page sections, plus
  slow-drifting floating background shapes, for visual continuity
  instead of stacked flat-color blocks.
{%- endcomment -%}

{{ 'https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@400;500;600;700;800&display=swap' | stylesheet_tag }}

{%- liquid
  assign section_id = section.id
  assign s = section.settings
  assign source_collection = s.collection_override | default: product.collections.first
  assign limit = s.products_to_show | default: 4
-%}

<section
  class="pr{% if s.sync_scroll_bg %} pr--transparent-bg{% endif %}"
  id="pr-{{ section_id }}"
  {% if s.sync_scroll_bg %}data-scroll-bg-zone="{{ s.background_color | default: '#F2F6F1' }}"{% endif %}
  style="
    --pr-bg: {{ s.background_color | default: '#F2F6F1' }};
    --pr-text: {{ s.text_color | default: '#141414' }};
    --pr-muted: {{ s.muted_color | default: '#6B6B6B' }};
    --pr-accent: {{ s.accent_color | default: '#2E7D32' }};
    --pr-cta: {{ s.cta_color | default: '#F58220' }};
    --pr-card-bg: {{ s.card_color | default: '#FFFFFF' }};
    --pr-padding-top: {{ s.padding_top | default: 80 }}px;
    --pr-padding-bottom: {{ s.padding_bottom | default: 90 }}px;
  "
>
  {%- if s.show_floating_elements -%}
    <div class="pr__floaters" aria-hidden="true">
      <span class="pr__floater pr__floater--1" data-pr-float data-float-speed="0.05"></span>
      <span class="pr__floater pr__floater--2" data-pr-float data-float-speed="0.09"></span>
    </div>
  {%- endif -%}

  <div class="pr__container">
    <div class="pr__header">
      {%- if s.eyebrow != blank -%}<p class="pr__eyebrow" data-reveal>{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="pr__heading" data-reveal>{{ s.heading }}</h2>{%- endif -%}
    </div>

    {%- if source_collection != blank -%}
      <div class="pr__grid">
        {%- assign shown = 0 -%}
        {%- for related_product in source_collection.products -%}
          {%- if related_product.id != product.id and shown < limit -%}
            {%- assign shown = shown | plus: 1 -%}
            <a href="{{ related_product.url }}" class="pr__card" data-reveal data-reveal-delay="{{ shown | modulo: 4 }}">
              <span class="pr__card-media">
                {%- if related_product.compare_at_price > related_product.price -%}
                  {%- assign discount = related_product.compare_at_price | minus: related_product.price | times: 100.0 | divided_by: related_product.compare_at_price | round -%}
                  <span class="pr__badge">{{ discount }}% OFF</span>
                {%- elsif related_product.available == false -%}
                  <span class="pr__badge pr__badge--muted">Sold Out</span>
                {%- endif -%}

                {%- if related_product.featured_image != blank -%}
                  <img
                    src="{{ related_product.featured_image | image_url: width: 600 }}"
                    srcset="{{ related_product.featured_image | image_url: width: 400 }} 400w, {{ related_product.featured_image | image_url: width: 600 }} 600w"
                    sizes="(max-width: 749px) 45vw, 300px"
                    alt="{{ related_product.featured_image.alt | default: related_product.title | escape }}"
                    width="{{ related_product.featured_image.width }}"
                    height="{{ related_product.featured_image.height }}"
                    loading="lazy"
                  >
                {%- else -%}
                  <span class="pr__card-placeholder" aria-hidden="true">
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none"><path d="M6 8h12l-1 12H7L6 8Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
                  </span>
                {%- endif -%}

                <span class="pr__quick-add" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                </span>
              </span>
              <span class="pr__card-body">
                <span class="pr__card-title">{{ related_product.title }}</span>
                <span class="pr__card-price">
                  <span class="pr__price-now">{{ related_product.price | money }}</span>
                  {%- if related_product.compare_at_price > related_product.price -%}
                    <span class="pr__price-compare">{{ related_product.compare_at_price | money }}</span>
                  {%- endif -%}
                </span>
              </span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{%- comment -%} ---------------- CSS ---------------- {%- endcomment -%}
<style>
  #pr-{{ section_id }} {
    position: relative;
    background: var(--pr-bg);
    color: var(--pr-text);
    font-family: 'Poppins', sans-serif;
    padding: var(--pr-padding-top) 20px var(--pr-padding-bottom);
    overflow: hidden;
  }

  #pr-{{ section_id }}.pr--transparent-bg {
    background: transparent;
  }

  #pr-{{ section_id }} * {
    box-sizing: border-box;
  }

  #pr-{{ section_id }} a {
    text-decoration: none;
    color: inherit;
  }

  #pr-{{ section_id }} .pr__floaters {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  #pr-{{ section_id }} .pr__floater {
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
    will-change: transform;
  }

  #pr-{{ section_id }} .pr__floater--1 {
    top: -8%;
    left: 8%;
    width: 280px;
    height: 280px;
    background: radial-gradient(circle at 30% 30%, var(--pr-accent), transparent 70%);
    opacity: 0.07;
  }

  #pr-{{ section_id }} .pr__floater--2 {
    bottom: -10%;
    right: 10%;
    width: 240px;
    height: 240px;
    background: radial-gradient(circle at 30% 30%, var(--pr-cta), transparent 70%);
    opacity: 0.06;
  }

  #pr-{{ section_id }} .pr__container {
    position: relative;
    z-index: 1;
    max-width: 1300px;
    margin: 0 auto;
  }

  #pr-{{ section_id }} [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 22px, 0);
    transition: opacity 0.65s cubic-bezier(0.22, 0.61, 0.36, 1), transform 0.65s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  #pr-{{ section_id }} [data-reveal].is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  #pr-{{ section_id }} .pr__grid [data-reveal-delay="1"] { transition-delay: 0.06s; }
  #pr-{{ section_id }} .pr__grid [data-reveal-delay="2"] { transition-delay: 0.12s; }
  #pr-{{ section_id }} .pr__grid [data-reveal-delay="3"] { transition-delay: 0.18s; }

  #pr-{{ section_id }} .pr__header {
    max-width: 560px;
    margin: 0 auto 40px;
    text-align: center;
  }

  #pr-{{ section_id }} .pr__eyebrow {
    margin: 0 0 10px;
    font-weight: 600;
    font-size: 12.5px;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--pr-accent);
  }

  #pr-{{ section_id }} .pr__heading {
    margin: 0;
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-weight: 400;
    font-size: clamp(28px, 3.6vw, 40px);
    line-height: 1.05;
    letter-spacing: 0.4px;
    text-transform: uppercase;
  }

  #pr-{{ section_id }} .pr__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }

  #pr-{{ section_id }} .pr__card-media {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: 18px;
    overflow: hidden;
    background: var(--pr-card-bg);
    box-shadow: 0 10px 24px rgba(20, 20, 20, 0.06);
  }

  #pr-{{ section_id }} .pr__card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  #pr-{{ section_id }} .pr__card:hover .pr__card-media img {
    transform: scale(1.06);
  }

  #pr-{{ section_id }} .pr__card-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--pr-accent);
    opacity: 0.4;
  }

  #pr-{{ section_id }} .pr__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    padding: 5px 10px;
    border-radius: 999px;
    background: var(--pr-cta);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
  }

  #pr-{{ section_id }} .pr__badge--muted {
    background: #8a8a8a;
  }

  #pr-{{ section_id }} .pr__quick-add {
    position: absolute;
    right: 12px;
    bottom: 12px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    min-width: 36px;
    min-height: 36px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #fff;
    color: var(--pr-accent);
    box-shadow: 0 6px 16px rgba(20, 20, 20, 0.14);
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  #pr-{{ section_id }} .pr__card:hover .pr__quick-add {
    background: var(--pr-accent);
    color: #fff;
    transform: scale(1.1);
  }

  #pr-{{ section_id }} .pr__card-body {
    display: block;
    margin-top: 14px;
  }

  #pr-{{ section_id }} .pr__card-title {
    display: block;
    margin-bottom: 6px;
    font-weight: 600;
    font-size: 15px;
    line-height: 1.3;
  }

  #pr-{{ section_id }} .pr__card-price {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  #pr-{{ section_id }} .pr__price-now {
    font-size: 16.5px;
    font-weight: 700;
    color: var(--pr-accent);
  }

  #pr-{{ section_id }} .pr__price-compare {
    font-size: 13px;
    color: var(--pr-muted);
    text-decoration: line-through;
  }

  @media (max-width: 999px) {
    #pr-{{ section_id }} .pr__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 749px) {
    #pr-{{ section_id }} {
      padding-left: 16px;
      padding-right: 16px;
    }

    #pr-{{ section_id }} .pr__grid {
      gap: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #pr-{{ section_id }} [data-reveal],
    #pr-{{ section_id }} .pr__card-media img {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>

{%- comment -%} ---------------- JS ---------------- {%- endcomment -%}
<script>
  (function () {
    var section = document.getElementById('pr-{{ section_id }}');
    if (!section) return;

    var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var revealTargets = Array.prototype.slice.call(section.querySelectorAll('[data-reveal]'));
    if (revealTargets.length) {
      if ('IntersectionObserver' in window) {
        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15 }
        );
        revealTargets.forEach(function (el) { observer.observe(el); });
      } else {
        revealTargets.forEach(function (el) { el.classList.add('is-visible'); });
      }
    }

    var floaters = Array.prototype.slice.call(section.querySelectorAll('[data-pr-float]'));
    if (floaters.length && !prefersReducedMotion) {
      var ticking = false;
      function updateFloaters() {
        ticking = false;
        var rect = section.getBoundingClientRect();
        floaters.forEach(function (el) {
          var speed = parseFloat(el.getAttribute('data-float-speed')) || 0.05;
          var offset = rect.top * speed;
          el.style.transform = 'translate3d(0, ' + offset.toFixed(1) + 'px, 0)';
        });
      }
      function onScroll() {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(updateFloaters);
      }
      var pageScroller = document.querySelector('.page-wrapper');
      window.addEventListener('scroll', onScroll, { passive: true });
      if (pageScroller) pageScroller.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      updateFloaters();
    }
  })();
</script>

{% schema %}
{
  "name": "Product - Related",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Keep Exploring" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You May Also Like" },
    { "type": "collection", "id": "collection_override", "label": "Collection override", "info": "Optional. Defaults to the current product's own first collection." },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 },

    { "type": "header", "content": "Background & Effects" },
    { "type": "checkbox", "id": "sync_scroll_bg", "label": "Sync background with page scroll effect", "default": true },
    { "type": "checkbox", "id": "show_floating_elements", "label": "Show floating background elements", "default": true },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F2F6F1" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#141414" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#6B6B6B" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#2E7D32" },
    { "type": "color", "id": "cta_color", "label": "CTA / badge color", "default": "#F58220" },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 5, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 5, "unit": "px", "default": 90 }
  ],
  "presets": [
    { "name": "Product - Related" }
  ]
}
{% endschema %}
