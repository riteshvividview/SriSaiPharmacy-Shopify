{%- comment -%}
  Section: Contact - Hero
  Full-bleed banner for the Contact page: background image, dark scrim,
  eyebrow + big heading + subtext + up to two buttons. Background drifts
  with a light parallax as the page scrolls, and the text stack reveals
  in staggered on load/scroll-into-view - same techniques used elsewhere
  in this theme (see 2nd-energy-countdown-banner.liquid, 4th-nourish-hero.liquid).
{%- endcomment -%}

{{ 'https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@400;500;600;700;800&display=swap' | stylesheet_tag }}

{%- liquid
  assign section_id = section.id
  assign s = section.settings
  assign overlay_opacity = s.overlay_opacity | default: 45 | divided_by: 100.0
  assign overlay_color = s.overlay_color | default: '#0B1F0F' | color_modify: 'alpha', overlay_opacity
-%}

<section
  class="ch"
  id="ch-{{ section_id }}"
  data-ch
  style="
    --ch-height: {{ s.height | default: 460 }}px;
    --ch-text-color: {{ s.text_color | default: '#FFFFFF' }};
    --ch-accent: {{ s.accent_color | default: '#F58220' }};
    --ch-overlay: {{ overlay_color }};
  "
>
  <div class="ch__media" data-ch-media>
    {%- if s.image != blank -%}
      <img
        class="ch__image"
        src="{{ s.image | image_url: width: 1800 }}"
        srcset="
          {{ s.image | image_url: width: 800 }} 800w,
          {{ s.image | image_url: width: 1200 }} 1200w,
          {{ s.image | image_url: width: 1800 }} 1800w,
          {{ s.image | image_url: width: 2400 }} 2400w
        "
        sizes="100vw"
        alt="{{ s.image.alt | default: s.heading | escape }}"
        width="{{ s.image.width }}"
        height="{{ s.image.height }}"
        loading="eager"
      >
    {%- endif -%}
    <div class="ch__scrim" aria-hidden="true"></div>
  </div>

  <div class="ch__container">
    {%- if s.eyebrow != blank -%}
      <p class="ch__eyebrow" data-reveal data-reveal-delay="0">{{ s.eyebrow }}</p>
    {%- endif -%}
    {%- if s.heading != blank -%}
      <h1 class="ch__heading" data-reveal data-reveal-delay="1">{{ s.heading }}</h1>
    {%- endif -%}
    {%- if s.subheading != blank -%}
      <p class="ch__subheading" data-reveal data-reveal-delay="2">{{ s.subheading }}</p>
    {%- endif -%}

    {%- if s.button_1_text != blank or s.button_2_text != blank -%}
      <div class="ch__actions" data-reveal data-reveal-delay="3">
        {%- if s.button_1_text != blank -%}
          <a href="{{ s.button_1_url | default: '#' }}" class="ch__btn ch__btn--primary">{{ s.button_1_text }}</a>
        {%- endif -%}
        {%- if s.button_2_text != blank -%}
          <a href="{{ s.button_2_url | default: '#' }}" class="ch__btn ch__btn--ghost">{{ s.button_2_text }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="ch__scroll-cue" aria-hidden="true">
    <svg width="18" height="28" viewBox="0 0 18 28" fill="none"><rect x="1" y="1" width="16" height="26" rx="8" stroke="currentColor" stroke-width="1.4"/><circle class="ch__scroll-dot" cx="9" cy="8" r="2.2" fill="currentColor"/></svg>
  </div>
</section>

{%- comment -%} ---------------- CSS ---------------- {%- endcomment -%}
<style>
  #ch-{{ section_id }} {
    position: relative;
    height: var(--ch-height);
    min-height: 320px;
    display: flex;
    align-items: center;
    overflow: hidden;
    font-family: 'Poppins', sans-serif;
    isolation: isolate;
  }

  #ch-{{ section_id }} * {
    box-sizing: border-box;
  }

  #ch-{{ section_id }} .ch__media {
    position: absolute;
    inset: -10% 0;
    z-index: 0;
  }

  #ch-{{ section_id }} .ch__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: translate3d(0, var(--ch-parallax, 0px), 0) scale(1.04);
  }

  #ch-{{ section_id }} .ch__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.25), var(--ch-overlay) 70%);
  }

  #ch-{{ section_id }} .ch__container {
    position: relative;
    z-index: 1;
    max-width: 1360px;
    width: 100%;
    margin: 0 auto;
    padding: 0 32px;
    color: var(--ch-text-color);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #ch-{{ section_id }} [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 26px, 0);
    transition: opacity 0.75s cubic-bezier(0.22, 0.61, 0.36, 1), transform 0.75s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  #ch-{{ section_id }} [data-reveal].is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  #ch-{{ section_id }} [data-reveal-delay="0"] { transition-delay: 0.05s; }
  #ch-{{ section_id }} [data-reveal-delay="1"] { transition-delay: 0.15s; }
  #ch-{{ section_id }} [data-reveal-delay="2"] { transition-delay: 0.25s; }
  #ch-{{ section_id }} [data-reveal-delay="3"] { transition-delay: 0.35s; }

  #ch-{{ section_id }} .ch__eyebrow {
    margin: 0 0 14px;
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 2.2px;
    text-transform: uppercase;
    color: var(--ch-accent);
  }

  #ch-{{ section_id }} .ch__heading {
    margin: 0 0 16px;
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-weight: 400;
    font-size: clamp(38px, 6vw, 72px);
    line-height: 1.05;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  #ch-{{ section_id }} .ch__subheading {
    max-width: 560px;
    margin: 0 0 28px;
    font-size: 16px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.88);
  }

  #ch-{{ section_id }} .ch__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }

  #ch-{{ section_id }} .ch__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 14.5px;
    text-decoration: none;
    transition: transform 0.25s cubic-bezier(0.22, 0.61, 0.36, 1), box-shadow 0.25s ease, background-color 0.25s ease, color 0.25s ease;
  }

  #ch-{{ section_id }} .ch__btn--primary {
    background: var(--ch-accent);
    color: #fff;
  }

  #ch-{{ section_id }} .ch__btn--primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.28);
  }

  #ch-{{ section_id }} .ch__btn--ghost {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    border: 1.5px solid rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(6px);
  }

  #ch-{{ section_id }} .ch__btn--ghost:hover {
    transform: translateY(-3px);
    background: rgba(255, 255, 255, 0.22);
  }

  #ch-{{ section_id }} .ch__scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 22px;
    z-index: 1;
    transform: translateX(-50%);
    color: rgba(255, 255, 255, 0.75);
    animation: ch-bob 2.2s ease-in-out infinite;
  }

  #ch-{{ section_id }} .ch__scroll-dot {
    animation: ch-scroll-dot 2.2s ease-in-out infinite;
    transform-origin: 9px 8px;
  }

  @keyframes ch-bob {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(6px); }
  }

  @keyframes ch-scroll-dot {
    0% { opacity: 1; transform: translateY(0); }
    60% { opacity: 0; transform: translateY(10px); }
    61% { opacity: 0; transform: translateY(0); }
    100% { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 749px) {
    #ch-{{ section_id }} {
      min-height: 360px;
    }

    #ch-{{ section_id }} .ch__container {
      padding: 0 20px;
    }

    #ch-{{ section_id }} .ch__btn {
      padding: 12px 22px;
      font-size: 14px;
    }

    #ch-{{ section_id }} .ch__scroll-cue {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #ch-{{ section_id }} [data-reveal],
    #ch-{{ section_id }} .ch__btn,
    #ch-{{ section_id }} .ch__scroll-cue,
    #ch-{{ section_id }} .ch__scroll-dot {
      transition: none !important;
      animation: none !important;
      transform: none !important;
      opacity: 1 !important;
    }

    #ch-{{ section_id }} .ch__image {
      transform: none !important;
    }
  }
</style>

{%- comment -%} ---------------- JS ---------------- {%- endcomment -%}
<script>
  (function () {
    var section = document.getElementById('ch-{{ section_id }}');
    if (!section) return;

    var revealTargets = Array.prototype.slice.call(section.querySelectorAll('[data-reveal]'));
    if (revealTargets.length) {
      if ('IntersectionObserver' in window) {
        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.2 }
        );
        revealTargets.forEach(function (el) { observer.observe(el); });
      } else {
        revealTargets.forEach(function (el) { el.classList.add('is-visible'); });
      }
    }

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var media = section.querySelector('[data-ch-media]');
    if (!media) return;

    var ticking = false;
    function updateParallax() {
      ticking = false;
      var rect = section.getBoundingClientRect();
      var vh = window.innerHeight || document.documentElement.clientHeight;
      if (rect.bottom < 0 || rect.top > vh) return;
      var progress = (vh - rect.top) / (vh + rect.height);
      var offset = (progress - 0.5) * 60;
      section.style.setProperty('--ch-parallax', offset.toFixed(1) + 'px');
    }
    function onScroll() {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(updateParallax);
    }
    var pageScroller = document.querySelector('.page-wrapper');
    window.addEventListener('scroll', onScroll, { passive: true });
    if (pageScroller) pageScroller.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    updateParallax();
  })();
</script>

{% schema %}
{
  "name": "Contact - Hero",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "We're Here To Help" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get In Touch" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Questions about a medicine, an order, or just want advice? Our team replies fast - reach out however's easiest for you." },

    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_1_text", "label": "Button 1 text", "default": "Call Us Now" },
    { "type": "url", "id": "button_1_url", "label": "Button 1 link" },
    { "type": "text", "id": "button_2_text", "label": "Button 2 text", "default": "Chat On WhatsApp" },
    { "type": "url", "id": "button_2_url", "label": "Button 2 link" },

    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "range", "id": "height", "label": "Banner height", "min": 320, "max": 720, "step": 20, "unit": "px", "default": 460 },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#0B1F0F" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 45 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Accent (eyebrow, primary button)", "default": "#F58220" }
  ],
  "presets": [
    { "name": "Contact - Hero" }
  ]
}
{% endschema %}
