{%- comment -%}
  Section: About - Masthead Hero
  Chapter 1 of the "Our Story" page rebuild: full-bleed image with a huge
  Bebas Neue heading overlapping its lower edge, held in place via plain
  CSS `position: sticky` (not a GSAP pin - see the .amh__hold comment
  below for why) while GSAP ScrollTrigger scrubs it (image slowly settles
  from a slight zoom, heading drifts up and fades), with a handful of
  floating Ayurvedic line-art motifs (leaf / herbal sprig / mortar &
  pestle) each drifting at its own scrub speed for a layered parallax
  depth effect. The next chapter then slides up and covers this one while
  it's still held in place - see about-identity-triptych.liquid's
  negative margin-top for that half of the effect.
  Also hosts the single, page-wide "scroll background morph" controller
  (copied verbatim from about-story-block.liquid) - since this is first in
  document order among the new About page chapters, it's the one that
  claims window.__scrollBgController.
{%- endcomment -%}

{{ 'https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@400;500;600;700&display=swap' | stylesheet_tag }}

{%- liquid
  assign section_id = section.id
  assign s = section.settings
-%}

<section
  class="amh"
  id="amh-{{ section_id }}"
  data-amh
  data-scroll-bg-zone="{{ s.background_color | default: '#FFFFFF' }}"
  style="
    --amh-bg: {{ s.background_color | default: '#FFFFFF' }};
    --amh-text: {{ s.text_color | default: '#141414' }};
    --amh-accent: {{ s.accent_color | default: '#2E7D32' }};
  "
>
  {%- comment -%}
    .amh__hold's height determines how long the sticky stage below stays
    held in the viewport: (stage's own 100svh) + (100svh "phase 1" - pure
    scrub, next chapter not visible yet) + (100svh "phase 2" - the next
    chapter, pulled up 100svh early via its own negative margin-top,
    slides over this still-held stage) = 300svh total. Plain CSS
    `position: sticky` (not a GSAP pin) handles the "stay in place" part
    natively, using the browser's real layout engine against this
    theme's actual scroll container (.page-wrapper on desktop) - this
    sidesteps GSAP's pinSpacing spacer-height math entirely, which is
    what produced a stray visible strip / a missing cover effect in
    earlier attempts at this. GSAP is only used below for the scrub
    animations, not for holding the stage in place.
  {%- endcomment -%}
  <div class="amh__hold">
  <div class="amh__stage" data-amh-stage>
    <div class="amh__image-wrap" data-amh-image-wrap>
      {%- if s.video != blank -%}
        {{ s.video | video_tag: image_size: '1600x', autoplay: true, loop: true, muted: true, controls: false, class: 'amh__image' }}
      {%- elsif s.image != blank -%}
        <img
          class="amh__image"
          src="{{ s.image | image_url: width: 1600 }}"
          srcset="
            {{ s.image | image_url: width: 800 }} 800w,
            {{ s.image | image_url: width: 1200 }} 1200w,
            {{ s.image | image_url: width: 1600 }} 1600w
          "
          sizes="100vw"
          alt="{{ s.image_alt | default: s.heading | escape }}"
          width="{{ s.image.width }}"
          height="{{ s.image.height }}"
        >
      {%- endif -%}
      <span class="amh__scrim" aria-hidden="true"></span>
    </div>

    <div class="amh__motifs" aria-hidden="true">
      <span class="amh__motif amh__motif--1" data-amh-motif data-motif-scrub="0.5">
        <svg width="46" height="46" viewBox="0 0 24 24" fill="none"><path d="M12 3c4 2 7 6 7 10a7 7 0 0 1-14 0c0-4 3-8 7-10Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M12 7v13" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
      </span>
      <span class="amh__motif amh__motif--2" data-amh-motif data-motif-scrub="1">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none"><path d="M12 21V9M12 9c0-3.5-2.5-6-6-6 0 3.5 2.5 6 6 6Zm0 0c0-3.5 2.5-6 6-6 0 3.5-2.5 6-6 6Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" stroke-linecap="round"/></svg>
      </span>
      <span class="amh__motif amh__motif--3" data-amh-motif data-motif-scrub="1.8">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none"><path d="M6 10c0 6 2.5 10 6 10s6-4 6-10" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><ellipse cx="12" cy="10" rx="8" ry="2.4" stroke="currentColor" stroke-width="1.3"/><path d="M15.5 5.5 18 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
      </span>
      <span class="amh__motif amh__motif--4" data-amh-motif data-motif-scrub="1.2">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none"><rect x="4" y="9" width="16" height="6" rx="3" stroke="currentColor" stroke-width="1.3"/><path d="M11 9v6" stroke="currentColor" stroke-width="1.3"/></svg>
      </span>
      <span class="amh__motif amh__motif--5" data-amh-motif data-motif-scrub="0.8">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none"><path d="M12 2c4 5 7 9 7 13a7 7 0 0 1-14 0c0-4 3-8 7-13Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
      </span>
      <span class="amh__motif amh__motif--6" data-amh-motif data-motif-scrub="1.5">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none"><rect x="4" y="4" width="16" height="16" rx="4" stroke="currentColor" stroke-width="1.3"/><path d="M12 8v8M8 12h8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
      </span>
      <span class="amh__motif amh__motif--7" data-amh-motif data-motif-scrub="2.1">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="2" stroke="currentColor" stroke-width="1.2"/><path d="M12 4v4M12 16v4M4 12h4M16 12h4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
      </span>
      <span class="amh__motif amh__motif--8" data-amh-motif data-motif-scrub="0.65">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="7" stroke="currentColor" stroke-width="1.2"/><circle cx="12" cy="12" r="2" fill="currentColor"/></svg>
      </span>
    </div>

    <div class="amh__heading-wrap" data-amh-heading>
      {%- if s.eyebrow != blank -%}<p class="amh__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h1 class="amh__heading">{{ s.heading }}</h1>{%- endif -%}
    </div>
  </div>
  </div>
</section>

<style>
  #amh-{{ section_id }} {
    position: relative;
    overflow-x: clip;
    background: var(--amh-bg);
    color: var(--amh-text);
    font-family: 'Poppins', sans-serif;
  }

  #amh-{{ section_id }}.amh--transparent-bg {
    background: transparent;
  }

  #amh-{{ section_id }} * {
    box-sizing: border-box;
  }

  #amh-{{ section_id }} .amh__hold {
    position: relative;
    height: 300svh;
    min-height: 1680px;
  }

  #amh-{{ section_id }} .amh__stage {
    position: sticky;
    top: 0;
    z-index: 1;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
  }

  #amh-{{ section_id }} .amh__image-wrap {
    position: absolute;
    inset: 0;
    will-change: transform;
  }

  #amh-{{ section_id }} .amh__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #amh-{{ section_id }} .amh__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.05) 0%, rgba(0, 0, 0, 0.45) 100%);
    pointer-events: none;
  }

  #amh-{{ section_id }} .amh__motifs {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  #amh-{{ section_id }} .amh__motif {
    position: absolute;
    color: #ffffff;
    opacity: 0.55;
    will-change: transform;
  }

  #amh-{{ section_id }} .amh__motif--1 { top: 14%; left: 8%; }
  #amh-{{ section_id }} .amh__motif--2 { top: 22%; right: 10%; }
  #amh-{{ section_id }} .amh__motif--3 { bottom: 30%; left: 14%; }
  #amh-{{ section_id }} .amh__motif--4 { bottom: 22%; right: 16%; }
  #amh-{{ section_id }} .amh__motif--5 { top: 40%; left: 4%; }
  #amh-{{ section_id }} .amh__motif--6 { top: 8%; right: 28%; }
  #amh-{{ section_id }} .amh__motif--7 { bottom: 12%; left: 32%; }
  #amh-{{ section_id }} .amh__motif--8 { top: 50%; right: 5%; }

  #amh-{{ section_id }} .amh__heading-wrap {
    position: absolute;
    z-index: 3;
    left: 0;
    right: 0;
    bottom: 9%;
    text-align: center;
    padding: 0 24px;
    will-change: transform, opacity;
  }

  #amh-{{ section_id }} .amh__eyebrow {
    margin: 0 0 12px;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #ffffff;
    opacity: 0.85;
  }

  #amh-{{ section_id }} .amh__heading {
    margin: 0;
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-weight: 400;
    font-size: clamp(40px, 9vw, 128px);
    line-height: 0.98;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #ffffff;
    text-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
  }

  @media (max-width: 749px) {
    #amh-{{ section_id }} .amh__motif--1,
    #amh-{{ section_id }} .amh__motif--3,
    #amh-{{ section_id }} .amh__motif--6,
    #amh-{{ section_id }} .amh__motif--7 {
      display: none;
    }
  }

</style>

<script>
  (function () {
    var section = document.getElementById('amh-{{ section_id }}');
    if (!section) return;

    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function initAmh() {
      if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;

      var hold = section.querySelector('.amh__hold');
      var stage = section.querySelector('[data-amh-stage]');
      var imageWrap = section.querySelector('[data-amh-image-wrap]');
      var headingWrap = section.querySelector('[data-amh-heading]');
      var motifs = Array.prototype.slice.call(section.querySelectorAll('[data-amh-motif]'));
      if (!hold || !stage) return;

      /* No GSAP pin here - .amh__stage is held via plain CSS
         `position: sticky` (see the .amh__hold markup comment above for
         why), so GSAP's only job for this chapter is the scrub itself.
         Tied to just the first 100% of .amh__hold's scroll range - the
         "phase 1" distance - independent of how long .amh__hold keeps
         the stage held overall (300svh total; sticky and the next
         chapter's negative margin-top handle "phase 2"'s cover effect
         entirely on their own, with no GSAP involvement). */
      var tl = gsap.timeline({
        scrollTrigger: {
          trigger: hold,
          start: 'top top',
          end: '+=100%',
          scrub: true,
          id: 'amh-scrub-{{ section_id }}'
        }
      });
      if (imageWrap) tl.fromTo(imageWrap, { scale: 1.15 }, { scale: 1, ease: 'none' }, 0);
      if (headingWrap) tl.fromTo(headingWrap, { opacity: 1, y: 0 }, { opacity: 0, y: -60, ease: 'none' }, 0);

      motifs.forEach(function (el) {
        var amount = parseFloat(el.getAttribute('data-motif-scrub')) || 1;
        gsap.to(el, {
          y: -130 * amount,
          ease: 'none',
          scrollTrigger: {
            trigger: hold,
            start: 'top top',
            end: '+=100%',
            scrub: amount
          }
        });
      });
    }

    if (!reducedMotion) {
      window.__aboutChapterInits = window.__aboutChapterInits || [];
      window.__aboutChapterInits.push(initAmh);
      initAmh();
    }

    /* ---- Whole-page background morph ---- copied verbatim from
       about-story-block.liquid: runs once for the whole page, guarded by
       window.__scrollBgController so only the first chapter to execute
       this script installs it. See that file for full commentary. */
    if (!window.__scrollBgController) {
      window.__scrollBgController = true;

      document.addEventListener('DOMContentLoaded', function () {
        var zones = Array.prototype.slice.call(document.querySelectorAll('[data-scroll-bg-zone]'));
        if (!zones.length) return;

        var bgLayer = document.createElement('div');
        bgLayer.id = 'scroll-bg-layer';
        bgLayer.setAttribute('aria-hidden', 'true');
        bgLayer.style.cssText =
          'position:fixed;inset:0;z-index:-1;pointer-events:none;' +
          'background-color:' + (zones[0].getAttribute('data-scroll-bg-zone') || '#ffffff') + ';' +
          (window.matchMedia('(prefers-reduced-motion: reduce)').matches ? '' : 'transition:background-color 0.8s ease;');
        document.body.prepend(bgLayer);

        if (!('IntersectionObserver' in window)) return;

        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              var color = entry.target.getAttribute('data-scroll-bg-zone');
              if (color) bgLayer.style.backgroundColor = color;
            });
          },
          { threshold: 0, rootMargin: '-50% 0px -50% 0px' }
        );
        zones.forEach(function (el) { observer.observe(el); });
      });
    }
  })();
</script>

{% schema %}
{
  "name": "About - Masthead Hero",
  "tag": "section",
  "class": "shopify-section--about-masthead-hero",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Since 1971" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Quest Was Pure From The Beginning" },
    { "type": "video", "id": "video", "label": "Full-bleed video", "info": "Plays muted and on loop. Used instead of the image below when set." },
    { "type": "image_picker", "id": "image", "label": "Full-bleed image", "info": "Used if no video is set above." },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background (also this chapter's scroll-color zone)", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#141414" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#2E7D32" }
  ],
  "presets": [
    { "name": "About - Masthead Hero" }
  ]
}
{% endschema %}
