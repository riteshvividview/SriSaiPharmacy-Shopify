{%- comment -%}
  Section: Blog - Showcase
  One continuous blog listing page (no separate generic hero banner -
  the intro lives here): eyebrow/heading/subheading, an optional trust
  strip, the latest article as a large feature, then the rest in a
  grid. The featured image is grayscale at rest and turns full color on
  hover; grid cards do the opposite (color at rest, grayscale on
  hover) - deliberately mismatched per request. Staggered scroll reveal
  throughout. Uses `blog.articles` directly, so this only renders
  meaningfully inside a blog template.
{%- endcomment -%}

{{ 'https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@400;500;600;700;800&display=swap' | stylesheet_tag }}

{%- liquid
  assign section_id = section.id
  assign s = section.settings
  assign per_page = s.articles_per_page | default: 9
-%}

<section
  class="bs"
  id="bs-{{ section_id }}"
  data-bs
  style="
    --bs-bg: {{ s.background_color | default: '#FFFFFF' }};
    --bs-card-bg: {{ s.card_color | default: '#F2F6F1' }};
    --bs-text: {{ s.text_color | default: '#141414' }};
    --bs-muted: {{ s.muted_color | default: '#6B6B6B' }};
    --bs-accent: {{ s.accent_color | default: '#2E7D32' }};
    --bs-cta: {{ s.cta_color | default: '#F58220' }};
    --bs-border: {{ s.border_color | default: '#ECECEC' }};
    --bs-padding-top: {{ s.padding_top | default: 70 }}px;
    --bs-padding-bottom: {{ s.padding_bottom | default: 90 }}px;
  "
>
  <div class="bs__container">
    {%- if s.heading != blank or s.subheading != blank -%}
      <div class="bs__intro">
        {%- if s.eyebrow != blank -%}<p class="bs__eyebrow" data-reveal>{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h1 class="bs__intro-heading" data-reveal data-reveal-delay="1">{{ s.heading }}</h1>{%- endif -%}
        {%- if s.subheading != blank -%}<p class="bs__intro-text" data-reveal data-reveal-delay="2">{{ s.subheading }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if s.show_trust_strip -%}
      <div class="bs__trust" data-reveal data-reveal-delay="2">
        {%- if s.trust_1 != blank -%}
          <div class="bs__trust-item">
            <span class="bs__trust-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 2 3 5v4.5c0 4.5 3 7.5 7 8.5 4-1 7-4 7-8.5V5l-7-3Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg></span>
            <span>{{ s.trust_1 }}</span>
          </div>
        {%- endif -%}
        {%- if s.trust_2 != blank -%}
          <div class="bs__trust-item">
            <span class="bs__trust-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 18s6-5.5 6-10a6 6 0 1 0-12 0c0 4.5 6 10 6 10Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><circle cx="10" cy="8" r="2.2" stroke="currentColor" stroke-width="1.4"/></svg></span>
            <span>{{ s.trust_2 }}</span>
          </div>
        {%- endif -%}
        {%- if s.trust_3 != blank -%}
          <div class="bs__trust-item">
            <span class="bs__trust-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M3 10h14M10 3v14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.4"/></svg></span>
            <span>{{ s.trust_3 }}</span>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if s.show_tags and blog.all_tags.size > 0 -%}
      <div class="bs__tags" data-reveal>
        <a href="{{ blog.url }}" class="bs__tag{% if current_tags == blank %} is-active{% endif %}">All</a>
        {%- for tag in blog.all_tags -%}
          <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="bs__tag{% if current_tags contains tag %} is-active{% endif %}">{{ tag }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- paginate blog.articles by per_page -%}
      {%- if blog.articles.size == 0 -%}
        <div class="bs__empty" data-reveal>
          <p>{{ s.empty_text | default: 'No stories here yet - check back soon.' }}</p>
        </div>
      {%- else -%}
        {%- if paginate.current_page == 1 -%}
          {%- assign featured = blog.articles.first -%}
          <a href="{{ featured.url }}" class="bs__featured" data-reveal>
            <span class="bs__featured-media">
              {%- if featured.image != blank -%}
                <span class="bs__featured-media-inner">
                  <img
                    src="{{ featured.image | image_url: width: 1400 }}"
                    srcset="{{ featured.image | image_url: width: 700 }} 700w, {{ featured.image | image_url: width: 1100 }} 1100w, {{ featured.image | image_url: width: 1400 }} 1400w"
                    sizes="(max-width: 899px) 100vw, 1300px"
                    alt="{{ featured.image.alt | default: featured.title | escape }}"
                    width="{{ featured.image.width }}"
                    height="{{ featured.image.height }}"
                    loading="eager"
                  >
                </span>
              {%- else -%}
                <span class="bs__card-placeholder" aria-hidden="true">
                  <svg width="36" height="36" viewBox="0 0 24 24" fill="none"><path d="M12 2 3 6v6c0 5 4 8.5 9 10 5-1.5 9-5 9-10V6l-9-4Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
                </span>
              {%- endif -%}
            </span>
            <span class="bs__featured-body">
              <span class="bs__meta">
                <span class="bs__eyebrow bs__eyebrow--inline">{{ s.featured_label | default: 'Latest Story' }}</span>
                <span class="bs__meta-dot" aria-hidden="true"></span>
                <span>{{ featured.published_at | date: '%B %d, %Y' }}</span>
                <span class="bs__meta-dot" aria-hidden="true"></span>
                <span>{{ featured.content | strip_html | size | divided_by: 200 | at_least: 1 }} min read</span>
              </span>
              <span class="bs__featured-title">{{ featured.title }}</span>
              <span class="bs__featured-excerpt">{{ featured.excerpt | default: featured.content | strip_html | truncate: 170 }}</span>
              <span class="bs__featured-cta">
                {{ s.read_text | default: 'Read the story' }}
                <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </span>
          </a>
        {%- endif -%}

        <div class="bs__grid">
          {%- for article in blog.articles -%}
            {%- if paginate.current_page == 1 and forloop.first -%}
              {%- continue -%}
            {%- endif -%}
            <a href="{{ article.url }}" class="bs__card" data-reveal {% if forloop.index0 %}data-reveal-delay="{{ forloop.index0 | modulo: 3 | plus: 1 }}"{% endif %}>
              <span class="bs__card-media">
                {%- if article.image != blank -%}
                  <img
                    src="{{ article.image | image_url: width: 700 }}"
                    srcset="{{ article.image | image_url: width: 400 }} 400w, {{ article.image | image_url: width: 700 }} 700w"
                    sizes="(max-width: 749px) 90vw, 400px"
                    alt="{{ article.image.alt | default: article.title | escape }}"
                    width="{{ article.image.width }}"
                    height="{{ article.image.height }}"
                    loading="lazy"
                  >
                {%- else -%}
                  <span class="bs__card-placeholder" aria-hidden="true">
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none"><path d="M12 2 3 6v6c0 5 4 8.5 9 10 5-1.5 9-5 9-10V6l-9-4Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
                  </span>
                {%- endif -%}
                {%- if s.show_tags and article.tags.size > 0 -%}<span class="bs__card-badge">{{ article.tags.first }}</span>{%- endif -%}
              </span>
              <span class="bs__card-body">
                <span class="bs__meta bs__meta--sm">
                  <span>{{ article.published_at | date: '%B %d, %Y' }}</span>
                  <span class="bs__meta-dot" aria-hidden="true"></span>
                  <span>{{ article.content | strip_html | size | divided_by: 200 | at_least: 1 }} min read</span>
                </span>
                <span class="bs__card-title">{{ article.title }}</span>
                <span class="bs__card-excerpt">{{ article.excerpt | default: article.content | strip_html | truncate: 100 }}</span>
              </span>
            </a>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="bs__pagination" data-reveal aria-label="Pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="bs__page-btn bs__page-btn--nav" aria-label="Previous page">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}" class="bs__page-btn">{{ part.title }}</a>
              {%- elsif part.title == paginate.current_page -%}
                <span class="bs__page-btn is-current">{{ part.title }}</span>
              {%- else -%}
                <span class="bs__page-btn bs__page-btn--dots">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="bs__page-btn bs__page-btn--nav" aria-label="Next page">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{%- comment -%} ---------------- CSS ---------------- {%- endcomment -%}
<style>
  #bs-{{ section_id }} {
    position: relative;
    background: var(--bs-bg);
    color: var(--bs-text);
    font-family: 'Poppins', sans-serif;
    padding: var(--bs-padding-top) 20px var(--bs-padding-bottom);
  }

  #bs-{{ section_id }} * {
    box-sizing: border-box;
  }

  #bs-{{ section_id }} a {
    text-decoration: none;
    color: inherit;
  }

  #bs-{{ section_id }} .bs__container {
    max-width: 1300px;
    margin: 0 auto;
  }

  #bs-{{ section_id }} [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 26px, 0);
    transition: opacity 0.7s cubic-bezier(0.22, 0.61, 0.36, 1), transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  #bs-{{ section_id }} [data-reveal].is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  #bs-{{ section_id }} [data-reveal-delay="1"] { transition-delay: 0.1s; }
  #bs-{{ section_id }} [data-reveal-delay="2"] { transition-delay: 0.2s; }
  #bs-{{ section_id }} [data-reveal-delay="3"] { transition-delay: 0.3s; }

  /* ---- Intro ---- */
  #bs-{{ section_id }} .bs__intro {
    max-width: 640px;
    margin: 0 auto 48px;
    text-align: center;
  }

  #bs-{{ section_id }} .bs__eyebrow {
    display: inline-block;
    font-weight: 600;
    font-size: 12.5px;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--bs-cta);
    margin: 0 0 12px;
  }

  #bs-{{ section_id }} .bs__intro-heading {
    margin: 0 0 14px;
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-weight: 400;
    font-size: clamp(32px, 5vw, 52px);
    line-height: 1.05;
    letter-spacing: 0.4px;
    text-transform: uppercase;
  }

  #bs-{{ section_id }} .bs__intro-text {
    margin: 0;
    font-size: 15px;
    line-height: 1.7;
    color: var(--bs-muted);
  }

  /* ---- Trust strip ---- */
  #bs-{{ section_id }} .bs__trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-bottom: 48px;
  }

  #bs-{{ section_id }} .bs__trust-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 20px;
    border-radius: 999px;
    background: var(--bs-card-bg);
    font-size: 13px;
    font-weight: 500;
    color: var(--bs-text);
  }

  #bs-{{ section_id }} .bs__trust-icon {
    display: flex;
    color: var(--bs-accent);
    flex-shrink: 0;
  }

  /* ---- Tags ---- */
  #bs-{{ section_id }} .bs__tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-bottom: 40px;
  }

  #bs-{{ section_id }} .bs__tag {
    padding: 9px 18px;
    border-radius: 999px;
    border: 1.5px solid var(--bs-border);
    color: var(--bs-muted);
    font-size: 13.5px;
    font-weight: 500;
    white-space: nowrap;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  #bs-{{ section_id }} .bs__tag:hover {
    border-color: var(--bs-accent);
    color: var(--bs-accent);
  }

  #bs-{{ section_id }} .bs__tag.is-active {
    background: var(--bs-accent);
    border-color: var(--bs-accent);
    color: #fff;
  }

  /* ---- Featured (image on top, landscape - matches the source photos
     instead of cropping them into a tall side column) ---- */
  #bs-{{ section_id }} .bs__featured {
    display: block;
    border-radius: 22px;
    overflow: hidden;
    background: var(--bs-card-bg);
    margin-bottom: 56px;
    box-shadow: 0 24px 50px rgba(20, 20, 20, 0.1);
  }

  #bs-{{ section_id }} .bs__featured-media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bs-card-bg);
  }

  #bs-{{ section_id }} .bs__featured-media-inner {
    position: absolute;
    inset: 0;
    height: 100%;
  }

  /* `contain` (not `cover`) on purpose: these article photos often have
     the title baked into the design itself, so cropping any edge risks
     cutting into that text - this always shows the whole image,
     letterboxed against the card background if its ratio doesn't
     exactly match the frame. */
  #bs-{{ section_id }} .bs__featured-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    filter: grayscale(100%);
    transition: filter 0.5s ease;
  }

  #bs-{{ section_id }} .bs__featured:hover .bs__featured-media img {
    filter: grayscale(0%);
  }

  #bs-{{ section_id }} .bs__featured-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 36px 40px 40px;
  }

  #bs-{{ section_id }} .bs__eyebrow--inline {
    margin: 0;
    color: var(--bs-cta);
  }

  #bs-{{ section_id }} .bs__featured-title {
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-weight: 400;
    font-size: clamp(26px, 3.2vw, 36px);
    line-height: 1.1;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    color: var(--bs-text);
  }

  #bs-{{ section_id }} .bs__featured-excerpt {
    max-width: 640px;
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--bs-muted);
  }

  #bs-{{ section_id }} .bs__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 12.5px;
    color: var(--bs-muted);
  }

  #bs-{{ section_id }} .bs__meta--sm {
    font-size: 11.5px;
    margin-bottom: 10px;
  }

  #bs-{{ section_id }} .bs__meta-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.6;
    flex-shrink: 0;
  }

  #bs-{{ section_id }} .bs__featured-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    font-weight: 600;
    font-size: 14px;
    color: var(--bs-accent);
    transition: gap 0.25s ease;
  }

  #bs-{{ section_id }} .bs__featured:hover .bs__featured-cta {
    gap: 13px;
  }

  /* ---- Grid (landscape cards throughout) ---- */
  #bs-{{ section_id }} .bs__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 56px 40px;
  }

  #bs-{{ section_id }} .bs__card {
    display: flex;
    flex-direction: column;
  }

  #bs-{{ section_id }} .bs__card-media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    overflow: hidden;
    background: var(--bs-card-bg);
    margin-bottom: 16px;
    border: 1px solid rgba(20, 20, 20, 0.06);
    box-shadow: 0 10px 24px rgba(20, 20, 20, 0.07);
  }

  #bs-{{ section_id }} .bs__card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(0%);
    transition: filter 0.4s ease;
  }

  #bs-{{ section_id }} .bs__card:hover .bs__card-media img {
    filter: grayscale(100%);
  }

  #bs-{{ section_id }} .bs__card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--bs-accent);
    opacity: 0.5;
  }

  #bs-{{ section_id }} .bs__card-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(6px);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    color: var(--bs-accent);
  }

  #bs-{{ section_id }} .bs__card-body {
    display: flex;
    flex-direction: column;
  }

  #bs-{{ section_id }} .bs__card-title {
    font-weight: 600;
    font-size: 16.5px;
    line-height: 1.4;
    margin-bottom: 8px;
    transition: color 0.2s ease;
  }

  #bs-{{ section_id }} .bs__card:hover .bs__card-title {
    color: var(--bs-accent);
  }

  #bs-{{ section_id }} .bs__card-excerpt {
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--bs-muted);
  }

  #bs-{{ section_id }} .bs__empty {
    text-align: center;
    padding: 60px 20px;
    color: var(--bs-muted);
  }

  /* ---- Pagination ---- */
  #bs-{{ section_id }} .bs__pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 56px;
  }

  #bs-{{ section_id }} .bs__page-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 40px;
    padding: 0 6px;
    border-radius: 10px;
    border: 1.5px solid var(--bs-border);
    color: var(--bs-text);
    font-size: 14px;
    font-weight: 500;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  #bs-{{ section_id }} a.bs__page-btn:hover {
    background: var(--bs-accent);
    border-color: var(--bs-accent);
    color: #fff;
  }

  #bs-{{ section_id }} .bs__page-btn.is-current {
    background: var(--bs-text);
    border-color: var(--bs-text);
    color: #fff;
  }

  #bs-{{ section_id }} .bs__page-btn--dots {
    border-color: transparent;
    color: var(--bs-muted);
  }

  /* ---- Tablet / Mobile ---- */
  @media (max-width: 999px) {
    #bs-{{ section_id }} .bs__featured-media {
      aspect-ratio: 16 / 10;
    }

    #bs-{{ section_id }} .bs__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 749px) {
    #bs-{{ section_id }} {
      padding-left: 16px;
      padding-right: 16px;
    }

    #bs-{{ section_id }} .bs__featured-media {
      aspect-ratio: 4 / 3;
    }

    #bs-{{ section_id }} .bs__featured-body {
      padding: 26px 22px 30px;
    }

    #bs-{{ section_id }} .bs__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #bs-{{ section_id }} [data-reveal],
    #bs-{{ section_id }} .bs__card-media img,
    #bs-{{ section_id }} .bs__featured-media img,
    #bs-{{ section_id }} .bs__featured-media-inner {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>

{%- comment -%} ---------------- JS ---------------- {%- endcomment -%}
<script>
  (function () {
    var section = document.getElementById('bs-{{ section_id }}');
    if (!section) return;

    var revealTargets = Array.prototype.slice.call(section.querySelectorAll('[data-reveal]'));
    if (revealTargets.length) {
      if ('IntersectionObserver' in window) {
        var revealObserver = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                revealObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -6% 0px' }
        );
        revealTargets.forEach(function (el) { revealObserver.observe(el); });
      } else {
        revealTargets.forEach(function (el) { el.classList.add('is-visible'); });
      }
    }

  })();
</script>

{% schema %}
{
  "name": "Blog - Showcase",
  "settings": [
    { "type": "header", "content": "Intro" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Health & Wellness Journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stories, Tips & Herbal Wisdom" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Ayurvedic remedies, product deep-dives and honest advice from our pharmacists." },

    { "type": "header", "content": "Trust strip" },
    { "type": "checkbox", "id": "show_trust_strip", "label": "Show trust strip", "default": true },
    { "type": "text", "id": "trust_1", "label": "Item 1", "default": "Written by licensed pharmacists" },
    { "type": "text", "id": "trust_2", "label": "Item 2", "default": "Ayurveda + modern science" },
