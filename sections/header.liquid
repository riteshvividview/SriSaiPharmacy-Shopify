{%- comment -%}
  Section: Header (Sri Sai Pharmacy)
  Self-contained desktop header with a hover mega-menu. Nav items are driven
  by blocks: "Nav Link" for plain links, "Nav Dropdown" for a mega-menu
  trigger (with an intro/context panel), followed by any number of
  "Dropdown Tile" blocks (image + heading + text) that belong to it. A tile
  block attaches to whichever Nav Dropdown precedes it in the block order.
  "Simple Dropdown" is a lighter trigger for plain link lists (e.g. a
  "Pages" menu grouping About Us / Contact / etc) - same attach-to-preceding-
  trigger convention, via "Simple Dropdown Link" blocks.
{%- endcomment -%}

{{ 'https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@400;500;600;700;800&display=swap' | stylesheet_tag }}

{%- liquid
  assign section_id = section.id
  assign s = section.settings
  assign accent_color = s.accent_color | default: '#2E7D32'
  assign cta_color = s.cta_color | default: '#F58220'
-%}

<header
  class="ssh"
  id="ssh-{{ section_id }}"
  data-ssh-header
  style="
    --ssh-bg: {{ s.background_color | default: '#ffffff' }};
    --ssh-text: {{ s.text_color | default: '#141414' }};
    --ssh-accent: {{ accent_color }};
    --ssh-cta: {{ cta_color }};
    --ssh-border: {{ s.border_color | default: '#ECECEC' }};
  "
>
  {%- if s.show_utility_bar -%}
    <div class="ssh__utility">
      <div class="ssh__utility-inner">
        <div class="ssh__utility-left">
          {%- if s.utility_text != blank -%}<span>{{ s.utility_text }}</span>{%- endif -%}
        </div>
        <div class="ssh__utility-right">
          {%- if s.utility_phone != blank -%}
            <a href="tel:{{ s.utility_phone | remove: ' ' }}" class="ssh__utility-link">
              <svg aria-hidden="true" width="13" height="13" viewBox="0 0 20 20" fill="none"><path stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" d="M4 3h3l2 4.5-2 1.5c.9 2.2 2.8 4.1 5 5l1.5-2 4.5 2v3c0 1-1 2-2 2C9.5 19 1 10.5 1 5c0-1 1-2 2-2z"/></svg>
              {{ s.utility_phone }}
            </a>
          {%- endif -%}
          {%- if s.utility_hours != blank -%}<span class="ssh__utility-divider"></span><span>{{ s.utility_hours }}</span>{%- endif -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  <div class="ssh__bar">
    <div class="ssh__inner">
      <a href="{{ routes.root_url }}" class="ssh__logo" aria-label="{{ shop.name }}">
        {%- if s.logo != blank -%}
          <img
            src="{{ s.logo | image_url: width: 320 }}"
            srcset="{{ s.logo | image_url: width: 160 }} 160w, {{ s.logo | image_url: width: 320 }} 320w"
            alt="{{ shop.name }}"
            width="{{ s.logo.width }}"
            height="{{ s.logo.height }}"
            loading="eager"
          >
        {%- else -%}
          <span class="ssh__logo-mark" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 2 3 6v6c0 5 4 8.5 9 10 5-1.5 9-5 9-10V6l-9-4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M12 8v8M8 12h8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </span>
          <span class="ssh__logo-text">{{ s.logo_text | default: shop.name }}</span>
        {%- endif -%}
      </a>

      <nav class="ssh__nav" aria-label="Primary">
        <ul class="ssh__nav-list">
          {%- for block in section.blocks -%}
            {%- assign bs = block.settings -%}
            {%- case block.type -%}
              {%- when 'nav_link' -%}
                <li class="ssh__nav-item" {{ block.shopify_attributes }}>
                  <a href="{{ bs.url | default: '#' }}" class="ssh__nav-link">{{ bs.label }}</a>
                </li>

              {%- when 'nav_dropdown' -%}
                <li class="ssh__nav-item ssh__nav-item--mega" {{ block.shopify_attributes }}>
                  <button
                    type="button"
                    class="ssh__nav-link ssh__nav-trigger"
                    aria-haspopup="true"
                    aria-expanded="false"
                    data-ssh-trigger
                  >
                    {{ bs.label }}
                    <svg class="ssh__caret" aria-hidden="true" width="10" height="10" viewBox="0 0 14 14" fill="none"><path d="M11 5.5L7 9.5L3 5.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </button>

                  {%- assign intro_overlay_opacity = bs.intro_overlay_opacity | default: 45 | divided_by: 100.0 -%}
                  {%- assign intro_overlay_color = bs.intro_overlay_color | default: '#000000' | color_modify: 'alpha', intro_overlay_opacity -%}
                  <div class="ssh__mega" style="--ssh-mega-columns: {{ bs.columns | default: 3 }};">
                    <div class="ssh__mega-inner">
                      <div
                        class="ssh__mega-intro"
                        {%- if bs.intro_image != blank %} style="background-image: url({{ bs.intro_image | image_url: width: 700 }});"{% endif -%}
                      >
                        <div class="ssh__mega-intro-scrim" style="background: {{ intro_overlay_color }};"></div>
                        <div class="ssh__mega-intro-content">
                          {%- if bs.intro_eyebrow != blank -%}<p class="ssh__mega-eyebrow">{{ bs.intro_eyebrow }}</p>{%- endif -%}
                          {%- if bs.intro_heading != blank -%}<h3 class="ssh__mega-heading">{{ bs.intro_heading }}</h3>{%- endif -%}
                          {%- if bs.intro_text != blank -%}<p class="ssh__mega-text">{{ bs.intro_text }}</p>{%- endif -%}
                          {%- if bs.intro_link_text != blank -%}
                            <a href="{{ bs.intro_link | default: '#' }}" class="ssh__mega-cta">
                              {{ bs.intro_link_text }}
                              <svg aria-hidden="true" width="14" height="14" viewBox="0 0 20 20" fill="none"><path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </a>
                          {%- endif -%}
                        </div>
                      </div>

                      <div class="ssh__mega-grid">
                        {%- assign tiles_offset = forloop.index0 | plus: 1 -%}
                        {%- for tile_block in section.blocks offset: tiles_offset -%}
                          {%- if tile_block.type == 'dropdown_tile' -%}
                            {%- assign ts = tile_block.settings -%}
                            {%- case ts.image_orientation -%}
                              {%- when 'portrait' -%}
                                {%- assign tile_aspect_ratio = '3 / 4' -%}
                              {%- when 'square' -%}
                                {%- assign tile_aspect_ratio = '1 / 1' -%}
                              {%- else -%}
                                {%- assign tile_aspect_ratio = '4 / 3' -%}
                            {%- endcase -%}
                            <a href="{{ ts.link | default: '#' }}" class="ssh__tile" {{ tile_block.shopify_attributes }}>
                              <span class="ssh__tile-image" style="aspect-ratio: {{ tile_aspect_ratio }};">
                                {%- if ts.image != blank -%}
                                  <img
                                    src="{{ ts.image | image_url: width: 400 }}"
                                    srcset="{{ ts.image | image_url: width: 200 }} 200w, {{ ts.image | image_url: width: 400 }} 400w"
                                    alt="{{ ts.heading | escape }}"
                                    width="{{ ts.image.width }}"
                                    height="{{ ts.image.height }}"
                                    loading="lazy"
                                    style="object-fit: {{ ts.image_fit | default: 'cover' }};"
                                  >
                                {%- else -%}
                                  <span class="ssh__tile-placeholder" aria-hidden="true">
                                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M12 2 3 6v6c0 5 4 8.5 9 10 5-1.5 9-5 9-10V6l-9-4Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M12 8v8M8 12h8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                                  </span>
                                {%- endif -%}
                              </span>
                              <span class="ssh__tile-body">
                                <span class="ssh__tile-heading">{{ ts.heading }}</span>
                                {%- if ts.text != blank -%}<span class="ssh__tile-text">{{ ts.text }}</span>{%- endif -%}
                              </span>
                            </a>
                          {%- else -%}
                            {%- break -%}
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    </div>
                  </div>
                </li>

              {%- when 'simple_dropdown' -%}
                <li class="ssh__nav-item ssh__nav-item--simple" {{ block.shopify_attributes }}>
                  <button
                    type="button"
                    class="ssh__nav-link ssh__nav-trigger"
                    aria-haspopup="true"
                    aria-expanded="false"
                    data-ssh-trigger
                  >
                    {{ bs.label }}
                    <svg class="ssh__caret" aria-hidden="true" width="10" height="10" viewBox="0 0 14 14" fill="none"><path d="M11 5.5L7 9.5L3 5.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </button>

                  <div class="ssh__simple-dropdown">
                    <ul class="ssh__simple-list">
                      {%- assign links_offset = forloop.index0 | plus: 1 -%}
                      {%- for link_block in section.blocks offset: links_offset -%}
                        {%- if link_block.type == 'simple_link' -%}
                          {%- assign ls = link_block.settings -%}
                          <li {{ link_block.shopify_attributes }}>
                            <a href="{{ ls.url | default: '#' }}">{{ ls.label }}</a>
                          </li>
                        {%- else -%}
                          {%- break -%}
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  </div>
                </li>

              {%- when 'dropdown_tile' or 'simple_link' -%}
                {%- comment -%} rendered inside the preceding nav_dropdown / simple_dropdown {%- endcomment -%}
            {%- endcase -%}
          {%- endfor -%}
        </ul>
      </nav>

      <div class="ssh__actions">
        <a href="{{ routes.search_url }}" class="ssh__icon-btn" aria-label="Search">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 20 20" fill="none"><circle cx="9" cy="9" r="4.75" stroke="currentColor" stroke-width="1.5"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m12.5 12.5 3.25 3.25"/></svg>
        </a>
        <a href="{{ routes.account_url }}" class="ssh__icon-btn ssh__icon-btn--desktop" aria-label="Account">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="6.5" r="2.75" stroke="currentColor" stroke-width="1.5"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m5.172 14.591-.437.786a.588.588 0 0 0 .514.873h9.502a.588.588 0 0 0 .514-.873l-.437-.786a5.523 5.523 0 0 0-9.656 0"/></svg>
        </a>
        <a href="{{ routes.cart_url }}" class="ssh__icon-btn ssh__cart" aria-label="Cart, {{ cart.item_count }} items">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 20 20" fill="none"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.392 6.875h13.216v8.016c0 .567-.224 1.112-.624 1.513-.4.402-.941.627-1.506.627H5.522a2.13 2.13 0 0 1-1.506-.627 2.15 2.15 0 0 1-.624-1.513zM8.818 2.969h2.333c.618 0 1.211.247 1.649.686a2.35 2.35 0 0 1 .683 1.658v1.562H6.486V5.313c0-.622.246-1.218.683-1.658a2.33 2.33 0 0 1 1.65-.686"/></svg>
          {%- if cart.item_count > 0 -%}<span class="ssh__cart-count">{{ cart.item_count }}</span>{%- endif -%}
        </a>
        <button type="button" class="ssh__icon-btn ssh__burger" data-ssh-burger aria-label="Menu" aria-expanded="false" aria-controls="ssh-mobile-{{ section_id }}">
          <svg class="ssh__burger-open" aria-hidden="true" width="18" height="18" viewBox="0 0 14 14" fill="none"><path d="M1 3.5H13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><path d="M1 10.5H13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
          <svg class="ssh__burger-close" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M11.1765 12.025C11.4108 12.2594 11.7907 12.2594 12.025 12.025C12.2594 11.7907 12.2594 11.4108 12.025 11.1765L8.84931 8.00078L12.025 4.82505C12.2594 4.59073 12.2594 4.21083 12.025 3.97652C11.7907 3.7422 11.4108 3.7422 11.1765 3.97652L8.00078 7.15225L4.82505 3.97652C4.59073 3.7422 4.21083 3.7422 3.97652 3.97652C3.7422 4.21083 3.7422 4.59073 3.97652 4.82505L7.15225 8.00078L3.97652 11.1765C3.7422 11.4108 3.7422 11.7907 3.97652 12.025C4.21083 12.2594 4.59073 12.2594 4.82505 12.025L8.00078 8.84931L11.1765 12.025Z" fill="currentColor"/></svg>
        </button>
      </div>
    </div>

    <div class="ssh__mobile" id="ssh-mobile-{{ section_id }}" data-ssh-mobile-panel>
      <ul class="ssh__mobile-list">
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- case block.type -%}
            {%- when 'nav_link' -%}
              <li><a href="{{ bs.url | default: '#' }}">{{ bs.label }}</a></li>
            {%- when 'nav_dropdown' -%}
              <li class="ssh__mobile-group">
                <span class="ssh__mobile-group-label">{{ bs.label }}</span>
                <ul>
                  {%- assign tiles_offset = forloop.index0 | plus: 1 -%}
                  {%- for tile_block in section.blocks offset: tiles_offset -%}
                    {%- if tile_block.type == 'dropdown_tile' -%}
                      <li><a href="{{ tile_block.settings.link | default: '#' }}">{{ tile_block.settings.heading }}</a></li>
                    {%- else -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              </li>
            {%- when 'simple_dropdown' -%}
              <li class="ssh__mobile-group">
                <span class="ssh__mobile-group-label">{{ bs.label }}</span>
                <ul>
                  {%- assign links_offset = forloop.index0 | plus: 1 -%}
                  {%- for link_block in section.blocks offset: links_offset -%}
                    {%- if link_block.type == 'simple_link' -%}
                      <li><a href="{{ link_block.settings.url | default: '#' }}">{{ link_block.settings.label }}</a></li>
                    {%- else -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              </li>
          {%- endcase -%}
        {%- endfor -%}
        <li class="ssh__mobile-account"><a href="{{ routes.account_url }}">My Account</a></li>
      </ul>
    </div>
  </div>

  <div class="ssh__bar-spacer" data-ssh-bar-spacer aria-hidden="true"></div>
</header>

<style>
  #ssh-{{ section_id }} {
    --ssh-height: 76px;
    color: var(--ssh-text);
    font-family: 'Poppins', sans-serif;
  }

  #ssh-{{ section_id }} *,
  #ssh-{{ section_id }} *::before,
  #ssh-{{ section_id }} *::after {
    box-sizing: border-box;
  }

  #ssh-{{ section_id }} a {
    text-decoration: none;
    color: inherit;
  }

  /* ---- Utility bar ---- */
  #ssh-{{ section_id }} .ssh__utility {
    background: var(--ssh-accent);
    color: #fff;
    font-size: 12.5px;
  }

  #ssh-{{ section_id }} .ssh__utility-inner {
    max-width: 1360px;
    margin: 0 auto;
    padding: 7px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  #ssh-{{ section_id }} .ssh__utility-right {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  #ssh-{{ section_id }} .ssh__utility-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 500;
  }

  #ssh-{{ section_id }} .ssh__utility-divider {
    width: 1px;
    height: 12px;
    background: rgba(255, 255, 255, 0.4);
  }

  /* ---- Bar ---- */
  /* Pinning is JS-driven (see script below) rather than plain CSS
     `position: sticky`. This theme scrolls `.page-wrapper` (not the
     document) on desktop, with several unstyled wrapper divs between this
     bar and that scroll container - a nesting depth where native sticky's
     containing-block resolution isn't reliable. The JS toggles this class
     to fix the bar to the viewport once the page has scrolled past the
     utility strip, while the announcement bar above it scrolls away
     normally. `.ssh__bar-spacer` (see below) fills the gap it leaves. */
  #ssh-{{ section_id }} .ssh__bar {
    position: relative;
    z-index: 100;
    background: var(--ssh-bg);
    border-bottom: 1px solid var(--ssh-border);
  }

  #ssh-{{ section_id }}.is-bar-pinned .ssh__bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
  }

  #ssh-{{ section_id }} .ssh__bar-spacer {
    display: none;
  }

  #ssh-{{ section_id }}.is-bar-pinned .ssh__bar-spacer {
    display: block;
  }

  #ssh-{{ section_id }} .ssh__inner {
    position: relative;
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 32px;
    height: var(--ssh-height);
    display: flex;
    align-items: center;
    gap: 24px;
  }

  /* ---- Logo ---- */
  #ssh-{{ section_id }} .ssh__logo {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  #ssh-{{ section_id }} .ssh__logo img {
    max-height: 44px;
    width: auto;
    display: block;
  }

  #ssh-{{ section_id }} .ssh__logo-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: var(--ssh-accent);
    color: #fff;
    flex-shrink: 0;
  }

  #ssh-{{ section_id }} .ssh__logo-text {
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-size: 22px;
    letter-spacing: 0.3px;
    text-transform: uppercase;
    color: var(--ssh-text);
  }

  /* ---- Nav ---- */
  #ssh-{{ section_id }} .ssh__nav {
    flex: 1;
    min-width: 0;
    display: none;
  }

  #ssh-{{ section_id }} .ssh__nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 2px;
    height: 100%;
  }

  #ssh-{{ section_id }} .ssh__nav-item {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
  }

  #ssh-{{ section_id }} .ssh__nav-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    font-size: 14px;
    white-space: nowrap;
    color: var(--ssh-text);
    background: none;
    border: none;
    cursor: pointer;
    padding: 9px 11px;
    border-radius: 8px;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  #ssh-{{ section_id }} .ssh__nav-link:hover,
  #ssh-{{ section_id }} .ssh__nav-item--mega:hover .ssh__nav-link,
  #ssh-{{ section_id }} .ssh__nav-item--mega:focus-within .ssh__nav-link,
  #ssh-{{ section_id }} .ssh__nav-item--simple:hover .ssh__nav-link,
  #ssh-{{ section_id }} .ssh__nav-item--simple:focus-within .ssh__nav-link {
    color: var(--ssh-accent);
    background: rgba(46, 125, 50, 0.08);
  }

  #ssh-{{ section_id }} .ssh__caret {
    transition: transform 0.25s ease;
  }

  #ssh-{{ section_id }} .ssh__nav-item--mega:hover .ssh__caret,
  #ssh-{{ section_id }} .ssh__nav-item--mega:focus-within .ssh__caret,
  #ssh-{{ section_id }} .ssh__nav-item--simple:hover .ssh__caret,
  #ssh-{{ section_id }} .ssh__nav-item--simple:focus-within .ssh__caret {
    transform: rotate(180deg);
  }

  /* ---- Mega menu ---- */
  /* Full-width by design: rather than a narrow panel centered under (and
     clipped/shifted to stay inside) its own trigger, this hit-area is
     `position: fixed` and spans the entire viewport width regardless of
     which trigger opened it or where that trigger sits in the nav - so
     there's no horizontal-overflow edge case to correct for at any
     viewport size (the old JS clamp logic is gone; `--ssh-mega-top` is
     the only thing JS still computes, matching wherever the bar's bottom
     edge currently is - pinned or not).
       .ssh__mega       - invisible, full-width hit-area. Only becomes
                           interactive (pointer-events) once hover starts,
                           so it never blocks clicks on page content
                           underneath while closed.
       .ssh__mega-inner - the actual glass card: centered within that
                           full-width area at a readable max-width, with
                           the frosted blur/shadow/radius and the
                           fade+slide animation. */
  #ssh-{{ section_id }} .ssh__mega {
    position: fixed;
    top: var(--ssh-mega-top, 76px);
    left: 0;
    right: 0;
    padding-top: 14px;
    pointer-events: none;
    z-index: 20;
  }

  #ssh-{{ section_id }} .ssh__nav-item--mega:hover .ssh__mega,
  #ssh-{{ section_id }} .ssh__nav-item--mega:focus-within .ssh__mega {
    pointer-events: auto;
  }

  #ssh-{{ section_id }} .ssh__mega-inner {
    display: grid;
    grid-template-columns: 260px 1fr;
    min-height: 300px;
    width: calc(100% - 48px);
    max-width: 1360px;
    margin: 0 auto;
    /* Safety valve: if a dropdown ever has enough tiles to be taller than
       the viewport allows, it scrolls internally instead of being cut off
       or pushed off-screen. */
    max-height: calc(100vh - 140px);
    overflow-x: hidden;
    overflow-y: auto;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(22px) saturate(160%);
    -webkit-backdrop-filter: blur(22px) saturate(160%);
    color: #141414;
    border-radius: 20px;
    box-shadow: 0 30px 70px rgba(20, 20, 20, 0.18), 0 2px 8px rgba(20, 20, 20, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.6);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity 0.22s ease, transform 0.22s ease, visibility 0.22s;
  }

  #ssh-{{ section_id }} .ssh__nav-item--mega:hover .ssh__mega-inner,
  #ssh-{{ section_id }} .ssh__nav-item--mega:focus-within .ssh__mega-inner {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  #ssh-{{ section_id }} .ssh__mega-intro {
    position: relative;
    border-radius: 20px 0 0 20px;
    overflow: hidden;
    background-color: var(--ssh-accent);
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: flex-end;
  }

  #ssh-{{ section_id }} .ssh__mega-intro-scrim {
    position: absolute;
    inset: 0;
  }

  #ssh-{{ section_id }} .ssh__mega-intro-content {
    position: relative;
    z-index: 1;
    padding: 24px;
    color: #fff;
  }

  #ssh-{{ section_id }} .ssh__mega-eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--ssh-cta);
    margin: 0 0 8px;
  }

  #ssh-{{ section_id }} .ssh__mega-heading {
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-weight: 400;
    font-size: 26px;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    line-height: 1.15;
    margin: 0 0 8px;
  }

  #ssh-{{ section_id }} .ssh__mega-text {
    font-size: 13px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 16px;
  }

  #ssh-{{ section_id }} .ssh__mega-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: #fff;
    background: var(--ssh-cta);
    padding: 9px 14px;
    border-radius: 999px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  #ssh-{{ section_id }} .ssh__mega-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.22);
  }

  #ssh-{{ section_id }} .ssh__mega-cta svg {
    transition: transform 0.2s ease;
  }

  #ssh-{{ section_id }} .ssh__mega-cta:hover svg {
    transform: translateX(2px);
  }

  #ssh-{{ section_id }} .ssh__mega-grid {
    padding: 20px;
    display: grid;
    /* Purely width-driven: each tile gets at least 110px, and auto-fit
       packs as many as actually fit per row (extra space is shared out via
       the 1fr max, so 2-3 tiles sit nicely wide and 5 tiles pack into one
       row without needing a fixed column count). Naturally reflows to
       fewer per row as the panel narrows on smaller viewports - never a
       forced tall wrap, never squeezed. */
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    gap: 12px;
    align-content: start;
  }

  #ssh-{{ section_id }} .ssh__tile {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 10px;
    border-radius: 12px;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  #ssh-{{ section_id }} .ssh__tile:hover {
    background: #f4f7f4;
    transform: translateY(-2px);
  }

  #ssh-{{ section_id }} .ssh__tile-image {
    display: block;
    width: 100%;
    border-radius: 10px;
    overflow: hidden;
    background: #f0f3f0;
  }

  #ssh-{{ section_id }} .ssh__tile-image img {
    width: 100%;
    height: 100%;
    display: block;
    transition: transform 0.4s ease;
  }

  #ssh-{{ section_id }} .ssh__tile:hover .ssh__tile-image img {
    transform: scale(1.06);
  }

  #ssh-{{ section_id }} .ssh__tile-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ssh-accent);
  }

  #ssh-{{ section_id }} .ssh__tile-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  #ssh-{{ section_id }} .ssh__tile-heading {
    font-weight: 600;
    font-size: 13.5px;
    color: #141414;
  }

  #ssh-{{ section_id }} .ssh__tile-text {
    font-size: 12px;
    color: #7a7a7a;
    line-height: 1.4;
  }

  /* ---- Simple dropdown (e.g. "Pages") ----
     A lighter-weight sibling of the mega menu for plain link lists - same
     glass/blur treatment for visual consistency, but compact and anchored
     to its own trigger (right-aligned, since triggers like this tend to
     sit near the end of the nav, close to the right edge) rather than
     full-width like the mega menu. */
  #ssh-{{ section_id }} .ssh__simple-dropdown {
    position: absolute;
    top: 100%;
    right: 0;
    padding-top: 14px;
    min-width: 220px;
    pointer-events: none;
    z-index: 20;
  }

  #ssh-{{ section_id }} .ssh__nav-item--simple:hover .ssh__simple-dropdown,
  #ssh-{{ section_id }} .ssh__nav-item--simple:focus-within .ssh__simple-dropdown {
    pointer-events: auto;
  }

  #ssh-{{ section_id }} .ssh__simple-list {
    list-style: none;
    margin: 0;
    padding: 10px;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(22px) saturate(160%);
    -webkit-backdrop-filter: blur(22px) saturate(160%);
    color: #141414;
    border-radius: 16px;
    box-shadow: 0 24px 50px rgba(20, 20, 20, 0.16), 0 2px 8px rgba(20, 20, 20, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.6);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity 0.22s ease, transform 0.22s ease, visibility 0.22s;
  }

  #ssh-{{ section_id }} .ssh__nav-item--simple:hover .ssh__simple-list,
  #ssh-{{ section_id }} .ssh__nav-item--simple:focus-within .ssh__simple-list {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  #ssh-{{ section_id }} .ssh__simple-list li + li {
    margin-top: 2px;
  }

  #ssh-{{ section_id }} .ssh__simple-list a {
    display: block;
    padding: 10px 14px;
    border-radius: 10px;
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    font-size: 14px;
    white-space: nowrap;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  #ssh-{{ section_id }} .ssh__simple-list a:hover {
    background: rgba(46, 125, 50, 0.08);
    color: var(--ssh-accent);
  }

  /* ---- Actions ---- */
  #ssh-{{ section_id }} .ssh__actions {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
  }

  #ssh-{{ section_id }} .ssh__icon-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    color: var(--ssh-text);
    background: none;
    border: none;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  #ssh-{{ section_id }} .ssh__icon-btn:hover {
    background: rgba(46, 125, 50, 0.08);
    color: var(--ssh-accent);
  }

  #ssh-{{ section_id }} .ssh__cart-count {
    position: absolute;
    top: 3px;
    right: 3px;
    min-width: 16px;
    height: 16px;
    padding: 0 3px;
    border-radius: 999px;
    background: var(--ssh-cta);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    line-height: 16px;
    text-align: center;
  }

  #ssh-{{ section_id }} .ssh__icon-btn--desktop {
    display: none;
  }

  /* Icon morphs from hamburger to X by cross-fading + rotating both icons
     in place, rather than an instant display swap. */
  #ssh-{{ section_id }} .ssh__burger-open,
  #ssh-{{ section_id }} .ssh__burger-close {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(0deg) scale(1);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  #ssh-{{ section_id }} .ssh__burger-close {
    opacity: 0;
    transform: translate(-50%, -50%) rotate(-90deg) scale(0.5);
  }

  #ssh-{{ section_id }}.is-mobile-open .ssh__burger-open {
    opacity: 0;
    transform: translate(-50%, -50%) rotate(90deg) scale(0.5);
  }

  #ssh-{{ section_id }}.is-mobile-open .ssh__burger-close {
    opacity: 1;
    transform: translate(-50%, -50%) rotate(0deg) scale(1);
  }

  /* ---- Mobile panel ---- */
  /* Collapsed via max-height (JS sets it to the panel's real scrollHeight
     on open, 0 on close) rather than display/hidden toggling, so it can
     actually transition instead of snapping open/closed. */
  #ssh-{{ section_id }} .ssh__mobile {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 90;
    border-top: 1px solid var(--ssh-border);
    background: var(--ssh-bg);
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transform: translateY(-6px);
    box-shadow: 0 16px 30px rgba(0, 0, 0, 0.08);
    transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.25s ease, transform 0.3s ease;
  }

  #ssh-{{ section_id }}.is-mobile-open .ssh__mobile {
    opacity: 1;
    transform: translateY(0);
  }

  #ssh-{{ section_id }} .ssh__mobile-list {
    list-style: none;
    margin: 0;
    padding: 8px 20px 20px;
    display: flex;
    flex-direction: column;
  }

  #ssh-{{ section_id }} .ssh__mobile-list > li > a,
  #ssh-{{ section_id }} .ssh__mobile-group-label {
    display: block;
    padding: 12px 4px;
    font-weight: 600;
    font-size: 15px;
    border-bottom: 1px solid var(--ssh-border);
  }

  #ssh-{{ section_id }} .ssh__mobile-group ul {
    list-style: none;
    margin: 0;
    padding: 0 0 6px 12px;
  }

  #ssh-{{ section_id }} .ssh__mobile-group ul a {
    display: block;
    padding: 8px 4px;
    font-size: 14px;
    color: #5a5a5a;
  }

  #ssh-{{ section_id }} .ssh__mobile-account a {
    display: block;
    padding: 12px 4px;
    font-weight: 600;
    font-size: 15px;
    color: var(--ssh-accent);
  }

  /* ---- Desktop + tablet (mega menu enabled) ----
     Hamburger is mobile-only: this shows the full nav from 750px up
     (matching the "mobile" breakpoint used by every other section in this
     theme), not just above 990px, so tablets get the real nav instead of
     a hamburger. A tighter tier just below covers narrower tablets where
     the full nav item count needs a bit more room to breathe. */
  @media screen and (min-width: 750px) {
    #ssh-{{ section_id }} .ssh__nav {
      display: block;
    }

    #ssh-{{ section_id }} .ssh__icon-btn--desktop {
      display: flex;
    }

    #ssh-{{ section_id }} .ssh__burger {
      display: none;
    }

    #ssh-{{ section_id }} .ssh__mobile {
      display: none !important;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 1099px) {
    #ssh-{{ section_id }} .ssh__inner {
      gap: 14px;
    }

    #ssh-{{ section_id }} .ssh__nav-list {
      gap: 0;
    }

    #ssh-{{ section_id }} .ssh__nav-link {
      padding: 9px 8px;
      font-size: 13px;
    }
  }

  @media screen and (max-width: 749px) {
    #ssh-{{ section_id }} .ssh__inner {
      padding: 0 20px;
      gap: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #ssh-{{ section_id }} .ssh__mobile,
    #ssh-{{ section_id }} .ssh__burger-open,
    #ssh-{{ section_id }} .ssh__burger-close {
      transition: none;
    }
  }
</style>

<script>
  (function () {
    var header = document.getElementById('ssh-{{ section_id }}');
    if (!header) return;

    var burger = header.querySelector('[data-ssh-burger]');
    var panel = header.querySelector('[data-ssh-mobile-panel]');
    var bar = header.querySelector('.ssh__bar');
    var spacer = header.querySelector('[data-ssh-bar-spacer]');
    if (!burger || !panel) return;

    /* Pin the bar to the viewport once scrolled past the utility strip.
       This theme scrolls `.page-wrapper` (not the document) on desktop, so
       both scroll sources are watched; whichever is actually active drives
       the pin state. See the CSS comment above `.ssh__bar` for why this is
       JS-driven rather than `position: sticky`. */
    if (bar && spacer) {
      var pageScroller = document.querySelector('.page-wrapper');

      function currentScrollTop() {
        var wrapperTop = pageScroller ? pageScroller.scrollTop : 0;
        var winTop = window.scrollY || document.documentElement.scrollTop || 0;
        return Math.max(wrapperTop, winTop);
      }

      var pinTicking = false;
      function updatePinned() {
        var shouldPin = currentScrollTop() > 2;
        var pinChanged = header.classList.contains('is-bar-pinned') !== shouldPin;
        if (pinChanged) {
          header.classList.toggle('is-bar-pinned', shouldPin);
          spacer.style.height = shouldPin ? bar.offsetHeight + 'px' : '0px';
        }
        /* The full-width mega/simple dropdowns are `position: fixed`, so
           they need to know exactly where the bar's bottom edge is right
           now (pinned or not) to sit flush beneath it. */
        header.style.setProperty('--ssh-mega-top', bar.getBoundingClientRect().bottom + 'px');
      }

      function onScroll() {
        if (pinTicking) return;
        pinTicking = true;
        window.requestAnimationFrame(function () {
          updatePinned();
          pinTicking = false;
        });
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      if (pageScroller) pageScroller.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      updatePinned();
    }

    /* Animate open/close by setting max-height to the panel's actual
       content height (rather than an arbitrary large value), so the CSS
       transition tracks real content and works at any viewport size. */
    function setMobilePanelOpen(isOpen) {
      header.classList.toggle('is-mobile-open', isOpen);
      burger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      panel.style.maxHeight = isOpen ? panel.scrollHeight + 'px' : '0px';
    }

    burger.addEventListener('click', function () {
      setMobilePanelOpen(!header.classList.contains('is-mobile-open'));
    });

    window.addEventListener('resize', function () {
      if (window.innerWidth >= 750 && header.classList.contains('is-mobile-open')) {
        setMobilePanelOpen(false);
      } else if (header.classList.contains('is-mobile-open')) {
        /* content height can change on resize (text reflow) - keep it in sync while open */
        panel.style.maxHeight = panel.scrollHeight + 'px';
      }
    });
  })();
</script>

