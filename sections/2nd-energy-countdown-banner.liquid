{%- comment -%}
  Section: Energy Countdown Banner
  A pinned countdown banner with a floating product image that slides,
  straightens and rotates into place purely from scroll position, using
  the standard "tall wrapper + position:sticky child" pin technique -
  no scroll-jacking, no timed animation, fully reversible either direction.
{%- endcomment -%}

{{ 'https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@400;500;600;700;800&display=swap' | stylesheet_tag }}

{%- liquid
  assign section_id = section.id
  assign s = section.settings

  assign shadow_opacity = s.image_shadow_intensity | divide: 200.0

  assign target_iso = s.target_date | append: 'T' | append: s.target_time | append: ':00' | append: s.timezone_offset
-%}

<section
  class="ecb"
  id="ecb-{{ section_id }}"
  data-ecb
  data-enable-pin="{{ s.enable_pin }}"
  data-mobile-disable-pin="{{ s.mobile_disable_pin }}"
  data-pin-duration="{{ s.pin_duration }}"
  data-scroll-distance="{{ s.scroll_distance }}"
  data-start-offset="{{ s.start_trigger_offset }}"
  data-end-offset="{{ s.end_trigger_offset }}"
  data-smoothness="{{ s.animation_smoothness }}"
  data-speed-multiplier="{{ s.animation_speed_multiplier }}"
  data-easing-strength="{{ s.easing_strength }}"
  data-translate-distance="{{ s.translate_distance_multiplier }}"
  data-rotation-amount="{{ s.rotation_amount_multiplier }}"
  data-scale-amount="{{ s.scale_amount_multiplier }}"
  data-initial-y="{{ s.image_initial_offset }}"
  data-final-y="{{ s.image_final_offset }}"
  data-initial-rotate="{{ s.image_initial_rotation }}"
  data-final-rotate="{{ s.image_final_rotation }}"
  data-base-scale="{{ s.image_scale }}"
  data-target-iso="{{ target_iso }}"
  data-on-complete="{{ s.on_complete_action }}"
  style="
    --ecb-container-width: {{ s.container_width }}px;
    --ecb-content-width: {{ s.content_width }}px;
    --ecb-padding-top: {{ s.padding_top }}px;
    --ecb-padding-bottom: {{ s.padding_bottom }}px;
    --ecb-margin-top: {{ s.margin_top }}px;
    --ecb-margin-bottom: {{ s.margin_bottom }}px;

    --ecb-banner-width: {{ s.banner_width }}px;
    --ecb-banner-height: {{ s.banner_height }}px;
    --ecb-banner-radius: {{ s.banner_radius }}px;
    --ecb-overlay-color: {{ s.overlay_color }};
    --ecb-overlay-opacity: {{ s.overlay_opacity }};

    --ecb-heading-size: {{ s.heading_font_size }}px;
    --ecb-heading-weight: {{ s.heading_font_weight }};
    --ecb-heading-spacing: {{ s.heading_letter_spacing }}px;
    --ecb-heading-line-height: {{ s.heading_line_height }};
    --ecb-heading-color: {{ s.heading_color }};
    --ecb-heading-shadow: {{ s.heading_text_shadow }};

    --ecb-box-bg: {{ s.box_color }};
    --ecb-box-radius: {{ s.box_radius }}px;
    --ecb-box-padding: {{ s.box_padding }}px;
    --ecb-box-width: {{ s.box_width }}px;
    --ecb-box-height: {{ s.box_height }}px;
    --ecb-number-color: {{ s.number_color }};
    --ecb-number-size: {{ s.number_font_size }}px;
    --ecb-label-color: {{ s.label_color }};
    --ecb-label-size: {{ s.label_font_size }}px;
    --ecb-divider-color: {{ s.divider_color }};
    --ecb-divider-width: {{ s.divider_width }}px;

    --ecb-btn-bg: {{ s.button_bg }};
    --ecb-btn-bg-hover: {{ s.button_bg_hover }};
    --ecb-btn-text: {{ s.button_text_color }};
    --ecb-btn-radius: {{ s.button_radius }}px;
    --ecb-btn-padding-x: {{ s.button_padding_x }}px;
    --ecb-btn-padding-y: {{ s.button_padding_y }}px;

    --ecb-img-width: {{ s.image_width }}px;
    --ecb-img-height: {{ s.image_height }}px;
    --ecb-img-scale: {{ s.image_scale }};
    --ecb-img-opacity: {{ s.image_opacity }};
    --ecb-img-zindex: {{ s.image_zindex }};
    --ecb-img-offset-x: {{ s.image_horizontal_offset }}px;
    --ecb-img-shadow-blur: {{ s.image_shadow_blur }}px;
    --ecb-img-shadow-opacity: {{ shadow_opacity }};
    --ecb-img-initial-y: {{ s.image_initial_offset }}px;
    --ecb-img-initial-rotate: {{ s.image_initial_rotation }}deg;

    --ecb-desktop-img-offset: {{ s.desktop_image_offset }}px;
    --ecb-tablet-img-offset: {{ s.tablet_image_offset }}px;
    --ecb-mobile-img-offset: {{ s.mobile_image_offset }}px;

    --ecb-decor-opacity: {{ s.bg_decor_opacity | default: 60 | divided_by: 100.0 }};
  "
>
  <div class="ecb__pin-wrapper" data-pin-wrapper>
    <div class="ecb__pin-inner" data-pin-inner>

      {%- assign has_decor_image = false -%}
      {%- if s.bg_decor_image_a != blank or s.bg_decor_image_b != blank -%}
        {%- assign has_decor_image = true -%}
      {%- endif -%}
      {%- if s.show_bg_decor and has_decor_image -%}
        <div class="ecb__bg-decor" data-bg-decor aria-hidden="true">
          {%- comment -%}
            Image instances placed on a grid (count and columns both
            derived from the "Number of images" setting) - one item per
            cell, each offset by a small deterministic jitter proportional
            to the cell size so the scatter looks organic while the grid
            partition guarantees no two images ever overlap, at any count.
            Alternates between the two uploaded images, with varied
            rotation/flip/size and a mix of drift directions on scroll.
          {%- endcomment -%}
          {%- assign decor_count = s.bg_decor_count | default: 20 -%}
          {%- assign last_index = decor_count | minus: 1 -%}
          {%- assign grid_cols = decor_count -%}
          {%- if grid_cols > 8 -%}
            {%- assign grid_cols = 8 -%}
          {%- endif -%}
          {%- if grid_cols < 1 -%}
            {%- assign grid_cols = 1 -%}
          {%- endif -%}
          {%- assign grid_rows = decor_count | minus: 1 | divided_by: grid_cols | plus: 1 -%}
          {%- assign cell_w = 100.0 | divided_by: grid_cols -%}
          {%- assign cell_h = 100.0 | divided_by: grid_rows -%}
          {%- assign half_cell_w = cell_w | divided_by: 2.0 -%}
          {%- assign half_cell_h = cell_h | divided_by: 2.0 -%}
          {%- assign base_size = s.bg_decor_size | default: 90 -%}
          {%- for i in (0..last_index) -%}
            {%- assign col = i | modulo: grid_cols -%}
            {%- assign row = i | divided_by: grid_cols -%}
            {%- assign jitter_raw_x = i | times: 13 | modulo: 5 | minus: 2 -%}
            {%- assign jitter_x = jitter_raw_x | times: cell_w | divided_by: 10.0 -%}
            {%- assign jitter_raw_y = i | times: 19 | modulo: 7 | minus: 3 -%}
            {%- assign jitter_y = jitter_raw_y | times: cell_h | divided_by: 10.0 -%}
            {%- assign left = col | times: cell_w | plus: half_cell_w | plus: jitter_x -%}
            {%- assign top = row | times: cell_h | plus: half_cell_h | plus: jitter_y -%}
            {%- assign size_variance = i | modulo: 5 | times: 8 -%}
            {%- assign size = base_size | plus: size_variance | minus: 16 -%}
            {%- assign rotate = i | times: 29 | modulo: 360 -%}
            {%- assign flip = i | modulo: 3 -%}
            {%- assign speed_step = i | modulo: 6 -%}
            {%- assign speed = speed_step | times: 4 | plus: 12 | divided_by: 100.0 -%}
            {%- assign dir_x = i | modulo: 3 | minus: 1 -%}
            {%- assign dir_y = i | modulo: 2 -%}
            {%- assign alt = i | modulo: 2 -%}
            {%- if alt == 1 and s.bg_decor_image_b != blank -%}
              {%- assign decor_img = s.bg_decor_image_b -%}
            {%- elsif s.bg_decor_image_a != blank -%}
              {%- assign decor_img = s.bg_decor_image_a -%}
            {%- else -%}
              {%- assign decor_img = s.bg_decor_image_b -%}
            {%- endif -%}
            <span
              class="ecb__decor-item"
              data-decor-item
              data-order="{{ i }}"
              data-speed="{{ speed }}"
              data-rotate="{{ rotate }}"
              data-flip="{% if flip == 0 %}1{% else %}0{% endif %}"
              data-dir-x="{{ dir_x }}"
              data-dir-y="{{ dir_y }}"
              style="
                top: {{ top }}%;
                left: {{ left }}%;
                width: {{ size }}px;
                transform: translate(-50%, -50%) rotate({{ rotate }}deg){% if flip == 0 %} scaleX(-1){% endif %};
              "
            >
              <img
                src="{{ decor_img | image_url: width: 200 }}"
                srcset="{{ decor_img | image_url: width: 100 }} 100w, {{ decor_img | image_url: width: 200 }} 200w"
                alt=""
                width="{{ decor_img.width }}"
                height="{{ decor_img.height }}"
                loading="lazy"
              >
            </span>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="ecb__stage">

        {%- if s.product_image != blank -%}
          <div class="ecb__product" data-product aria-hidden="true">
            <img
              class="ecb__product-image"
              src="{{ s.product_image | image_url: width: 800 }}"
              srcset="
                {{ s.product_image | image_url: width: 400 }} 400w,
                {{ s.product_image | image_url: width: 800 }} 800w,
                {{ s.product_image | image_url: width: 1200 }} 1200w
              "
              sizes="(max-width: 749px) 200px, 340px"
              alt="{{ s.product_image.alt | default: s.heading | escape }}"
              width="{{ s.product_image.width }}"
              height="{{ s.product_image.height }}"
              loading="lazy"
            >
          </div>
        {%- endif -%}

        <div
          class="ecb__banner"
          {% if s.background_image != blank %}
            style="background-image: url('{{ s.background_image | image_url: width: 1800 }}');"
          {% endif %}
        >
          <div class="ecb__overlay"></div>

          <div class="ecb__content">
            <h2 class="ecb__heading">{{ s.heading }}</h2>

            <div
              class="ecb__countdown"
              data-countdown
              role="timer"
              aria-live="polite"
              aria-label="Countdown timer"
            >
              <div class="ecb__unit">
                <div class="ecb__box"><span class="ecb__number" data-days>00</span></div>
                <span class="ecb__label">{{ s.label_days | default: 'Days' }}</span>
              </div>
              <span class="ecb__divider" aria-hidden="true"></span>
              <div class="ecb__unit">
                <div class="ecb__box"><span class="ecb__number" data-hours>00</span></div>
                <span class="ecb__label">{{ s.label_hours | default: 'Hours' }}</span>
              </div>
              <span class="ecb__divider" aria-hidden="true"></span>
              <div class="ecb__unit">
                <div class="ecb__box"><span class="ecb__number" data-minutes>00</span></div>
                <span class="ecb__label">{{ s.label_minutes | default: 'Minutes' }}</span>
              </div>
              <span class="ecb__divider" aria-hidden="true"></span>
              <div class="ecb__unit">
                <div class="ecb__box"><span class="ecb__number" data-seconds>00</span></div>
                <span class="ecb__label">{{ s.label_seconds | default: 'Seconds' }}</span>
              </div>
            </div>

            <p class="ecb__complete-message" data-complete-message hidden>{{ s.complete_message }}</p>

            {%- if s.button_text != blank -%}
              <a href="{{ s.button_url | default: '#' }}" class="ecb__button">{{ s.button_text }}</a>
            {%- endif -%}
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

{%- comment -%} ---------------- CSS ---------------- {%- endcomment -%}
<style>
  #ecb-{{ section_id }} {
    position: relative;
    margin: var(--ecb-margin-top) 0 var(--ecb-margin-bottom);
  }

  #ecb-{{ section_id }} * {
    box-sizing: border-box;
  }

  #ecb-{{ section_id }} .ecb__pin-wrapper {
    position: relative;
  }

  #ecb-{{ section_id }} .ecb__pin-inner {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  #ecb-{{ section_id }} .ecb__stage {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--ecb-container-width);
    margin: 0 auto;
    padding: var(--ecb-padding-top) 20px var(--ecb-padding-bottom);
  }

  /* ---- Background decoration (scattered leaf/element images) ---- */
  #ecb-{{ section_id }} .ecb__bg-decor {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  #ecb-{{ section_id }} .ecb__decor-item {
    position: absolute;
    opacity: var(--ecb-decor-opacity);
  }

  #ecb-{{ section_id }} .ecb__decor-item img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 749px) {
    #ecb-{{ section_id }} .ecb__decor-item:nth-child(n + 15) {
      display: none;
    }

    #ecb-{{ section_id }} .ecb__decor-item {
      width: 40px !important;
    }
  }

  /* ---- Banner ---- */
  #ecb-{{ section_id }} .ecb__banner {
    position: relative;
    width: 100%;
    max-width: var(--ecb-banner-width);
    height: var(--ecb-banner-height);
    margin: 0 auto;
    border-radius: var(--ecb-banner-radius);
    overflow: hidden;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-color: #111;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
  }

  #ecb-{{ section_id }} .ecb__overlay {
    position: absolute;
    inset: 0;
    background: var(--ecb-overlay-color);
    opacity: calc(var(--ecb-overlay-opacity) / 100);
  }

  #ecb-{{ section_id }} .ecb__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--ecb-content-width);
    margin: 0 auto;
    padding: 0 24px;
    text-align: center;
  }

  #ecb-{{ section_id }} .ecb__heading {
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-weight: var(--ecb-heading-weight);
    font-size: var(--ecb-heading-size);
    letter-spacing: var(--ecb-heading-spacing);
    line-height: var(--ecb-heading-line-height);
    color: var(--ecb-heading-color);
    text-shadow: var(--ecb-heading-shadow);
    text-transform: uppercase;
    margin: 0 0 28px;
  }

  /* ---- Countdown ---- */
  #ecb-{{ section_id }} .ecb__countdown {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    flex-wrap: wrap;
    margin-bottom: 30px;
  }

  #ecb-{{ section_id }} .ecb__unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  #ecb-{{ section_id }} .ecb__box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--ecb-box-width);
    height: var(--ecb-box-height);
    padding: var(--ecb-box-padding);
    background: var(--ecb-box-bg);
    border-radius: var(--ecb-box-radius);
  }

  #ecb-{{ section_id }} .ecb__number {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: var(--ecb-number-size);
    color: var(--ecb-number-color);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  #ecb-{{ section_id }} .ecb__label {
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: var(--ecb-label-size);
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--ecb-label-color);
  }

  #ecb-{{ section_id }} .ecb__divider {
    width: var(--ecb-divider-width);
    height: var(--ecb-box-height);
    background: var(--ecb-divider-color);
    opacity: 0.5;
    align-self: flex-start;
  }

  #ecb-{{ section_id }} .ecb__complete-message {
    font-family: 'Poppins', sans-serif;
    color: var(--ecb-heading-color);
    font-size: 18px;
    margin: 0 0 24px;
  }

  /* ---- Button ---- */
  #ecb-{{ section_id }} .ecb__button {
    display: inline-block;
    background: var(--ecb-btn-bg);
    color: var(--ecb-btn-text);
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    border-radius: var(--ecb-btn-radius);
    padding: var(--ecb-btn-padding-y) var(--ecb-btn-padding-x);
    transition: background-color 0.3s ease, transform 0.3s ease;
  }

  #ecb-{{ section_id }} .ecb__button:hover {
    background: var(--ecb-btn-bg-hover);
    transform: translateY(-2px);
  }

  #ecb-{{ section_id }} .ecb__button:focus-visible {
    outline: 2px solid var(--ecb-btn-bg-hover);
    outline-offset: 3px;
  }

  /* ---- Floating product image ---- */
  #ecb-{{ section_id }} .ecb__product {
    position: absolute;
    left: calc(50% - (var(--ecb-banner-width) / 2) + var(--ecb-img-offset-x) + var(--ecb-desktop-img-offset));
    bottom: 6%;
    width: var(--ecb-img-width);
    max-width: 40vw;
    z-index: var(--ecb-img-zindex);
    opacity: var(--ecb-img-opacity);
    pointer-events: none;
    transform: translate3d(0, var(--ecb-img-initial-y), 0) rotate(var(--ecb-img-initial-rotate)) scale(var(--ecb-img-scale));
    will-change: transform;
  }

  #ecb-{{ section_id }} .ecb__product-image {
    width: 100%;
    height: auto;
    max-height: var(--ecb-img-height);
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 30px var(--ecb-img-shadow-blur) rgba(0, 0, 0, var(--ecb-img-shadow-opacity)));
  }

  /* ---- Tablet ---- */
  @media (max-width: 999px) {
    #ecb-{{ section_id }} .ecb__product {
      left: calc(50% - (var(--ecb-banner-width) / 2) + var(--ecb-img-offset-x) + var(--ecb-tablet-img-offset));
      max-width: 34vw;
    }

    #ecb-{{ section_id }} .ecb__heading {
      font-size: min(var(--ecb-heading-size), 2.4rem);
    }
  }

  /* ---- Mobile ---- */
  @media (max-width: 749px) {
    #ecb-{{ section_id }} .ecb__pin-inner {
      position: relative;
      top: auto;
      height: auto;
      padding: 40px 0;
    }

    #ecb-{{ section_id }} .ecb__stage {
      padding: 0 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 24px;
    }

    #ecb-{{ section_id }} .ecb__product {
      position: relative;
      left: auto;
      bottom: auto;
      width: min(var(--ecb-img-width), 60vw);
      max-width: 60vw;
      margin: 0 auto;
      transform: translate3d(0, 0, 0) rotate(var(--ecb-img-initial-rotate)) scale(var(--ecb-img-scale));
      order: 2;
    }

    #ecb-{{ section_id }} .ecb__banner {
      order: 1;
      height: auto;
      min-height: 320px;
      padding: 40px 0;
    }

    #ecb-{{ section_id }} .ecb__heading {
      font-size: min(var(--ecb-heading-size), 1.7rem);
    }

    #ecb-{{ section_id }} .ecb__countdown {
      gap: 10px;
    }

    #ecb-{{ section_id }} .ecb__divider {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #ecb-{{ section_id }} .ecb__pin-inner {
      position: relative;
      top: auto;
      height: auto;
    }

    #ecb-{{ section_id }} .ecb__product {
      transform: translate3d(0, 0, 0) rotate(var(--ecb-img-initial-rotate)) scale(var(--ecb-img-scale)) !important;
    }
  }
</style>

{%- comment -%} ---------------- JS ---------------- {%- endcomment -%}
<script>
  (function () {
    var section = document.getElementById('ecb-{{ section_id }}');
    if (!section) return;

    var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ================= Countdown ================= */
    var countdownEl = section.querySelector('[data-countdown]');
    var completeMessageEl = section.querySelector('[data-complete-message]');
    var daysEl = section.querySelector('[data-days]');
    var hoursEl = section.querySelector('[data-hours]');
    var minutesEl = section.querySelector('[data-minutes]');
    var secondsEl = section.querySelector('[data-seconds]');

    var targetIso = section.getAttribute('data-target-iso');
    var onComplete = section.getAttribute('data-on-complete') || 'hide';
    var targetTime = new Date(targetIso).getTime();
    var originalDuration = null;

    function pad(n) {
      return String(Math.max(0, Math.floor(n))).padStart(2, '0');
    }

    function renderCountdown() {
      if (!countdownEl) return;
      var now = Date.now();
      var diff = targetTime - now;

      if (originalDuration === null) {
        originalDuration = Math.max(diff, 0);
      }

      if (diff <= 0) {
        if (onComplete === 'hide') {
          countdownEl.hidden = true;
          return;
        }
        if (onComplete === 'message') {
          countdownEl.hidden = true;
          if (completeMessageEl) completeMessageEl.hidden = false;
          return;
        }
        if (onComplete === 'restart' || onComplete === 'loop') {
          targetTime = now + (originalDuration || 24 * 60 * 60 * 1000);
          diff = targetTime - now;
        }
      }

      var days = diff / (1000 * 60 * 60 * 24);
      var hours = (diff / (1000 * 60 * 60)) % 24;
      var minutes = (diff / (1000 * 60)) % 60;
      var seconds = (diff / 1000) % 60;

      if (daysEl) daysEl.textContent = pad(days);
      if (hoursEl) hoursEl.textContent = pad(hours);
      if (minutesEl) minutesEl.textContent = pad(minutes);
      if (secondsEl) secondsEl.textContent = pad(seconds);
    }

    if (!isNaN(targetTime)) {
      renderCountdown();
      window.setInterval(renderCountdown, 1000);
    }

    /* ================= Background decoration (multi-directional parallax) ================= */
    var decorList = Array.prototype.slice.call(section.querySelectorAll('[data-decor-item]')).map(function (el) {
      return {
        el: el,
        speed: parseFloat(el.getAttribute('data-speed')) || 0.2,
        rotate: parseFloat(el.getAttribute('data-rotate')) || 0,
        flip: el.getAttribute('data-flip') === '1',
        dirX: parseFloat(el.getAttribute('data-dir-x')) || 0,
        dirY: el.getAttribute('data-dir-y') === '1' ? -1 : 1
      };
    });

    function getDecorProgress() {
      if (!pinWrapper) return 1;
      var rect = pinWrapper.getBoundingClientRect();
      var viewportH = window.innerHeight || document.documentElement.clientHeight || 1;
      var total = rect.height + viewportH;
      if (total <= 0) return 1;
      var passed = viewportH - rect.top;
      return Math.max(0, Math.min(1, passed / total));
    }

    function updateDecor() {
      if (prefersReducedMotion || !decorList.length) return;
      var progress = getDecorProgress();

      decorList.forEach(function (item) {
        var y = (progress - 0.5) * -40 * item.speed * item.dirY;
        var x = (progress - 0.5) * 24 * item.speed * item.dirX;
        var transform =
          'translate(-50%,-50%) translate3d(' + x.toFixed(1) + 'px,' + y.toFixed(1) + 'px,0) rotate(' + item.rotate + 'deg)';
        if (item.flip) transform += ' scaleX(-1)';
        item.el.style.transform = transform;
      });
    }

    /* ================= Scroll-driven pin & reveal ================= */
    var pinWrapper = section.querySelector('[data-pin-wrapper]');
    var pinInner = section.querySelector('[data-pin-inner]');
    var product = section.querySelector('[data-product]');

    var enablePin = section.getAttribute('data-enable-pin') === 'true';
    var mobileDisablePin = section.getAttribute('data-mobile-disable-pin') === 'true';

    function getNum(attr, fallback) {
      var v = parseFloat(section.getAttribute(attr));
      return isNaN(v) ? fallback : v;
    }

    var pinDuration = getNum('data-pin-duration', 800);
    var scrollDistance = getNum('data-scroll-distance', 800);
    var startOffset = getNum('data-start-offset', 0);
    var endOffset = getNum('data-end-offset', 0);
    var smoothness = getNum('data-smoothness', 0.15);
    var speedMultiplier = getNum('data-speed-multiplier', 1);
    var easingStrength = getNum('data-easing-strength', 1);
    var translateMultiplier = getNum('data-translate-distance', 1);
    var rotationMultiplier = getNum('data-rotation-amount', 1);
    var scaleMultiplier = getNum('data-scale-amount', 1);
    var initialY = getNum('data-initial-y', 220);
    var finalY = getNum('data-final-y', 0);
    var initialRotate = getNum('data-initial-rotate', -14);
    var finalRotate = getNum('data-final-rotate', -6);
    var baseScale = getNum('data-base-scale', 1);
    /* subtle "grows into place" scale-in, intensity controlled by the
       Scale Amount multiplier - at 0 the image doesn't scale at all */
    var scaleStart = baseScale * (1 - 0.08 * scaleMultiplier);

    function isMobile() {
      return window.innerWidth <= 749;
    }

    function pinActive() {
      if (prefersReducedMotion) return false;
      if (!enablePin) return false;
      if (isMobile() && mobileDisablePin) return false;
      return true;
    }

    if (pinWrapper) {
      pinWrapper.style.height = pinActive()
        ? 'calc(100vh + ' + pinDuration + 'px)'
        : 'auto';
    }

    var currentY = initialY;
    var currentRotate = initialRotate;
    var currentScale = scaleStart;
    var targetY = initialY;
    var targetRotate = initialRotate;
    var targetScale = scaleStart;
    var rafId = null;

    function easeProgress(p) {
      if (easingStrength <= 0) return p;
      return Math.pow(p, 1 / easingStrength);
    }

    function computeTargets() {
      if (!pinActive() || !pinWrapper) {
        targetY = finalY;
        targetRotate = finalRotate;
        targetScale = baseScale;
        return;
      }

      var rect = pinWrapper.getBoundingClientRect();
      var viewportH = window.innerHeight || document.documentElement.clientHeight;
      var scrollableHeight = rect.height - viewportH;
      if (scrollableHeight <= 0) {
        targetY = finalY;
        targetRotate = finalRotate;
        targetScale = baseScale;
        return;
      }

      var raw = (-rect.top - startOffset) / (scrollableHeight - endOffset || 1);
      raw *= speedMultiplier;
      raw = Math.max(0, Math.min(1, raw));

      /* image finishes its motion within `scrollDistance` px of the total
         `pinDuration` scroll - once reached it holds at the final state
         for the remainder of the pin, exactly like the reference. */
      var animFraction = scrollDistance > 0 ? pinDuration / scrollDistance : 1;
      var imageProgress = Math.max(0, Math.min(1, raw * animFraction));
      var eased = easeProgress(imageProgress);

      targetY = initialY + (finalY - initialY) * translateMultiplier * eased;
      targetRotate = initialRotate + (finalRotate - initialRotate) * rotationMultiplier * eased;
      targetScale = scaleStart + (baseScale - scaleStart) * eased;
    }

    function tick() {
      computeTargets();
      updateDecor();

      var lerp = prefersReducedMotion ? 1 : Math.max(0.01, Math.min(1, smoothness));
      currentY += (targetY - currentY) * lerp;
      currentRotate += (targetRotate - currentRotate) * lerp;
      currentScale += (targetScale - currentScale) * lerp;

      if (product) {
        product.style.setProperty('--ecb-img-initial-y', currentY.toFixed(2) + 'px');
        product.style.setProperty('--ecb-img-initial-rotate', currentRotate.toFixed(2) + 'deg');
        product.style.setProperty('--ecb-img-scale', currentScale.toFixed(3));
      }

      rafId = window.requestAnimationFrame(tick);
    }

    var visibilityObserver = null;
    if ('IntersectionObserver' in window) {
      visibilityObserver = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              if (rafId === null) rafId = window.requestAnimationFrame(tick);
            } else if (rafId !== null) {
              window.cancelAnimationFrame(rafId);
              rafId = null;
            }
          });
        },
        { rootMargin: '200px 0px 200px 0px' }
      );
      visibilityObserver.observe(section);
    } else {
      rafId = window.requestAnimationFrame(tick);
    }

    var resizeRaf = null;
    window.addEventListener(
      'resize',
      function () {
        if (resizeRaf) window.cancelAnimationFrame(resizeRaf);
        resizeRaf = window.requestAnimationFrame(function () {
          if (pinWrapper) {
            pinWrapper.style.height = pinActive()
              ? 'calc(100vh + ' + pinDuration + 'px)'
              : 'auto';
          }
        });
      },
      { passive: true }
    );
  })();
</script>

