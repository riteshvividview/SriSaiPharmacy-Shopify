{%- comment -%}
  Section: Testimonials (light, draggable single-row carousel)
  A finite row of review cards - native drag/swipe/trackpad scroll plus
  working prev/next arrows (same proven interaction as the Featured
  Collection slider elsewhere in this theme), no auto-scroll or looping.
  Dummy reviews ship in the preset; swap them for real ones later via the
  "Review" blocks (each just needs a name, rating, quote, and an optional
  avatar - initials are used as a fallback when no avatar is uploaded).
{%- endcomment -%}

{{ 'https://fonts.googleapis.com/css2?family=Anton&family=Poppins:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap' | stylesheet_tag }}

{%- liquid
  assign section_id = section.id
  assign s = section.settings
  assign reviews = section.blocks
  assign review_count = reviews.size
-%}

<section
  class="tsm"
  id="tsm-{{ section_id }}"
  style="
    --tsm-bg: {{ s.background_color | default: '#FFFFFF' }};
    --tsm-card-bg: {{ s.card_background | default: '#F7F5F0' }};
    --tsm-card-border: {{ s.card_border_color | default: '#ECECEC' }};
    --tsm-text: {{ s.text_color | default: '#141414' }};
    --tsm-muted: {{ s.muted_color | default: '#6B6B6B' }};
    --tsm-accent: {{ s.accent_color | default: '#F58220' }};
    --tsm-eyebrow: {{ s.eyebrow_color | default: '#2E7D32' }};
    --tsm-card-width: {{ s.card_width | default: 340 }}px;
    --tsm-card-gap: {{ s.card_gap | default: 20 }}px;
    --tsm-padding-block: {{ s.padding_block | default: 88 }}px;
  "
>
  <div class="tsm__inner">
    <div class="tsm__header">
      <div class="tsm__header-text">
        {%- if s.eyebrow != blank -%}<p class="tsm__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="tsm__heading">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.subheading != blank -%}<p class="tsm__subheading">{{ s.subheading }}</p>{%- endif -%}
      </div>

      {%- if review_count > 1 -%}
        <div class="tsm__nav">
          <button type="button" class="tsm__arrow tsm__arrow--prev" data-tsm-prev aria-label="Previous reviews">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="tsm__arrow tsm__arrow--next" data-tsm-next aria-label="Next reviews">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if review_count > 0 -%}
    <div class="tsm__track-wrap">
      <div class="tsm__track" data-tsm-track tabindex="0" role="region" aria-label="Customer reviews">
        {%- for block in reviews -%}
          {%- assign rs = block.settings -%}
          {%- assign initial = rs.reviewer_name | slice: 0, 1 -%}
          <div class="tsm__card" data-tsm-card {{ block.shopify_attributes }}>
            <div class="tsm__card-top">
              <span class="tsm__avatar">
                {%- if rs.avatar_image != blank -%}
                  <img
                    src="{{ rs.avatar_image | image_url: width: 96 }}"
                    alt=""
                    width="48"
                    height="48"
                    loading="lazy"
                  >
                {%- else -%}
                  <span class="tsm__avatar-initial">{{ initial | default: '?' }}</span>
                {%- endif -%}
              </span>
              <span class="tsm__identity">
                <span class="tsm__name">{{ rs.reviewer_name | default: 'Happy Customer' }}</span>
                {%- if rs.reviewer_location != blank -%}<span class="tsm__location">{{ rs.reviewer_location }}</span>{%- endif -%}
              </span>
              <svg class="tsm__quote-mark" aria-hidden="true" width="26" height="21" viewBox="0 0 30 24" fill="none"><path d="M12.6 0 8.4 10.8h5.4v13.2H0V12.6L4.8 0zm16.8 0-4.2 10.8h5.4v13.2H16.8V12.6L21.6 0z" fill="currentColor"/></svg>
            </div>

            <div class="tsm__stars" aria-label="{{ rs.rating | default: 5 }} out of 5 stars">
              {%- assign rating = rs.rating | default: 5 -%}
              {%- for i in (1..5) -%}
                <svg width="15" height="15" viewBox="0 0 20 20" fill="none" class="tsm__star{% if i > rating %} tsm__star--empty{% endif %}"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.2 1 5.9L10 15l-5.2 2.8 1-5.9-4.3-4.2 5.9-.8L10 1.5Z" fill="currentColor"/></svg>
              {%- endfor -%}
            </div>

            {%- if rs.review_text != blank -%}<p class="tsm__quote">{{ rs.review_text }}</p>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if s.view_all_text != blank -%}
    <div class="tsm__inner">
      <div class="tsm__view-all-wrap">
        <a href="{{ s.view_all_link | default: '#' }}" class="tsm__view-all">{{ s.view_all_text }}</a>
      </div>
    </div>
  {%- endif -%}
</section>

<style>
  #tsm-{{ section_id }} {
    position: relative;
    background: var(--tsm-bg);
    color: var(--tsm-text);
    padding: var(--tsm-padding-block) 0;
    font-family: 'Poppins', sans-serif;
  }

  #tsm-{{ section_id }} *,
  #tsm-{{ section_id }} *::before,
  #tsm-{{ section_id }} *::after {
    box-sizing: border-box;
  }

  #tsm-{{ section_id }} .tsm__inner {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 32px;
  }

  /* ---- Header ---- */
  #tsm-{{ section_id }} .tsm__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 32px;
  }

  #tsm-{{ section_id }} .tsm__header-text {
    max-width: 640px;
  }

  #tsm-{{ section_id }} .tsm__eyebrow {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--tsm-eyebrow);
    margin: 0 0 10px;
  }

  #tsm-{{ section_id }} .tsm__heading {
    font-family: 'Anton', 'Impact', sans-serif;
    font-weight: 400;
    font-size: clamp(26px, 3.6vw, 40px);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    line-height: 1.15;
    color: var(--tsm-text);
    margin: 0 0 10px;
  }

  #tsm-{{ section_id }} .tsm__subheading {
    font-size: 15px;
    line-height: 1.6;
    color: var(--tsm-muted);
    margin: 0;
  }

  #tsm-{{ section_id }} .tsm__nav {
    display: flex;
    gap: 10px;
    flex-shrink: 0;
  }

  #tsm-{{ section_id }} .tsm__arrow {
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1.5px solid var(--tsm-card-border);
    border-radius: 50%;
    color: var(--tsm-text);
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
    padding: 0;
  }

  #tsm-{{ section_id }} .tsm__arrow:hover,
  #tsm-{{ section_id }} .tsm__arrow:focus-visible {
    background: var(--tsm-eyebrow);
    border-color: var(--tsm-eyebrow);
    color: #fff;
    outline: none;
  }

  #tsm-{{ section_id }} .tsm__arrow[disabled] {
    opacity: 0.35;
    cursor: default;
    pointer-events: none;
  }

  /* ---- Track ---- */
  #tsm-{{ section_id }} .tsm__track-wrap {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 32px;
  }

  #tsm-{{ section_id }} .tsm__track {
    display: flex;
    gap: var(--tsm-card-gap);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
    padding: 4px 4px 16px;
    margin: -4px -4px -16px;
    scrollbar-width: none;
    -ms-overflow-style: none;
    user-select: none;
  }

  #tsm-{{ section_id }} .tsm__track::-webkit-scrollbar {
    display: none;
  }

  #tsm-{{ section_id }} .tsm__track.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
  }

  /* ---- Card ---- */
  #tsm-{{ section_id }} .tsm__card {
    flex: 0 0 var(--tsm-card-width);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    background: var(--tsm-card-bg);
    border: 1px solid var(--tsm-card-border);
    border-radius: 20px;
    padding: 24px;
  }

  #tsm-{{ section_id }} .tsm__card-top {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }

  #tsm-{{ section_id }} .tsm__avatar {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--tsm-accent);
  }

  #tsm-{{ section_id }} .tsm__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }

  #tsm-{{ section_id }} .tsm__avatar-initial {
    color: #fff;
    font-weight: 700;
    font-size: 16px;
    text-transform: uppercase;
  }

  #tsm-{{ section_id }} .tsm__identity {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  #tsm-{{ section_id }} .tsm__name {
    font-weight: 600;
    font-size: 14.5px;
    color: var(--tsm-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  #tsm-{{ section_id }} .tsm__location {
    font-size: 12px;
    color: var(--tsm-muted);
  }

  #tsm-{{ section_id }} .tsm__quote-mark {
    position: absolute;
    top: -4px;
    right: 0;
    color: var(--tsm-accent);
    opacity: 0.25;
  }

  #tsm-{{ section_id }} .tsm__stars {
    display: flex;
    gap: 3px;
    margin-bottom: 12px;
  }

  #tsm-{{ section_id }} .tsm__star {
    color: var(--tsm-accent);
  }

  #tsm-{{ section_id }} .tsm__star--empty {
    color: var(--tsm-card-border);
  }

  #tsm-{{ section_id }} .tsm__quote {
    font-style: italic;
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--tsm-muted);
    margin: 0;
  }

  /* ---- View all ---- */
  #tsm-{{ section_id }} .tsm__view-all-wrap {
    display: flex;
    justify-content: center;
    margin-top: 40px;
  }

  #tsm-{{ section_id }} .tsm__view-all {
    display: inline-block;
    font-weight: 600;
    font-size: 14.5px;
    color: var(--tsm-text);
    text-decoration: none;
    border: 1.5px solid var(--tsm-card-border);
    padding: 13px 32px;
    border-radius: 999px;
    transition: background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
  }

  #tsm-{{ section_id }} .tsm__view-all:hover {
    background: var(--tsm-eyebrow);
    border-color: var(--tsm-eyebrow);
    color: #fff;
    transform: translateY(-2px);
  }

  /* ---- Mobile ---- */
  @media (max-width: 749px) {
    #tsm-{{ section_id }} .tsm__inner,
    #tsm-{{ section_id }} .tsm__track-wrap {
      padding: 0 20px;
    }

    #tsm-{{ section_id }} .tsm__header {
      align-items: center;
    }

    #tsm-{{ section_id }} .tsm__card {
      flex-basis: min(var(--tsm-card-width), 78vw);
      padding: 18px;
    }

    #tsm-{{ section_id }} .tsm__arrow {
      width: 38px;
      height: 38px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #tsm-{{ section_id }} .tsm__track {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  (function () {
    var section = document.getElementById('tsm-{{ section_id }}');
    if (!section) return;

    var track = section.querySelector('[data-tsm-track]');
    var cards = Array.prototype.slice.call(section.querySelectorAll('[data-tsm-card]'));
    var prevBtn = section.querySelector('[data-tsm-prev]');
    var nextBtn = section.querySelector('[data-tsm-next]');

    if (!track || !cards.length) return;

    function stepSize() {
      var cardRect = cards[0].getBoundingClientRect();
      var gap = cards.length > 1 ? cards[1].getBoundingClientRect().left - cardRect.right : 0;
      return cardRect.width + Math.max(gap, 0);
    }

    function updateArrows() {
      if (!prevBtn || !nextBtn) return;
      var maxScroll = track.scrollWidth - track.clientWidth;
      prevBtn.disabled = track.scrollLeft <= 1;
      nextBtn.disabled = track.scrollLeft >= maxScroll - 1;
    }

    var scrollTicking = false;
    track.addEventListener(
      'scroll',
      function () {
        if (!scrollTicking) {
          window.requestAnimationFrame(function () {
            updateArrows();
            scrollTicking = false;
          });
          scrollTicking = true;
        }
      },
      { passive: true }
    );

    window.addEventListener('resize', updateArrows, { passive: true });
    window.addEventListener('load', updateArrows);

    if (prevBtn) {
      prevBtn.addEventListener('click', function () {
        track.scrollBy({ left: -stepSize(), behavior: 'smooth' });
      });
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', function () {
        track.scrollBy({ left: stepSize(), behavior: 'smooth' });
      });
    }

    /* ---- Mouse drag-to-scroll (touch/trackpad already work natively) ---- */
    var isDragging = false;
    var dragMoved = false;
    var startX = 0;
    var startScrollLeft = 0;

    track.addEventListener('pointerdown', function (e) {
      if (e.pointerType !== 'mouse') return;
      isDragging = true;
      dragMoved = false;
      startX = e.clientX;
      startScrollLeft = track.scrollLeft;
      track.classList.add('is-dragging');
    });

    window.addEventListener('pointermove', function (e) {
      if (!isDragging) return;
      var dx = e.clientX - startX;
      if (Math.abs(dx) > 4) dragMoved = true;
      track.scrollLeft = startScrollLeft - dx;
    });

    function endDrag() {
      if (!isDragging) return;
      isDragging = false;
      track.classList.remove('is-dragging');
    }

    window.addEventListener('pointerup', endDrag);
    window.addEventListener('pointercancel', endDrag);

    track.addEventListener(
      'click',
      function (e) {
        if (dragMoved) {
          e.preventDefault();
          e.stopPropagation();
        }
        dragMoved = false;
      },
      true
    );

    updateArrows();
  })();
</script>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "shopify-section--testimonials",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Loved By Our Customers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real Stories, Real Relief" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Thousands of families trust us for genuine medicines and caring service — here's what a few of them had to say." },

    { "type": "header", "content": "View all button" },
    { "type": "text", "id": "view_all_text", "label": "Button text", "default": "View all reviews" },
    { "type": "url", "id": "view_all_link", "label": "Button link" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "card_width", "label": "Card width", "min": 240, "max": 440, "step": 10, "unit": "px", "default": 340 },
    { "type": "range", "id": "card_gap", "label": "Gap between cards", "min": 8, "max": 40, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "padding_block", "label": "Vertical padding", "min": 20, "max": 160, "step": 4, "unit": "px", "default": 88 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#F7F5F0" },
    { "type": "color", "id": "card_border_color", "label": "Card / button border", "default": "#ECECEC" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#141414" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#6B6B6B" },
    { "type": "color", "id": "accent_color", "label": "Accent (stars, quote mark, avatar)", "default": "#F58220" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow / hover color", "default": "#2E7D32" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "avatar_image", "label": "Avatar (optional)", "info": "Falls back to a colored initial if left blank" },
        { "type": "text", "id": "reviewer_name", "label": "Name", "default": "Happy Customer" },
        { "type": "text", "id": "reviewer_location", "label": "Location", "default": "Chennai, TN" },
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "review_text", "label": "Review text", "default": "Great service and genuine products every time." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "review", "settings": { "reviewer_name": "Priya Ramesh", "reviewer_location": "Chennai, TN", "rating": 5, "review_text": "Ordered my mother's diabetes medicines here for over a year now. Always genuine, always on time. Never had a single issue." } },
        { "type": "review", "settings": { "reviewer_name": "Arun Kumar", "reviewer_location": "Coimbatore, TN", "rating": 5, "review_text": "The immunity combo pack actually works — fewer sick days this monsoon for the whole family. Fast delivery too." } },
        { "type": "review", "settings": { "reviewer_name": "Meena Sundaram", "reviewer_location": "Madurai, TN", "rating": 4, "review_text": "Love that they have a whole section for women's health. Found exactly what my doctor recommended in two minutes." } },
        { "type": "review", "settings": { "reviewer_name": "Karthik Raja", "reviewer_location": "Salem, TN", "rating": 5, "review_text": "Customer support actually picks up the phone and knows what they're talking about. Rare these days." } },
        { "type": "review", "settings": { "reviewer_name": "Divya Prakash", "reviewer_location": "Trichy, TN", "rating": 5, "review_text": "The pain relief balm from the joint care range is now a permanent fixture in our house. Ordering my third bottle." } },
        { "type": "review", "settings": { "reviewer_name": "Suresh Babu", "reviewer_location": "Erode, TN", "rating": 4, "review_text": "Clean website, easy checkout, and the packaging keeps everything intact. Switched from my old pharmacy for good." } },
        { "type": "review", "settings": { "reviewer_name": "Lakshmi Narayanan", "reviewer_location": "Vellore, TN", "rating": 5, "review_text": "Their digestive care combo sorted out my acidity issues within a week. Wish I'd found them sooner." } },
        { "type": "review", "settings": { "reviewer_name": "Vikram Anand", "reviewer_location": "Chennai, TN", "rating": 5, "review_text": "Been buying my supplements here for months. Prices are fair and everything ships fast, even during festival season." } }
      ]
    }
  ]
}
{% endschema %}
