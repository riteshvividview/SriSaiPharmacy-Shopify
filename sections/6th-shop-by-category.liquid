{%- comment -%}
  Section: Shop By Category (tabbed product showcase + phone mockup)
  Left: a small "shop on the go" phone-mockup collage - up to 2 phones,
  each showing a merchant-uploaded portrait video (native Shopify video
  picker) or a static portrait image as a fallback. Each phone has its
  own gentle floating bob + scroll-linked parallax drift (one JS layer)
  and tilts toward the cursor (a separate JS layer) - kept on two
  different nested wrappers, plus a third inner wrapper carrying the
  fixed "jaunty angle" rotation in plain CSS, so none of the three ever
  fight over the same element's `transform`.
  Right: the original tabbed product grid (tabs: Shop by Concern /
  Men's Health / Women's Health / Care & Wellness / Health Packs),
  each tab's own full product grid, sliding pill indicator, staggered
  card entrance - unchanged in behavior, restyled to match.
  Blocks: "Category Tab" defines a tab; any number of "Product" blocks
  placed directly after it belong to that tab (same grouping pattern
  used by the header's mega-menu dropdowns/tiles elsewhere in this
  theme).
{%- endcomment -%}

{{ 'https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@400;500;600;700;800&display=swap' | stylesheet_tag }}

{%- liquid
  assign section_id = section.id
  assign s = section.settings
  assign accent_color = s.accent_color | default: '#2E7D32'
  assign cta_color = s.cta_color | default: '#F58220'
  assign has_phone_1 = false
  assign has_phone_2 = false
  if s.phone_1_video != blank or s.phone_1_image != blank
    assign has_phone_1 = true
  endif
  if s.phone_2_video != blank or s.phone_2_image != blank
    assign has_phone_2 = true
  endif
-%}

<section
  class="stc{% if s.sync_scroll_bg %} stc--transparent-bg{% endif %}"
  id="stc-{{ section_id }}"
  {% if s.sync_scroll_bg %}data-scroll-bg-zone="{{ s.background_color | default: '#FFFFFF' }}"{% endif %}
  style="
    --stc-bg: {{ s.background_color | default: '#FFFFFF' }};
    --stc-card-bg: {{ s.card_color | default: '#F2F6F1' }};
    --stc-text: {{ s.text_color | default: '#141414' }};
    --stc-muted: {{ s.muted_color | default: '#6B6B6B' }};
    --stc-accent: {{ accent_color }};
    --stc-cta: {{ cta_color }};
    --stc-border: {{ s.border_color | default: '#ECECEC' }};
    --stc-columns: {{ s.columns_desktop | default: 4 }};
    --stc-padding-block: {{ s.padding_block | default: 72 }}px;
    --stc-phone-frame: {{ s.phone_frame_color | default: '#141414' }};
  "
>
  <div class="stc__inner">
    {%- if s.eyebrow != blank or s.heading != blank or s.subheading != blank -%}
      <div class="stc__header" data-reveal>
        {%- if s.eyebrow != blank -%}<p class="stc__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="stc__heading">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.subheading != blank -%}<p class="stc__subheading">{{ s.subheading }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="stc__layout{% unless s.show_phone_showcase %} stc__layout--no-phone{% endunless %}">
      {%- if s.show_phone_showcase -%}
        <div class="stc__showcase" data-stc-showcase>
          <div class="stc__phone-stage">
            <span class="stc__stage-ring stc__stage-ring--1" aria-hidden="true"></span>
            <span class="stc__stage-ring stc__stage-ring--2" aria-hidden="true"></span>

            {%- if has_phone_2 -%}
              <div class="stc__phone-float stc__phone-float--secondary" data-stc-phone-float="1">
                <div class="stc__phone-tilt" data-stc-phone-tilt>
                  <div class="stc__phone stc__phone--secondary">
                    <span class="stc__phone-notch" aria-hidden="true"></span>
                    <span class="stc__phone-screen">
                      {%- if s.phone_2_video != blank -%}
                        {{ s.phone_2_video | video_tag: image_size: '400x', autoplay: true, loop: true, muted: true, controls: false, class: 'stc__phone-media' }}
                      {%- else -%}
                        <img class="stc__phone-media" src="{{ s.phone_2_image | image_url: width: 400 }}" alt="" width="{{ s.phone_2_image.width }}" height="{{ s.phone_2_image.height }}" loading="lazy">
                      {%- endif -%}
                      <span class="stc__phone-shine" aria-hidden="true"></span>
                    </span>
                  </div>
                  <span class="stc__phone-reflection" aria-hidden="true"></span>
                </div>
              </div>
            {%- endif -%}

            <div class="stc__phone-float stc__phone-float--primary" data-stc-phone-float="0">
              {%- if s.phone_caption != blank -%}
                <span class="stc__phone-watermark" data-stc-watermark aria-hidden="true">{{ s.phone_caption }}</span>
              {%- endif -%}
              <div class="stc__phone-tilt" data-stc-phone-tilt>
                <div class="stc__phone stc__phone--primary" data-stc-phone-body>
                  <span class="stc__phone-notch" aria-hidden="true"></span>
                  <span class="stc__phone-screen">
                    {%- if s.phone_1_video != blank -%}
                      {{ s.phone_1_video | video_tag: image_size: '500x', autoplay: true, loop: true, muted: true, controls: false, class: 'stc__phone-media' }}
                    {%- elsif has_phone_1 -%}
                      <img class="stc__phone-media" src="{{ s.phone_1_image | image_url: width: 500 }}" alt="" width="{{ s.phone_1_image.width }}" height="{{ s.phone_1_image.height }}" loading="lazy">
                    {%- else -%}
                      <span class="stc__phone-placeholder" aria-hidden="true">
                        <svg width="34" height="34" viewBox="0 0 24 24" fill="none"><rect x="6" y="3" width="12" height="18" rx="2.5" stroke="currentColor" stroke-width="1.3"/><path d="M10 18h4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
                      </span>
                    {%- endif -%}
                    <span class="stc__phone-shine" aria-hidden="true"></span>
                  </span>
                </div>
                <span class="stc__phone-reflection" aria-hidden="true"></span>
              </div>
            </div>

            {%- if s.show_showcase_chips -%}
              <div class="stc__chip stc__chip--1" data-stc-float-chip="0">
                <span class="stc__chip-icon" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                {{ s.showcase_chip_1_text | default: '100% Genuine' }}
              </div>
              <div class="stc__chip stc__chip--2" data-stc-float-chip="1">
                <span class="stc__chip-icon" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M3 7h11v9H3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M14 10h3.5L21 13.5V16h-7z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="7" cy="18" r="1.6" stroke="currentColor" stroke-width="1.4"/><circle cx="17.5" cy="18" r="1.6" stroke="currentColor" stroke-width="1.4"/></svg>
                </span>
                {{ s.showcase_chip_2_text | default: 'Free Delivery' }}
              </div>
              <div class="stc__chip stc__chip--3" data-stc-float-chip="2">
                <span class="stc__chip-stars" aria-hidden="true">★★★★★</span>
                {{ s.showcase_chip_3_text | default: '4.8 (2,300+ reviews)' }}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      <div class="stc__content">
        <div class="stc__tabbar-wrap">
          <div class="stc__tabbar" role="tablist" aria-label="Shop by category" data-stc-tabs>
            <span class="stc__tab-indicator" data-stc-indicator aria-hidden="true"></span>
            {%- for block in section.blocks -%}
              {%- if block.type == 'tab' -%}
                <button
                  type="button"
                  class="stc__tab{% if forloop.first %} is-active{% endif %}"
                  role="tab"
                  id="stc-tab-{{ section_id }}-{{ forloop.index0 }}"
                  aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                  aria-controls="stc-panel-{{ section_id }}-{{ forloop.index0 }}"
                  tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                  data-stc-tab
                  data-index="{{ forloop.index0 }}"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.label }}
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>

        <div class="stc__panels" data-stc-panels>
          {%- assign tab_index = -1 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'tab' -%}
              {%- assign tab_index = tab_index | plus: 1 -%}
              {%- assign tb = block.settings -%}
              <div
                class="stc__panel{% if tab_index == 0 %} is-active{% endif %}"
                role="tabpanel"
                id="stc-panel-{{ section_id }}-{{ tab_index }}"
                aria-labelledby="stc-tab-{{ section_id }}-{{ tab_index }}"
                data-stc-panel
                data-index="{{ tab_index }}"
                {% unless tab_index == 0 %}hidden{% endunless %}
              >
                <div class="stc__grid-wrap">
                  <button type="button" class="stc__arrow stc__arrow--prev" data-stc-arrow="prev" aria-label="Scroll left">
                    <svg width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M12.5 15 7 10l5.5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </button>

                  <div class="stc__grid" data-stc-grid>
                    {%- assign products_offset = forloop.index0 | plus: 1 -%}
                    {%- assign card_i = 0 -%}
                    {%- for product_block in section.blocks offset: products_offset -%}
                      {%- if product_block.type == 'product' -%}
                        {%- assign pb = product_block.settings -%}
                        <a
                          href="{{ pb.link | default: '#' }}"
                          class="stc__card"
                          data-stc-card
                          style="--stc-card-delay: {{ card_i | times: 60 }}ms;"
                          {{ product_block.shopify_attributes }}
                        >
                          <span class="stc__card-inner">
                            {%- if pb.enable_badge and pb.badge_text != blank -%}
                              <span class="stc__badge">{{ pb.badge_text }}</span>
                            {%- endif -%}
                            <span class="stc__card-image">
                              {%- if pb.image != blank -%}
                                <img
                                  src="{{ pb.image | image_url: width: 500 }}"
                                  srcset="{{ pb.image | image_url: width: 250 }} 250w, {{ pb.image | image_url: width: 500 }} 500w"
                                  alt="{{ pb.alt_text | default: pb.title | escape }}"
                                  width="{{ pb.image.width }}"
                                  height="{{ pb.image.height }}"
                                  loading="lazy"
                                >
                              {%- else -%}
                                <span class="stc__card-placeholder" aria-hidden="true">
                                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none"><rect x="7" y="2.5" width="10" height="19" rx="5" stroke="currentColor" stroke-width="1.4"/><path d="M7 12h10" stroke="currentColor" stroke-width="1.4"/></svg>
                                </span>
                              {%- endif -%}
                              <span class="stc__card-quick-add" aria-hidden="true">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M3 4h2l2.4 12.2a1.5 1.5 0 0 0 1.5 1.3h8.6a1.5 1.5 0 0 0 1.47-1.2L21 7.5H6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9.5" cy="20" r="1.4" fill="currentColor"/><circle cx="17" cy="20" r="1.4" fill="currentColor"/></svg>
                              </span>
                            </span>
                            <span class="stc__card-body">
                              {%- if pb.vendor != blank -%}<span class="stc__card-vendor">{{ pb.vendor }}</span>{%- endif -%}
                              <span class="stc__card-title">{{ pb.title }}</span>
                              <span class="stc__card-price">
                                <span class="stc__card-price-now">{{ pb.price }}</span>
                                {%- if pb.compare_at_price != blank -%}
                                  <span class="stc__card-price-compare">{{ pb.compare_at_price }}</span>
                                {%- endif -%}
                              </span>
                            </span>
                          </span>
                        </a>
                        {%- assign card_i = card_i | plus: 1 -%}
                      {%- else -%}
                        {%- break -%}
                      {%- endif -%}
                    {%- endfor -%}
                  </div>

                  <button type="button" class="stc__arrow stc__arrow--next" data-stc-arrow="next" aria-label="Scroll right">
                    <svg width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M7.5 15 13 10 7.5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </button>
                </div>

                {%- if tb.view_all_link != blank and tb.view_all_text != blank -%}
                  <div class="stc__view-all-wrap">
                    <a href="{{ tb.view_all_link }}" class="stc__view-all">
                      {{ tb.view_all_text }}
                      <svg aria-hidden="true" width="15" height="15" viewBox="0 0 20 20" fill="none"><path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </a>
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #stc-{{ section_id }} {
    position: relative;
    background: var(--stc-bg);
    color: var(--stc-text);
    padding: var(--stc-padding-block) 0;
    font-family: 'Poppins', sans-serif;
    overflow-x: clip;
  }

  @property --stc-glow-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  #stc-{{ section_id }}.stc--transparent-bg {
    background: transparent;
  }

  #stc-{{ section_id }} *,
  #stc-{{ section_id }} *::before,
  #stc-{{ section_id }} *::after {
    box-sizing: border-box;
  }

  #stc-{{ section_id }} a {
    text-decoration: none;
    color: inherit;
  }

  #stc-{{ section_id }} .stc__inner {
    position: relative;
    z-index: 1;
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 32px;
  }

  #stc-{{ section_id }} [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 22px, 0);
    transition: opacity 0.7s cubic-bezier(0.22, 0.61, 0.36, 1), transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  #stc-{{ section_id }} [data-reveal].is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  /* ---- Header ---- */
  #stc-{{ section_id }} .stc__header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 48px;
  }

  #stc-{{ section_id }} .stc__eyebrow {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--stc-cta);
    margin: 0 0 10px;
  }

  #stc-{{ section_id }} .stc__heading {
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-weight: 400;
    font-size: clamp(26px, 3.5vw, 38px);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    line-height: 1.15;
    color: var(--stc-text);
    margin: 0 0 12px;
  }

  #stc-{{ section_id }} .stc__subheading {
    font-size: 15px;
    line-height: 1.6;
    color: var(--stc-muted);
    margin: 0;
  }

  /* ---- Two-column layout ---- */
  #stc-{{ section_id }} .stc__layout {
    display: grid;
    grid-template-columns: minmax(300px, 420px) minmax(0, 1fr);
    gap: 40px;
    align-items: start;
  }

  #stc-{{ section_id }} .stc__layout--no-phone {
    grid-template-columns: 1fr;
  }

  /* ---- Phone showcase ---- */
  #stc-{{ section_id }} .stc__showcase {
    position: relative;
    padding: 30px 0 20px;
    margin-top: -26px;
  }

  #stc-{{ section_id }} .stc__phone-stage {
    position: relative;
    z-index: 1;
    min-height: 500px;
    padding: 30px 10px 60px 40px;
    perspective: 1400px;
  }

  #stc-{{ section_id }} .stc__stage-ring {
    position: absolute;
    top: 46%;
    left: 46%;
    border: 1.5px dashed color-mix(in srgb, var(--stc-accent) 55%, transparent);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 0;
  }

  #stc-{{ section_id }} .stc__stage-ring--1 {
    width: 320px;
    height: 320px;
    animation: stc-ring-spin 26s linear infinite;
  }

  #stc-{{ section_id }} .stc__stage-ring--2 {
    width: 430px;
    height: 430px;
    border-color: color-mix(in srgb, var(--stc-cta) 45%, transparent);
    animation: stc-ring-spin 34s linear infinite reverse;
  }

  @keyframes stc-ring-spin {
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }

  #stc-{{ section_id }} .stc__phone-float {
    position: absolute;
    will-change: transform;
  }

  #stc-{{ section_id }} .stc__phone-float--primary {
    left: 90px;
    top: 10px;
    z-index: 2;
  }

  #stc-{{ section_id }} .stc__phone-float--secondary {
    left: 8px;
    top: 90px;
    z-index: 1;
    opacity: 0.9;
  }

  #stc-{{ section_id }} .stc__phone-tilt {
    position: relative;
    will-change: transform;
  }

  #stc-{{ section_id }} .stc__phone {
    position: relative;
    width: 240px;
    aspect-ratio: 9 / 19.4;
    border-radius: 40px;
    background: linear-gradient(160deg, color-mix(in srgb, var(--stc-phone-frame) 92%, #fff) 0%, var(--stc-phone-frame) 60%);
    padding: 12px;
    box-shadow:
      0 16px 24px rgba(0, 0, 0, 0.16),
      0 4px 10px rgba(0, 0, 0, 0.12),
      0 0 0 1px rgba(255, 255, 255, 0.08) inset;
    transform: rotate(-5deg);
  }

  #stc-{{ section_id }} .stc__phone--secondary {
    width: 184px;
    transform: rotate(9deg);
  }

  #stc-{{ section_id }} .stc__phone::before,
  #stc-{{ section_id }} .stc__phone::after {
    content: '';
    position: absolute;
    background: rgba(255, 255, 255, 0.16);
    border-radius: 2px;
  }

  #stc-{{ section_id }} .stc__phone::before {
    right: -2px;
    top: 108px;
    width: 3px;
    height: 52px;
  }

  #stc-{{ section_id }} .stc__phone::after {
    left: -2px;
    top: 86px;
    width: 3px;
    height: 34px;
  }

  #stc-{{ section_id }} .stc__phone-notch {
    position: absolute;
    top: 12px;
    left: 50%;
    transform: translateX(-50%);
    width: 72px;
    height: 20px;
    border-radius: 11px;
    background: var(--stc-phone-frame);
    z-index: 2;
  }

  #stc-{{ section_id }} .stc__phone-screen {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border-radius: 29px;
    overflow: hidden;
    background: linear-gradient(160deg, #1a1a1a, #0c0c0c);
  }

  #stc-{{ section_id }} .stc__phone-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #stc-{{ section_id }} .stc__phone-placeholder {
    color: rgba(255, 255, 255, 0.35);
  }

  #stc-{{ section_id }} .stc__phone-shine {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: linear-gradient(100deg, transparent 42%, rgba(255, 255, 255, 0.12) 50%, transparent 58%);
    background-size: 260% 100%;
    background-position: -80% 0;
    mix-blend-mode: screen;
    animation: stc-phone-shine 6.5s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes stc-phone-shine {
    0%, 45% { background-position: -80% 0; }
    70%, 100% { background-position: 180% 0; }
  }

  #stc-{{ section_id }} .stc__phone-reflection {
    position: absolute;
    left: 50%;
    bottom: -20px;
    width: 68%;
    height: 18px;
    transform: translateX(-50%);
    background: radial-gradient(ellipse, rgba(20, 20, 20, 0.14), transparent 78%);
    filter: blur(8px);
    z-index: 0;
    pointer-events: none;
  }

  #stc-{{ section_id }} .stc__chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 14px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--stc-bg) 55%, #fff 45%);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 12px 24px rgba(20, 20, 20, 0.14);
    font-size: 12px;
    font-weight: 600;
    color: var(--stc-text);
    white-space: nowrap;
    z-index: 3;
    will-change: transform;
  }

  #stc-{{ section_id }} .stc__chip-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--stc-accent);
    color: #fff;
    flex-shrink: 0;
  }

  #stc-{{ section_id }} .stc__chip-stars {
    color: var(--stc-cta);
    font-size: 11px;
    letter-spacing: 1px;
  }

  #stc-{{ section_id }} .stc__chip--1 {
    top: 6%;
    right: 4%;
  }

  #stc-{{ section_id }} .stc__chip--2 {
    top: 46%;
    left: -2%;
  }

  #stc-{{ section_id }} .stc__chip--3 {
    bottom: 6%;
    right: 8%;
  }

  #stc-{{ section_id }} .stc__phone-watermark {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    margin: 0;
    white-space: nowrap;
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-weight: 400;
    font-size: 60px;
    letter-spacing: 2px;
    text-transform: uppercase;
    line-height: 1;
    color: #6b6b6b;
    opacity: 0.14;
    pointer-events: none;
    user-select: none;
  }

  /* ---- Tab bar ---- */
  #stc-{{ section_id }} .stc__tabbar-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    margin-bottom: 36px;
  }

