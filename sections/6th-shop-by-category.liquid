<script>
  (function () {
    var section = document.getElementById('stc-{{ section_id }}');
    if (!section) return;

    var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ---- Scroll reveal ---- */
    var revealTargets = Array.prototype.slice.call(section.querySelectorAll('[data-reveal]'));
    if (revealTargets.length) {
      if ('IntersectionObserver' in window) {
        var revealObserver = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                revealObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 }
        );
        revealTargets.forEach(function (el) { revealObserver.observe(el); });
      } else {
        revealTargets.forEach(function (el) { el.classList.add('is-visible'); });
      }
    }

    /* ---- Tabs (unchanged behavior) ---- */
    var tabs = Array.prototype.slice.call(section.querySelectorAll('[data-stc-tab]'));
    var panels = Array.prototype.slice.call(section.querySelectorAll('[data-stc-panel]'));
    var indicator = section.querySelector('[data-stc-indicator]');
    var tabbar = section.querySelector('[data-stc-tabs]');

    if (tabs.length && panels.length) {
      function moveIndicator(tab) {
        if (!indicator || !tab) return;
        indicator.style.width = tab.offsetWidth + 'px';
        indicator.style.transform = 'translateX(' + tab.offsetLeft + 'px)';
      }

      function replayEntrance(panel) {
        var cards = panel.querySelectorAll('[data-stc-card]');
        panel.style.animation = 'none';
        cards.forEach(function (card) {
          card.classList.remove('is-settled');
          card.style.animation = 'none';
        });
        panel.offsetHeight; /* force reflow so the animation can restart */
        panel.style.animation = '';
        cards.forEach(function (card) {
          card.style.animation = '';
        });
      }

      function activateTab(index) {
        tabs.forEach(function (tab) {
          var isActive = tab.getAttribute('data-index') === String(index);
          tab.classList.toggle('is-active', isActive);
          tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
          tab.setAttribute('tabindex', isActive ? '0' : '-1');
          if (isActive) moveIndicator(tab);
        });

        panels.forEach(function (panel) {
          var isActive = panel.getAttribute('data-index') === String(index);
          panel.hidden = !isActive;
          if (isActive) {
            replayEntrance(panel);
            window.requestAnimationFrame(function () {
              section.dispatchEvent(new CustomEvent('stc:panel-shown', { detail: { panel: panel } }));
            });
          }
        });
      }

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          activateTab(tab.getAttribute('data-index'));
        });
      });

      if (tabbar) {
        tabbar.addEventListener('keydown', function (e) {
          var currentIndex = tabs.findIndex(function (t) { return t.classList.contains('is-active'); });
          var nextIndex = null;
          if (e.key === 'ArrowRight') nextIndex = (currentIndex + 1) % tabs.length;
          else if (e.key === 'ArrowLeft') nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
          else if (e.key === 'Home') nextIndex = 0;
          else if (e.key === 'End') nextIndex = tabs.length - 1;
          if (nextIndex !== null) {
            e.preventDefault();
            tabs[nextIndex].focus();
            activateTab(tabs[nextIndex].getAttribute('data-index'));
          }
        });
      }

      var activeTab = tabs.filter(function (t) { return t.classList.contains('is-active'); })[0] || tabs[0];
      moveIndicator(activeTab);

      var resizeRaf = null;
      window.addEventListener(
        'resize',
        function () {
          if (resizeRaf) window.cancelAnimationFrame(resizeRaf);
          resizeRaf = window.requestAnimationFrame(function () {
            var current = tabs.filter(function (t) { return t.classList.contains('is-active'); })[0];
            moveIndicator(current);
          });
        },
        { passive: true }
      );
    }

    /* ---- Phone showcase: float + scroll parallax + cursor tilt ----
       Three separate nested wrappers, one concern each, so none of
       them ever fight over the same element's `transform`:
       .stc__phone-float (JS: bob + scroll parallax on translateY)
       -> .stc__phone-tilt (JS: cursor-driven rotateX/rotateY)
       -> .stc__phone (CSS only: the fixed "jaunty angle" rotation). */
    var stage = section.querySelector('[data-stc-showcase]');

    /* ---- Watermark: size it to the phone's own rendered height and
       hug its left edge. Lives inside the same float wrapper as the
       phone, so it inherits that wrapper's bob/parallax transform and
       moves together with the phone automatically - this script only
       ever writes the watermark's own `transform` (the rotation),
       never the wrapper's. */
    var watermark = section.querySelector('[data-stc-watermark]');
    var watermarkFloat = watermark ? watermark.closest('.stc__phone-float') : null;
    var phoneBody = watermarkFloat ? watermarkFloat.querySelector('[data-stc-phone-body]') : null;
    if (watermark && phoneBody) {
      var sizeWatermarkRaf = null;
      function sizeWatermark() {
        var phoneHeight = phoneBody.getBoundingClientRect().height;
        if (!phoneHeight) return;
        var desiredSpan = phoneHeight * 0.68;
        var refSize = 100;
        watermark.style.transform = 'none';
        watermark.style.left = '0px';
        watermark.style.top = '0px';
        watermark.style.fontSize = refSize + 'px';
        var measuredWidth = watermark.getBoundingClientRect().width;
        if (!measuredWidth) return;
        var newSize = refSize * (desiredSpan / measuredWidth);
        watermark.style.fontSize = newSize + 'px';
        var rect = watermark.getBoundingClientRect();
        /* After rotating, the box's screen-space thickness against the
           phone is rect.height (its line-height), not rect.width - so
           the gap has to be measured from that, not a flat offset. */
        var gap = 4;
        var targetX = -gap - rect.height / 2;
        var targetY = phoneHeight / 2;
        watermark.style.left = (targetX - rect.width / 2) + 'px';
        watermark.style.top = (targetY - rect.height / 2) + 'px';
        /* -95deg instead of a plain -90 so the text's edge lines up
           flush with the phone body, which is itself tilted -5deg. */
        watermark.style.transform = 'rotate(-95deg)';
      }
      sizeWatermark();
      window.addEventListener('resize', function () {
        if (sizeWatermarkRaf) window.cancelAnimationFrame(sizeWatermarkRaf);
        sizeWatermarkRaf = window.requestAnimationFrame(sizeWatermark);
      }, { passive: true });
    }

    if (stage && !prefersReducedMotion) {
      var floats = Array.prototype.slice.call(section.querySelectorAll('[data-stc-phone-float]'));
      var tilts = Array.prototype.slice.call(section.querySelectorAll('[data-stc-phone-tilt]'));

      if (floats.length) {
        var rafId = null;
        var startTime = null;

        function tick(now) {
          if (startTime === null) startTime = now;
          var t = (now - startTime) / 1000;
          var rect = stage.getBoundingClientRect();
          var vh = window.innerHeight || document.documentElement.clientHeight || 1;
          var progress = (vh - rect.top) / (vh + rect.height);
          progress = Math.max(0, Math.min(1, progress));

          floats.forEach(function (el, i) {
            var amp = i === 0 ? 8 : 12;
            var speed = i === 0 ? 3.1 : 3.7;
            var parAmount = i === 0 ? 26 : -34;
            var floatY = Math.sin((t / speed) * Math.PI * 2 + i * 2) * amp;
            var parY = (progress - 0.5) * parAmount;
            el.style.transform = 'translate3d(0, ' + (floatY + parY).toFixed(1) + 'px, 0)';
          });

          rafId = window.requestAnimationFrame(tick);
        }

        var visibilityObserver = null;
        if ('IntersectionObserver' in window) {
          visibilityObserver = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  if (rafId === null) rafId = window.requestAnimationFrame(tick);
                } else if (rafId !== null) {
                  window.cancelAnimationFrame(rafId);
                  rafId = null;
                  startTime = null;
                }
              });
            },
            { rootMargin: '200px 0px 200px 0px' }
          );
          visibilityObserver.observe(stage);
        } else {
          rafId = window.requestAnimationFrame(tick);
        }
      }

      if (tilts.length) {
        var tiltTicking = false;
        var targetRX = 0;
        var targetRY = 0;
        var curRX = 0;
        var curRY = 0;

        function renderTilt() {
          curRX += (targetRX - curRX) * 0.12;
          curRY += (targetRY - curRY) * 0.12;
          tilts.forEach(function (el) {
            el.style.transform = 'perspective(900px) rotateX(' + curRX.toFixed(2) + 'deg) rotateY(' + curRY.toFixed(2) + 'deg)';
          });
          if (Math.abs(targetRX - curRX) > 0.05 || Math.abs(targetRY - curRY) > 0.05) {
            window.requestAnimationFrame(renderTilt);
          } else {
            tiltTicking = false;
          }
        }

        function startTiltRender() {
          if (!tiltTicking) {
            tiltTicking = true;
            window.requestAnimationFrame(renderTilt);
          }
        }

        stage.addEventListener('mousemove', function (e) {
          var rect = stage.getBoundingClientRect();
          var relX = (e.clientX - rect.left) / rect.width - 0.5;
          var relY = (e.clientY - rect.top) / rect.height - 0.5;
          targetRX = relY * -14;
          targetRY = relX * 14;
          startTiltRender();
        });

        stage.addEventListener('mouseleave', function () {
          targetRX = 0;
          targetRY = 0;
          startTiltRender();
        });
      }

      /* ---- Floating glass chips: independent bob, own element, own transform ---- */
      var chips = Array.prototype.slice.call(section.querySelectorAll('[data-stc-float-chip]'));
      if (chips.length) {
        var chipStart = null;
        function chipTick(now) {
          if (chipStart === null) chipStart = now;
          var t = (now - chipStart) / 1000;
          chips.forEach(function (chip, i) {
            var amp = 6 + i * 2;
            var speed = 2.6 + i * 0.5;
            var y = Math.sin((t / speed) * Math.PI * 2 + i) * amp;
            chip.style.transform = 'translate3d(0, ' + y.toFixed(1) + 'px, 0)';
          });
          window.requestAnimationFrame(chipTick);
        }
        window.requestAnimationFrame(chipTick);
      }
    }

    /* ---- Product cards: lock in the resting state after the entrance
       animation finishes, so the CSS-only hover lift (.is-settled:hover)
       becomes the sole owner of `transform` from then on - no JS
       tracks the cursor for cards any more. */
    var allCards = Array.prototype.slice.call(section.querySelectorAll('[data-stc-card]'));
    allCards.forEach(function (card) {
      card.addEventListener('animationend', function () {
        card.classList.add('is-settled');
        card.style.animation = 'none';
      });
    });

    /* ---- Product row arrows: scroll the grid by roughly one card width ---- */
    var grids = Array.prototype.slice.call(section.querySelectorAll('[data-stc-grid]'));
    grids.forEach(function (grid) {
      var wrap = grid.closest('.stc__grid-wrap');
      if (!wrap) return;
      var prevBtn = wrap.querySelector('[data-stc-arrow="prev"]');
      var nextBtn = wrap.querySelector('[data-stc-arrow="next"]');

      function updateArrows() {
        var maxScroll = grid.scrollWidth - grid.clientWidth;
        if (prevBtn) prevBtn.disabled = grid.scrollLeft <= 4;
        if (nextBtn) nextBtn.disabled = grid.scrollLeft >= maxScroll - 4;
        if (wrap) wrap.classList.toggle('is-not-scrollable', maxScroll <= 4);
      }

      function scrollByCard(direction) {
        var firstCard = grid.querySelector('[data-stc-card]');
        var step = firstCard ? firstCard.getBoundingClientRect().width + 22 : grid.clientWidth * 0.8;
        grid.scrollBy({ left: direction * step, behavior: 'smooth' });
      }

      if (prevBtn) prevBtn.addEventListener('click', function () { scrollByCard(-1); });
      if (nextBtn) nextBtn.addEventListener('click', function () { scrollByCard(1); });
      grid.addEventListener('scroll', updateArrows, { passive: true });
      window.addEventListener('resize', updateArrows, { passive: true });
      section.addEventListener('stc:panel-shown', function (e) {
        if (e.detail && e.detail.panel && e.detail.panel.contains(grid)) updateArrows();
      });
      updateArrows();
    });
  })();
</script>

