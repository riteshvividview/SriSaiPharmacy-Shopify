{
  "name": "Product - Main",
  "settings": [
    { "type": "header", "content": "Content" },
    {
      "type": "select",
      "id": "eyebrow_source",
      "label": "Eyebrow text",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "vendor", "label": "Vendor" },
        { "value": "type", "label": "Product type" }
      ],
      "default": "vendor"
    },
    { "type": "textarea", "id": "short_description", "label": "Short description", "info": "Optional line shown below the price, above the buttons." },
    { "type": "checkbox", "id": "show_sku", "label": "Show SKU", "default": true },
    { "type": "checkbox", "id": "show_availability", "label": "Show stock status", "default": true },
    { "type": "text", "id": "in_stock_text", "label": "In-stock text", "default": "In stock, ready to ship" },
    { "type": "text", "id": "out_of_stock_text", "label": "Out-of-stock text", "default": "Currently out of stock" },

    { "type": "header", "content": "Gallery" },
    { "type": "checkbox", "id": "enable_sticky_gallery", "label": "Keep gallery pinned while info scrolls (desktop only)", "default": true },
    { "type": "range", "id": "thumbnail_columns", "label": "Thumbnails per row", "min": 3, "max": 6, "step": 1, "default": 5 },

    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "add_to_cart_text", "label": "Add to cart text", "default": "Add to Cart" },
    { "type": "text", "id": "sold_out_text", "label": "Sold out text", "default": "Sold Out" },
    { "type": "checkbox", "id": "show_buy_now", "label": "Show Buy It Now button", "default": true },
    { "type": "text", "id": "buy_now_text", "label": "Buy Now text", "default": "Buy It Now" },

    { "type": "header", "content": "Trust row" },
    { "type": "checkbox", "id": "show_trust_row", "label": "Show trust row", "default": true },
    { "type": "text", "id": "trust_1", "label": "Item 1", "default": "Licensed Pharmacy" },
    { "type": "text", "id": "trust_2", "label": "Item 2", "default": "100% Genuine" },
    { "type": "text", "id": "trust_3", "label": "Item 3", "default": "Secure Checkout" },

