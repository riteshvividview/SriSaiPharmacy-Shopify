{%- comment -%}
  Section: Product - Main
  Premium product page: sticky image gallery (main image + thumbnail
  strip) on the left that stays pinned while the info column scrolls
  past it on the right, matching the reference layout. Description area
  can be switched between plain text and an accordion (Description /
  Shipping / Additional Information) via schema. Native variant
  picker + Shopify `product` form for cart/checkout. Heavily
  schema-driven per request - colors, labels, toggles and tab content
  are all editable without touching code.
{%- endcomment -%}

{{ 'https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@400;500;600;700;800&display=swap' | stylesheet_tag }}

{%- liquid
  assign section_id = section.id
  assign s = section.settings
  assign current_variant = product.selected_or_first_available_variant
  assign images = product.images
  assign form_id = 'ProductForm-' | append: section_id
-%}

<section
  class="pm"
  id="pm-{{ section_id }}"
  data-pm
  data-enable-sticky="{{ s.enable_sticky_gallery }}"
  style="
    --pm-bg: {{ s.background_color | default: '#FFFFFF' }};
    --pm-text: {{ s.text_color | default: '#141414' }};
    --pm-muted: {{ s.muted_color | default: '#6B6B6B' }};
    --pm-accent: {{ s.accent_color | default: '#2E7D32' }};
    --pm-cta: {{ s.cta_color | default: '#F58220' }};
    --pm-border: {{ s.border_color | default: '#ECECEC' }};
    --pm-card-bg: {{ s.card_color | default: '#F7F5F0' }};
    --pm-padding-top: {{ s.padding_top | default: 48 }}px;
    --pm-padding-bottom: {{ s.padding_bottom | default: 80 }}px;
  "
>
  <div class="pm__container" data-pm-columns>
    <div class="pm__gallery-col" data-pm-gallery-col>
      <div class="pm__gallery" data-pm-gallery>
        <div class="pm__main-image" data-pm-main-image>
          {%- if images.size > 0 -%}
            {%- for image in images -%}
              <img
                class="pm__main-image-el{% if forloop.first %} is-active{% endif %}"
                data-pm-main-img
                data-index="{{ forloop.index0 }}"
                src="{{ image | image_url: width: 900 }}"
                srcset="{{ image | image_url: width: 500 }} 500w, {{ image | image_url: width: 900 }} 900w, {{ image | image_url: width: 1200 }} 1200w"
                sizes="(max-width: 899px) 100vw, 520px"
                alt="{{ image.alt | default: product.title | escape }}"
                width="{{ image.width }}"
                height="{{ image.height }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              >
            {%- endfor -%}
          {%- else -%}
            <span class="pm__main-image-placeholder" aria-hidden="true">
              <svg width="56" height="56" viewBox="0 0 24 24" fill="none"><path d="M6 8h12l-1 12H7L6 8Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M9 8V6a3 3 0 0 1 6 0v2" stroke="currentColor" stroke-width="1.4"/></svg>
            </span>
          {%- endif -%}

          {%- if current_variant.compare_at_price > current_variant.price -%}
            {%- assign discount = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round -%}
            <span class="pm__badge">{{ discount }}% OFF</span>
          {%- elsif product.available == false -%}
            <span class="pm__badge pm__badge--muted">Sold Out</span>
          {%- endif -%}
        </div>

        {%- if images.size > 1 -%}
          <div class="pm__thumbs" style="--pm-thumb-cols: {{ s.thumbnail_columns | default: 5 }};">
            {%- for image in images -%}
              <button
                type="button"
                class="pm__thumb{% if forloop.first %} is-active{% endif %}"
                data-pm-thumb
                data-index="{{ forloop.index0 }}"
                aria-label="Show image {{ forloop.index }}"
              >
                <img
                  src="{{ image | image_url: width: 200 }}"
                  alt=""
                  width="{{ image.width }}"
                  height="{{ image.height }}"
                  loading="lazy"
                >
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="pm__info-col" data-pm-info>
      {%- assign eyebrow_text = blank -%}
      {%- if s.eyebrow_source == 'vendor' and product.vendor != blank -%}
        {%- assign eyebrow_text = product.vendor -%}
      {%- elsif s.eyebrow_source == 'type' and product.type != blank -%}
        {%- assign eyebrow_text = product.type -%}
      {%- endif -%}
      {%- if eyebrow_text != blank -%}<p class="pm__eyebrow">{{ eyebrow_text }}</p>{%- endif -%}

      <h1 class="pm__title">{{ product.title }}</h1>

      <div class="pm__price-row">
        <span class="pm__price" data-pm-price>{{ current_variant.price | money }}</span>
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <span class="pm__price-compare" data-pm-price-compare>{{ current_variant.compare_at_price | money }}</span>
        {%- endif -%}
      </div>

      {%- if s.show_sku or s.show_availability -%}
        <div class="pm__meta-row">
          {%- if s.show_sku and current_variant.sku != blank -%}
            <span data-pm-sku>SKU: {{ current_variant.sku }}</span>
          {%- endif -%}
          {%- if s.show_availability -%}
            <span class="pm__stock{% if current_variant.available == false %} pm__stock--out{% endif %}" data-pm-stock>
              <span class="pm__stock-dot" aria-hidden="true"></span>
              {%- if current_variant.available -%}{{ s.in_stock_text | default: 'In stock, ready to ship' }}{%- else -%}{{ s.out_of_stock_text | default: 'Currently out of stock' }}{%- endif -%}
            </span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if s.short_description != blank -%}
        <p class="pm__short-description">{{ s.short_description }}</p>
      {%- endif -%}

      {%- form 'product', product, id: form_id, class: 'pm__form' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-pm-variant-id>

        {%- unless product.has_only_default_variant -%}
          <div class="pm__options">
            {%- for option in product.options_with_values -%}
              <div class="pm__option" data-pm-option data-option-index="{{ forloop.index0 }}">
                <p class="pm__option-label">{{ option.name }}<span class="pm__option-value" data-pm-option-value>{{ option.selected_value }}</span></p>
                <div class="pm__option-values">
                  {%- for value in option.values -%}
                    <button
                      type="button"
                      class="pm__pill{% if value == option.selected_value %} is-selected{% endif %}"
                      data-pm-option-btn
                      data-option-index="{{ forloop.parentloop.index0 }}"
                      data-value="{{ value | escape }}"
                    >{{ value }}</button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        <div class="pm__buy-row">
          <div class="pm__quantity">
            <button type="button" class="pm__qty-btn" data-pm-qty-minus aria-label="Decrease quantity">−</button>
            <input type="number" name="quantity" value="1" min="1" class="pm__qty-input" data-pm-qty-input aria-label="Quantity">
            <button type="button" class="pm__qty-btn" data-pm-qty-plus aria-label="Increase quantity">+</button>
          </div>

          <button type="submit" class="pm__add-btn" data-pm-add-btn {% if current_variant.available == false %}disabled{% endif %}>
            <svg width="17" height="17" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3.392 6.875h13.216v8.016c0 .567-.224 1.112-.624 1.513-.4.402-.941.627-1.506.627H5.522a2.13 2.13 0 0 1-1.506-.627 2.15 2.15 0 0 1-.624-1.513zM8.818 2.969h2.333c.618 0 1.211.247 1.649.686a2.35 2.35 0 0 1 .683 1.658v1.562H6.486V5.313c0-.622.246-1.218.683-1.658a2.33 2.33 0 0 1 1.65-.686" stroke="currentColor" stroke-width="1.5"/></svg>
            <span data-pm-add-btn-text>
              {%- if current_variant.available -%}{{ s.add_to_cart_text | default: 'Add to Cart' }}{%- else -%}{{ s.sold_out_text | default: 'Sold Out' }}{%- endif -%}
            </span>
          </button>
        </div>

        {%- if s.show_buy_now and current_variant.available -%}
          <button type="submit" name="checkout" class="pm__buy-now-btn">{{ s.buy_now_text | default: 'Buy It Now' }}</button>
        {%- endif -%}
      {%- endform -%}

      {%- if s.show_trust_row and s.trust_1 != blank or s.trust_2 != blank or s.trust_3 != blank -%}
        <div class="pm__trust-row">
          {%- if s.trust_1 != blank -%}
            <span class="pm__trust-item"><svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 2 3 5v4.5c0 4.5 3 7.5 7 8.5 4-1 7-4 7-8.5V5l-7-3Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>{{ s.trust_1 }}</span>
          {%- endif -%}
          {%- if s.trust_2 != blank -%}
            <span class="pm__trust-item"><svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M2.5 10s2.9-5.5 7.5-5.5S17.5 10 17.5 10 14.6 15.5 10 15.5 2.5 10 2.5 10Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><circle cx="10" cy="10" r="2" stroke="currentColor" stroke-width="1.4"/></svg>{{ s.trust_2 }}</span>
          {%- endif -%}
          {%- if s.trust_3 != blank -%}
            <span class="pm__trust-item"><svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3.5 6.5h13v8a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1v-8Z" stroke="currentColor" stroke-width="1.4"/><path d="M6.5 6.5V5a3.5 3.5 0 1 1 7 0v1.5" stroke="currentColor" stroke-width="1.4"/></svg>{{ s.trust_3 }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if s.show_share -%}
        <div class="pm__share">
          <span>{{ s.share_label | default: 'Share' }}</span>
          <a href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url | append: product.url | url_encode }}" target="_blank" rel="noopener" aria-label="Share on Facebook"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12Z"/></svg></a>
          <a href="https://twitter.com/intent/tweet?url={{ shop.url | append: product.url | url_encode }}&text={{ product.title | url_encode }}" target="_blank" rel="noopener" aria-label="Share on X"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 2H22l-7.6 8.7L23.3 22h-7.2l-5.6-7.3L4 22H1l8.1-9.3L.9 2h7.4l5 6.7L18.9 2Zm-1.3 18h1.7L7.5 4H5.7L17.6 20Z"/></svg></a>
          <a href="https://pinterest.com/pin/create/button/?url={{ shop.url | append: product.url | url_encode }}&media={{ current_variant.featured_image | image_url: width: 800 }}&description={{ product.title | url_encode }}" target="_blank" rel="noopener" aria-label="Share on Pinterest"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.6 19.3c-.05-.8-.1-2 .02-2.9l1.3-5.5s-.3-.7-.3-1.6c0-1.5.9-2.7 2-2.7.9 0 1.4.7 1.4 1.6 0 1-.6 2.4-.9 3.7-.3 1.1.5 2 1.6 2 1.9 0 3.2-2.4 3.2-5.3 0-2.2-1.5-3.8-4.2-3.8-3 0-4.9 2.2-4.9 4.7 0 .9.3 1.5.7 2 .2.2.2.3.1.5l-.2.9c-.1.3-.3.4-.6.3-1.3-.5-1.9-2-1.9-3.6 0-2.7 2.3-5.9 6.8-5.9 3.6 0 6 2.6 6 5.4 0 3.7-2 6.5-5 6.5-1 0-1.9-.5-2.3-1.2l-.6 2.5c-.2.9-.7 2-1.1 2.6A10 10 0 1 0 12 2Z"/></svg></a>
        </div>
      {%- endif -%}

      <div class="pm__description" data-pm-description>
        {%- if s.description_style == 'accordion' -%}
          <div class="pm__accordion">
            {%- if product.description != blank -%}
              <div class="pm__accordion-item{% if s.accordion_open_first %} is-open{% endif %}" data-pm-accordion-item>
                <button type="button" class="pm__accordion-toggle" data-pm-accordion-toggle aria-expanded="{% if s.accordion_open_first %}true{% else %}false{% endif %}">
                  <span>{{ s.description_tab_label | default: 'Description' }}</span>
                  <span class="pm__accordion-icon" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 14 14" fill="none"><path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></span>
                </button>
                <div class="pm__accordion-panel">
                  <div class="pm__accordion-panel-inner">{{ product.description }}</div>
                </div>
              </div>
            {%- endif -%}

            {%- if s.show_shipping_tab -%}
              <div class="pm__accordion-item" data-pm-accordion-item>
                <button type="button" class="pm__accordion-toggle" data-pm-accordion-toggle aria-expanded="false">
                  <span>{{ s.shipping_tab_label | default: 'Shipping Details' }}</span>
                  <span class="pm__accordion-icon" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 14 14" fill="none"><path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></span>
                </button>
                <div class="pm__accordion-panel">
                  <div class="pm__accordion-panel-inner">{{ s.shipping_tab_content }}</div>
                </div>
              </div>
            {%- endif -%}

            {%- if s.show_additional_tab -%}
              <div class="pm__accordion-item" data-pm-accordion-item>
                <button type="button" class="pm__accordion-toggle" data-pm-accordion-toggle aria-expanded="false">
                  <span>{{ s.additional_tab_label | default: 'Additional Information' }}</span>
                  <span class="pm__accordion-icon" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 14 14" fill="none"><path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></span>
                </button>
                <div class="pm__accordion-panel">
                  <div class="pm__accordion-panel-inner">{{ s.additional_tab_content }}</div>
                </div>
              </div>
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="pm__description-plain">{{ product.description }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{%- comment -%} ---------------- CSS ---------------- {%- endcomment -%}
<style>
  #pm-{{ section_id }} {
    position: relative;
    background: var(--pm-bg);
    color: var(--pm-text);
    font-family: 'Poppins', sans-serif;
    padding: var(--pm-padding-top) 20px var(--pm-padding-bottom);
  }

  #pm-{{ section_id }} * {
    box-sizing: border-box;
  }

  #pm-{{ section_id }} a {
    color: inherit;
  }

  #pm-{{ section_id }} .pm__container {
    max-width: 1300px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 480px) minmax(0, 1fr);
    gap: 64px;
    align-items: start;
  }

  /* ---- Gallery ---- */
  /* `position: relative` here is the positioning anchor for the
     "released" (absolute) sticky state below - without it, a missing
     positioned ancestor makes the browser fall back to the nearest one
     up the tree (often close to full page width), which is exactly why
     the gallery briefly went full-width mid-scroll. */
  #pm-{{ section_id }} .pm__gallery-col {
    position: relative;
    min-width: 0;
  }

  #pm-{{ section_id }} .pm__gallery {
    width: 100%;
  }

  #pm-{{ section_id }} .pm__main-image {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: 20px;
    overflow: hidden;
    background: var(--pm-card-bg);
  }

  #pm-{{ section_id }} .pm__main-image-el {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 24px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease;
  }

  #pm-{{ section_id }} .pm__main-image-el.is-active {
    position: relative;
    opacity: 1;
    visibility: visible;
  }

  #pm-{{ section_id }} .pm__main-image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    border-radius: 20px;
    background: var(--pm-card-bg);
    color: var(--pm-accent);
    opacity: 0.4;
  }

  #pm-{{ section_id }} .pm__badge {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 2;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--pm-cta);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
  }

  #pm-{{ section_id }} .pm__badge--muted {
    background: #8a8a8a;
  }

  #pm-{{ section_id }} .pm__thumbs {
    display: grid;
    grid-template-columns: repeat(var(--pm-thumb-cols), 1fr);
    gap: 12px;
    margin-top: 14px;
  }

  #pm-{{ section_id }} .pm__thumb {
    padding: 0;
    aspect-ratio: 1 / 1;
    border-radius: 12px;
    overflow: hidden;
    background: var(--pm-card-bg);
    border: 1.5px solid var(--pm-border);
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  #pm-{{ section_id }} .pm__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #pm-{{ section_id }} .pm__thumb.is-active,
  #pm-{{ section_id }} .pm__thumb:hover {
    border-color: var(--pm-accent);
  }

  /* Sticky state applied by JS (position: fixed/absolute), not CSS
     `position: sticky` - proven unreliable at this nesting depth in this
     theme (see header.liquid / collection-banner.liquid for the same
     fix and why). `.pm__gallery-col` keeps its grid-track width/height
     reserved regardless of the inner `.pm__gallery`'s position state. */
  #pm-{{ section_id }} .pm__gallery.is-pinned {
    position: fixed;
  }

  #pm-{{ section_id }} .pm__gallery.is-released {
    position: absolute;
  }

  /* ---- Info column ---- */
  #pm-{{ section_id }} .pm__info-col {
    min-width: 0;
  }

  #pm-{{ section_id }} .pm__eyebrow {
    margin: 0 0 10px;
    font-weight: 600;
    font-size: 12.5px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--pm-accent);
  }

  #pm-{{ section_id }} .pm__title {
    margin: 0 0 16px;
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-weight: 400;
    font-size: clamp(30px, 3.4vw, 42px);
    line-height: 1.08;
    letter-spacing: 0.4px;
    text-transform: uppercase;
  }

  #pm-{{ section_id }} .pm__price-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 14px;
  }

  #pm-{{ section_id }} .pm__price {
    font-size: 24px;
    font-weight: 700;
    color: var(--pm-accent);
  }

  #pm-{{ section_id }} .pm__price-compare {
    font-size: 16px;
    color: var(--pm-muted);
    text-decoration: line-through;
  }

  #pm-{{ section_id }} .pm__meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-bottom: 18px;
    font-size: 13px;
    color: var(--pm-muted);
  }

  #pm-{{ section_id }} .pm__stock {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  #pm-{{ section_id }} .pm__stock-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--pm-accent);
  }

  #pm-{{ section_id }} .pm__stock--out .pm__stock-dot {
    background: #c0392b;
  }

  #pm-{{ section_id }} .pm__short-description {
    margin: 0 0 22px;
    font-size: 14.5px;
    line-height: 1.75;
    color: var(--pm-muted);
  }

  /* ---- Variant options ---- */
  #pm-{{ section_id }} .pm__options {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-bottom: 24px;
  }

  #pm-{{ section_id }} .pm__option-label {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 10px;
    font-weight: 600;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.4px;
  }

  #pm-{{ section_id }} .pm__option-value {
    font-weight: 400;
    text-transform: none;
    letter-spacing: normal;
    color: var(--pm-muted);
  }

  #pm-{{ section_id }} .pm__option-values {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  #pm-{{ section_id }} .pm__pill {
    padding: 9px 18px;
    border-radius: 999px;
    border: 1.5px solid var(--pm-border);
    background: #fff;
    font-family: 'Poppins', sans-serif;
    font-size: 13.5px;
    font-weight: 500;
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  #pm-{{ section_id }} .pm__pill:hover {
    border-color: var(--pm-accent);
  }

  #pm-{{ section_id }} .pm__pill.is-selected {
    background: var(--pm-accent);
    border-color: var(--pm-accent);
    color: #fff;
  }

  /* ---- Buy row ---- */
  #pm-{{ section_id }} .pm__buy-row {
    display: flex;
    gap: 12px;
    margin-bottom: 12px;
  }

  #pm-{{ section_id }} .pm__quantity {
    display: flex;
    align-items: center;
    border: 1.5px solid var(--pm-border);
    border-radius: 999px;
    overflow: hidden;
    flex-shrink: 0;
  }

  #pm-{{ section_id }} .pm__qty-btn {
    width: 40px;
    height: 48px;
    border: none;
    background: none;
    font-size: 18px;
    color: var(--pm-text);
    cursor: pointer;
  }

  #pm-{{ section_id }} .pm__qty-btn:hover {
    color: var(--pm-accent);
  }

  #pm-{{ section_id }} .pm__qty-input {
    width: 40px;
    height: 48px;
    border: none;
    border-left: 1px solid var(--pm-border);
    border-right: 1px solid var(--pm-border);
    text-align: center;
    font-family: 'Poppins', sans-serif;
    font-size: 14px;
    -moz-appearance: textfield;
  }

  #pm-{{ section_id }} .pm__qty-input::-webkit-outer-spin-button,
  #pm-{{ section_id }} .pm__qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  #pm-{{ section_id }} .pm__add-btn {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 48px;
    padding: 0 24px;
    border-radius: 999px;
    border: none;
    background: var(--pm-text);
    color: #fff;
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 14.5px;
    cursor: pointer;
    transition: background-color 0.25s ease, transform 0.2s ease;
  }

  #pm-{{ section_id }} .pm__add-btn:hover {
    background: var(--pm-accent);
    transform: translateY(-2px);
  }

  #pm-{{ section_id }} .pm__add-btn[disabled] {
    background: #b7b7b7;
    cursor: not-allowed;
    transform: none;
  }

  #pm-{{ section_id }} .pm__buy-now-btn {
    display: block;
    width: 100%;
    height: 48px;
    margin-bottom: 22px;
    border-radius: 999px;
    border: 1.5px solid var(--pm-text);
    background: #fff;
    color: var(--pm-text);
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 14.5px;
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  #pm-{{ section_id }} .pm__buy-now-btn:hover {
    background: var(--pm-text);
    color: #fff;
  }

  /* ---- Trust row ---- */
  #pm-{{ section_id }} .pm__trust-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 20px;
    margin: 18px 0;
    padding: 16px 0;
    border-top: 1px solid var(--pm-border);
    border-bottom: 1px solid var(--pm-border);
  }

  #pm-{{ section_id }} .pm__trust-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    color: var(--pm-muted);
  }

  #pm-{{ section_id }} .pm__trust-item svg {
    color: var(--pm-accent);
    flex-shrink: 0;
  }

  /* ---- Share ---- */
  #pm-{{ section_id }} .pm__share {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 26px;
    font-size: 13px;
    color: var(--pm-muted);
  }

  #pm-{{ section_id }} .pm__share a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--pm-card-bg);
    color: var(--pm-text);
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  #pm-{{ section_id }} .pm__share a:hover {
    background: var(--pm-accent);
    color: #fff;
  }

  /* ---- Description / accordion ---- */
  #pm-{{ section_id }} .pm__description-plain {
    font-size: 14.5px;
    line-height: 1.8;
    color: var(--pm-muted);
    padding-top: 22px;
    border-top: 1px solid var(--pm-border);
  }

  #pm-{{ section_id }} .pm__description-plain p {
    margin: 0 0 1em;
  }

  #pm-{{ section_id }} .pm__accordion {
    border-top: 1px solid var(--pm-border);
  }

  #pm-{{ section_id }} .pm__accordion-item {
    border-bottom: 1px solid var(--pm-border);
  }

  #pm-{{ section_id }} .pm__accordion-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 2px;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 14.5px;
    color: var(--pm-text);
  }

  #pm-{{ section_id }} .pm__accordion-item.is-open .pm__accordion-toggle {
    color: var(--pm-accent);
  }

  #pm-{{ section_id }} .pm__accordion-icon {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1.5px solid var(--pm-border);
    color: var(--pm-text);
    transition: transform 0.3s cubic-bezier(0.22, 0.61, 0.36, 1), background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  #pm-{{ section_id }} .pm__accordion-item.is-open .pm__accordion-icon {
    transform: rotate(135deg);
    background: var(--pm-accent);
    border-color: var(--pm-accent);
    color: #fff;
  }

  #pm-{{ section_id }} .pm__accordion-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  #pm-{{ section_id }} .pm__accordion-item.is-open .pm__accordion-panel {
    grid-template-rows: 1fr;
  }

  #pm-{{ section_id }} .pm__accordion-panel-inner {
    overflow: hidden;
    min-height: 0;
    font-size: 14px;
    line-height: 1.75;
    color: var(--pm-muted);
  }

  #pm-{{ section_id }} .pm__accordion-item.is-open .pm__accordion-panel-inner {
    padding-bottom: 20px;
  }

  #pm-{{ section_id }} .pm__accordion-panel-inner p {
    margin: 0 0 1em;
  }

  /* ---- Tablet / Mobile ---- */
  @media (max-width: 999px) {
    #pm-{{ section_id }} .pm__container {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    #pm-{{ section_id }} .pm__gallery.is-pinned,
    #pm-{{ section_id }} .pm__gallery.is-released {
      position: static !important;
      top: auto !important;
      left: auto !important;
      width: auto !important;
    }
  }

  @media (max-width: 749px) {
    #pm-{{ section_id }} {
      padding-left: 16px;
      padding-right: 16px;
    }

    #pm-{{ section_id }} .pm__thumbs {
      --pm-thumb-cols: 4;
    }

    #pm-{{ section_id }} .pm__buy-row {
      flex-direction: column;
    }

    #pm-{{ section_id }} .pm__quantity {
      align-self: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #pm-{{ section_id }} .pm__accordion-panel,
    #pm-{{ section_id }} .pm__accordion-icon,
    #pm-{{ section_id }} .pm__add-btn {
      transition: none !important;
    }
  }
</style>

{%- comment -%} ---------------- JS ---------------- {%- endcomment -%}
<script>
  (function () {
    var section = document.getElementById('pm-{{ section_id }}');
    if (!section) return;

    /* ---- Thumbnail gallery ---- */
    var thumbs = Array.prototype.slice.call(section.querySelectorAll('[data-pm-thumb]'));
    var mainImages = Array.prototype.slice.call(section.querySelectorAll('[data-pm-main-img]'));
    thumbs.forEach(function (thumb) {
      thumb.addEventListener('click', function () {
        var index = thumb.getAttribute('data-index');
        thumbs.forEach(function (t) { t.classList.toggle('is-active', t === thumb); });
        mainImages.forEach(function (img) {
          img.classList.toggle('is-active', img.getAttribute('data-index') === index);
        });
      });
    });

    /* ---- Quantity stepper ---- */
    var qtyInput = section.querySelector('[data-pm-qty-input]');
    var qtyMinus = section.querySelector('[data-pm-qty-minus]');
    var qtyPlus = section.querySelector('[data-pm-qty-plus]');
    if (qtyInput && qtyMinus && qtyPlus) {
      qtyMinus.addEventListener('click', function () {
        var v = Math.max(1, (parseInt(qtyInput.value, 10) || 1) - 1);
        qtyInput.value = v;
      });
      qtyPlus.addEventListener('click', function () {
        var v = (parseInt(qtyInput.value, 10) || 1) + 1;
        qtyInput.value = v;
      });
    }

    /* ---- Variant picker ---- */
    var variantData = {{ product.variants | json }};
    var optionButtons = Array.prototype.slice.call(section.querySelectorAll('[data-pm-option-btn]'));
    var optionGroups = Array.prototype.slice.call(section.querySelectorAll('[data-pm-option]'));
    var variantIdInput = section.querySelector('[data-pm-variant-id]');
    var priceEl = section.querySelector('[data-pm-price]');
    var compareEl = section.querySelector('[data-pm-price-compare]');
    var stockEl = section.querySelector('[data-pm-stock]');
    var skuEl = section.querySelector('[data-pm-sku]');
    var addBtn = section.querySelector('[data-pm-add-btn]');
    var addBtnText = section.querySelector('[data-pm-add-btn-text]');

    function currentSelections() {
      return optionGroups.map(function (group) {
        var selected = group.querySelector('.pm__pill.is-selected');
        return selected ? selected.getAttribute('data-value') : null;
      });
    }

    function findMatchingVariant(selections) {
      return variantData.filter(function (v) { return v.available !== undefined; }).find(function (v) {
        return [v.option1, v.option2, v.option3].every(function (opt, i) {
          return selections[i] == null || opt === selections[i];
        });
      });
    }

    function money(cents) {
      return '{{ shop.money_format }}'.replace(/\{\{\s*amount\s*\}\}/, (cents / 100).toFixed(2));
    }

    function updateForVariant(variant) {
      if (!variant) return;
      if (variantIdInput) variantIdInput.value = variant.id;
      if (priceEl) priceEl.textContent = money(variant.price);
      if (compareEl) {
        if (variant.compare_at_price && variant.compare_at_price > variant.price) {
          compareEl.textContent = money(variant.compare_at_price);
          compareEl.style.display = '';
        } else {
          compareEl.style.display = 'none';
        }
      }
      if (stockEl) {
        stockEl.classList.toggle('pm__stock--out', !variant.available);
      }
      if (skuEl && variant.sku) skuEl.textContent = 'SKU: ' + variant.sku;
      if (addBtn) addBtn.disabled = !variant.available;
      if (addBtnText) addBtnText.textContent = variant.available ? '{{ s.add_to_cart_text | default: "Add to Cart" | escape }}' : '{{ s.sold_out_text | default: "Sold Out" | escape }}';
    }

    optionButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var group = btn.closest('[data-pm-option]');
        var siblings = group.querySelectorAll('[data-pm-option-btn]');
        siblings.forEach(function (b) { b.classList.remove('is-selected'); });
        btn.classList.add('is-selected');
        var valueLabel = group.querySelector('[data-pm-option-value]');
        if (valueLabel) valueLabel.textContent = btn.getAttribute('data-value');

        var variant = findMatchingVariant(currentSelections());
        updateForVariant(variant);
      });
    });

    /* ---- Accordion ---- */
    var accordionItems = Array.prototype.slice.call(section.querySelectorAll('[data-pm-accordion-item]'));
    accordionItems.forEach(function (item) {
      var toggle = item.querySelector('[data-pm-accordion-toggle]');
      if (!toggle) return;
      toggle.addEventListener('click', function () {
        var isOpen = item.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });
    });

    /* ---- Sticky gallery ----
       JS-driven (not CSS `position: sticky`) for the same reliability
       reasons as the header/collection banner. Only three states:
       normal flow -> fixed while the info column is taller and still
       scrolling past -> absolute, released to the bottom of the column
       once the info column ends, so the gallery scrolls away with it
       instead of staying fixed forever. */
    var enableSticky = section.getAttribute('data-enable-sticky') === 'true';
    var container = section.querySelector('[data-pm-columns]');
    var galleryCol = section.querySelector('.pm__gallery-col');
    var gallery = section.querySelector('[data-pm-gallery]');
    var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (enableSticky && container && galleryCol && gallery && !prefersReducedMotion) {
      var cachedLeft = 0;
      var cachedWidth = 0;
      var topOffset = 96;

      function getHeaderBottom() {
        var bar = document.querySelector('.ssh__bar');
        return bar ? bar.getBoundingClientRect().bottom : 0;
      }

      function measure() {
        if (gallery.classList.contains('is-pinned') || gallery.classList.contains('is-released')) return;
        var rect = galleryCol.getBoundingClientRect();
        cachedLeft = rect.left;
        cachedWidth = rect.width;
      }

      function isDesktop() {
        return window.innerWidth > 999;
      }

      function resetGallery() {
        gallery.classList.remove('is-pinned', 'is-released');
        gallery.style.position = '';
        gallery.style.top = '';
        gallery.style.left = '';
        gallery.style.width = '';
      }

      var ticking = false;
      function updateSticky() {
        ticking = false;

        if (!isDesktop()) {
          resetGallery();
          return;
        }

        topOffset = getHeaderBottom() + 20;
        var containerRect = container.getBoundingClientRect();
        var galleryHeight = gallery.offsetHeight;

        if (containerRect.top > topOffset - 20) {
          resetGallery();
        } else if (containerRect.bottom - topOffset < galleryHeight) {
          gallery.classList.remove('is-pinned');
          gallery.classList.add('is-released');
          gallery.style.position = 'absolute';
          gallery.style.top = (container.offsetHeight - galleryHeight) + 'px';
          gallery.style.left = '0';
          gallery.style.width = '100%';
        } else {
          if (!gallery.classList.contains('is-pinned')) measure();
          gallery.classList.remove('is-released');
          gallery.classList.add('is-pinned');
          gallery.style.position = 'fixed';
          gallery.style.top = topOffset + 'px';
          gallery.style.left = cachedLeft + 'px';
          gallery.style.width = cachedWidth + 'px';
        }
      }

      function onScroll() {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(updateSticky);
      }

      function onResize() {
        resetGallery();
        measure();
        onScroll();
      }

      var pageScroller = document.querySelector('.page-wrapper');
      window.addEventListener('scroll', onScroll, { passive: true });
      if (pageScroller) pageScroller.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onResize, { passive: true });
      window.addEventListener('load', onResize);
      measure();
      updateSticky();
    }
  })();
</script>

