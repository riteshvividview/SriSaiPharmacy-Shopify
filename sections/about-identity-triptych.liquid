{%- comment -%}
  Section: About - Identity Triptych
  Chapter 2 of the "Our Story" page rebuild: the three "Who We Are / Our
  Mission / Our Vision" points, presented as three distinct graphic cards
  with their own line-art icon rather than a stacked label+paragraph list.
  GSAP ScrollTrigger staggers them in on scroll. A small marker element at
  the end of the section carries its own data-scroll-bg-zone so the shared
  background layer begins darkening in anticipation of the next (dark)
  chapter before this section's own boundary is reached.

  Pulled up 100svh early via a negative margin-top: the masthead hero
  above holds itself in place (via CSS position: sticky) for 300svh of
  scroll - 100svh of pure scrub, then 200svh where this section is meant
  to progressively cover it. Without the negative margin, this section
  would only reach the viewport once the hero's hold naturally ends (no
  overlap at all, just a plain handoff); pulling it up means it starts
  sliding into view - and visually covering the still-held hero
  underneath, since it's later in DOM order and paints on top - 100svh
  before that natural handoff point, exactly matching the hero's "phase
  2". Needs its own z-index since position: sticky establishes a
  stacking context for the hero's stage that a plain DOM-order paint
  priority can't be assumed to beat.
{%- endcomment -%}

{{ 'https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@400;500;600;700&display=swap' | stylesheet_tag }}

{%- liquid
  assign section_id = section.id
  assign s = section.settings
  assign cards = section.blocks
-%}

<section
  class="ait"
  id="ait-{{ section_id }}"
  data-ait
  data-scroll-bg-zone="{{ s.background_color | default: '#FFFFFF' }}"
  style="
    --ait-bg: {{ s.background_color | default: '#FFFFFF' }};
    --ait-text: {{ s.text_color | default: '#141414' }};
    --ait-muted: {{ s.muted_color | default: '#5B5B5B' }};
    --ait-accent: {{ s.accent_color | default: '#2E7D32' }};
  "
>
  {%- if s.show_bg_decor and s.bg_decor_image_a != blank -%}
    {%- liquid
      assign decor_count = s.bg_decor_count | default: 20
      assign grid_cols = decor_count
      if grid_cols > 8
        assign grid_cols = 8
      endif
      if grid_cols < 1
        assign grid_cols = 1
      endif
      assign grid_rows = decor_count | minus: 1 | divided_by: grid_cols | plus: 1
      assign cell_w = 100.0 | divided_by: grid_cols
      assign cell_h = 100.0 | divided_by: grid_rows
    -%}
    <div class="ait__bg-decor" aria-hidden="true" style="--ait-decor-opacity: {{ s.bg_decor_opacity | default: 60 | divided_by: 100.0 }};">
      {%- for i in (0..decor_count) -%}
        {%- if i == decor_count -%}{%- break -%}{%- endif -%}
        {%- liquid
          assign col = i | modulo: grid_cols
          assign row = i | divided_by: grid_cols
          assign cell_center_x = col | times: cell_w | plus: cell_w | divided_by: 2.0
          assign cell_center_y = row | times: cell_h | plus: cell_h | divided_by: 2.0

          assign jitter_raw_x = i | times: 13 | modulo: 5 | minus: 2
          assign jitter_raw_y = i | times: 7 | modulo: 5 | minus: 2
          assign jitter_x = jitter_raw_x | times: cell_w | divided_by: 10.0
          assign jitter_y = jitter_raw_y | times: cell_h | divided_by: 10.0

          assign top = cell_center_y | plus: jitter_y
          assign left = cell_center_x | plus: jitter_x

          assign size_variance = i | modulo: 5 | times: 8
          assign size = s.bg_decor_size | default: 90 | minus: 20 | plus: size_variance

          assign rotate = i | times: 29 | modulo: 360
          assign flip = i | modulo: 3
          assign speed_raw = i | modulo: 6 | times: 4 | plus: 12
          assign speed = speed_raw | divided_by: 100.0

          assign dir_x = i | modulo: 4 | minus: 2
          assign dir_y = i | modulo: 2

          assign decor_parity = i | modulo: 2
          if decor_parity == 0
            assign decor_img = s.bg_decor_image_a
          else
            assign decor_img = s.bg_decor_image_b
          endif
          if decor_img == blank
            assign decor_img = s.bg_decor_image_a | default: s.bg_decor_image_b
          endif
        -%}
        {%- if decor_img != blank -%}
          <span
            class="ait__decor-item"
            data-decor-item
            data-speed="{{ speed }}"
            data-rotate="{{ rotate }}"
            data-flip="{{ flip }}"
            data-dir-x="{{ dir_x }}"
            data-dir-y="{{ dir_y }}"
            style="top: {{ top }}%; left: {{ left }}%; width: {{ size }}px; transform: translate(-50%, -50%) rotate({{ rotate }}deg){% if flip == 0 %} scaleX(-1){% endif %};"
          >
            <img src="{{ decor_img | image_url: width: 200 }}" width="200" height="{{ 200 | divided_by: decor_img.aspect_ratio | default: 200 }}" alt="" loading="lazy">
          </span>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="ait__inner">
    {%- if s.eyebrow != blank or s.heading != blank -%}
      <div class="ait__header">
        {%- if s.eyebrow != blank -%}<p class="ait__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="ait__heading">{{ s.heading }}</h2>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if cards.size > 0 -%}
      <div class="ait__grid" data-ait-grid>
        {%- for card in cards -%}
          {%- assign cs = card.settings -%}
          <div class="ait__card" data-ait-card {{ card.shopify_attributes }}>
            <span class="ait__card-icon" aria-hidden="true">
              {%- case cs.icon -%}
                {%- when 'mission' -%}
                  <svg width="34" height="34" viewBox="0 0 24 24" fill="none"><path d="M6 10c0 6 2.5 10 6 10s6-4 6-10" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><ellipse cx="12" cy="10" rx="8" ry="2.4" stroke="currentColor" stroke-width="1.3"/><path d="M15.5 5.5 18 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
                {%- when 'vision' -%}
                  <svg width="34" height="34" viewBox="0 0 24 24" fill="none"><path d="M12 3c4 2 7 6 7 10a7 7 0 0 1-14 0c0-4 3-8 7-10Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M12 7v13" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
                {%- else -%}
                  <svg width="34" height="34" viewBox="0 0 24 24" fill="none"><path d="M12 20s-7-4.35-9.5-8.5C1 8 2.5 5 5.8 5 8 5 10 6.5 12 9c2-2.5 4-4 6.2-4 3.3 0 4.8 3 3.3 6.5C19 15.65 12 20 12 20Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
              {%- endcase -%}
            </span>
            {%- if cs.label != blank -%}<p class="ait__card-label">{{ cs.label }}</p>{%- endif -%}
            {%- if cs.content != blank -%}<div class="ait__card-content">{{ cs.content }}</div>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <span class="ait__zone-marker" aria-hidden="true" data-scroll-bg-zone="{{ s.next_zone_color | default: '#FFFFFF' }}"></span>
</section>

<style>
  #ait-{{ section_id }} {
    position: relative;
    z-index: 2;
    margin-top: -100svh;
    /* Has to be at least a full viewport tall, not just tall enough for
       its own content: as this section's top slides up from the bottom
       of the viewport to the top (the "cover" effect - see the negative
       margin-top comment above), it needs to still be covering the
       ENTIRE viewport by the time that slide finishes. If its own
       height is shorter than the viewport, its bottom edge scrolls past
       the top before the slide completes, opening a gap that exposes
       whatever's behind (the hero) and pulls the next chapter up too
       early - exactly the "stray strip + gap" bug that was reported. */
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow-x: clip;
    background: var(--ait-bg);
    color: var(--ait-text);
    font-family: 'Poppins', sans-serif;
    padding: 100px 20px;
  }

  #ait-{{ section_id }}.ait--transparent-bg {
    background: transparent;
  }

  #ait-{{ section_id }} * {
    box-sizing: border-box;
  }

  #ait-{{ section_id }} .ait__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  #ait-{{ section_id }} .ait__bg-decor {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  #ait-{{ section_id }} .ait__decor-item {
    position: absolute;
    opacity: var(--ait-decor-opacity, 0.6);
  }

  #ait-{{ section_id }} .ait__decor-item img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 749px) {
    #ait-{{ section_id }} .ait__decor-item:nth-child(n + 15) {
      display: none;
    }

    #ait-{{ section_id }} .ait__decor-item {
      width: 40px !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #ait-{{ section_id }} .ait__bg-decor {
      display: none;
    }
  }

  #ait-{{ section_id }} .ait__header {
    text-align: center;
    max-width: 620px;
    margin: 0 auto 64px;
  }

  #ait-{{ section_id }} .ait__eyebrow {
    margin: 0 0 12px;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--ait-accent);
  }

  #ait-{{ section_id }} .ait__heading {
    margin: 0;
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-weight: 400;
    font-size: clamp(30px, 4.5vw, 52px);
    line-height: 1.05;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  #ait-{{ section_id }} .ait__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
    border-radius: 24px;
    overflow: hidden;
  }

  #ait-{{ section_id }} .ait__card {
    position: relative;
    padding: 48px 34px;
    background: color-mix(in srgb, var(--ait-accent) 5%, var(--ait-bg));
    opacity: 0;
    transform: translate3d(0, 40px, 0);
  }

  #ait-{{ section_id }} .ait__card:nth-child(2) {
    background: color-mix(in srgb, var(--ait-accent) 9%, var(--ait-bg));
  }

  #ait-{{ section_id }} .ait__card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--ait-accent) 14%, transparent);
    color: var(--ait-accent);
    margin-bottom: 22px;
  }

  #ait-{{ section_id }} .ait__card-label {
    margin: 0 0 12px;
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-weight: 400;
    font-size: 24px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--ait-text);
  }

  #ait-{{ section_id }} .ait__card-content {
    font-size: 15px;
    line-height: 1.75;
    color: var(--ait-muted);
  }

  #ait-{{ section_id }} .ait__card-content p {
    margin: 0;
  }

  #ait-{{ section_id }} .ait__zone-marker {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  /* ---- Tablet ---- */
  @media (max-width: 899px) {
    #ait-{{ section_id }} .ait__grid {
      grid-template-columns: 1fr;
      gap: 3px;
      border-radius: 18px;
    }
  }

  /* ---- Mobile ---- */
  @media (max-width: 749px) {
    #ait-{{ section_id }} {
      padding: 72px 20px;
    }

    #ait-{{ section_id }} .ait__header {
      margin-bottom: 40px;
    }

    #ait-{{ section_id }} .ait__card {
      padding: 34px 26px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #ait-{{ section_id }} .ait__card {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  (function () {
    var section = document.getElementById('ait-{{ section_id }}');
    if (!section) return;

    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var decorList = Array.prototype.slice.call(section.querySelectorAll('[data-decor-item]')).map(function (el) {
      return {
        el: el,
        speed: parseFloat(el.getAttribute('data-speed')) || 0.2,
        rotate: parseFloat(el.getAttribute('data-rotate')) || 0,
        flip: el.getAttribute('data-flip') === '0',
        dirX: parseFloat(el.getAttribute('data-dir-x')) || 0,
        dirY: el.getAttribute('data-dir-y') === '1' ? -1 : 1
      };
    });
    var decorRaf = null;
    var decorObserver = null;

    function getDecorProgress() {
      var rect = section.getBoundingClientRect();
      var vh = window.innerHeight || document.documentElement.clientHeight;
      var total = rect.height + vh;
      var passed = vh - rect.top;
      var progress = passed / total;
      if (progress < 0) progress = 0;
      if (progress > 1) progress = 1;
      return progress;
    }

    function updateDecor() {
      var progress = getDecorProgress();
      decorList.forEach(function (item) {
        var y = (progress - 0.5) * -40 * item.speed * item.dirY;
        var x = (progress - 0.5) * 24 * item.speed * item.dirX;
        var transform = 'translate(-50%, -50%) translate3d(' + x.toFixed(1) + 'px, ' + y.toFixed(1) + 'px, 0) rotate(' + item.rotate + 'deg)';
        if (item.flip) transform += ' scaleX(-1)';
        item.el.style.transform = transform;
      });
      decorRaf = requestAnimationFrame(updateDecor);
    }

    function startDecorLoop() {
      if (decorRaf) return;
      decorRaf = requestAnimationFrame(updateDecor);
    }

    function stopDecorLoop() {
      if (decorRaf) cancelAnimationFrame(decorRaf);
      decorRaf = null;
    }

    if (decorList.length && !reducedMotion) {
      if ('IntersectionObserver' in window) {
        decorObserver = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              startDecorLoop();
            } else {
              stopDecorLoop();
            }
          });
        });
        decorObserver.observe(section);
      } else {
        startDecorLoop();
      }
    }

    function initAit() {
      if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;
      var cards = Array.prototype.slice.call(section.querySelectorAll('[data-ait-card]'));
      var grid = section.querySelector('[data-ait-grid]');
      if (!cards.length || !grid) return;

      gsap.set(cards, { clearProps: 'opacity,transform' });
      /* fromTo, not from: the cards' own CSS sets a static opacity:0/
         translateY(40px) as their base (pre-JS) state, so gsap.from()
         would read that same opacity:0 as the "natural" end state it
         animates back to - fading in from invisible to invisible. The
         end state has to be given explicitly. */
      gsap.fromTo(
        cards,
        { opacity: 0, y: 40 },
        {
          opacity: 1,
          y: 0,
          stagger: 0.15,
          duration: 0.7,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: grid,
            start: 'top 75%'
          }
        }
      );
    }

    if (reducedMotion) {
      var cards = Array.prototype.slice.call(section.querySelectorAll('[data-ait-card]'));
      cards.forEach(function (card) {
        card.style.opacity = '1';
        card.style.transform = 'none';
      });
    } else {
      window.__aboutChapterInits = window.__aboutChapterInits || [];
      window.__aboutChapterInits.push(initAit);
      initAit();
    }
  })();
</script>

{% schema %}
{
  "name": "About - Identity Triptych",
  "tag": "section",
  "class": "shopify-section--about-identity-triptych",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background (also this chapter's scroll-color zone)", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#141414" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#5B5B5B" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#2E7D32" },
    { "type": "color", "id": "next_zone_color", "label": "Hand-off color to the next chapter", "info": "The shared background starts fading to this color as the reader nears the bottom of this section, so the transition into the next chapter feels anticipated rather than abrupt. Keep this matching the other chapters' zone colors so the page reads as one continuous surface.", "default": "#FFFFFF" },

    { "type": "header", "content": "Background decoration" },
    { "type": "checkbox", "id": "show_bg_decor", "label": "Show scattered background images", "default": true },
    { "type": "image_picker", "id": "bg_decor_image_a", "label": "Decoration image A" },
    { "type": "image_picker", "id": "bg_decor_image_b", "label": "Decoration image B" },
    { "type": "range", "id": "bg_decor_count", "label": "Number of images", "min": 4, "max": 46, "step": 2, "default": 20 },
    { "type": "range", "id": "bg_decor_size", "label": "Base image size", "min": 40, "max": 300, "step": 5, "unit": "px", "default": 90 },
    { "type": "range", "id": "bg_decor_opacity", "label": "Decoration opacity", "min": 1, "max": 100, "step": 1, "unit": "%", "default": 60 }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "who", "label": "Who We Are (people)" },
            { "value": "mission", "label": "Mission (mortar & pestle)" },
            { "value": "vision", "label": "Vision (leaf)" }
          ],
          "default": "who"
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Who We Are" },
        { "type": "richtext", "id": "content", "label": "Content" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About - Identity Triptych",
      "blocks": [
        { "type": "point", "settings": { "icon": "who", "label": "Who We Are" } },
        { "type": "point", "settings": { "icon": "mission", "label": "Our Mission" } },
        { "type": "point", "settings": { "icon": "vision", "label": "Our Vision" } }
      ]
    }
  ]
}
{% endschema %}
