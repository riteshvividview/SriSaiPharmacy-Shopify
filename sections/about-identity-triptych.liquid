{%- comment -%}
  Section: About - Identity Triptych
  Chapter 2 of the "Our Story" page rebuild: the three "Who We Are / Our
  Mission / Our Vision" points, presented as three distinct graphic cards
  with their own line-art icon rather than a stacked label+paragraph list.
  GSAP ScrollTrigger staggers them in on scroll. A small marker element at
  the end of the section carries its own data-scroll-bg-zone so the shared
  background layer begins darkening in anticipation of the next (dark)
  chapter before this section's own boundary is reached.
{%- endcomment -%}

{{ 'https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@400;500;600;700&display=swap' | stylesheet_tag }}

{%- liquid
  assign section_id = section.id
  assign s = section.settings
  assign cards = section.blocks
-%}

<section
  class="ait"
  id="ait-{{ section_id }}"
  data-ait
  data-scroll-bg-zone="{{ s.background_color | default: '#FFFFFF' }}"
  style="
    --ait-bg: {{ s.background_color | default: '#FFFFFF' }};
    --ait-text: {{ s.text_color | default: '#141414' }};
    --ait-muted: {{ s.muted_color | default: '#5B5B5B' }};
    --ait-accent: {{ s.accent_color | default: '#2E7D32' }};
  "
>
  <div class="ait__inner">
    {%- if s.eyebrow != blank or s.heading != blank -%}
      <div class="ait__header">
        {%- if s.eyebrow != blank -%}<p class="ait__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="ait__heading">{{ s.heading }}</h2>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if cards.size > 0 -%}
      <div class="ait__grid" data-ait-grid>
        {%- for card in cards -%}
          {%- assign cs = card.settings -%}
          <div class="ait__card" data-ait-card {{ card.shopify_attributes }}>
            <span class="ait__card-icon" aria-hidden="true">
              {%- case cs.icon -%}
                {%- when 'mission' -%}
                  <svg width="34" height="34" viewBox="0 0 24 24" fill="none"><path d="M6 10c0 6 2.5 10 6 10s6-4 6-10" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><ellipse cx="12" cy="10" rx="8" ry="2.4" stroke="currentColor" stroke-width="1.3"/><path d="M15.5 5.5 18 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
                {%- when 'vision' -%}
                  <svg width="34" height="34" viewBox="0 0 24 24" fill="none"><path d="M12 3c4 2 7 6 7 10a7 7 0 0 1-14 0c0-4 3-8 7-10Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M12 7v13" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
                {%- else -%}
                  <svg width="34" height="34" viewBox="0 0 24 24" fill="none"><path d="M12 20s-7-4.35-9.5-8.5C1 8 2.5 5 5.8 5 8 5 10 6.5 12 9c2-2.5 4-4 6.2-4 3.3 0 4.8 3 3.3 6.5C19 15.65 12 20 12 20Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
              {%- endcase -%}
            </span>
            {%- if cs.label != blank -%}<p class="ait__card-label">{{ cs.label }}</p>{%- endif -%}
            {%- if cs.content != blank -%}<div class="ait__card-content">{{ cs.content }}</div>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <span class="ait__zone-marker" aria-hidden="true" data-scroll-bg-zone="{{ s.next_zone_color | default: '#123321' }}"></span>
</section>

<style>
  #ait-{{ section_id }} {
    position: relative;
    background: var(--ait-bg);
    color: var(--ait-text);
    font-family: 'Poppins', sans-serif;
    padding: 100px 20px;
  }

  #ait-{{ section_id }}.ait--transparent-bg {
    background: transparent;
  }

  #ait-{{ section_id }} * {
    box-sizing: border-box;
  }

  #ait-{{ section_id }} .ait__inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  #ait-{{ section_id }} .ait__header {
    text-align: center;
    max-width: 620px;
    margin: 0 auto 64px;
  }

  #ait-{{ section_id }} .ait__eyebrow {
    margin: 0 0 12px;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--ait-accent);
  }

  #ait-{{ section_id }} .ait__heading {
    margin: 0;
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-weight: 400;
    font-size: clamp(30px, 4.5vw, 52px);
    line-height: 1.05;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  #ait-{{ section_id }} .ait__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
    border-radius: 24px;
    overflow: hidden;
  }

  #ait-{{ section_id }} .ait__card {
    position: relative;
    padding: 48px 34px;
    background: color-mix(in srgb, var(--ait-accent) 5%, var(--ait-bg));
    opacity: 0;
    transform: translate3d(0, 40px, 0);
  }

  #ait-{{ section_id }} .ait__card:nth-child(2) {
    background: color-mix(in srgb, var(--ait-accent) 9%, var(--ait-bg));
  }

  #ait-{{ section_id }} .ait__card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--ait-accent) 14%, transparent);
    color: var(--ait-accent);
    margin-bottom: 22px;
  }

  #ait-{{ section_id }} .ait__card-label {
    margin: 0 0 12px;
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-weight: 400;
    font-size: 24px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--ait-text);
  }

  #ait-{{ section_id }} .ait__card-content {
    font-size: 15px;
    line-height: 1.75;
    color: var(--ait-muted);
  }

  #ait-{{ section_id }} .ait__card-content p {
    margin: 0;
  }

  #ait-{{ section_id }} .ait__zone-marker {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  /* ---- Tablet ---- */
  @media (max-width: 899px) {
    #ait-{{ section_id }} .ait__grid {
      grid-template-columns: 1fr;
      gap: 3px;
      border-radius: 18px;
    }
  }

  /* ---- Mobile ---- */
  @media (max-width: 749px) {
    #ait-{{ section_id }} {
      padding: 72px 20px;
    }

    #ait-{{ section_id }} .ait__header {
      margin-bottom: 40px;
    }

    #ait-{{ section_id }} .ait__card {
      padding: 34px 26px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #ait-{{ section_id }} .ait__card {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  (function () {
    var section = document.getElementById('ait-{{ section_id }}');
    if (!section) return;

    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function initAit() {
      if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;
      var cards = Array.prototype.slice.call(section.querySelectorAll('[data-ait-card]'));
      var grid = section.querySelector('[data-ait-grid]');
      if (!cards.length || !grid) return;

      gsap.set(cards, { clearProps: 'opacity,transform' });
      /* fromTo, not from: the cards' own CSS sets a static opacity:0/
         translateY(40px) as their base (pre-JS) state, so gsap.from()
         would read that same opacity:0 as the "natural" end state it
         animates back to - fading in from invisible to invisible. The
         end state has to be given explicitly. */
      gsap.fromTo(
        cards,
        { opacity: 0, y: 40 },
        {
          opacity: 1,
          y: 0,
          stagger: 0.15,
          duration: 0.7,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: grid,
            start: 'top 75%'
          }
        }
      );
    }

    if (reducedMotion) {
      var cards = Array.prototype.slice.call(section.querySelectorAll('[data-ait-card]'));
      cards.forEach(function (card) {
        card.style.opacity = '1';
        card.style.transform = 'none';
      });
    } else {
      window.__aboutChapterInits = window.__aboutChapterInits || [];
      window.__aboutChapterInits.push(initAit);
      initAit();
    }
  })();
</script>

{% schema %}
{
  "name": "About - Identity Triptych",
  "tag": "section",
  "class": "shopify-section--about-identity-triptych",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background (also this chapter's scroll-color zone)", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#141414" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#5B5B5B" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#2E7D32" },
    { "type": "color", "id": "next_zone_color", "label": "Hand-off color to the next (dark) chapter", "info": "The shared background starts fading to this color as the reader nears the bottom of this section, so the transition into the next chapter feels anticipated rather than abrupt.", "default": "#123321" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "who", "label": "Who We Are (people)" },
            { "value": "mission", "label": "Mission (mortar & pestle)" },
            { "value": "vision", "label": "Vision (leaf)" }
          ],
          "default": "who"
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Who We Are" },
        { "type": "richtext", "id": "content", "label": "Content" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About - Identity Triptych",
      "blocks": [
        { "type": "point", "settings": { "icon": "who", "label": "Who We Are" } },
        { "type": "point", "settings": { "icon": "mission", "label": "Our Mission" } },
        { "type": "point", "settings": { "icon": "vision", "label": "Our Vision" } }
      ]
    }
  ]
}
{% endschema %}
