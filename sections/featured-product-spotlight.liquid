    { "type": "text", "id": "share_label", "label": "Share label", "default": "Share" },

    { "type": "header", "content": "Background" },
    { "type": "checkbox", "id": "sync_scroll_bg", "label": "Sync background with page scroll effect", "info": "Joins the whole-page background color morph shared with other sections that opt in, instead of showing this section's own flat background block.", "default": true },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#F2F6F1" },
    { "type": "color", "id": "card_color", "label": "Panel background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#141414" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#6B6B6B" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#2E7D32" },
    { "type": "color", "id": "cta_color", "label": "CTA (buttons, badges)", "default": "#F58220" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#ECECEC" },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 5, "unit": "px", "default": 90 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 5, "unit": "px", "default": 90 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "limit": 4,
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "reason", "label": "Why use it?", "info": "Optional short line shown in the hover popup on this product's image, alongside its name and price." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Essentials Pack",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
