    { "type": "color", "id": "card_color", "label": "Panel background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#141414" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#6B6B6B" },
    { "type": "color", "id": "accent_color", "label": "Accent (include toggle)", "default": "#2E7D32" },
    { "type": "color", "id": "cta_color", "label": "CTA (buttons, badges, promo note)", "default": "#F58220" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#ECECEC" },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 5, "unit": "px", "default": 90 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 5, "unit": "px", "default": 90 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "highlight_line", "label": "Highlight line", "info": "e.g. Fast Wellness in Every Sip" },
        { "type": "text", "id": "specifications", "label": "Specifications", "info": "e.g. 250ml can | 1-day supply" },
        { "type": "checkbox", "id": "default_selected", "label": "Included by default", "default": true },
        { "type": "number", "id": "default_quantity", "label": "Default quantity" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Pack Bundle",
      "blocks": [
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
