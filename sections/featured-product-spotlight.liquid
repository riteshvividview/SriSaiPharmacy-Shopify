{%- comment -%}
  Section: Essentials Pack
  Homepage "buy these essentials together" section, matching the
  reference layout exactly: one panel, a 2x2 grid of up to 4 DIFFERENT
  products' own main images on the left, and hand-written content on
  the right (title, description, specs - typed by the merchant, since
  there is no single "the product" here to pull that copy from
  automatically). Price is the real, automatically summed total of the
  chosen products' current prices (and compare-at prices, for the
  discount badge) - never typed in manually, so it can't drift out of
  sync with actual pricing. One click on "Add Pack to Cart" adds every
  chosen product's default variant to the real Shopify cart in a
  single request.

  Pick up to 4 products as blocks (the block type is capped at 4 in
  the schema). If a chosen product's current variant is sold out, its
  grid image gets a "Sold out" ribbon and it's automatically left out
  of both the price total and the cart request - the rest of the pack
  still adds normally.
{%- endcomment -%}

{{ 'https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@400;500;600;700;800&display=swap' | stylesheet_tag }}

{%- liquid
  assign section_id = section.id
  assign s = section.settings
  assign items = section.blocks

  assign total_price = 0
  assign total_compare = 0
  assign available_count = 0
  for block in items
    assign item_product = block.settings.product
    if item_product != blank
      assign item_variant = item_product.selected_or_first_available_variant
      if item_variant.available
        assign total_price = total_price | plus: item_variant.price
        if item_variant.compare_at_price > item_variant.price
          assign total_compare = total_compare | plus: item_variant.compare_at_price
        else
          assign total_compare = total_compare | plus: item_variant.price
        endif
        assign available_count = available_count | plus: 1
      endif
    endif
  endfor
-%}

<section
  class="fs{% if s.sync_scroll_bg %} fs--transparent-bg{% endif %}"
  id="fs-{{ section_id }}"
  {% if s.sync_scroll_bg %}data-scroll-bg-zone="{{ s.background_color | default: '#F2F6F1' }}"{% endif %}
  style="
    --fs-bg: {{ s.background_color | default: '#F2F6F1' }};
    --fs-card-bg: {{ s.card_color | default: '#FFFFFF' }};
    --fs-text: {{ s.text_color | default: '#141414' }};
    --fs-muted: {{ s.muted_color | default: '#6B6B6B' }};
    --fs-accent: {{ s.accent_color | default: '#2E7D32' }};
    --fs-cta: {{ s.cta_color | default: '#F58220' }};
    --fs-border: {{ s.border_color | default: '#ECECEC' }};
    --fs-padding-top: {{ s.padding_top | default: 90 }}px;
    --fs-padding-bottom: {{ s.padding_bottom | default: 90 }}px;
  "
>
  <div class="fs__container">
    {%- if s.eyebrow != blank -%}<p class="fs__section-eyebrow" data-reveal>{{ s.eyebrow }}</p>{%- endif -%}
    {%- if s.heading != blank -%}<h2 class="fs__section-heading" data-reveal>{{ s.heading }}</h2>{%- endif -%}

    {%- if items.size == 0 -%}
      {%- if request.design_mode -%}
        <div class="fs__placeholder">Add up to 4 product blocks in section settings to build this pack.</div>
      {%- endif -%}
    {%- else -%}
      <div class="fs__panel" data-reveal>
        <div class="fs__grid">
          {%- for block in items limit: 4 -%}
            {%- assign item_product = block.settings.product -%}
            <span class="fs__grid-cell{% if forloop.first %} fs__grid-cell--primary{% endif %}{% if item_product == blank %} fs__grid-cell--empty{% endif %}">
              {%- if item_product != blank -%}
                {%- assign item_variant = item_product.selected_or_first_available_variant -%}
                {%- if item_product.featured_image != blank -%}
                  <img
                    src="{{ item_product.featured_image | image_url: width: 500 }}"
                    srcset="{{ item_product.featured_image | image_url: width: 350 }} 350w, {{ item_product.featured_image | image_url: width: 500 }} 500w"
                    sizes="(max-width: 899px) 45vw, 260px"
                    alt="{{ item_product.featured_image.alt | default: item_product.title | escape }}"
                    width="{{ item_product.featured_image.width }}"
                    height="{{ item_product.featured_image.height }}"
                    loading="lazy"
                  >
                {%- else -%}
                  <span class="fs__grid-placeholder" aria-hidden="true">
                    <svg width="34" height="34" viewBox="0 0 24 24" fill="none"><path d="M6 8h12l-1 12H7L6 8Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
                  </span>
                {%- endif -%}
                {%- if item_variant.available == false -%}
                  <span class="fs__grid-ribbon">{{ s.sold_out_text | default: 'Sold out' }}</span>
                {%- endif -%}
              {%- endif -%}
            </span>
          {%- endfor -%}
        </div>

        <div class="fs__info">
          {%- if s.product_eyebrow != blank -%}<p class="fs__product-eyebrow">{{ s.product_eyebrow }}</p>{%- endif -%}
          {%- if s.product_title != blank -%}<h3 class="fs__title">{{ s.product_title }}</h3>{%- endif -%}

          <div class="fs__price-row">
            <span class="fs__price" data-fs-total-price>{{ total_price | money }}</span>
            {%- if total_compare > total_price -%}
              <span class="fs__price-compare" data-fs-total-compare>{{ total_compare | money }}</span>
              {%- assign discount = total_compare | minus: total_price | times: 100.0 | divided_by: total_compare | round -%}
              <span class="fs__discount">-{{ discount }}% OFF</span>
            {%- endif -%}
          </div>

          {%- if s.show_shipping_note -%}
            <p class="fs__shipping-note"><a href="{{ s.shipping_policy_url | default: routes.root_url }}">{{ s.shipping_note_label | default: 'Shipping' }}</a> {{ s.shipping_note_text | default: 'calculated at checkout.' }}</p>
          {%- endif -%}

          {%- if s.highlight_line != blank -%}
            <p class="fs__highlight">{{ s.highlight_line }}</p>
          {%- endif -%}

          {%- if s.description != blank -%}
            <div class="fs__description">{{ s.description }}</div>
          {%- endif -%}

          {%- if s.specifications != blank -%}
            <p class="fs__specs"><strong>{{ s.specifications_label | default: 'Specifications:' }}</strong> {{ s.specifications }}</p>
          {%- endif -%}

          {%- if available_count == 0 -%}
            <p class="fs__all-out">{{ s.all_sold_out_text | default: 'All items in this pack are currently sold out.' }}</p>
          {%- endif -%}

          <div class="fs__quantity">
            <button type="button" class="fs__qty-btn" data-fs-qty-minus aria-label="Decrease quantity">−</button>
            <input type="number" value="1" min="1" class="fs__qty-input" data-fs-qty-input aria-label="Quantity">
            <button type="button" class="fs__qty-btn" data-fs-qty-plus aria-label="Increase quantity">+</button>
          </div>

          <div class="fs__cta-row">
            <button type="button" class="fs__add-btn" data-fs-add-btn {% if available_count == 0 %}disabled{% endif %}>
              <span data-fs-add-btn-text>{{ s.add_to_cart_text | default: 'Add Pack to Cart' }}</span>
            </button>
            {%- if s.show_buy_now -%}
              <button type="button" class="fs__buy-now-btn" data-fs-buy-now-btn {% if available_count == 0 %}disabled{% endif %}>{{ s.buy_now_text | default: 'Buy it now' }}</button>
            {%- endif -%}
          </div>

          <p class="fs__feedback" data-fs-feedback aria-live="polite"></p>

          {%- if s.show_share -%}
            <div class="fs__share">
              <span>{{ s.share_label | default: 'Share' }}</span>
              <a href="https://www.facebook.com/sharer/sharer.php?u={{ canonical_url | url_encode }}" target="_blank" rel="noopener" aria-label="Share on Facebook"><svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12Z"/></svg></a>
              <a href="https://twitter.com/intent/tweet?url={{ canonical_url | url_encode }}" target="_blank" rel="noopener" aria-label="Share on X"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 2H22l-7.6 8.7L23.3 22h-7.2l-5.6-7.3L4 22H1l8.1-9.3L.9 2h7.4l5 6.7L18.9 2Zm-1.3 18h1.7L7.5 4H5.7L17.6 20Z"/></svg></a>
              <a href="https://pinterest.com/pin/create/button/?url={{ canonical_url | url_encode }}" target="_blank" rel="noopener" aria-label="Share on Pinterest"><svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.6 19.3c-.05-.8-.1-2 .02-2.9l1.3-5.5s-.3-.7-.3-1.6c0-1.5.9-2.7 2-2.7.9 0 1.4.7 1.4 1.6 0 1-.6 2.4-.9 3.7-.3 1.1.5 2 1.6 2 1.9 0 3.2-2.4 3.2-5.3 0-2.2-1.5-3.8-4.2-3.8-3 0-4.9 2.2-4.9 4.7 0 .9.3 1.5.7 2 .2.2.2.3.1.5l-.2.9c-.1.3-.3.4-.6.3-1.3-.5-1.9-2-1.9-3.6 0-2.7 2.3-5.9 6.8-5.9 3.6 0 6 2.6 6 5.4 0 3.7-2 6.5-5 6.5-1 0-1.9-.5-2.3-1.2l-.6 2.5c-.2.9-.7 2-1.1 2.6A10 10 0 1 0 12 2Z"/></svg></a>
            </div>
          {%- endif -%}
        </div>
      </div>

      <script type="application/json" data-fs-pack-items>
        [
          {%- for block in items limit: 4 -%}
            {%- assign item_product = block.settings.product -%}
            {%- if item_product != blank -%}
              {%- assign item_variant = item_product.selected_or_first_available_variant -%}
              {%- unless forloop.first -%},{%- endunless -%}
              { "variantId": {{ item_variant.id | json }}, "available": {{ item_variant.available | json }} }
            {%- endif -%}
          {%- endfor -%}
        ]
      </script>
    {%- endif -%}
  </div>
</section>

{%- comment -%} ---------------- CSS ---------------- {%- endcomment -%}
<style>
  #fs-{{ section_id }} {
    position: relative;
    background: var(--fs-bg);
    color: var(--fs-text);
    font-family: 'Poppins', sans-serif;
    padding: var(--fs-padding-top) 20px var(--fs-padding-bottom);
  }

  #fs-{{ section_id }}.fs--transparent-bg {
    background: transparent;
  }

  #fs-{{ section_id }} * {
    box-sizing: border-box;
  }

  #fs-{{ section_id }} a {
    color: inherit;
  }

  #fs-{{ section_id }} .fs__container {
    max-width: 1100px;
    margin: 0 auto;
  }

  #fs-{{ section_id }} .fs__placeholder {
    padding: 60px 20px;
    text-align: center;
    border: 1.5px dashed var(--fs-border);
    border-radius: 16px;
    color: var(--fs-muted);
  }

  #fs-{{ section_id }} [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 24px, 0);
    transition: opacity 0.7s cubic-bezier(0.22, 0.61, 0.36, 1), transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  #fs-{{ section_id }} [data-reveal].is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  #fs-{{ section_id }} .fs__section-eyebrow {
    margin: 0 0 10px;
    font-weight: 600;
    font-size: 12.5px;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--fs-accent);
    text-align: center;
  }

  #fs-{{ section_id }} .fs__section-heading {
    margin: 0 0 40px;
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-weight: 400;
    font-size: clamp(28px, 3.8vw, 42px);
    line-height: 1.05;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    text-align: center;
  }

  #fs-{{ section_id }} .fs__panel {
    display: grid;
    grid-template-columns: minmax(0, 460px) minmax(0, 1fr);
    gap: 56px;
    align-items: start;
    background: var(--fs-card-bg);
    border-radius: 28px;
    padding: 32px;
    box-shadow: 0 30px 70px rgba(20, 20, 20, 0.08);
  }

  /* ---- 2x2 image grid: 4 different products ---- */
  #fs-{{ section_id }} .fs__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  #fs-{{ section_id }} .fs__grid-cell {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: 16px;
    overflow: hidden;
    background: var(--fs-bg);
  }

  #fs-{{ section_id }} .fs__grid-cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #fs-{{ section_id }} .fs__grid-cell--empty {
    border: 1.5px dashed var(--fs-border);
  }

  #fs-{{ section_id }} .fs__grid-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--fs-accent);
    opacity: 0.4;
  }

  #fs-{{ section_id }} .fs__grid-ribbon {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 4px 10px;
    border-radius: 999px;
    background: #c0392b;
    color: #fff;
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.4px;
  }

  /* ---- Info ---- */
  #fs-{{ section_id }} .fs__info {
    min-width: 0;
  }

  #fs-{{ section_id }} .fs__product-eyebrow {
    margin: 0 0 8px;
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--fs-cta);
  }

  #fs-{{ section_id }} .fs__title {
    margin: 0 0 16px;
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-weight: 400;
    font-size: clamp(24px, 2.6vw, 32px);
    line-height: 1.1;
    letter-spacing: 0.3px;
    text-transform: uppercase;
  }

  #fs-{{ section_id }} .fs__price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
  }

  #fs-{{ section_id }} .fs__price {
    font-size: 20px;
    font-weight: 700;
  }

  #fs-{{ section_id }} .fs__price-compare {
    font-size: 15px;
    color: var(--fs-muted);
    text-decoration: line-through;
  }

  #fs-{{ section_id }} .fs__discount {
    padding: 4px 10px;
    border-radius: 6px;
    background: var(--fs-cta);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
  }

  #fs-{{ section_id }} .fs__shipping-note {
    margin: 0 0 16px;
    font-size: 13px;
    color: var(--fs-muted);
  }

  #fs-{{ section_id }} .fs__shipping-note a {
    color: var(--fs-cta);
    text-decoration: underline;
  }

  #fs-{{ section_id }} .fs__highlight {
    margin: 0 0 10px;
    font-weight: 700;
    font-size: 14.5px;
  }

  #fs-{{ section_id }} .fs__description {
    margin: 0 0 14px;
    font-size: 14px;
    line-height: 1.7;
    color: var(--fs-muted);
    padding-bottom: 16px;
    border-bottom: 1px solid var(--fs-border);
  }

  #fs-{{ section_id }} .fs__description p {
    margin: 0 0 0.8em;
  }

  #fs-{{ section_id }} .fs__description p:last-child {
    margin-bottom: 0;
  }

  #fs-{{ section_id }} .fs__specs {
    margin: 0 0 18px;
    font-size: 13.5px;
    color: var(--fs-muted);
  }

  #fs-{{ section_id }} .fs__specs strong {
    color: var(--fs-text);
  }

  #fs-{{ section_id }} .fs__all-out {
    margin: 0 0 16px;
    font-size: 13px;
    font-weight: 700;
    color: #c0392b;
  }

  /* ---- Quantity ---- */
  #fs-{{ section_id }} .fs__quantity {
    display: inline-flex;
    align-items: center;
    border: 1.5px solid var(--fs-border);
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 16px;
  }

  #fs-{{ section_id }} .fs__qty-btn {
    width: 34px;
    height: 38px;
    border: none;
    background: none;
    font-size: 16px;
    color: var(--fs-text);
    cursor: pointer;
  }

  #fs-{{ section_id }} .fs__qty-btn:hover {
    color: var(--fs-cta);
  }

  #fs-{{ section_id }} .fs__qty-input {
    width: 38px;
    height: 38px;
    border: none;
    border-left: 1px solid var(--fs-border);
    border-right: 1px solid var(--fs-border);
    text-align: center;
    font-family: 'Poppins', sans-serif;
    font-size: 13px;
    -moz-appearance: textfield;
  }

  #fs-{{ section_id }} .fs__qty-input::-webkit-outer-spin-button,
  #fs-{{ section_id }} .fs__qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  #fs-{{ section_id }} .fs__cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 4px;
  }

  #fs-{{ section_id }} .fs__add-btn,
  #fs-{{ section_id }} .fs__buy-now-btn {
    flex: 1;
    min-width: 140px;
    height: 46px;
    padding: 0 20px;
    border-radius: 999px;
    border: none;
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    transition: background-color 0.25s ease, transform 0.2s ease, opacity 0.2s ease;
  }

  #fs-{{ section_id }} .fs__add-btn {
    background: var(--fs-cta);
    color: #fff;
  }

  #fs-{{ section_id }} .fs__add-btn:hover:not([disabled]) {
    transform: translateY(-2px);
  }

  #fs-{{ section_id }} .fs__add-btn[disabled],
  #fs-{{ section_id }} .fs__buy-now-btn[disabled] {
    background: #b7b7b7;
    cursor: not-allowed;
    transform: none;
  }

  #fs-{{ section_id }} .fs__add-btn.is-loading,
  #fs-{{ section_id }} .fs__buy-now-btn.is-loading {
    opacity: 0.75;
    cursor: wait;
  }

  #fs-{{ section_id }} .fs__buy-now-btn {
    background: #1a1a1a;
    color: #fff;
  }

  #fs-{{ section_id }} .fs__buy-now-btn:hover:not([disabled]) {
    background: var(--fs-accent);
    transform: translateY(-2px);
  }

  #fs-{{ section_id }} .fs__feedback {
    min-height: 18px;
    margin: 10px 0 4px;
    font-size: 12.5px;
    font-weight: 600;
  }

  #fs-{{ section_id }} .fs__feedback.is-success {
    color: var(--fs-accent);
  }

  #fs-{{ section_id }} .fs__feedback.is-error {
    color: #c0392b;
  }

  /* ---- Share ---- */
  #fs-{{ section_id }} .fs__share {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 10px;
    font-size: 12.5px;
    color: var(--fs-muted);
  }

  #fs-{{ section_id }} .fs__share a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--fs-bg);
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  #fs-{{ section_id }} .fs__share a:hover {
    background: var(--fs-accent);
    color: #fff;
  }

  /* ---- Tablet / Mobile ---- */
  @media (max-width: 899px) {
    #fs-{{ section_id }} .fs__panel {
      grid-template-columns: 1fr;
      padding: 22px;
      gap: 28px;
    }
  }

  @media (max-width: 749px) {
    #fs-{{ section_id }} {
      padding-left: 16px;
      padding-right: 16px;
    }

    #fs-{{ section_id }} .fs__panel {
      border-radius: 20px;
      padding: 18px;
    }

    #fs-{{ section_id }} .fs__cta-row {
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #fs-{{ section_id }} [data-reveal] {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>

{%- comment -%} ---------------- JS ---------------- {%- endcomment -%}
<script>
  (function () {
    var section = document.getElementById('fs-{{ section_id }}');
    if (!section) return;

    var revealTargets = Array.prototype.slice.call(section.querySelectorAll('[data-reveal]'));
    if (revealTargets.length) {
      if ('IntersectionObserver' in window) {
        var revealObserver = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                revealObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 }
        );
        revealTargets.forEach(function (el) { revealObserver.observe(el); });
      } else {
        revealTargets.forEach(function (el) { el.classList.add('is-visible'); });
      }
    }

    var itemsScript = section.querySelector('[data-fs-pack-items]');
    if (!itemsScript) return;
    var packItems = [];
    try { packItems = JSON.parse(itemsScript.textContent); } catch (e) { packItems = []; }
    var availableItems = packItems.filter(function (item) { return item.available; });
    if (!availableItems.length) return;

    var basePriceCents = {{ total_price }};
    var baseCompareCents = {{ total_compare }};

    var qtyInput = section.querySelector('[data-fs-qty-input]');
    var qtyMinus = section.querySelector('[data-fs-qty-minus]');
    var qtyPlus = section.querySelector('[data-fs-qty-plus]');
    var priceEl = section.querySelector('[data-fs-total-price]');
    var compareEl = section.querySelector('[data-fs-total-compare]');

    function money(amountCents) {
      return '{{ shop.money_format }}'.replace(/\{\{\s*amount\s*\}\}/, (amountCents / 100).toFixed(2));
    }

    function updatePriceDisplay() {
      var qty = parseInt((qtyInput && qtyInput.value) || 1, 10) || 1;
      if (priceEl) priceEl.textContent = money(basePriceCents * qty);
      if (compareEl) compareEl.textContent = money(baseCompareCents * qty);
    }

    if (qtyInput && qtyMinus && qtyPlus) {
      qtyMinus.addEventListener('click', function () {
        qtyInput.value = Math.max(1, (parseInt(qtyInput.value, 10) || 1) - 1);
        updatePriceDisplay();
      });
      qtyPlus.addEventListener('click', function () {
        qtyInput.value = (parseInt(qtyInput.value, 10) || 1) + 1;
        updatePriceDisplay();
      });
      qtyInput.addEventListener('change', updatePriceDisplay);
    }

    var addBtn = section.querySelector('[data-fs-add-btn]');
    var buyNowBtn = section.querySelector('[data-fs-buy-now-btn]');
    var feedback = section.querySelector('[data-fs-feedback]');

    function setFeedback(message, type) {
      if (!feedback) return;
      feedback.textContent = message;
      feedback.classList.remove('is-success', 'is-error');
      if (type) feedback.classList.add(type);
    }

    function bumpCartBubble(itemCount) {
      var counts = document.querySelectorAll('.cart-bubble__text-count');
      counts.forEach(function (el) { el.textContent = itemCount; });
    }

    function buildPayload() {
      var qty = parseInt((qtyInput && qtyInput.value) || 1, 10) || 1;
      return {
        items: availableItems.map(function (item) {
          return { id: item.variantId, quantity: qty };
        })
      };
    }

    function addPackToCart(onSuccess) {
      return fetch('{{ routes.cart_add_url }}', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(buildPayload())
      })
        .then(function (response) { return response.json().then(function (data) { return { ok: response.ok, data: data }; }); })
        .then(function (result) {
          if (!result.ok) {
            var message = (result.data.description) || (result.data.message) || 'Could not add the pack to cart.';
            setFeedback(message, 'is-error');
            return false;
          }
          if (onSuccess) onSuccess();
          return true;
        })
        .catch(function () {
          setFeedback('Could not add the pack to cart. Please try again.', 'is-error');
          return false;
        });
    }

    if (addBtn) {
      addBtn.addEventListener('click', function () {
        if (addBtn.disabled) return;
        addBtn.classList.add('is-loading');
        setFeedback('', null);

        addPackToCart(function () {
          setFeedback('{{ s.added_to_cart_text | default: "Pack added to cart" | escape }}', 'is-success');
          fetch('{{ routes.cart_url }}.js')
            .then(function (r) { return r.json(); })
            .then(function (cart) { bumpCartBubble(cart.item_count); })
            .catch(function () {});
        }).then(function () {
          addBtn.classList.remove('is-loading');
        });
      });
    }

    if (buyNowBtn) {
      buyNowBtn.addEventListener('click', function () {
        if (buyNowBtn.disabled) return;
        buyNowBtn.classList.add('is-loading');
        setFeedback('', null);

        addPackToCart(function () {
          window.location.href = '{{ routes.cart_url }}';
        }).then(function (success) {
          if (!success) buyNowBtn.classList.remove('is-loading');
        });
      });
    }

    updatePriceDisplay();
  })();
</script>

