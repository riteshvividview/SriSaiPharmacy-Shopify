{%- comment -%}
  Section: Product Pack Bundle
  Homepage "build your own pack" section - the merchant adds several
  DIFFERENT products as blocks, the shopper ticks which ones they want
  (all ticked by default), and one button adds every ticked item to the
  real Shopify cart in a single request. This replaces an earlier
  single-product/variant version after feedback that a "pack" should
  mean multiple distinct products bundled together, not one product's
  own size/flavor options.

  Two things worth knowing:
  - Each product block adds that product's own default/first-available
    variant. There is no per-product variant picker inside the pack
    (size/flavor per item) - adding that on top of multi-select would
    make the UI considerably heavier; flag if you want it added for a
    specific product.
  - This section cannot apply an automatic bundle discount to the
    price shown at checkout - that requires either a discount code the
    shopper enters, an Automatic Discount configured in Shopify Admin
    (Discounts > percentage off, targeted at these products/a
    collection/tag), or a bundle app/Shopify Function. The optional
    "Promo note" field below is just merchant-editable text (e.g. "Save
    10% with code PACK10") - it does not change any price on its own.
    The total shown is always the real, accurate sum of selected items.
{%- endcomment -%}

{{ 'https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@400;500;600;700;800&display=swap' | stylesheet_tag }}

{%- liquid
  assign section_id = section.id
  assign s = section.settings
  assign items = section.blocks
-%}

<section
  class="pb{% if s.sync_scroll_bg %} pb--transparent-bg{% endif %}"
  id="pb-{{ section_id }}"
  {% if s.sync_scroll_bg %}data-scroll-bg-zone="{{ s.background_color | default: '#F2F6F1' }}"{% endif %}
  style="
    --pb-bg: {{ s.background_color | default: '#F2F6F1' }};
    --pb-card-bg: {{ s.card_color | default: '#FFFFFF' }};
    --pb-text: {{ s.text_color | default: '#141414' }};
    --pb-muted: {{ s.muted_color | default: '#6B6B6B' }};
    --pb-accent: {{ s.accent_color | default: '#2E7D32' }};
    --pb-cta: {{ s.cta_color | default: '#F58220' }};
    --pb-border: {{ s.border_color | default: '#ECECEC' }};
    --pb-padding-top: {{ s.padding_top | default: 90 }}px;
    --pb-padding-bottom: {{ s.padding_bottom | default: 90 }}px;
    --pb-columns: {{ s.columns_desktop | default: 2 }};
  "
>
  <div class="pb__container">
    {%- if s.eyebrow != blank -%}<p class="pb__eyebrow" data-reveal>{{ s.eyebrow }}</p>{%- endif -%}
    {%- if s.heading != blank -%}<h2 class="pb__heading" data-reveal>{{ s.heading }}</h2>{%- endif -%}
    {%- if s.subheading != blank -%}<p class="pb__subheading" data-reveal>{{ s.subheading }}</p>{%- endif -%}

    {%- if items.size == 0 -%}
      {%- if request.design_mode -%}
        <div class="pb__placeholder">Add product blocks in section settings to build this pack.</div>
      {%- endif -%}
    {%- else -%}
      <div class="pb__panel" data-reveal>
        <div class="pb__grid" data-pb-grid>
          {%- for block in items -%}
            {%- assign bs = block.settings -%}
            {%- assign item_product = bs.product -%}
            {%- if item_product != blank -%}
              {%- assign item_variant = item_product.selected_or_first_available_variant -%}
              <label
                class="pb__item{% if bs.default_selected %} is-selected{% endif %}"
                data-pb-item
                data-variant-id="{{ item_variant.id }}"
                data-price="{{ item_variant.price }}"
                data-available="{{ item_variant.available }}"
                {{ block.shopify_attributes }}
              >
                <input
                  type="checkbox"
                  class="pb__item-checkbox"
                  data-pb-item-checkbox
                  {% if bs.default_selected %}checked{% endif %}
                  {% if item_variant.available == false %}disabled{% endif %}
                >
                <span class="pb__item-media">
                  {%- if item_product.featured_image != blank -%}
                    <img
                      src="{{ item_product.featured_image | image_url: width: 200 }}"
                      alt="{{ item_product.featured_image.alt | default: item_product.title | escape }}"
                      width="{{ item_product.featured_image.width }}"
                      height="{{ item_product.featured_image.height }}"
                      loading="lazy"
                    >
                  {%- else -%}
                    <span class="pb__item-placeholder" aria-hidden="true">
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M6 8h12l-1 12H7L6 8Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
                    </span>
                  {%- endif -%}
                </span>
                <span class="pb__item-body">
                  <span class="pb__item-title">{{ item_product.title }}</span>
                  {%- if item_variant.available == false -%}
                    <span class="pb__item-price pb__item-price--unavailable">{{ s.sold_out_text | default: 'Sold out' }}</span>
                  {%- else -%}
                    <span class="pb__item-price">
                      {{ item_variant.price | money }}
                      {%- if item_variant.compare_at_price > item_variant.price -%}
                        <span class="pb__item-price-compare">{{ item_variant.compare_at_price | money }}</span>
                      {%- endif -%}
                    </span>
                  {%- endif -%}
                </span>
                <span class="pb__item-check" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 14 14" fill="none"><path d="M2.5 7.2 5.4 10 11.5 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </label>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="pb__summary">
          {%- if s.promo_note != blank -%}
            <p class="pb__promo-note">{{ s.promo_note }}</p>
          {%- endif -%}
          <div class="pb__summary-row">
            <span class="pb__summary-label" data-pb-count>0 {{ s.items_label | default: 'items selected' }}</span>
            <span class="pb__summary-total"><span data-pb-total>{{ 0 | money }}</span></span>
          </div>
          <button type="button" class="pb__add-btn" data-pb-add-btn disabled>
            <span data-pb-add-btn-text>{{ s.add_to_cart_text | default: 'Add Pack to Cart' }}</span>
          </button>
          <p class="pb__feedback" data-pb-feedback aria-live="polite"></p>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{%- comment -%} ---------------- CSS ---------------- {%- endcomment -%}
<style>
  #pb-{{ section_id }} {
    position: relative;
    background: var(--pb-bg);
    color: var(--pb-text);
    font-family: 'Poppins', sans-serif;
    padding: var(--pb-padding-top) 20px var(--pb-padding-bottom);
  }

  #pb-{{ section_id }}.pb--transparent-bg {
    background: transparent;
  }

  #pb-{{ section_id }} * {
    box-sizing: border-box;
  }

  #pb-{{ section_id }} .pb__container {
    max-width: 1100px;
    margin: 0 auto;
  }

  #pb-{{ section_id }} .pb__placeholder {
    padding: 60px 20px;
    text-align: center;
    border: 1.5px dashed var(--pb-border);
    border-radius: 16px;
    color: var(--pb-muted);
  }

  #pb-{{ section_id }} [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 22px, 0);
    transition: opacity 0.65s cubic-bezier(0.22, 0.61, 0.36, 1), transform 0.65s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  #pb-{{ section_id }} [data-reveal].is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  #pb-{{ section_id }} .pb__eyebrow {
    margin: 0 0 10px;
    font-weight: 600;
    font-size: 12.5px;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--pb-accent);
    text-align: center;
  }

  #pb-{{ section_id }} .pb__heading {
    margin: 0 0 12px;
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-weight: 400;
    font-size: clamp(28px, 3.8vw, 42px);
    line-height: 1.05;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    text-align: center;
  }

  #pb-{{ section_id }} .pb__subheading {
    max-width: 560px;
    margin: 0 auto 36px;
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--pb-muted);
    text-align: center;
  }

  #pb-{{ section_id }} .pb__panel {
    background: var(--pb-card-bg);
    border-radius: 26px;
    padding: 28px;
    box-shadow: 0 30px 70px rgba(20, 20, 20, 0.08);
  }

  /* ---- Item grid ---- */
  #pb-{{ section_id }} .pb__grid {
    display: grid;
    grid-template-columns: repeat(var(--pb-columns), 1fr);
    gap: 14px;
    margin-bottom: 22px;
  }

  #pb-{{ section_id }} .pb__item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px;
    border: 1.5px solid var(--pb-border);
    border-radius: 16px;
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  #pb-{{ section_id }} .pb__item.is-selected {
    border-color: var(--pb-accent);
    background: color-mix(in srgb, var(--pb-accent) 6%, transparent);
  }

  #pb-{{ section_id }} .pb__item-checkbox {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  #pb-{{ section_id }} .pb__item-media {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: 12px;
    overflow: hidden;
    background: var(--pb-bg);
  }

  #pb-{{ section_id }} .pb__item-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #pb-{{ section_id }} .pb__item-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--pb-accent);
    opacity: 0.4;
  }

  #pb-{{ section_id }} .pb__item-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  #pb-{{ section_id }} .pb__item-title {
    font-weight: 600;
    font-size: 14px;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  #pb-{{ section_id }} .pb__item-price {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--pb-accent);
  }

  #pb-{{ section_id }} .pb__item-price--unavailable {
    color: #c0392b;
    font-weight: 600;
  }

  #pb-{{ section_id }} .pb__item-price-compare {
    font-size: 12px;
    font-weight: 400;
    color: var(--pb-muted);
    text-decoration: line-through;
  }

  #pb-{{ section_id }} .pb__item-check {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1.5px solid var(--pb-border);
    color: transparent;
    background: #fff;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  #pb-{{ section_id }} .pb__item.is-selected .pb__item-check {
    background: var(--pb-accent);
    border-color: var(--pb-accent);
    color: #fff;
  }

  #pb-{{ section_id }} .pb__item-checkbox:focus-visible ~ .pb__item-check {
    outline: 2px solid var(--pb-accent);
    outline-offset: 2px;
  }

  /* ---- Summary ---- */
  #pb-{{ section_id }} .pb__summary {
    border-top: 1px solid var(--pb-border);
    padding-top: 22px;
  }

  #pb-{{ section_id }} .pb__promo-note {
    margin: 0 0 14px;
    font-size: 13px;
    font-weight: 600;
    color: var(--pb-cta);
  }

  #pb-{{ section_id }} .pb__summary-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  #pb-{{ section_id }} .pb__summary-label {
    font-size: 13.5px;
    color: var(--pb-muted);
  }

  #pb-{{ section_id }} .pb__summary-total {
    font-size: 22px;
    font-weight: 700;
  }

  #pb-{{ section_id }} .pb__add-btn {
    display: block;
    width: 100%;
    height: 50px;
    border-radius: 999px;
    border: none;
    background: var(--pb-cta);
    color: #fff;
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
    transition: background-color 0.25s ease, transform 0.2s ease, opacity 0.2s ease;
  }

  #pb-{{ section_id }} .pb__add-btn:hover:not([disabled]) {
    transform: translateY(-2px);
  }

  #pb-{{ section_id }} .pb__add-btn[disabled] {
    background: #b7b7b7;
    cursor: not-allowed;
    transform: none;
  }

  #pb-{{ section_id }} .pb__add-btn.is-loading {
    opacity: 0.75;
    cursor: wait;
  }

  #pb-{{ section_id }} .pb__feedback {
    min-height: 18px;
    margin: 10px 0 0;
    text-align: center;
    font-size: 12.5px;
    font-weight: 600;
  }

  #pb-{{ section_id }} .pb__feedback.is-success {
    color: var(--pb-accent);
  }

  #pb-{{ section_id }} .pb__feedback.is-error {
    color: #c0392b;
  }

  @media (max-width: 599px) {
    #pb-{{ section_id }} .pb__grid {
      grid-template-columns: 1fr;
    }

    #pb-{{ section_id }} .pb__panel {
      padding: 20px;
      border-radius: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #pb-{{ section_id }} [data-reveal] {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>

{%- comment -%} ---------------- JS ---------------- {%- endcomment -%}
<script>
  (function () {
    var section = document.getElementById('pb-{{ section_id }}');
    if (!section) return;

    var revealTargets = Array.prototype.slice.call(section.querySelectorAll('[data-reveal]'));
    if (revealTargets.length) {
      if ('IntersectionObserver' in window) {
        var revealObserver = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                revealObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 }
        );
        revealTargets.forEach(function (el) { revealObserver.observe(el); });
      } else {
        revealTargets.forEach(function (el) { el.classList.add('is-visible'); });
      }
    }

    var items = Array.prototype.slice.call(section.querySelectorAll('[data-pb-item]'));
    if (!items.length) return;

    var countEl = section.querySelector('[data-pb-count]');
    var totalEl = section.querySelector('[data-pb-total]');
    var addBtn = section.querySelector('[data-pb-add-btn]');
    var addBtnText = section.querySelector('[data-pb-add-btn-text]');
    var feedback = section.querySelector('[data-pb-feedback]');
    var itemsLabel = '{{ s.items_label | default: "items selected" | escape }}';

    function money(amountCents) {
      return '{{ shop.money_format }}'.replace(/\{\{\s*amount\s*\}\}/, (amountCents / 100).toFixed(2));
    }

    function selectedItems() {
      return items.filter(function (el) {
        return el.getAttribute('data-available') === 'true' && el.classList.contains('is-selected');
      });
    }

    function updateSummary() {
      var selected = selectedItems();
      var total = selected.reduce(function (sum, el) { return sum + parseInt(el.getAttribute('data-price'), 10); }, 0);
      if (countEl) countEl.textContent = selected.length + ' ' + itemsLabel;
      if (totalEl) totalEl.textContent = money(total);
      if (addBtn) addBtn.disabled = selected.length === 0;
    }

    items.forEach(function (item) {
      var checkbox = item.querySelector('[data-pb-item-checkbox]');
      if (!checkbox) return;
      checkbox.addEventListener('change', function () {
        item.classList.toggle('is-selected', checkbox.checked);
        updateSummary();
      });
    });

    updateSummary();

    function setFeedback(message, type) {
      if (!feedback) return;
      feedback.textContent = message;
      feedback.classList.remove('is-success', 'is-error');
      if (type) feedback.classList.add(type);
    }

    function bumpCartBubble(itemCount) {
      var counts = document.querySelectorAll('.cart-bubble__text-count');
      counts.forEach(function (el) { el.textContent = itemCount; });
    }

    if (addBtn) {
      addBtn.addEventListener('click', function () {
        var selected = selectedItems();
        if (!selected.length || addBtn.disabled) return;

        addBtn.classList.add('is-loading');
        setFeedback('', null);

        var payload = {
          items: selected.map(function (el) {
            return { id: parseInt(el.getAttribute('data-variant-id'), 10), quantity: 1 };
          })
        };

        fetch('{{ routes.cart_add_url }}', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload)
        })
          .then(function (response) { return response.json().then(function (data) { return { ok: response.ok, data: data }; }); })
          .then(function (result) {
            addBtn.classList.remove('is-loading');
            if (!result.ok) {
              var message = (result.data.description) || (result.data.message) || 'Could not add the pack to cart.';
              setFeedback(message, 'is-error');
              return;
            }
            setFeedback('{{ s.added_to_cart_text | default: "Pack added to cart" | escape }}', 'is-success');
            fetch('{{ routes.cart_url }}.js')
              .then(function (r) { return r.json(); })
              .then(function (cart) { bumpCartBubble(cart.item_count); })
              .catch(function () {});
          })
          .catch(function () {
            addBtn.classList.remove('is-loading');
            setFeedback('Could not add the pack to cart. Please try again.', 'is-error');
          });
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Product Pack Bundle",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Build Your Pack" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Grab Your Essentials Pack" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Pick what you need and add the whole pack to your cart in one tap." },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "columns_desktop", "label": "Columns (desktop)", "min": 1, "max": 3, "step": 1, "default": 2 },

    { "type": "header", "content": "Summary & Button" },
    { "type": "text", "id": "items_label", "label": "Item-count label", "default": "items selected" },
    { "type": "text", "id": "add_to_cart_text", "label": "Add-to-cart button text", "default": "Add Pack to Cart" },
    { "type": "text", "id": "added_to_cart_text", "label": "Success message", "default": "Pack added to cart" },
    { "type": "text", "id": "sold_out_text", "label": "Sold out label", "default": "Sold out" },
    {
      "type": "text",
      "id": "promo_note",
      "label": "Promo note",
      "info": "Optional editable text only (e.g. \"Save 10% with code PACK10\"). This does not apply a real discount - set that up as an Automatic Discount in Shopify Admin > Discounts, or give shoppers a discount code to enter at checkout."
    },

    { "type": "header", "content": "Background" },
    { "type": "checkbox", "id": "sync_scroll_bg", "label": "Sync background with page scroll effect", "default": false },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#F2F6F1" },
    { "type": "color", "id": "card_color", "label": "Panel background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#141414" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#6B6B6B" },
    { "type": "color", "id": "accent_color", "label": "Accent (selected state, prices)", "default": "#2E7D32" },
    { "type": "color", "id": "cta_color", "label": "CTA (button, promo note)", "default": "#F58220" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#ECECEC" },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 5, "unit": "px", "default": 90 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 5, "unit": "px", "default": 90 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "checkbox", "id": "default_selected", "label": "Selected by default", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Pack Bundle",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
