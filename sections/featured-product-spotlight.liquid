{%- comment -%}
  Section: Essentials Pack
  Homepage "buy these essentials together" section, matching the
  reference layout exactly: one panel, a 2x2 grid of up to 4 DIFFERENT
  products' own main images on the left, and hand-written content on
  the right (title, description, specs - typed by the merchant, since
  there is no single "the product" here to pull that copy from
  automatically). Price is the real, automatically summed total of the
  chosen products' current prices (and compare-at prices, for the
  discount badge) - never typed in manually, so it can't drift out of
  sync with actual pricing. One click on "Add Pack to Cart" adds every
  chosen product's default variant to the real Shopify cart in a
  single request.

  Pick up to 4 products as blocks (the block type is capped at 4 in
  the schema). If a chosen product's current variant is sold out, its
  grid image gets a "Sold out" ribbon and it's automatically left out
  of both the price total and the cart request - the rest of the pack
  still adds normally.
{%- endcomment -%}

{{ 'https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@400;500;600;700;800&display=swap' | stylesheet_tag }}

{%- liquid
  assign section_id = section.id
  assign s = section.settings
  assign items = section.blocks

  assign total_price = 0
  assign total_compare = 0
  assign available_count = 0
  for block in items
    assign item_product = block.settings.product
    if item_product != blank
      assign item_variant = item_product.selected_or_first_available_variant
      if item_variant.available
        assign total_price = total_price | plus: item_variant.price
        if item_variant.compare_at_price > item_variant.price
          assign total_compare = total_compare | plus: item_variant.compare_at_price
        else
          assign total_compare = total_compare | plus: item_variant.price
        endif
        assign available_count = available_count | plus: 1
      endif
    endif
  endfor
-%}

<section
  class="fs{% if s.sync_scroll_bg %} fs--transparent-bg{% endif %}"
  id="fs-{{ section_id }}"
  {% if s.sync_scroll_bg %}data-scroll-bg-zone="{{ s.background_color | default: '#F2F6F1' }}"{% endif %}
  style="
    --fs-bg: {{ s.background_color | default: '#F2F6F1' }};
    --fs-card-bg: {{ s.card_color | default: '#FFFFFF' }};
    --fs-text: {{ s.text_color | default: '#141414' }};
    --fs-muted: {{ s.muted_color | default: '#6B6B6B' }};
    --fs-accent: {{ s.accent_color | default: '#2E7D32' }};
    --fs-cta: {{ s.cta_color | default: '#F58220' }};
    --fs-border: {{ s.border_color | default: '#ECECEC' }};
    --fs-padding-top: {{ s.padding_top | default: 90 }}px;
    --fs-padding-bottom: {{ s.padding_bottom | default: 90 }}px;
  "
>
  <div class="fs__container">
    {%- if s.eyebrow != blank -%}<p class="fs__section-eyebrow" data-reveal>{{ s.eyebrow }}</p>{%- endif -%}
    {%- if s.heading != blank -%}<h2 class="fs__section-heading" data-reveal>{{ s.heading }}</h2>{%- endif -%}

    {%- if items.size == 0 -%}
      {%- if request.design_mode -%}
        <div class="fs__placeholder">Add up to 4 product blocks in section settings to build this pack.</div>
      {%- endif -%}
    {%- else -%}
      <div class="fs__panel" data-reveal>
        <div class="fs__grid" data-fs-grid>
          <span class="fs__ghost-cursor" data-fs-ghost-cursor aria-hidden="true">
            <span class="fs__ghost-cursor-dot"></span>
            <span class="fs__ghost-cursor-label" data-fs-ghost-label>Hover to explore</span>
          </span>
          {%- for block in items limit: 4 -%}
            {%- assign item_product = block.settings.product -%}
            {%- if item_product != blank -%}
              {%- assign item_variant = item_product.selected_or_first_available_variant -%}
              <a
                href="{{ item_product.url }}"
                class="fs__grid-cell{% if forloop.first %} fs__grid-cell--primary{% endif %}"
                data-fs-cell
                data-fs-cell-drop
                data-fs-cell-index="{{ forloop.index0 }}"
                data-fs-magnetic
                data-fs-parallax="{{ forloop.index0 | modulo: 2 | times: 2 | minus: 1 | times: 34 }}"
              >
                <span class="fs__grid-cell-media">
                  {%- if item_product.featured_image != blank -%}
                    <img
                      src="{{ item_product.featured_image | image_url: width: 500 }}"
                      srcset="{{ item_product.featured_image | image_url: width: 350 }} 350w, {{ item_product.featured_image | image_url: width: 500 }} 500w"
                      sizes="(max-width: 899px) 45vw, 260px"
                      alt="{{ item_product.featured_image.alt | default: item_product.title | escape }}"
                      width="{{ item_product.featured_image.width }}"
                      height="{{ item_product.featured_image.height }}"
                      loading="lazy"
                    >
                  {%- else -%}
                    <span class="fs__grid-placeholder" aria-hidden="true">
                      <svg width="34" height="34" viewBox="0 0 24 24" fill="none"><path d="M6 8h12l-1 12H7L6 8Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
                    </span>
                  {%- endif -%}
                  {%- if item_variant.available == false -%}
                    <span class="fs__grid-ribbon">{{ s.sold_out_text | default: 'Sold out' }}</span>
                  {%- endif -%}
                </span>
                <span class="fs__cell-tip" data-fs-cell-tip aria-hidden="true">
                  <span class="fs__cell-tip-title">{{ item_product.title }}</span>
                  <span class="fs__cell-tip-price">{{ item_variant.price | money }}</span>
                  {%- if block.settings.reason != blank -%}
                    <span class="fs__cell-tip-reason">{{ block.settings.reason }}</span>
                  {%- endif -%}
                </span>
              </a>
            {%- else -%}
              <span class="fs__grid-cell fs__grid-cell--empty"></span>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="fs__info">
          {%- if s.product_eyebrow != blank -%}<p class="fs__product-eyebrow">{{ s.product_eyebrow }}</p>{%- endif -%}
          {%- if s.product_title != blank -%}<h3 class="fs__title">{{ s.product_title }}</h3>{%- endif -%}

          <div class="fs__price-row">
            <span class="fs__price" data-fs-total-price>{{ total_price | money }}</span>
            {%- if total_compare > total_price -%}
              <span class="fs__price-compare" data-fs-total-compare>{{ total_compare | money }}</span>
              {%- assign discount = total_compare | minus: total_price | times: 100.0 | divided_by: total_compare | round -%}
              <span class="fs__discount">-{{ discount }}% OFF</span>
            {%- endif -%}
          </div>

          {%- if s.show_shipping_note -%}
            <p class="fs__shipping-note"><a href="{{ s.shipping_policy_url | default: routes.root_url }}">{{ s.shipping_note_label | default: 'Shipping' }}</a> {{ s.shipping_note_text | default: 'calculated at checkout.' }}</p>
          {%- endif -%}

          {%- if s.highlight_line != blank -%}
            <p class="fs__highlight">{{ s.highlight_line }}</p>
          {%- endif -%}

          {%- if s.description != blank -%}
            <div class="fs__description">{{ s.description }}</div>
          {%- endif -%}

          {%- if s.specifications != blank -%}
            <p class="fs__specs"><strong>{{ s.specifications_label | default: 'Specifications:' }}</strong> {{ s.specifications }}</p>
          {%- endif -%}

          {%- if available_count == 0 -%}
            <p class="fs__all-out">{{ s.all_sold_out_text | default: 'All items in this pack are currently sold out.' }}</p>
          {%- endif -%}

          <div class="fs__quantity">
            <button type="button" class="fs__qty-btn" data-fs-qty-minus aria-label="Decrease quantity">−</button>
            <input type="number" value="1" min="1" class="fs__qty-input" data-fs-qty-input aria-label="Quantity">
            <button type="button" class="fs__qty-btn" data-fs-qty-plus aria-label="Increase quantity">+</button>
          </div>

          <div class="fs__cta-row">
            <button type="button" class="fs__add-btn" data-fs-add-btn {% if available_count == 0 %}disabled{% endif %}>
              <span data-fs-add-btn-text>{{ s.add_to_cart_text | default: 'Add Pack to Cart' }}</span>
            </button>
            {%- if s.show_buy_now -%}
              <button type="button" class="fs__buy-now-btn" data-fs-buy-now-btn {% if available_count == 0 %}disabled{% endif %}>{{ s.buy_now_text | default: 'Buy it now' }}</button>
            {%- endif -%}
          </div>

          <p class="fs__feedback" data-fs-feedback aria-live="polite"></p>

          {%- if s.show_share -%}
            <div class="fs__share">
              <span>{{ s.share_label | default: 'Share' }}</span>
              <a href="https://www.facebook.com/sharer/sharer.php?u={{ canonical_url | url_encode }}" target="_blank" rel="noopener" aria-label="Share on Facebook"><svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12Z"/></svg></a>
              <a href="https://twitter.com/intent/tweet?url={{ canonical_url | url_encode }}" target="_blank" rel="noopener" aria-label="Share on X"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 2H22l-7.6 8.7L23.3 22h-7.2l-5.6-7.3L4 22H1l8.1-9.3L.9 2h7.4l5 6.7L18.9 2Zm-1.3 18h1.7L7.5 4H5.7L17.6 20Z"/></svg></a>
              <a href="https://pinterest.com/pin/create/button/?url={{ canonical_url | url_encode }}" target="_blank" rel="noopener" aria-label="Share on Pinterest"><svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.6 19.3c-.05-.8-.1-2 .02-2.9l1.3-5.5s-.3-.7-.3-1.6c0-1.5.9-2.7 2-2.7.9 0 1.4.7 1.4 1.6 0 1-.6 2.4-.9 3.7-.3 1.1.5 2 1.6 2 1.9 0 3.2-2.4 3.2-5.3 0-2.2-1.5-3.8-4.2-3.8-3 0-4.9 2.2-4.9 4.7 0 .9.3 1.5.7 2 .2.2.2.3.1.5l-.2.9c-.1.3-.3.4-.6.3-1.3-.5-1.9-2-1.9-3.6 0-2.7 2.3-5.9 6.8-5.9 3.6 0 6 2.6 6 5.4 0 3.7-2 6.5-5 6.5-1 0-1.9-.5-2.3-1.2l-.6 2.5c-.2.9-.7 2-1.1 2.6A10 10 0 1 0 12 2Z"/></svg></a>
            </div>
          {%- endif -%}
        </div>
      </div>

      <script type="application/json" data-fs-pack-items>
        [
          {%- for block in items limit: 4 -%}
            {%- assign item_product = block.settings.product -%}
            {%- if item_product != blank -%}
              {%- assign item_variant = item_product.selected_or_first_available_variant -%}
              {%- unless forloop.first -%},{%- endunless -%}
              { "variantId": {{ item_variant.id | json }}, "available": {{ item_variant.available | json }} }
            {%- endif -%}
          {%- endfor -%}
        ]
      </script>
    {%- endif -%}
  </div>
</section>

{%- comment -%} ---------------- CSS ---------------- {%- endcomment -%}
<style>
  #fs-{{ section_id }} {
    position: relative;
    background: var(--fs-bg);
    color: var(--fs-text);
    font-family: 'Poppins', sans-serif;
    padding: var(--fs-padding-top) 20px var(--fs-padding-bottom);
  }

  #fs-{{ section_id }}.fs--transparent-bg {
    background: transparent;
  }

  #fs-{{ section_id }} * {
    box-sizing: border-box;
  }

  #fs-{{ section_id }} a {
    color: inherit;
  }

  #fs-{{ section_id }} .fs__container {
    max-width: 1100px;
    margin: 0 auto;
  }

  #fs-{{ section_id }} .fs__placeholder {
    padding: 60px 20px;
    text-align: center;
    border: 1.5px dashed var(--fs-border);
    border-radius: 16px;
    color: var(--fs-muted);
  }

  #fs-{{ section_id }} [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 24px, 0);
    transition: opacity 0.7s cubic-bezier(0.22, 0.61, 0.36, 1), transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  #fs-{{ section_id }} [data-reveal].is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  #fs-{{ section_id }} .fs__section-eyebrow {
    margin: 0 0 10px;
    font-weight: 600;
    font-size: 12.5px;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--fs-accent);
    text-align: center;
  }

  #fs-{{ section_id }} .fs__section-heading {
    margin: 0 0 40px;
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-weight: 400;
    font-size: clamp(28px, 3.8vw, 42px);
    line-height: 1.05;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    text-align: center;
  }

  #fs-{{ section_id }} .fs__panel {
    display: grid;
    grid-template-columns: minmax(0, 460px) minmax(0, 1fr);
    gap: 56px;
    align-items: start;
  }

  /* ---- 2x2 image grid: 4 different products ---- */
  #fs-{{ section_id }} .fs__grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    perspective: 1200px;
  }

  /* ---- Ghost-cursor onboarding demo ----
     A one-time visual walkthrough that plays when the grid first
     scrolls into view: a small cursor-like dot glides to the first
     two product images in turn and briefly triggers each one's own
     hover state, teaching the interaction before the visitor has to
     discover it themselves. Positioned/moved via JS (left/top), never
     touching `transform` on the actual grid cells, so it can't
     interfere with their magnetic/parallax transforms. */
  #fs-{{ section_id }} .fs__ghost-cursor {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 8;
    display: flex;
    align-items: center;
    gap: 8px;
    opacity: 0;
    pointer-events: none;
    transition: left 0.7s cubic-bezier(0.4, 0, 0.2, 1), top 0.7s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.35s ease;
  }

  #fs-{{ section_id }} .fs__ghost-cursor.is-active {
    opacity: 1;
  }

  #fs-{{ section_id }} .fs__ghost-cursor-dot {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--fs-text);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--fs-text) 12%, transparent);
    animation: fs-ghost-pulse 1.1s ease-in-out infinite;
  }

  #fs-{{ section_id }} .fs__ghost-cursor-label {
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--fs-text);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    transform: translate3d(-6px, 0, 0);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  #fs-{{ section_id }} .fs__ghost-cursor-label.is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  @keyframes fs-ghost-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.15); }
  }

  /* Ghost-triggered hover preview - a CSS-only nudge on the inner
     media wrapper (never the cell itself, whose transform belongs to
     the JS magnetic/parallax system), so the demo can never fight
     real hover/scroll interactions for the same property. */
  #fs-{{ section_id }} .fs__grid-cell.is-ghost-hover .fs__grid-cell-media {
    transform: scale(1.04);
  }

  #fs-{{ section_id }} .fs__grid-cell {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    cursor: pointer;
    text-decoration: none;
    color: inherit;
    will-change: transform;
  }

  #fs-{{ section_id }} .fs__grid-cell--empty {
    cursor: default;
  }

  /* The visible rounded/clipped card is this inner wrapper, not the
     cell itself - the cell stays overflow:visible so the hover tip
     below isn't clipped when the cursor nears the top edge. */
  #fs-{{ section_id }} .fs__grid-cell-media {
    position: absolute;
    inset: 0;
    display: block;
    border-radius: 16px;
    overflow: hidden;
    background: var(--fs-card-bg);
    box-shadow: 0 16px 40px rgba(20, 20, 20, 0.08);
    transition: transform 0.4s ease;
  }

  /* Drop-in entrance: each cell falls into place from above and
     settles with a slight overshoot, staggered cell-by-cell rather
     than the whole grid appearing at once. */
  #fs-{{ section_id }} .fs__grid-cell[data-fs-cell-drop] {
    opacity: 0;
    transform: translate3d(0, -60px, 0) rotateX(12deg) scale(0.92);
    transition: transform 0.75s cubic-bezier(0.22, 1.15, 0.32, 1), opacity 0.55s ease;
  }

  #fs-{{ section_id }} .fs__grid-cell[data-fs-cell-drop].is-dropped {
    opacity: 1;
    transform: translate3d(0, 0, 0) rotateX(0) scale(1);
  }

  #fs-{{ section_id }} .fs__grid-cell[data-fs-cell-index="0"] { transition-delay: 0s; }
  #fs-{{ section_id }} .fs__grid-cell[data-fs-cell-index="1"] { transition-delay: 0.1s; }
  #fs-{{ section_id }} .fs__grid-cell[data-fs-cell-index="2"] { transition-delay: 0.2s; }
  #fs-{{ section_id }} .fs__grid-cell[data-fs-cell-index="3"] { transition-delay: 0.3s; }

  #fs-{{ section_id }} .fs__grid-cell-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #fs-{{ section_id }} .fs__grid-cell--empty {
    border: 1.5px dashed var(--fs-border);
    border-radius: 16px;
  }

  #fs-{{ section_id }} .fs__grid-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--fs-accent);
    opacity: 0.4;
  }

  #fs-{{ section_id }} .fs__grid-ribbon {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 4px 10px;
    border-radius: 999px;
    background: #c0392b;
    color: #fff;
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.4px;
  }

  /* ---- Cursor-following info popup ----
     Positioned via JS to track the pointer inside the cell (left/top
     set on mousemove), not CSS centering - it needs to follow the
     cursor, not sit in one fixed spot. Hidden by default and faded in
     only while actively hovered. */
  #fs-{{ section_id }} .fs__cell-tip {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 5;
    display: flex;
    flex-direction: column;
    gap: 2px;
    max-width: 200px;
    padding: 10px 14px;
    border-radius: 10px;
    background: rgba(20, 20, 20, 0.92);
    color: #fff;
    opacity: 0;
    pointer-events: none;
    transform: translate3d(-50%, -120%, 0);
    transition: opacity 0.2s ease;
    white-space: normal;
  }

  #fs-{{ section_id }} .fs__cell-tip.is-visible {
    opacity: 1;
  }

  #fs-{{ section_id }} .fs__cell-tip-title {
    font-weight: 700;
    font-size: 12.5px;
    line-height: 1.3;
  }

  #fs-{{ section_id }} .fs__cell-tip-price {
    font-weight: 700;
    font-size: 12px;
    color: #a8e0ad;
  }

  #fs-{{ section_id }} .fs__cell-tip-reason {
    font-size: 11px;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.8);
  }

  /* ---- Info ---- */
  #fs-{{ section_id }} .fs__info {
    min-width: 0;
  }

  #fs-{{ section_id }} .fs__product-eyebrow {
    margin: 0 0 8px;
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--fs-cta);
  }

  #fs-{{ section_id }} .fs__title {
    margin: 0 0 16px;
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-weight: 400;
    font-size: clamp(24px, 2.6vw, 32px);
    line-height: 1.1;
    letter-spacing: 0.3px;
    text-transform: uppercase;
  }

  #fs-{{ section_id }} .fs__price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
  }

  #fs-{{ section_id }} .fs__price {
    font-size: 20px;
    font-weight: 700;
  }

  #fs-{{ section_id }} .fs__price-compare {
    font-size: 15px;
    color: var(--fs-muted);
    text-decoration: line-through;
  }

  #fs-{{ section_id }} .fs__discount {
    padding: 4px 10px;
    border-radius: 6px;
    background: var(--fs-cta);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
  }

  #fs-{{ section_id }} .fs__shipping-note {
    margin: 0 0 16px;
    font-size: 13px;
    color: var(--fs-muted);
  }

  #fs-{{ section_id }} .fs__shipping-note a {
    color: var(--fs-cta);
    text-decoration: underline;
  }

  #fs-{{ section_id }} .fs__highlight {
    margin: 0 0 10px;
    font-weight: 700;
    font-size: 14.5px;
  }

  #fs-{{ section_id }} .fs__description {
    margin: 0 0 14px;
    font-size: 14px;
    line-height: 1.7;
    color: var(--fs-muted);
    padding-bottom: 16px;
    border-bottom: 1px solid var(--fs-border);
  }

  #fs-{{ section_id }} .fs__description p {
    margin: 0 0 0.8em;
  }

  #fs-{{ section_id }} .fs__description p:last-child {
    margin-bottom: 0;
  }

  #fs-{{ section_id }} .fs__specs {
    margin: 0 0 18px;
    font-size: 13.5px;
    color: var(--fs-muted);
  }

  #fs-{{ section_id }} .fs__specs strong {
    color: var(--fs-text);
  }

  #fs-{{ section_id }} .fs__all-out {
    margin: 0 0 16px;
    font-size: 13px;
    font-weight: 700;
    color: #c0392b;
  }

  /* ---- Quantity ---- */
  #fs-{{ section_id }} .fs__quantity {
    display: inline-flex;
    align-items: center;
    border: 1.5px solid var(--fs-border);
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 16px;
  }

  #fs-{{ section_id }} .fs__qty-btn {
    width: 34px;
    height: 38px;
    border: none;
    background: none;
    font-size: 16px;
    color: var(--fs-text);
    cursor: pointer;
  }

  #fs-{{ section_id }} .fs__qty-btn:hover {
    color: var(--fs-cta);
  }

  #fs-{{ section_id }} .fs__qty-input {
    width: 38px;
    height: 38px;
    border: none;
    border-left: 1px solid var(--fs-border);
    border-right: 1px solid var(--fs-border);
    text-align: center;
    font-family: 'Poppins', sans-serif;
    font-size: 13px;
    -moz-appearance: textfield;
  }

  #fs-{{ section_id }} .fs__qty-input::-webkit-outer-spin-button,
  #fs-{{ section_id }} .fs__qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  #fs-{{ section_id }} .fs__cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 4px;
  }

  #fs-{{ section_id }} .fs__add-btn,
  #fs-{{ section_id }} .fs__buy-now-btn {
    flex: 1;
    min-width: 140px;
    height: 46px;
    padding: 0 20px;
    border-radius: 999px;
    border: none;
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    transition: background-color 0.25s ease, transform 0.2s ease, opacity 0.2s ease;
  }

  #fs-{{ section_id }} .fs__add-btn {
    background: var(--fs-cta);
    color: #fff;
  }

  #fs-{{ section_id }} .fs__add-btn:hover:not([disabled]) {
    transform: translateY(-2px);
  }

  #fs-{{ section_id }} .fs__add-btn[disabled],
  #fs-{{ section_id }} .fs__buy-now-btn[disabled] {
    background: #b7b7b7;
    cursor: not-allowed;
    transform: none;
  }

  #fs-{{ section_id }} .fs__add-btn.is-loading,
  #fs-{{ section_id }} .fs__buy-now-btn.is-loading {
    opacity: 0.75;
    cursor: wait;
  }

  #fs-{{ section_id }} .fs__buy-now-btn {
    background: #1a1a1a;
    color: #fff;
  }

  #fs-{{ section_id }} .fs__buy-now-btn:hover:not([disabled]) {
    background: var(--fs-accent);
    transform: translateY(-2px);
  }

  #fs-{{ section_id }} .fs__feedback {
    min-height: 18px;
    margin: 10px 0 4px;
    font-size: 12.5px;
    font-weight: 600;
  }

  #fs-{{ section_id }} .fs__feedback.is-success {
    color: var(--fs-accent);
  }

  #fs-{{ section_id }} .fs__feedback.is-error {
    color: #c0392b;
  }

  /* ---- Share ---- */
  #fs-{{ section_id }} .fs__share {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 10px;
    font-size: 12.5px;
    color: var(--fs-muted);
  }

  #fs-{{ section_id }} .fs__share a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--fs-bg);
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  #fs-{{ section_id }} .fs__share a:hover {
    background: var(--fs-accent);
    color: #fff;
  }

  /* ---- Tablet / Mobile ---- */
  @media (max-width: 899px) {
    #fs-{{ section_id }} .fs__panel {
      grid-template-columns: 1fr;
      padding: 22px;
      gap: 28px;
    }
  }

  @media (max-width: 749px) {
    #fs-{{ section_id }} {
      padding-left: 16px;
      padding-right: 16px;
    }

    #fs-{{ section_id }} .fs__panel {
      border-radius: 20px;
      padding: 18px;
    }

    #fs-{{ section_id }} .fs__cta-row {
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #fs-{{ section_id }} [data-reveal],
    #fs-{{ section_id }} .fs__grid-cell[data-fs-cell-drop] {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>

{%- comment -%} ---------------- JS ---------------- {%- endcomment -%}
<script>
  (function () {
    var section = document.getElementById('fs-{{ section_id }}');
    if (!section) return;

    var revealTargets = Array.prototype.slice.call(section.querySelectorAll('[data-reveal]'));
    if (revealTargets.length) {
      if ('IntersectionObserver' in window) {
        var revealObserver = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                revealObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 }
        );
        revealTargets.forEach(function (el) { revealObserver.observe(el); });
      } else {
        revealTargets.forEach(function (el) { el.classList.add('is-visible'); });
      }
    }

    /* ---- Grid cells: staggered drop-in, then magnetic hover + scroll
       parallax once dropped ----
       The drop-in entrance and the magnetic/parallax drift both end up
       writing this same element's `transform`, so a cell's magnetic +
       parallax state (and its listeners) are only registered AFTER its
       drop-in transition finishes - never both at once fighting over
       the same style property. Everything shares one composed
       transform per cell (translate + rotateX + scale) via elState,
       same pattern as the testimonials section. */
    var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var cellState = new Map();
    var activeCells = [];

    function composeCellTransform(el) {
      var st = cellState.get(el);
      if (!st) return;
      el.style.transform =
        'translate3d(' + (st.curMagX + st.dragX).toFixed(2) + 'px, ' + (st.curMagY + st.curParY).toFixed(2) + 'px, 0) ' +
        'scale(' + st.curScale.toFixed(3) + ')';
    }

    function registerCellEffects(el) {
      if (cellState.has(el)) return;
      // The drop-in entrance's own CSS transition (0.75s, bouncy) is
      // still attached to `transform` at this point - left in place,
      // it would keep re-triggering on every mousemove-driven style
      // change from here on, chasing a target that moves every frame
      // and reading as heavy lag/rubber-banding instead of following
      // the cursor. From here, JS's own eased rAF loop is the only
      // thing that should smooth `transform`, so the CSS transition is
      // switched off for this element for good.
      el.style.transition = 'none';
      var st = { magX: 0, magY: 0, curMagX: 0, curMagY: 0, parY: 0, curParY: 0, dragX: 0, scale: 1, curScale: 1, ticking: false };
      cellState.set(el, st);
      activeCells.push(el);

      function render() {
        st.curMagX += (st.magX - st.curMagX) * 0.2;
        st.curMagY += (st.magY - st.curMagY) * 0.2;
        st.curScale += (st.scale - st.curScale) * 0.25;
        st.curParY += (st.parY - st.curParY) * 0.09;
        composeCellTransform(el);
        if (
          Math.abs(st.magX - st.curMagX) > 0.1 ||
          Math.abs(st.magY - st.curMagY) > 0.1 ||
          Math.abs(st.scale - st.curScale) > 0.002 ||
          Math.abs(st.parY - st.curParY) > 0.05
        ) {
          window.requestAnimationFrame(render);
        } else {
          st.ticking = false;
        }
      }

      function startRender() {
        if (!st.ticking) {
          st.ticking = true;
          window.requestAnimationFrame(render);
        }
      }
      st.startRender = startRender;

      var tip = el.querySelector('[data-fs-cell-tip]');

      if (!prefersReducedMotion) {
        el.addEventListener('mousemove', function (e) {
          var rect = el.getBoundingClientRect();
          var relX = e.clientX - (rect.left + rect.width / 2);
          var relY = e.clientY - (rect.top + rect.height / 2);
          st.magX = Math.max(-18, Math.min(18, relX * 0.16));
          st.magY = Math.max(-18, Math.min(18, relY * 0.16));
          st.scale = 1.03;
          startRender();

          if (tip) {
            // Positioned relative to the cell, following the pointer
            // directly rather than sitting in one fixed spot.
            tip.style.left = (e.clientX - rect.left) + 'px';
            tip.style.top = (e.clientY - rect.top) + 'px';
          }
        });

        el.addEventListener('mouseenter', function () {
          if (tip) tip.classList.add('is-visible');
        });

        el.addEventListener('mouseleave', function () {
          st.magX = 0;
          st.magY = 0;
          st.scale = 1;
          startRender();
          if (tip) tip.classList.remove('is-visible');
        });
      }
    }

    var dropCells = Array.prototype.slice.call(section.querySelectorAll('[data-fs-cell-drop]'));
    if (dropCells.length) {
      if ('IntersectionObserver' in window) {
        var dropObserver = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              var el = entry.target;
              el.classList.add('is-dropped');
              dropObserver.unobserve(el);
              if (prefersReducedMotion) return;
              var delayMs = parseFloat(window.getComputedStyle(el).transitionDelay) * 1000 || 0;
              var durationMs = parseFloat(window.getComputedStyle(el).transitionDuration) * 1000 || 750;
              window.setTimeout(function () { registerCellEffects(el); }, delayMs + durationMs + 30);
            });
          },
          { threshold: 0.15 }
        );
        dropCells.forEach(function (el) { dropObserver.observe(el); });
      } else {
        dropCells.forEach(function (el) {
          el.classList.add('is-dropped');
          if (!prefersReducedMotion) registerCellEffects(el);
        });
      }
    }

    /* ---- Scroll parallax for dropped cells (differential per cell,
       via data-fs-parallax amount) ---- */
    var grid = section.querySelector('[data-fs-grid]');
    if (grid && !prefersReducedMotion) {
      var parallaxTicking = false;
      function updateGridParallax() {
        parallaxTicking = false;
        var rect = grid.getBoundingClientRect();
        var vh = window.innerHeight || document.documentElement.clientHeight;
        if (rect.bottom < 0 || rect.top > vh) return;
        var progress = (vh - rect.top) / (vh + rect.height);
        activeCells.forEach(function (el) {
          var amount = parseFloat(el.getAttribute('data-fs-parallax')) || 0;
          var st = cellState.get(el);
          if (!st) return;
          st.parY = (progress - 0.5) * amount;
          if (st.startRender) st.startRender();
        });
      }
      function onGridScroll() {
        if (parallaxTicking) return;
        parallaxTicking = true;
        window.requestAnimationFrame(updateGridParallax);
      }
      var pageScroller = document.querySelector('.page-wrapper');
      window.addEventListener('scroll', onGridScroll, { passive: true });
      if (pageScroller) pageScroller.addEventListener('scroll', onGridScroll, { passive: true });
      window.addEventListener('resize', onGridScroll, { passive: true });
    }

    /* ---- Ghost-cursor onboarding demo ----
       Plays once, the first time the grid scrolls into view: glides a
       small cursor-like dot to the first two product images in turn
       and briefly shows each one's own hover state (tooltip + a CSS-
       only image scale), teaching visitors that these images are
       hoverable before they'd otherwise have to discover it. Timed to
       start only after the last cell's drop-in entrance has settled,
       and skipped entirely under reduced motion. */
    var ghostCursor = section.querySelector('[data-fs-ghost-cursor]');
    var ghostLabel = section.querySelector('[data-fs-ghost-label]');
    if (grid && ghostCursor && dropCells.length && !prefersReducedMotion) {
      var demoCells = dropCells.filter(function (el) {
        var i = el.getAttribute('data-fs-cell-index');
        return i === '0' || i === '1';
      });

      function moveGhostTo(cellEl) {
        var gridRect = grid.getBoundingClientRect();
        var cellRect = cellEl.getBoundingClientRect();
        var x = cellRect.left - gridRect.left + cellRect.width / 2;
        var y = cellRect.top - gridRect.top + cellRect.height / 2;
        ghostCursor.style.left = x + 'px';
        ghostCursor.style.top = y + 'px';
      }

      function showCellPreview(cellEl) {
        cellEl.classList.add('is-ghost-hover');
        var tip = cellEl.querySelector('[data-fs-cell-tip]');
        if (tip) {
          tip.style.left = '50%';
          tip.style.top = '20%';
          tip.classList.add('is-visible');
        }
      }

      function hideCellPreview(cellEl) {
        cellEl.classList.remove('is-ghost-hover');
        var tip = cellEl.querySelector('[data-fs-cell-tip]');
        if (tip) tip.classList.remove('is-visible');
      }

      function runGhostDemo() {
        if (demoCells.length === 0) return;

        moveGhostTo(demoCells[0]);
        ghostCursor.classList.add('is-active');

        window.setTimeout(function () {
          showCellPreview(demoCells[0]);
          if (ghostLabel) ghostLabel.classList.add('is-visible');
        }, 500);

        window.setTimeout(function () {
          hideCellPreview(demoCells[0]);
          if (ghostLabel) ghostLabel.classList.remove('is-visible');
          if (demoCells[1]) moveGhostTo(demoCells[1]);
        }, 1500);

        if (demoCells[1]) {
          window.setTimeout(function () { showCellPreview(demoCells[1]); }, 2200);
          window.setTimeout(function () { hideCellPreview(demoCells[1]); }, 3200);
        }

        window.setTimeout(function () {
          ghostCursor.classList.remove('is-active');
        }, demoCells[1] ? 3300 : 1600);
      }

      if ('IntersectionObserver' in window) {
        var demoObserver = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              demoObserver.disconnect();
              // Give the staggered drop-in entrance (up to ~1.05s for
              // the last cell) time to finish before layering the
              // demo on top of it.
              window.setTimeout(runGhostDemo, 1300);
            });
          },
          { threshold: 0.4 }
        );
        demoObserver.observe(grid);
      }
    }

    /* ---- Magnetic hover on the CTA buttons ---- */
    if (!prefersReducedMotion) {
      var magneticButtons = Array.prototype.slice.call(section.querySelectorAll('.fs__add-btn, .fs__buy-now-btn'));
      magneticButtons.forEach(function (btn) {
        var bx = 0, by = 0, cbx = 0, cby = 0, ticking = false;
        function render() {
          cbx += (bx - cbx) * 0.2;
          cby += (by - cby) * 0.2;
          btn.style.transform = 'translate3d(' + cbx.toFixed(2) + 'px, ' + cby.toFixed(2) + 'px, 0)';
          if (Math.abs(bx - cbx) > 0.1 || Math.abs(by - cby) > 0.1) {
            window.requestAnimationFrame(render);
          } else {
            ticking = false;
          }
        }
        function startRender() {
          if (!ticking) { ticking = true; window.requestAnimationFrame(render); }
        }
        btn.addEventListener('mousemove', function (e) {
          var rect = btn.getBoundingClientRect();
          bx = Math.max(-6, Math.min(6, (e.clientX - (rect.left + rect.width / 2)) * 0.25));
          by = Math.max(-6, Math.min(6, (e.clientY - (rect.top + rect.height / 2)) * 0.25));
          startRender();
        });
        btn.addEventListener('mouseleave', function () {
          bx = 0; by = 0;
          startRender();
        });
      });
    }

    var itemsScript = section.querySelector('[data-fs-pack-items]');
    if (!itemsScript) return;
    var packItems = [];
    try { packItems = JSON.parse(itemsScript.textContent); } catch (e) { packItems = []; }
    var availableItems = packItems.filter(function (item) { return item.available; });
    if (!availableItems.length) return;

    var basePriceCents = {{ total_price }};
    var baseCompareCents = {{ total_compare }};

    var qtyInput = section.querySelector('[data-fs-qty-input]');
    var qtyMinus = section.querySelector('[data-fs-qty-minus]');
    var qtyPlus = section.querySelector('[data-fs-qty-plus]');
    var priceEl = section.querySelector('[data-fs-total-price]');
    var compareEl = section.querySelector('[data-fs-total-compare]');

    function money(amountCents) {
      return '{{ shop.money_format }}'.replace(/\{\{\s*amount\s*\}\}/, (amountCents / 100).toFixed(2));
    }

    function updatePriceDisplay() {
      var qty = parseInt((qtyInput && qtyInput.value) || 1, 10) || 1;
      if (priceEl) priceEl.textContent = money(basePriceCents * qty);
      if (compareEl) compareEl.textContent = money(baseCompareCents * qty);
    }

    if (qtyInput && qtyMinus && qtyPlus) {
      qtyMinus.addEventListener('click', function () {
        qtyInput.value = Math.max(1, (parseInt(qtyInput.value, 10) || 1) - 1);
        updatePriceDisplay();
      });
      qtyPlus.addEventListener('click', function () {
        qtyInput.value = (parseInt(qtyInput.value, 10) || 1) + 1;
        updatePriceDisplay();
      });
      qtyInput.addEventListener('change', updatePriceDisplay);
    }

    var addBtn = section.querySelector('[data-fs-add-btn]');
    var buyNowBtn = section.querySelector('[data-fs-buy-now-btn]');
    var feedback = section.querySelector('[data-fs-feedback]');

    function setFeedback(message, type) {
      if (!feedback) return;
      feedback.textContent = message;
      feedback.classList.remove('is-success', 'is-error');
      if (type) feedback.classList.add(type);
    }

    function bumpCartBubble(itemCount) {
      var counts = document.querySelectorAll('.cart-bubble__text-count');
      counts.forEach(function (el) { el.textContent = itemCount; });
    }

    function buildPayload() {
      var qty = parseInt((qtyInput && qtyInput.value) || 1, 10) || 1;
      return {
        items: availableItems.map(function (item) {
          return { id: item.variantId, quantity: qty };
        })
      };
    }

    function addPackToCart(onSuccess) {
      return fetch('{{ routes.cart_add_url }}', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(buildPayload())
      })
        .then(function (response) { return response.json().then(function (data) { return { ok: response.ok, data: data }; }); })
        .then(function (result) {
          if (!result.ok) {
            var message = (result.data.description) || (result.data.message) || 'Could not add the pack to cart.';
            setFeedback(message, 'is-error');
            return false;
          }
          if (onSuccess) onSuccess();
          return true;
        })
        .catch(function () {
          setFeedback('Could not add the pack to cart. Please try again.', 'is-error');
          return false;
        });
    }

    if (addBtn) {
      addBtn.addEventListener('click', function () {
        if (addBtn.disabled) return;
        addBtn.classList.add('is-loading');
        setFeedback('', null);

        addPackToCart(function () {
          setFeedback('{{ s.added_to_cart_text | default: "Pack added to cart" | escape }}', 'is-success');
          fetch('{{ routes.cart_url }}.js')
            .then(function (r) { return r.json(); })
            .then(function (cart) { bumpCartBubble(cart.item_count); })
            .catch(function () {});
        }).then(function () {
          addBtn.classList.remove('is-loading');
        });
      });
    }

    if (buyNowBtn) {
      buyNowBtn.addEventListener('click', function () {
        if (buyNowBtn.disabled) return;
        buyNowBtn.classList.add('is-loading');
        setFeedback('', null);

        addPackToCart(function () {
          window.location.href = '{{ routes.cart_url }}';
        }).then(function (success) {
          if (!success) buyNowBtn.classList.remove('is-loading');
        });
      });
    }

    updatePriceDisplay();
  })();
</script>

