{%- comment -%}
  Section: Product Pack Bundle
  Homepage "build your own pack" section. Each block is one merchant-
  chosen product, rendered as its own full panel matching the
  reference layout exactly - a 2x2 image grid on the left (swaps to
  the chosen variant's own image when the variant has one) and full
  product info on the right (title, price, description, specs, a
  complete variant picker, quantity). Panels stack one per product.
  A single shared summary bar at the bottom totals up every INCLUDED
  panel's currently selected variant + quantity and adds all of them
  to the real Shopify cart in one `/cart/add.js` request when "Add
  Pack to Cart" is clicked - not one product's Add to Cart at a time.

  Two things worth knowing:
  - Each panel's 2x2 grid only swaps its primary image per variant if
    that variant has its own image assigned in Shopify admin. Variants
    that share the product's regular photo set won't visibly change on
    selection - that's the store's product data, not something this
    section can invent.
  - This section cannot apply an automatic bundle discount to the
    price shown at checkout - that needs either a discount code the
    shopper enters, an Automatic Discount configured in Shopify Admin
    (Discounts > percentage off, targeted at these products), or a
    bundle app/Shopify Function. The optional "Promo note" field is
    just merchant-editable text, not a functioning discount - the
    total shown is always the real, accurate sum of selected items.
{%- endcomment -%}

{{ 'https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@400;500;600;700;800&display=swap' | stylesheet_tag }}

{%- liquid
  assign section_id = section.id
  assign s = section.settings
  assign items = section.blocks
-%}

<section
  class="pb{% if s.sync_scroll_bg %} pb--transparent-bg{% endif %}"
  id="pb-{{ section_id }}"
  {% if s.sync_scroll_bg %}data-scroll-bg-zone="{{ s.background_color | default: '#F2F6F1' }}"{% endif %}
  style="
    --pb-bg: {{ s.background_color | default: '#F2F6F1' }};
    --pb-card-bg: {{ s.card_color | default: '#FFFFFF' }};
    --pb-text: {{ s.text_color | default: '#141414' }};
    --pb-muted: {{ s.muted_color | default: '#6B6B6B' }};
    --pb-accent: {{ s.accent_color | default: '#2E7D32' }};
    --pb-cta: {{ s.cta_color | default: '#F58220' }};
    --pb-border: {{ s.border_color | default: '#ECECEC' }};
    --pb-padding-top: {{ s.padding_top | default: 90 }}px;
    --pb-padding-bottom: {{ s.padding_bottom | default: 90 }}px;
  "
>
  <div class="pb__container">
    {%- if s.eyebrow != blank -%}<p class="pb__eyebrow" data-reveal>{{ s.eyebrow }}</p>{%- endif -%}
    {%- if s.heading != blank -%}<h2 class="pb__heading" data-reveal>{{ s.heading }}</h2>{%- endif -%}
    {%- if s.subheading != blank -%}<p class="pb__subheading" data-reveal>{{ s.subheading }}</p>{%- endif -%}

    {%- if items.size == 0 -%}
      {%- if request.design_mode -%}
        <div class="pb__placeholder">Add product blocks in section settings to build this pack.</div>
      {%- endif -%}
    {%- else -%}
      <div class="pb__list" data-pb-list>
        {%- for block in items -%}
          {%- assign bs = block.settings -%}
          {%- assign item_product = bs.product -%}
          {%- if item_product != blank -%}
            {%- assign current_variant = item_product.selected_or_first_available_variant -%}
            {%- assign images = item_product.images -%}

            <div
              class="pb__panel{% if bs.default_selected %} is-included{% endif %}"
              data-pb-panel
              data-included="{{ bs.default_selected }}"
              data-reveal
              {{ block.shopify_attributes }}
            >
              {%- if s.show_include_toggle -%}
                <label class="pb__include">
                  <input type="checkbox" data-pb-include-checkbox {% if bs.default_selected %}checked{% endif %}>
                  <span class="pb__include-box" aria-hidden="true">
                    <svg width="11" height="11" viewBox="0 0 14 14" fill="none"><path d="M2.5 7.2 5.4 10 11.5 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                  <span>{{ s.include_label | default: 'Include in pack' }}</span>
                </label>
              {%- endif -%}

              <div class="pb__grid" data-pb-grid>
                {%- for image in images limit: 4 -%}
                  <span class="pb__grid-cell{% if forloop.first %} pb__grid-cell--primary{% endif %}" data-pb-cell="{{ forloop.index0 }}">
                    <img
                      src="{{ image | image_url: width: 500 }}"
                      srcset="{{ image | image_url: width: 350 }} 350w, {{ image | image_url: width: 500 }} 500w"
                      sizes="(max-width: 899px) 45vw, 260px"
                      alt="{{ image.alt | default: item_product.title | escape }}"
                      width="{{ image.width }}"
                      height="{{ image.height }}"
                      loading="lazy"
                      data-pb-cell-img
                    >
                  </span>
                {%- endfor -%}
                {%- if images.size == 0 -%}
                  <span class="pb__grid-cell pb__grid-cell--primary pb__grid-placeholder" aria-hidden="true">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none"><path d="M6 8h12l-1 12H7L6 8Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
                  </span>
                {%- endif -%}
              </div>

              <div class="pb__info">
                {%- assign eyebrow_text = blank -%}
                {%- if s.product_eyebrow_source == 'vendor' and item_product.vendor != blank -%}
                  {%- assign eyebrow_text = item_product.vendor -%}
                {%- elsif s.product_eyebrow_source == 'type' and item_product.type != blank -%}
                  {%- assign eyebrow_text = item_product.type -%}
                {%- endif -%}
                {%- if eyebrow_text != blank -%}<p class="pb__product-eyebrow">{{ eyebrow_text }}</p>{%- endif -%}

                <h3 class="pb__title">{{ item_product.title }}</h3>

                <div class="pb__price-row">
                  <span class="pb__price" data-pb-price>{{ current_variant.price | money }}</span>
                  {%- if current_variant.compare_at_price > current_variant.price -%}
                    <span class="pb__price-compare" data-pb-price-compare>{{ current_variant.compare_at_price | money }}</span>
                    {%- assign discount = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round -%}
                    <span class="pb__discount" data-pb-discount>-{{ discount }}% OFF</span>
                  {%- else -%}
                    <span class="pb__price-compare" data-pb-price-compare style="display:none;"></span>
                    <span class="pb__discount" data-pb-discount style="display:none;"></span>
                  {%- endif -%}
                </div>

                {%- if bs.highlight_line != blank -%}
                  <p class="pb__highlight">{{ bs.highlight_line }}</p>
                {%- endif -%}

                {%- if item_product.description != blank -%}
                  <div class="pb__description">{{ item_product.description | strip_html | truncate: 200 }}</div>
                {%- endif -%}

                {%- if bs.specifications != blank -%}
                  <p class="pb__specs"><strong>{{ s.specifications_label | default: 'Specifications:' }}</strong> {{ bs.specifications }}</p>
                {%- endif -%}

                <input type="hidden" data-pb-variant-id value="{{ current_variant.id }}">

                {%- unless item_product.has_only_default_variant -%}
                  <div class="pb__options">
                    {%- for option in item_product.options_with_values -%}
                      <div class="pb__option" data-pb-option data-option-index="{{ forloop.index0 }}">
                        <p class="pb__option-label">{{ option.name }}: <span data-pb-option-value>{{ option.selected_value }}</span></p>
                        <div class="pb__option-values">
                          {%- for value in option.values -%}
                            <button
                              type="button"
                              class="pb__option-btn{% if value == option.selected_value %} is-selected{% endif %}"
                              data-pb-option-btn
                              data-option-index="{{ forloop.parentloop.index0 }}"
                              data-value="{{ value | escape }}"
                            >{{ value }}</button>
                          {%- endfor -%}
                        </div>
                      </div>
                    {%- endfor -%}
                  </div>
                {%- endunless -%}

                {%- if current_variant.available == false -%}
                  <p class="pb__stock-status pb__stock-status--out" data-pb-stock-status>{{ s.sold_out_text | default: 'Sold out' }}</p>
                {%- endif -%}

                <div class="pb__quantity">
                  <button type="button" class="pb__qty-btn" data-pb-qty-minus aria-label="Decrease quantity">−</button>
                  <input type="number" value="{{ bs.default_quantity | default: 1 }}" min="1" class="pb__qty-input" data-pb-qty-input aria-label="Quantity">
                  <button type="button" class="pb__qty-btn" data-pb-qty-plus aria-label="Increase quantity">+</button>
                </div>

                {%- if s.show_view_details -%}
                  <a href="{{ item_product.url }}" class="pb__view-details">{{ s.view_details_text | default: 'View full details' }}</a>
                {%- endif -%}
              </div>

              <script type="application/json" data-pb-variants>{{ item_product.variants | json }}</script>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="pb__summary" data-reveal>
        {%- if s.promo_note != blank -%}
          <p class="pb__promo-note">{{ s.promo_note }}</p>
        {%- endif -%}
        <div class="pb__summary-row">
          <span class="pb__summary-label" data-pb-count>0 {{ s.items_label | default: 'items selected' }}</span>
          <span class="pb__summary-total"><span data-pb-total>{{ 0 | money }}</span></span>
        </div>
        <button type="button" class="pb__add-btn" data-pb-add-btn disabled>
          <span data-pb-add-btn-text>{{ s.add_to_cart_text | default: 'Add Pack to Cart' }}</span>
        </button>
        <p class="pb__feedback" data-pb-feedback aria-live="polite"></p>
      </div>
    {%- endif -%}
  </div>
</section>

{%- comment -%} ---------------- CSS ---------------- {%- endcomment -%}
<style>
  #pb-{{ section_id }} {
    position: relative;
    background: var(--pb-bg);
    color: var(--pb-text);
    font-family: 'Poppins', sans-serif;
    padding: var(--pb-padding-top) 20px var(--pb-padding-bottom);
  }

  #pb-{{ section_id }}.pb--transparent-bg {
    background: transparent;
  }

  #pb-{{ section_id }} * {
    box-sizing: border-box;
  }

  #pb-{{ section_id }} a {
    color: inherit;
  }

  #pb-{{ section_id }} .pb__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  #pb-{{ section_id }} .pb__placeholder {
    padding: 60px 20px;
    text-align: center;
    border: 1.5px dashed var(--pb-border);
    border-radius: 16px;
    color: var(--pb-muted);
  }

  #pb-{{ section_id }} [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 24px, 0);
    transition: opacity 0.7s cubic-bezier(0.22, 0.61, 0.36, 1), transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  #pb-{{ section_id }} [data-reveal].is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  #pb-{{ section_id }} .pb__eyebrow {
    margin: 0 0 10px;
    font-weight: 600;
    font-size: 12.5px;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--pb-accent);
    text-align: center;
  }

  #pb-{{ section_id }} .pb__heading {
    margin: 0 0 12px;
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-weight: 400;
    font-size: clamp(28px, 3.8vw, 42px);
    line-height: 1.05;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    text-align: center;
  }

  #pb-{{ section_id }} .pb__subheading {
    max-width: 560px;
    margin: 0 auto 44px;
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--pb-muted);
    text-align: center;
  }

  #pb-{{ section_id }} .pb__list {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 28px;
  }

  /* ---- Per-product panel ---- */
  #pb-{{ section_id }} .pb__panel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 380px) minmax(0, 1fr);
    gap: 40px;
    background: var(--pb-card-bg);
    border-radius: 24px;
    padding: 28px;
    box-shadow: 0 20px 50px rgba(20, 20, 20, 0.07);
    transition: opacity 0.25s ease;
  }

  #pb-{{ section_id }} .pb__panel:not(.is-included) {
    opacity: 0.5;
  }

  #pb-{{ section_id }} .pb__include {
    position: absolute;
    top: 20px;
    right: 20px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 600;
    color: var(--pb-muted);
    cursor: pointer;
    background: rgba(255, 255, 255, 0.9);
    padding: 6px 12px 6px 8px;
    border-radius: 999px;
  }

  #pb-{{ section_id }} .pb__include input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  #pb-{{ section_id }} .pb__include-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1.5px solid var(--pb-border);
    color: transparent;
    background: #fff;
    flex-shrink: 0;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  #pb-{{ section_id }} .pb__panel.is-included .pb__include-box {
    background: var(--pb-accent);
    border-color: var(--pb-accent);
    color: #fff;
  }

  /* ---- 2x2 image grid ---- */
  #pb-{{ section_id }} .pb__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    align-content: start;
  }

  #pb-{{ section_id }} .pb__grid-cell {
    display: block;
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: 16px;
    overflow: hidden;
    background: var(--pb-bg);
  }

  #pb-{{ section_id }} .pb__grid-cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #pb-{{ section_id }} .pb__grid-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--pb-accent);
    opacity: 0.4;
    grid-column: span 2;
  }

  /* ---- Info ---- */
  #pb-{{ section_id }} .pb__info {
    min-width: 0;
  }

  #pb-{{ section_id }} .pb__product-eyebrow {
    margin: 0 0 8px;
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--pb-cta);
  }

  #pb-{{ section_id }} .pb__title {
    margin: 0 0 14px;
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-weight: 400;
    font-size: clamp(22px, 2.4vw, 30px);
    line-height: 1.1;
    letter-spacing: 0.3px;
    text-transform: uppercase;
  }

  #pb-{{ section_id }} .pb__price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }

  #pb-{{ section_id }} .pb__price {
    font-size: 19px;
    font-weight: 700;
  }

  #pb-{{ section_id }} .pb__price-compare {
    font-size: 14px;
    color: var(--pb-muted);
    text-decoration: line-through;
  }

  #pb-{{ section_id }} .pb__discount {
    padding: 4px 10px;
    border-radius: 6px;
    background: var(--pb-cta);
    color: #fff;
    font-size: 11.5px;
    font-weight: 700;
  }

  #pb-{{ section_id }} .pb__highlight {
    margin: 0 0 10px;
    font-weight: 700;
    font-size: 14px;
  }

  #pb-{{ section_id }} .pb__description {
    margin: 0 0 14px;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--pb-muted);
    padding-bottom: 14px;
    border-bottom: 1px solid var(--pb-border);
  }

  #pb-{{ section_id }} .pb__specs {
    margin: 0 0 16px;
    font-size: 13px;
    color: var(--pb-muted);
  }

  #pb-{{ section_id }} .pb__specs strong {
    color: var(--pb-text);
  }

  /* ---- Variant options ---- */
  #pb-{{ section_id }} .pb__options {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 14px;
  }

  #pb-{{ section_id }} .pb__option-label {
    margin: 0 0 8px;
    font-size: 13px;
    font-weight: 600;
  }

  #pb-{{ section_id }} .pb__option-label span {
    font-weight: 400;
    color: var(--pb-muted);
  }

  #pb-{{ section_id }} .pb__option-values {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  #pb-{{ section_id }} .pb__option-btn {
    padding: 7px 14px;
    border-radius: 6px;
    border: 1.5px solid var(--pb-border);
    background: #fff;
    font-family: 'Poppins', sans-serif;
    font-size: 12.5px;
    font-weight: 500;
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  #pb-{{ section_id }} .pb__option-btn:hover {
    border-color: var(--pb-cta);
  }

  #pb-{{ section_id }} .pb__option-btn.is-selected {
    background: var(--pb-cta);
    border-color: var(--pb-cta);
    color: #fff;
  }

  #pb-{{ section_id }} .pb__stock-status {
    margin: 0 0 14px;
    font-size: 12.5px;
    font-weight: 700;
  }

  #pb-{{ section_id }} .pb__stock-status--out {
    color: #c0392b;
  }

  /* ---- Quantity ---- */
  #pb-{{ section_id }} .pb__quantity {
    display: inline-flex;
    align-items: center;
    border: 1.5px solid var(--pb-border);
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 14px;
  }

  #pb-{{ section_id }} .pb__qty-btn {
    width: 32px;
    height: 36px;
    border: none;
    background: none;
    font-size: 15px;
    color: var(--pb-text);
    cursor: pointer;
  }

  #pb-{{ section_id }} .pb__qty-btn:hover {
    color: var(--pb-cta);
  }

  #pb-{{ section_id }} .pb__qty-input {
    width: 36px;
    height: 36px;
    border: none;
    border-left: 1px solid var(--pb-border);
    border-right: 1px solid var(--pb-border);
    text-align: center;
    font-family: 'Poppins', sans-serif;
    font-size: 12.5px;
    -moz-appearance: textfield;
  }

  #pb-{{ section_id }} .pb__qty-input::-webkit-outer-spin-button,
  #pb-{{ section_id }} .pb__qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  #pb-{{ section_id }} .pb__view-details {
    display: block;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--pb-cta);
    text-decoration: underline;
  }

  /* ---- Summary bar ---- */
  #pb-{{ section_id }} .pb__summary {
    max-width: 460px;
    margin: 0 auto;
    background: var(--pb-card-bg);
    border-radius: 22px;
    padding: 26px 28px;
    box-shadow: 0 20px 50px rgba(20, 20, 20, 0.08);
  }

  #pb-{{ section_id }} .pb__promo-note {
    margin: 0 0 14px;
    font-size: 13px;
    font-weight: 600;
    color: var(--pb-cta);
    text-align: center;
  }

  #pb-{{ section_id }} .pb__summary-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  #pb-{{ section_id }} .pb__summary-label {
    font-size: 13.5px;
    color: var(--pb-muted);
  }

  #pb-{{ section_id }} .pb__summary-total {
    font-size: 22px;
    font-weight: 700;
  }

  #pb-{{ section_id }} .pb__add-btn {
    display: block;
    width: 100%;
    height: 50px;
    border-radius: 999px;
    border: none;
    background: var(--pb-cta);
    color: #fff;
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
    transition: background-color 0.25s ease, transform 0.2s ease, opacity 0.2s ease;
  }

  #pb-{{ section_id }} .pb__add-btn:hover:not([disabled]) {
    transform: translateY(-2px);
  }

  #pb-{{ section_id }} .pb__add-btn[disabled] {
    background: #b7b7b7;
    cursor: not-allowed;
    transform: none;
  }

  #pb-{{ section_id }} .pb__add-btn.is-loading {
    opacity: 0.75;
    cursor: wait;
  }

  #pb-{{ section_id }} .pb__feedback {
    min-height: 18px;
    margin: 10px 0 0;
    text-align: center;
    font-size: 12.5px;
    font-weight: 600;
  }

  #pb-{{ section_id }} .pb__feedback.is-success {
    color: var(--pb-accent);
  }

  #pb-{{ section_id }} .pb__feedback.is-error {
    color: #c0392b;
  }

  /* ---- Tablet / Mobile ---- */
  @media (max-width: 899px) {
    #pb-{{ section_id }} .pb__panel {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  @media (max-width: 599px) {
    #pb-{{ section_id }} .pb__panel {
      padding: 20px;
      border-radius: 20px;
    }

    #pb-{{ section_id }} .pb__summary {
      padding: 22px 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #pb-{{ section_id }} [data-reveal] {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>

{%- comment -%} ---------------- JS ---------------- {%- endcomment -%}
<script>
  (function () {
    var section = document.getElementById('pb-{{ section_id }}');
    if (!section) return;

    var revealTargets = Array.prototype.slice.call(section.querySelectorAll('[data-reveal]'));
    if (revealTargets.length) {
      if ('IntersectionObserver' in window) {
        var revealObserver = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                revealObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1 }
        );
        revealTargets.forEach(function (el) { revealObserver.observe(el); });
      } else {
        revealTargets.forEach(function (el) { el.classList.add('is-visible'); });
      }
    }

    var panels = Array.prototype.slice.call(section.querySelectorAll('[data-pb-panel]'));
    if (!panels.length) return;

    function money(amountCents) {
      return '{{ shop.money_format }}'.replace(/\{\{\s*amount\s*\}\}/, (amountCents / 100).toFixed(2));
    }

    /* ---- Per-panel: quantity, include toggle, variant picker ---- */
    panels.forEach(function (panel) {
      var variantScript = panel.querySelector('[data-pb-variants]');
      var variantData = [];
      try { variantData = JSON.parse(variantScript.textContent); } catch (e) { variantData = []; }

      var qtyInput = panel.querySelector('[data-pb-qty-input]');
      var qtyMinus = panel.querySelector('[data-pb-qty-minus]');
      var qtyPlus = panel.querySelector('[data-pb-qty-plus]');
      if (qtyInput && qtyMinus && qtyPlus) {
        qtyMinus.addEventListener('click', function () {
          qtyInput.value = Math.max(1, (parseInt(qtyInput.value, 10) || 1) - 1);
          updateSummary();
        });
        qtyPlus.addEventListener('click', function () {
          qtyInput.value = (parseInt(qtyInput.value, 10) || 1) + 1;
          updateSummary();
        });
        qtyInput.addEventListener('change', updateSummary);
      }

      var includeCheckbox = panel.querySelector('[data-pb-include-checkbox]');
      if (includeCheckbox) {
        includeCheckbox.addEventListener('change', function () {
          panel.classList.toggle('is-included', includeCheckbox.checked);
          panel.setAttribute('data-included', includeCheckbox.checked);
          updateSummary();
        });
      }

      var optionButtons = Array.prototype.slice.call(panel.querySelectorAll('[data-pb-option-btn]'));
      var optionGroups = Array.prototype.slice.call(panel.querySelectorAll('[data-pb-option]'));
      var variantIdInput = panel.querySelector('[data-pb-variant-id]');
      var priceEl = panel.querySelector('[data-pb-price]');
      var compareEl = panel.querySelector('[data-pb-price-compare]');
      var discountEl = panel.querySelector('[data-pb-discount]');
      var stockStatus = panel.querySelector('[data-pb-stock-status]');
      var primaryCellImg = panel.querySelector('[data-pb-cell="0"] [data-pb-cell-img]');

      function currentSelections() {
        return optionGroups.map(function (group) {
          var selected = group.querySelector('.pb__option-btn.is-selected');
          return selected ? selected.getAttribute('data-value') : null;
        });
      }

      function findMatchingVariant(selections) {
        return variantData.find(function (v) {
          return [v.option1, v.option2, v.option3].every(function (opt, i) {
            return selections[i] == null || opt === selections[i];
          });
        });
      }

      function updateForVariant(variant) {
        if (!variant) return;
        if (variantIdInput) variantIdInput.value = variant.id;
        if (priceEl) priceEl.textContent = money(variant.price);

        if (compareEl && discountEl) {
          if (variant.compare_at_price && variant.compare_at_price > variant.price) {
            compareEl.textContent = money(variant.compare_at_price);
            compareEl.style.display = '';
            var pct = Math.round(((variant.compare_at_price - variant.price) / variant.compare_at_price) * 100);
            discountEl.textContent = '-' + pct + '% OFF';
            discountEl.style.display = '';
          } else {
            compareEl.style.display = 'none';
            discountEl.style.display = 'none';
          }
        }

        if (stockStatus) stockStatus.style.display = variant.available ? 'none' : '';
        panel.setAttribute('data-available', variant.available);

        if (primaryCellImg && variant.featured_image && variant.featured_image.src) {
          primaryCellImg.src = variant.featured_image.src.replace(/(\.[a-z]+)(\?|$)/i, '_500x$1$2');
          primaryCellImg.srcset = '';
        }

        updateSummary();
      }

      optionButtons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var group = btn.closest('[data-pb-option]');
          var siblings = group.querySelectorAll('[data-pb-option-btn]');
          siblings.forEach(function (b) { b.classList.remove('is-selected'); });
          btn.classList.add('is-selected');
          var valueLabel = group.querySelector('[data-pb-option-value]');
          if (valueLabel) valueLabel.textContent = btn.getAttribute('data-value');

          var variant = findMatchingVariant(currentSelections());
          updateForVariant(variant);
        });
      });
    });

    /* ---- Shared summary + add-pack-to-cart ---- */
    var countEl = section.querySelector('[data-pb-count]');
    var totalEl = section.querySelector('[data-pb-total]');
    var addBtn = section.querySelector('[data-pb-add-btn]');
    var feedback = section.querySelector('[data-pb-feedback]');
    var itemsLabel = '{{ s.items_label | default: "items selected" | escape }}';

    function includedPanels() {
      return panels.filter(function (panel) {
        var checkbox = panel.querySelector('[data-pb-include-checkbox]');
        var included = checkbox ? checkbox.checked : true;
        return included && panel.getAttribute('data-available') !== 'false';
      });
    }

    function updateSummary() {
      var included = includedPanels();
      var total = 0;
      included.forEach(function (panel) {
        var priceText = panel.querySelector('[data-pb-price]').textContent.replace(/[^0-9.]/g, '');
        var price = Math.round(parseFloat(priceText) * 100) || 0;
        var qty = parseInt((panel.querySelector('[data-pb-qty-input]') || {}).value, 10) || 1;
        total += price * qty;
      });
      if (countEl) countEl.textContent = included.length + ' ' + itemsLabel;
      if (totalEl) totalEl.textContent = money(total);
      if (addBtn) addBtn.disabled = included.length === 0;
    }

    updateSummary();

    function setFeedback(message, type) {
      if (!feedback) return;
      feedback.textContent = message;
      feedback.classList.remove('is-success', 'is-error');
      if (type) feedback.classList.add(type);
    }

    function bumpCartBubble(itemCount) {
      var counts = document.querySelectorAll('.cart-bubble__text-count');
      counts.forEach(function (el) { el.textContent = itemCount; });
    }

    if (addBtn) {
      addBtn.addEventListener('click', function () {
        var included = includedPanels();
        if (!included.length || addBtn.disabled) return;

        addBtn.classList.add('is-loading');
        setFeedback('', null);

        var payload = {
          items: included.map(function (panel) {
            var variantId = parseInt(panel.querySelector('[data-pb-variant-id]').value, 10);
            var qty = parseInt((panel.querySelector('[data-pb-qty-input]') || {}).value, 10) || 1;
            return { id: variantId, quantity: qty };
          })
        };

        fetch('{{ routes.cart_add_url }}', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload)
        })
          .then(function (response) { return response.json().then(function (data) { return { ok: response.ok, data: data }; }); })
          .then(function (result) {
            addBtn.classList.remove('is-loading');
            if (!result.ok) {
              var message = (result.data.description) || (result.data.message) || 'Could not add the pack to cart.';
              setFeedback(message, 'is-error');
              return;
            }
            setFeedback('{{ s.added_to_cart_text | default: "Pack added to cart" | escape }}', 'is-success');
            fetch('{{ routes.cart_url }}.js')
              .then(function (r) { return r.json(); })
              .then(function (cart) { bumpCartBubble(cart.item_count); })
              .catch(function () {});
          })
          .catch(function () {
            addBtn.classList.remove('is-loading');
            setFeedback('Could not add the pack to cart. Please try again.', 'is-error');
          });
      });
    }
  })();
</script>

