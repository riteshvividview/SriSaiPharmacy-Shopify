    { "type": "header", "content": "Pack Content" },
    { "type": "paragraph", "content": "This content is written by you, not pulled from any single product - since the pack combines several different products, there's no one product to auto-fill it from." },
    { "type": "text", "id": "product_eyebrow", "label": "Eyebrow", "default": "Pure Wellness" },
    { "type": "text", "id": "product_title", "label": "Title", "default": "Cold & Flu Essentials Pack" },
    { "type": "checkbox", "id": "show_shipping_note", "label": "Show shipping note", "default": true },
    { "type": "text", "id": "shipping_note_label", "label": "Shipping note label", "default": "Shipping" },
    { "type": "text", "id": "shipping_note_text", "label": "Shipping note text", "default": "calculated at checkout." },
    { "type": "url", "id": "shipping_policy_url", "label": "Shipping note link" },
    { "type": "text", "id": "highlight_line", "label": "Highlight line", "default": "Everything you need, in one tap" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>A hand-picked set of everyday essentials, bundled together so you don't have to add them one at a time.</p>" },
    { "type": "text", "id": "specifications_label", "label": "Specifications label", "default": "Specifications:" },
    { "type": "text", "id": "specifications", "label": "Specifications", "info": "e.g. 4 products | Ships together" },
    { "type": "text", "id": "sold_out_text", "label": "Sold-out ribbon text", "default": "Sold out" },
    { "type": "text", "id": "all_sold_out_text", "label": "All-sold-out message", "default": "All items in this pack are currently sold out." },

    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "add_to_cart_text", "label": "Add-to-cart button text", "default": "Add Pack to Cart" },
    { "type": "text", "id": "added_to_cart_text", "label": "Success message", "default": "Pack added to cart" },
    { "type": "checkbox", "id": "show_buy_now", "label": "Show Buy It Now button", "default": true },
