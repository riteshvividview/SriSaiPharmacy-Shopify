{%- comment -%}
  Section: Collection - Cross-sell
  "Explore more collections" strip for the bottom of a collection page -
  fills out what would otherwise be a page that ends abruptly right
  after the product grid. Blocks use Shopify's native `collection`
  setting so admins just pick real collections from a list (title/image/
  URL all come along for free) rather than typing them in manually.
{%- endcomment -%}

{{ 'https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@400;500;600;700;800&display=swap' | stylesheet_tag }}

{%- liquid
  assign section_id = section.id
  assign s = section.settings
  assign cards = section.blocks
-%}

<section
  class="cx"
  id="cx-{{ section_id }}"
  data-cx
  style="
    --cx-bg: {{ s.background_color | default: '#F7F5F0' }};
    --cx-text: {{ s.text_color | default: '#141414' }};
    --cx-muted: {{ s.muted_color | default: '#6B6B6B' }};
    --cx-accent: {{ s.accent_color | default: '#2E7D32' }};
    --cx-padding-top: {{ s.padding_top | default: 80 }}px;
    --cx-padding-bottom: {{ s.padding_bottom | default: 90 }}px;
  "
>
  <div class="cx__container">
    <div class="cx__header">
      {%- if s.eyebrow != blank -%}<p class="cx__eyebrow" data-reveal>{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="cx__heading" data-reveal>{{ s.heading }}</h2>{%- endif -%}
    </div>

    {%- if cards.size > 0 -%}
      <div class="cx__grid">
        {%- for block in cards -%}
          {%- assign bs = block.settings -%}
          {%- assign target = bs.collection -%}
          {%- if target != blank and target.handle != collection.handle -%}
            <a href="{{ target.url }}" class="cx__card" data-reveal data-reveal-delay="{{ forloop.index0 | modulo: 4 }}" {{ block.shopify_attributes }}>
              <span class="cx__card-media">
                {%- if target.image != blank -%}
                  <img
                    src="{{ target.image | image_url: width: 500 }}"
                    srcset="{{ target.image | image_url: width: 300 }} 300w, {{ target.image | image_url: width: 500 }} 500w"
                    sizes="(max-width: 749px) 45vw, 260px"
                    alt="{{ target.image.alt | default: target.title | escape }}"
                    width="{{ target.image.width }}"
                    height="{{ target.image.height }}"
                    loading="lazy"
                  >
                {%- else -%}
                  <span class="cx__card-placeholder" aria-hidden="true">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><path d="M12 2 3 6v6c0 5 4 8.5 9 10 5-1.5 9-5 9-10V6l-9-4Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
                  </span>
                {%- endif -%}
                <span class="cx__card-scrim" aria-hidden="true"></span>
                <span class="cx__card-title">
                  {{ bs.label | default: target.title }}
                  <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{%- comment -%} ---------------- CSS ---------------- {%- endcomment -%}
<style>
  #cx-{{ section_id }} {
    position: relative;
    background: var(--cx-bg);
    color: var(--cx-text);
    font-family: 'Poppins', sans-serif;
    padding: var(--cx-padding-top) 20px var(--cx-padding-bottom);
  }

  #cx-{{ section_id }} * {
    box-sizing: border-box;
  }

  #cx-{{ section_id }} a {
    text-decoration: none;
    color: inherit;
  }

  #cx-{{ section_id }} .cx__container {
    max-width: 1300px;
    margin: 0 auto;
  }

  #cx-{{ section_id }} [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 22px, 0);
    transition: opacity 0.65s cubic-bezier(0.22, 0.61, 0.36, 1), transform 0.65s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  #cx-{{ section_id }} [data-reveal].is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  #cx-{{ section_id }} .cx__grid [data-reveal-delay="1"] { transition-delay: 0.06s; }
  #cx-{{ section_id }} .cx__grid [data-reveal-delay="2"] { transition-delay: 0.12s; }
  #cx-{{ section_id }} .cx__grid [data-reveal-delay="3"] { transition-delay: 0.18s; }

  #cx-{{ section_id }} .cx__header {
    max-width: 560px;
    margin: 0 auto 40px;
    text-align: center;
  }

  #cx-{{ section_id }} .cx__eyebrow {
    margin: 0 0 10px;
    font-weight: 600;
    font-size: 12.5px;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--cx-accent);
  }

  #cx-{{ section_id }} .cx__heading {
    margin: 0;
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-weight: 400;
    font-size: clamp(28px, 3.6vw, 40px);
    line-height: 1.05;
    letter-spacing: 0.4px;
    text-transform: uppercase;
  }

  #cx-{{ section_id }} .cx__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
  }

  #cx-{{ section_id }} .cx__card-media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: 18px;
    overflow: hidden;
    background: #eceee9;
    box-shadow: 0 14px 30px rgba(20, 20, 20, 0.08);
  }

  #cx-{{ section_id }} .cx__card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  #cx-{{ section_id }} .cx__card:hover .cx__card-media img {
    transform: scale(1.08);
  }

  #cx-{{ section_id }} .cx__card-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--cx-accent);
    opacity: 0.5;
  }

  #cx-{{ section_id }} .cx__card-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(0, 0, 0, 0.55));
  }

  #cx-{{ section_id }} .cx__card-title {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    color: #fff;
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-size: 19px;
    letter-spacing: 0.3px;
    text-transform: uppercase;
  }

  #cx-{{ section_id }} .cx__card-title svg {
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  #cx-{{ section_id }} .cx__card:hover .cx__card-title svg {
    transform: translateX(3px);
  }

  @media (max-width: 999px) {
    #cx-{{ section_id }} .cx__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 749px) {
    #cx-{{ section_id }} {
      padding-left: 16px;
      padding-right: 16px;
    }

    #cx-{{ section_id }} .cx__grid {
      gap: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #cx-{{ section_id }} [data-reveal],
    #cx-{{ section_id }} .cx__card-media img,
    #cx-{{ section_id }} .cx__card-title svg {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>

{%- comment -%} ---------------- JS ---------------- {%- endcomment -%}
<script>
  (function () {
    var section = document.getElementById('cx-{{ section_id }}');
    if (!section) return;

    var revealTargets = Array.prototype.slice.call(section.querySelectorAll('[data-reveal]'));
    if (!revealTargets.length) return;

    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15 }
      );
      revealTargets.forEach(function (el) { observer.observe(el); });
    } else {
      revealTargets.forEach(function (el) { el.classList.add('is-visible'); });
    }
  })();
</script>

{% schema %}
{
  "name": "Collection - Cross-sell",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Keep Exploring" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop Other Collections" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F7F5F0" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#141414" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#6B6B6B" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#2E7D32" },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 5, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 5, "unit": "px", "default": 90 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Collection Card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label override", "info": "Optional. Defaults to the collection's own title." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection - Cross-sell",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
