{%- comment -%}
  Section: FAQ Accordion
  One continuous scrolling page of grouped questions: a quick-nav row of
  category pills at the top (click to jump, highlights as you scroll past
  each category), then each category's questions as expand/collapse
  accordion items. Blocks follow this theme's "attach to preceding
  trigger" convention (see header.liquid's Nav Dropdown/Dropdown Tile):
  a "Category" block starts a new group, followed by any number of
  "Question" blocks that belong to it.
{%- endcomment -%}

{{ 'https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@400;500;600;700;800&display=swap' | stylesheet_tag }}

{%- liquid
  assign section_id = section.id
  assign s = section.settings
  assign categories = section.blocks | where: 'type', 'category'
  assign categories_count = categories.size
-%}

<section
  class="fq"
  id="fq-{{ section_id }}"
  data-fq
  style="
    --fq-bg: {{ s.background_color | default: '#FFFFFF' }};
    --fq-text: {{ s.text_color | default: '#141414' }};
    --fq-muted: {{ s.muted_color | default: '#6B6B6B' }};
    --fq-accent: {{ s.accent_color | default: '#2E7D32' }};
    --fq-cta: {{ s.cta_color | default: '#F58220' }};
    --fq-border: {{ s.border_color | default: '#ECECEC' }};
    --fq-card-bg: {{ s.card_color | default: '#F7F5F0' }};
    --fq-padding-top: {{ s.padding_top | default: 80 }}px;
    --fq-padding-bottom: {{ s.padding_bottom | default: 90 }}px;
  "
>
  <div class="fq__container">
    {%- if categories_count > 1 -%}
      <nav class="fq__quicknav" data-reveal aria-label="Jump to FAQ category">
        {%- for category in categories -%}
          {%- assign cat_id = 'fq-cat-' | append: section_id | append: '-' | append: forloop.index -%}
          <a href="#{{ cat_id }}" class="fq__quicknav-link" data-quicknav-link data-target="{{ cat_id }}">{{ category.settings.heading }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    {%- for category in categories -%}
      {%- assign cat_id = 'fq-cat-' | append: section_id | append: '-' | append: forloop.index -%}
      <div class="fq__category" id="{{ cat_id }}" data-category>
        <h2 class="fq__category-heading" data-reveal>{{ category.settings.heading }}</h2>

        <div class="fq__list">
          {%- assign block_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.id == category.id -%}
              {%- assign block_index = forloop.index0 -%}
            {%- endif -%}
          {%- endfor -%}
          {%- assign q_offset = block_index | plus: 1 -%}
          {%- for q in section.blocks offset: q_offset -%}
            {%- if q.type == 'question' -%}
              {%- assign qs = q.settings -%}
              <div class="fq__item" data-reveal data-faq-item {{ q.shopify_attributes }}>
                <button type="button" class="fq__question" data-faq-toggle aria-expanded="false">
                  <span class="fq__question-text">{{ qs.question }}</span>
                  <span class="fq__icon" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                  </span>
                </button>
                <div class="fq__answer-wrap">
                  <div class="fq__answer">{{ qs.answer }}</div>
                </div>
              </div>
            {%- else -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endfor -%}

    {%- if s.cta_text != blank -%}
      <div class="fq__cta" data-reveal>
        {%- if s.cta_heading != blank -%}<p class="fq__cta-heading">{{ s.cta_heading }}</p>{%- endif -%}
        <a href="{{ s.cta_url | default: '#' }}" class="fq__cta-btn">{{ s.cta_text }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{%- comment -%} ---------------- CSS ---------------- {%- endcomment -%}
<style>
  #fq-{{ section_id }} {
    position: relative;
    background: var(--fq-bg);
    color: var(--fq-text);
    font-family: 'Poppins', sans-serif;
    padding: var(--fq-padding-top) 20px var(--fq-padding-bottom);
  }

  #fq-{{ section_id }} * {
    box-sizing: border-box;
  }

  #fq-{{ section_id }} .fq__container {
    max-width: 880px;
    margin: 0 auto;
  }

  #fq-{{ section_id }} [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 22px, 0);
    transition: opacity 0.65s cubic-bezier(0.22, 0.61, 0.36, 1), transform 0.65s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  #fq-{{ section_id }} [data-reveal].is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  /* ---- Quick-nav ---- */
  #fq-{{ section_id }} .fq__quicknav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 56px;
  }

  #fq-{{ section_id }} .fq__quicknav-link {
    padding: 10px 18px;
    border-radius: 999px;
    border: 1.5px solid var(--fq-border);
    color: var(--fq-muted);
    font-size: 13.5px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }

  #fq-{{ section_id }} .fq__quicknav-link:hover {
    border-color: var(--fq-accent);
    color: var(--fq-accent);
  }

  #fq-{{ section_id }} .fq__quicknav-link.is-active {
    background: var(--fq-accent);
    border-color: var(--fq-accent);
    color: #fff;
  }

  /* ---- Category ---- */
  #fq-{{ section_id }} .fq__category {
    scroll-margin-top: 110px;
    margin-bottom: 56px;
  }

  #fq-{{ section_id }} .fq__category:last-of-type {
    margin-bottom: 0;
  }

  #fq-{{ section_id }} .fq__category-heading {
    margin: 0 0 22px;
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-weight: 400;
    font-size: clamp(24px, 3vw, 32px);
    letter-spacing: 0.4px;
    text-transform: uppercase;
    line-height: 1.1;
    color: var(--fq-text);
    display: flex;
    align-items: center;
    gap: 12px;
  }

  #fq-{{ section_id }} .fq__category-heading::before {
    content: '';
    width: 26px;
    height: 3px;
    border-radius: 3px;
    background: var(--fq-cta);
    flex-shrink: 0;
  }

  #fq-{{ section_id }} .fq__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* ---- Item / accordion ---- */
  #fq-{{ section_id }} .fq__item {
    background: var(--fq-card-bg);
    border: 1px solid var(--fq-border);
    border-radius: 14px;
    overflow: hidden;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  #fq-{{ section_id }} .fq__item.is-open {
    border-color: color-mix(in srgb, var(--fq-accent) 35%, var(--fq-border));
    box-shadow: 0 10px 26px rgba(20, 20, 20, 0.06);
  }

  #fq-{{ section_id }} .fq__question {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 20px;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    font-family: 'Poppins', sans-serif;
    color: var(--fq-text);
  }

  #fq-{{ section_id }} .fq__question-text {
    font-weight: 600;
    font-size: 15px;
    line-height: 1.5;
  }

  #fq-{{ section_id }} .fq__item.is-open .fq__question-text {
    color: var(--fq-accent);
  }

  #fq-{{ section_id }} .fq__icon {
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #fff;
    border: 1.5px solid var(--fq-border);
    color: var(--fq-accent);
    transition: transform 0.3s cubic-bezier(0.22, 0.61, 0.36, 1), background-color 0.25s ease, border-color 0.25s ease;
  }

  #fq-{{ section_id }} .fq__item.is-open .fq__icon {
    transform: rotate(135deg);
    background: var(--fq-accent);
    border-color: var(--fq-accent);
    color: #fff;
  }

  /* Grid-rows trick: animates height without JS measuring the content,
     and without the padding-jump issues a plain max-height transition
     tends to have. */
  #fq-{{ section_id }} .fq__answer-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.38s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  #fq-{{ section_id }} .fq__item.is-open .fq__answer-wrap {
    grid-template-rows: 1fr;
  }

  #fq-{{ section_id }} .fq__answer {
    min-height: 0;
    overflow: hidden;
  }

  #fq-{{ section_id }} .fq__answer > * {
    margin: 0 0 1em;
    padding: 0 20px;
    font-size: 14px;
    line-height: 1.75;
    color: var(--fq-muted);
  }

  #fq-{{ section_id }} .fq__answer > *:first-child {
    padding-top: 2px;
  }

  #fq-{{ section_id }} .fq__answer > *:last-child {
    margin-bottom: 0;
    padding-bottom: 20px;
  }

  #fq-{{ section_id }} .fq__answer ul,
  #fq-{{ section_id }} .fq__answer ol {
    padding-left: 38px;
  }

  #fq-{{ section_id }} .fq__answer a {
    color: var(--fq-accent);
    text-decoration: underline;
  }

  /* ---- Closing CTA ---- */
  #fq-{{ section_id }} .fq__cta {
    margin-top: 64px;
    padding: 40px 30px;
    border-radius: 20px;
    background: var(--fq-card-bg);
    text-align: center;
  }

  #fq-{{ section_id }} .fq__cta-heading {
    margin: 0 0 18px;
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-weight: 400;
    font-size: clamp(22px, 3vw, 28px);
    letter-spacing: 0.4px;
    text-transform: uppercase;
  }

  #fq-{{ section_id }} .fq__cta-btn {
    display: inline-flex;
    align-items: center;
    background: var(--fq-cta);
    color: #fff;
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    padding: 15px 32px;
    border-radius: 999px;
    transition: transform 0.25s cubic-bezier(0.22, 0.61, 0.36, 1), box-shadow 0.25s ease;
  }

  #fq-{{ section_id }} .fq__cta-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 26px rgba(0, 0, 0, 0.2);
  }

  @media (max-width: 749px) {
    #fq-{{ section_id }} .fq__quicknav {
      margin-bottom: 40px;
    }

    #fq-{{ section_id }} .fq__category {
      margin-bottom: 44px;
    }

    #fq-{{ section_id }} .fq__question {
      padding: 16px;
    }

    #fq-{{ section_id }} .fq__answer > * {
      padding-left: 16px;
      padding-right: 16px;
    }

    #fq-{{ section_id }} .fq__cta {
      padding: 30px 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #fq-{{ section_id }} [data-reveal],
    #fq-{{ section_id }} .fq__icon,
    #fq-{{ section_id }} .fq__answer-wrap,
    #fq-{{ section_id }} .fq__cta-btn {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>

{%- comment -%} ---------------- JS ---------------- {%- endcomment -%}
<script>
  (function () {
    var section = document.getElementById('fq-{{ section_id }}');
    if (!section) return;

    var revealTargets = Array.prototype.slice.call(section.querySelectorAll('[data-reveal]'));
    if (revealTargets.length) {
      if ('IntersectionObserver' in window) {
        var revealObserver = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                revealObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -6% 0px' }
        );
        revealTargets.forEach(function (el) { revealObserver.observe(el); });
      } else {
        revealTargets.forEach(function (el) { el.classList.add('is-visible'); });
      }
    }

    /* ---- Accordion open/close (multiple can be open at once) ---- */
    var items = Array.prototype.slice.call(section.querySelectorAll('[data-faq-item]'));
    items.forEach(function (item) {
      var toggle = item.querySelector('[data-faq-toggle]');
      if (!toggle) return;
      toggle.addEventListener('click', function () {
        var isOpen = item.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });
    });

    /* ---- Quick-nav: smooth scroll + active state while scrolling ---- */
    var quicknavLinks = Array.prototype.slice.call(section.querySelectorAll('[data-quicknav-link]'));
    var categories = Array.prototype.slice.call(section.querySelectorAll('[data-category]'));
    if (!quicknavLinks.length || !categories.length) return;

    function setActive(id) {
      quicknavLinks.forEach(function (link) {
        link.classList.toggle('is-active', link.getAttribute('data-target') === id);
      });
    }

    quicknavLinks.forEach(function (link) {
      link.addEventListener('click', function (e) {
        var targetId = link.getAttribute('data-target');
        var targetEl = document.getElementById(targetId);
        if (!targetEl) return;
        e.preventDefault();
        targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        setActive(targetId);
      });
    });

    if ('IntersectionObserver' in window) {
      var navObserver = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) setActive(entry.target.id);
          });
        },
        { threshold: 0, rootMargin: '-45% 0px -50% 0px' }
      );
      categories.forEach(function (cat) { navObserver.observe(cat); });
    }
  })();
</script>

{% schema %}
{
  "name": "FAQ Accordion",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Closing CTA" },
    { "type": "text", "id": "cta_heading", "label": "Heading", "default": "Still have a question?" },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Contact Us" },
    { "type": "url", "id": "cta_url", "label": "Button link" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_color", "label": "Card / closing CTA background", "default": "#F2F6F1" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#141414" },
    { "type": "color", "id": "muted_color", "label": "Muted text (answers)", "default": "#6B6B6B" },
    { "type": "color", "id": "accent_color", "label": "Accent (open state, links)", "default": "#2E7D32" },
    { "type": "color", "id": "cta_color", "label": "CTA / bullet color", "default": "#F58220" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#ECECEC" },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 5, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 5, "unit": "px", "default": 90 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "heading", "label": "Category heading", "default": "Category" }
      ]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "paragraph", "content": "Place this block directly below the Category it belongs to." },
        { "type": "text", "id": "question", "label": "Question", "default": "Question text?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer text.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion",
      "blocks": [
        { "type": "category" },
        { "type": "question" },
        { "type": "question" }
      ]
    }
  ]
}
{% endschema %}
