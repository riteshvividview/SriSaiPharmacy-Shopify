<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %}
      Opt into cross-document (MPA) view transitions and hold first paint until #MainContent
      parses, so the transition runs consistently.
      Both are gated on the same settings as the view-transitions.js opt-out switch (see snippets/scripts.liquid).
    {% endcomment %}
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}
      {% style %}
        @media (prefers-reduced-motion: no-preference) {
          @view-transition {
            navigation: auto;
          }
        }
      {% endstyle %}
      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {% endif %}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-palette' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}

    {%- comment -%}
      About page only: GSAP + ScrollTrigger for the scroll-driven "chapter"
      storytelling in sections/about-*.liquid. Loaded in <head> (unlike the
      homepage's Lenis block, which sits at the end of <body>) on purpose:
      each chapter section's own inline <script> calls ScrollTrigger.create()
      while the <body> is still parsing, so the scroller default below MUST
      already be set before that happens, not after.

      Same .page-wrapper vs window concern as Lenis - see
      assets/scroll-container.js and the Lenis comment near </body> below.
      ScrollTrigger can't have an existing instance's scroller changed in
      place, so on breakpoint crossing every instance is killed and every
      chapter's init function (pushed to window.__aboutChapterInits by each
      chapter's own script) is re-run against the new scroller.
    {%- endcomment -%}
    {% if template == 'page.about-us' %}
      <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.7/dist/gsap.min.js"></script>
      <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.7/dist/ScrollTrigger.min.js"></script>
      <script>
        (function () {
          if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;
          gsap.registerPlugin(ScrollTrigger);

          var DESKTOP_QUERY = window.matchMedia('(min-width: 990px)');

          function currentScroller() {
            return DESKTOP_QUERY.matches ? document.querySelector('.page-wrapper') : window;
          }

          ScrollTrigger.defaults({ scroller: currentScroller() });

          window.__aboutChapterInits = window.__aboutChapterInits || [];

          DESKTOP_QUERY.addEventListener('change', function () {
            ScrollTrigger.getAll().forEach(function (st) { st.kill(); });
            ScrollTrigger.defaults({ scroller: currentScroller() });
            window.__aboutChapterInits.forEach(function (fn) { fn(); });
            ScrollTrigger.refresh();
          });

          window.addEventListener('load', function () {
            ScrollTrigger.refresh();
          });
        })();
      </script>
    {% endif %}
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}

    {% render 'chat-drawer' %}

    <div class="page-wrapper">
      <div id="header-group">
        {% sections 'header-group' %}
      </div>

      <script>
        // Inline header height and menu style calculations to prevent layout shift
        // Note: Updates in calculateHeaderGroupHeight(), updateTransparentHeaderOffset() and setHeaderMenuStyle() utilities.js should be kept in sync with this function
        (function setHeaderHeighCustomProperties() {
          /*
           * Header calculation functions for maintaining CSS variables
           * Mimic calculateHeaderGroupHeight() in utilities.js
           */
          const header = document.querySelector('header-component');
          const headerGroup = document.querySelector('#header-group');
          const hasHeaderSection = headerGroup?.querySelector('.header-section');

          if (!header || !headerGroup) return;

          const headerTopRow = header.querySelector('.header__row--top');
          const headerHeight = header.offsetHeight;

          // Calculate the total height of the header group
          let headerGroupHeight = 0;
          const children = headerGroup.children;
          for (let i = 0; i < children.length; i++) {
            const element = children[i];
            if (element === header || !(element instanceof HTMLElement)) continue;
            headerGroupHeight += element.offsetHeight;
          }

          // Check for transparent header special case
          if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
            headerGroupHeight += headerHeight;
          }

          // Set CSS variables
          document.body.style.setProperty('--header-height', `${headerHeight}px`);
          document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);

          if (headerTopRow) {
            window.requestAnimationFrame(function () {
              document.body.style.setProperty('--top-row-height', `${headerTopRow.offsetHeight}px`);
            });
          }

          /**
           * Updates CSS custom properties for transparent header offset calculation
           * Mimic updateTransparentHeaderOffset() in utilities.js
           */

          if (!hasHeaderSection || !header?.hasAttribute('transparent')) {
            document.body.style.setProperty('--transparent-header-offset-boolean', '0');
            return;
          }

          const hasImmediateSection = hasHeaderSection.nextElementSibling?.classList.contains('shopify-section');

          const shouldApplyOffset = !hasImmediateSection ? '1' : '0';
          document.body.style.setProperty('--transparent-header-offset-boolean', shouldApplyOffset);
        })();

        (function setHeaderMenuStyle() {
          const headerComponent = document.querySelector('#header-component');
          if (headerComponent) {
            const isTouchDevice = 'ontouchstart' in window && navigator.maxTouchPoints > 0;
            const overflowList = headerComponent?.querySelector('overflow-list');
            const hasReachedMinimum = overflowList && overflowList.hasAttribute('minimum-reached');
            headerComponent.dataset.menuStyle = isTouchDevice || hasReachedMinimum ? 'drawer' : 'menu';
          }
        })();
      </script>

      <main
        id="MainContent"
        class="content-for-layout"
        role="main"
        data-page-transition-enabled="{{ settings.page_transition_enabled }}"
        data-product-transition="{{ settings.transition_to_main_product }}"
        data-template="{{ template }}"
      >
        {{ content_for_layout }}
      </main>

      <footer>
        {% sections 'footer-group' %}
      </footer>
    </div>

    {% render 'cart-drawer', render_wrapper: true %}
    {% render 'theme-drawer' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}

    {%- comment -%}
      Homepage-only smooth scroll (Lenis). Scoped to `template == 'index'`
      so it never touches other pages - added back per explicit request
      after being fully removed earlier in the project.

      This theme scrolls `.page-wrapper` (not window/document) at desktop
      widths (>=990px) - see assets/scroll-container.js - while mobile
      scrolls the document natively so the browser chrome can hide/show.
      Lenis is instantiated against whichever one is actually the real
      scroll container for the current width, and re-created on any
      desktop/mobile breakpoint crossing. Because Lenis drives the real
      element's scrollTop (not a transform-based fake scroll), every
      existing `.page-wrapper` / window scroll listener in this theme's
      custom sections keeps receiving genuine native scroll events and
      needs no changes.
    {%- endcomment -%}
    {% if template == 'index' %}
      <script src="https://cdn.jsdelivr.net/npm/lenis@1.1.13/dist/lenis.min.js"></script>
      <script>
        (function () {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          if (typeof Lenis === 'undefined') return;

          var DESKTOP_QUERY = window.matchMedia('(min-width: 990px)');
          var lenisInstance = null;

          function createLenis() {
            var isDesktop = DESKTOP_QUERY.matches;
            var wrapper = isDesktop ? document.querySelector('.page-wrapper') : window;
            var options = {
              duration: 0.85,
              // Exponential ease-out (Lenis's own recommended default) -
              // starts with real velocity immediately instead of the
              // slow ramp-up feel of a softer curve, which is what was
              // reading as "scroll happens after a delay".
              easing: function (t) { return Math.min(1, 1.001 - Math.pow(2, -10 * t)); },
              smoothWheel: true,
              syncTouch: false,
            };
            if (wrapper && wrapper !== window) {
              // .page-wrapper has `scroll-behavior: smooth` in this
              // theme's own base CSS (assets/base.css). Left in place,
              // every scrollTop update Lenis makes each frame would
              // ALSO get the browser's native smooth-scroll easing
              // layered on top of Lenis's own easing - two animations
              // chasing each other, which is exactly what shows up as
              // input lag. Force it off while Lenis owns this element.
              wrapper.style.scrollBehavior = 'auto';
              options.wrapper = wrapper;
              options.content = wrapper;
            }
            lenisInstance = new Lenis(options);
          }

          function destroyLenis() {
            if (lenisInstance) {
              lenisInstance.destroy();
              lenisInstance = null;
            }
            var pageWrapper = document.querySelector('.page-wrapper');
            if (pageWrapper) pageWrapper.style.scrollBehavior = '';
          }

          function raf(time) {
            if (lenisInstance) lenisInstance.raf(time);
            window.requestAnimationFrame(raf);
          }

          createLenis();
          window.requestAnimationFrame(raf);

          DESKTOP_QUERY.addEventListener('change', function () {
            destroyLenis();
            createLenis();
          });
        })();
      </script>
    {% endif %}

  </body>
</html>
